{% doc %}
  @prompt
    Update the "Plant care help" section to include a background image upload option. The section should allow merchants to upload a background image, with an overlay option for text readability. Keep all existing content and settings intact, just add the background image upload functionality.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .plant-care-help-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .plant-care-help-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: {% if block.settings.background_image %}url('{{ block.settings.background_image | image_url: width: 2400 }}'){% else %}none{% endif %};
    background-position: {{ block.settings.background_position }};
    background-size: cover;
    background-repeat: no-repeat;
  }

  .plant-care-help-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .plant-care-help__inner-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment }};
    gap: 16px;
    max-width: 720px;
    min-height: {{ block.settings.min_height }}px;
    justify-content: center;
    padding: 56px 32px;
    text-align: {{ block.settings.text_alignment }};
  }

  .plant-care-help__heading-{{ ai_gen_id }} {
    margin: 0;
    color: inherit;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .plant-care-help__text-{{ ai_gen_id }} {
    margin: 0;
    color: inherit;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .plant-care-help__link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 12px 22px;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-weight: 600;
    text-decoration: none;
  }

  .plant-care-help__link-{{ ai_gen_id }}:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .plant-care-help__inner-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_min_height }}px;
      padding: 40px 20px;
    }

    .plant-care-help__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<section class="plant-care-help-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="plant-care-help__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="plant-care-help__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.text != blank %}
      <div class="plant-care-help__text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
    {% endif %}
    {% if block.settings.button_label != blank and block.settings.button_link != blank %}
      <a class="plant-care-help__link-{{ ai_gen_id }}" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Plant care help",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Plant care help" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Find helpful guidance to keep your plants healthy and thriving.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "select", "id": "background_position", "label": "Image position", "options": [{ "value": "center center", "label": "Center" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }, { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" }], "default": "center center" },
    { "type": "checkbox", "id": "enable_overlay", "label": "Enable overlay", "default": true },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#0d3a1d" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "options": [{ "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 180, "max": 700, "step": 20, "unit": "px", "default": 360 },
    { "type": "range", "id": "mobile_min_height", "label": "Mobile height", "min": 160, "max": 600, "step": 20, "unit": "px", "default": 300 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f4f7dc" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#ffd60a" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#0d3a1d" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#ffd60a" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 14, "max": 28, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Plant care help" }],
  "tag": null,
  "class": "plant-care-help-block"
}
{% endschema %}