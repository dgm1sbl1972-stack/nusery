{% doc %}
  @prompt
    Create a responsive Shopify section inspired by the uploaded reference image.
    
    Add a centered heading “Transform Your Home.” followed by 4 image tiles in a horizontal row on desktop.
    
    Card functionality:
    
    Make the entire image tile clickable.
    When a customer clicks anywhere on a tile — image, title, or button area — it should open the collection assigned to that tile.
    Add a Collection picker in the Shopify Theme Editor for each tile so I can select the collection.
    Do not use separate links for the image and title; the entire card must use the same collection link.
    Remove the “Shop Now” button.
    
    Cards:
    
    Living Room
    Bedroom
    Balcony
    Office
    
    Each card should have:
    
    Full-background image
    Rounded corners
    Dark transparent overlay for readability
    White centered collection title
    Hover effect with a subtle image zoom
    Cursor/pointer interaction to clearly indicate the tile is clickable
    
    Theme Editor settings:
    
    Section heading
    Collection picker for each card
    Image picker for each card
    Card title
    Add/remove/reorder cards
    Desktop cards per row
    Mobile cards per row
    Border radius
    Overlay opacity
    
    Make the entire section fully responsive and ensure clicking anywhere inside a tile opens its selected Shopify collection page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-transform-home-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 48px 24px;
    background: {{ block.settings.background_color }};
  }

  .ai-transform-home-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-transform-home-{{ ai_gen_id }}__heading {
    margin: 0 0 28px;
    color: {{ block.settings.heading_color }};
    text-align: center;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    font-weight: 700;
  }

  .ai-transform-home-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_cards_per_row }}, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-transform-home-{{ ai_gen_id }}__card {
    position: relative;
    display: flex;
    min-height: {{ block.settings.card_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    color: #ffffff;
    text-decoration: none;
    isolation: isolate;
    cursor: pointer;
    background: {{ block.settings.fallback_color }};
  }

  .ai-transform-home-{{ ai_gen_id }}__media,
  .ai-transform-home-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
  }

  .ai-transform-home-{{ ai_gen_id }}__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
    z-index: -2;
  }

  .ai-transform-home-{{ ai_gen_id }}__overlay {
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: -1;
  }

  .ai-transform-home-{{ ai_gen_id }}__card:hover .ai-transform-home-{{ ai_gen_id }}__media,
  .ai-transform-home-{{ ai_gen_id }}__card:focus-visible .ai-transform-home-{{ ai_gen_id }}__media {
    transform: scale(1.06);
  }

  .ai-transform-home-{{ ai_gen_id }}__title {
    width: 100%;
    align-self: center;
    margin: 0;
    padding: 24px;
    color: #ffffff;
    text-align: center;
    font-size: {{ block.settings.card_title_size }}px;
    line-height: 1.2;
    font-weight: 700;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }

  .ai-transform-home-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.placeholder_color }};
    background: {{ block.settings.placeholder_background }};
  }

  .ai-transform-home-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.35;
  }

  .ai-transform-home-{{ ai_gen_id }}__empty {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    padding: 7px 10px;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.62);
    border-radius: 4px;
    text-align: center;
    font-size: 12px;
    line-height: 1.3;
  }

  .ai-transform-home-{{ ai_gen_id }}__card:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-transform-home-{{ ai_gen_id }} {
      padding: 36px 16px;
    }

    .ai-transform-home-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.mobile_cards_per_row }}, minmax(0, 1fr));
    }

    .ai-transform-home-{{ ai_gen_id }}__card {
      min-height: {{ block.settings.mobile_card_height }}px;
    }
  }
{% endstyle %}

<div class="ai-transform-home-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-transform-home-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-transform-home-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    <div class="ai-transform-home-{{ ai_gen_id }}__grid">
      {% for i in (1..4) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign image_key = 'image_' | append: i
          assign title_key = 'title_' | append: i
          assign collection = block.settings[collection_key]
          assign image = block.settings[image_key]
          assign title = block.settings[title_key]
        %}
        {% if collection != blank %}
          <a class="ai-transform-home-{{ ai_gen_id }}__card" href="{{ collection.url }}" aria-label="View {{ title | default: collection.title | escape }} collection">
        {% else %}
          <div class="ai-transform-home-{{ ai_gen_id }}__card" role="link" aria-disabled="true" tabindex="0">
        {% endif %}
            {% if image != blank %}
              <img class="ai-transform-home-{{ ai_gen_id }}__media" src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: title | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">
            {% else %}
              <div class="ai-transform-home-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-transform-home-{{ ai_gen_id }}__empty">Add an image for this card</span></div>
            {% endif %}
            <span class="ai-transform-home-{{ ai_gen_id }}__overlay"></span>
            <span class="ai-transform-home-{{ ai_gen_id }}__title">{{ title | default: collection.title | escape }}</span>
        {% if collection != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Transform home cards",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Transform Your Home." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "desktop_cards_per_row", "label": "Desktop cards per row", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "mobile_cards_per_row", "label": "Mobile cards per row", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "card_title_size", "label": "Card title size", "min": 14, "max": 32, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_height", "label": "Card height", "min": 180, "max": 500, "step": 10, "unit": "px", "default": 280 },
    { "type": "range", "id": "mobile_card_height", "label": "Mobile card height", "min": 140, "max": 360, "step": 10, "unit": "px", "default": 220 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f8f4ec" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#0d3a1d" },
    { "type": "color", "id": "fallback_color", "label": "Card fallback", "default": "#1f5130" },
    { "type": "color", "id": "placeholder_background", "label": "Placeholder background", "default": "#dfe8df" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder icon", "default": "#5b6660" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#ffd60a" },
    { "type": "header", "content": "Living room" },
    { "type": "collection", "id": "collection_1", "label": "Collection" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "text", "id": "title_1", "label": "Card title", "default": "Living Room" },
    { "type": "header", "content": "Bedroom" },
    { "type": "collection", "id": "collection_2", "label": "Collection" },
    { "type": "image_picker", "id": "image_2", "label": "Image" },
    { "type": "text", "id": "title_2", "label": "Card title", "default": "Bedroom" },
    { "type": "header", "content": "Balcony" },
    { "type": "collection", "id": "collection_3", "label": "Collection" },
    { "type": "image_picker", "id": "image_3", "label": "Image" },
    { "type": "text", "id": "title_3", "label": "Card title", "default": "Balcony" },
    { "type": "header", "content": "Office" },
    { "type": "collection", "id": "collection_4", "label": "Collection" },
    { "type": "image_picker", "id": "image_4", "label": "Image" },
    { "type": "text", "id": "title_4", "label": "Card title", "default": "Office" }
  ],
  "presets": [{ "name": "Transform home cards" }],
  "tag": null,
  "class": "transform-home-cards"
}
{% endschema %}