{% doc %}
  @prompt
    can we create a blog section and need an option like all articles , 3 blogs each should have blog link to past, need the blogs in square shape  from end to end of the desktop, need in small box kind, end to end desktop 1080x1080 pixel boxes need 3 blogs , need in small boxs , need in square shape boxes 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{%- liquid
  assign blog_numbers = '1,2,3,4' | split: ','
  assign blog_count = 0
  for number in blog_numbers
    assign blog_key = 'blog_' | append: number
    if block.settings[blog_key] != blank or request.design_mode
      assign blog_count = blog_count | plus: 1
    endif
  endfor
  if blog_count == 0
    assign blog_count = 1
  endif
-%}
{% style %}
.ai-square-blog-boxes-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding:{{ block.settings.section_padding }}px 16px;background:{{ block.settings.background_color }}}.ai-square-blog-boxes-{{ ai_gen_id }}__heading{margin:0 0 24px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px;text-align:center}.ai-square-blog-boxes-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat({{ blog_count }},minmax(0,{{ block.settings.box_size }}px));justify-content:center;gap:{{ block.settings.gap }}px;width:100%}.ai-square-blog-boxes-{{ ai_gen_id }}__card{position:relative;width:100%;aspect-ratio:1/1;max-width:100%;overflow:hidden;background:{{ block.settings.card_color }};border:1px solid rgba(20,35,26,.14);border-radius:{{ block.settings.card_radius }}px;box-shadow:0 3px 12px rgba(20,35,26,.08)}.ai-square-blog-boxes-{{ ai_gen_id }}__card>a:first-child{display:block;width:100%;height:100%}.ai-square-blog-boxes-{{ ai_gen_id }}__media,.ai-square-blog-boxes-{{ ai_gen_id }}__placeholder{display:block;width:100%;height:100%;object-fit:cover}.ai-square-blog-boxes-{{ ai_gen_id }}__placeholder{background:{{ settings.color_lime }}}.ai-square-blog-boxes-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-square-blog-boxes-{{ ai_gen_id }}__content{position:absolute;right:0;bottom:0;left:0;padding:14px;color:#fff;background:linear-gradient(transparent,rgba(13,58,29,.94))}.ai-square-blog-boxes-{{ ai_gen_id }}__title{margin:24px 0 6px;font-size:17px;line-height:1.25}.ai-square-blog-boxes-{{ ai_gen_id }}__title a,.ai-square-blog-boxes-{{ ai_gen_id }}__article a{color:#fff;text-decoration:none}.ai-square-blog-boxes-{{ ai_gen_id }}__article{margin:0 0 8px;font-size:12px}.ai-square-blog-boxes-{{ ai_gen_id }}__link{color:#fff;font-size:12px;font-weight:700;text-decoration:underline;text-underline-offset:3px}.ai-square-blog-boxes-{{ ai_gen_id }}__empty{display:flex;width:100%;height:100%;align-items:center;justify-content:center;padding:20px;color:{{ settings.color_muted }};text-align:center;font-size:13px}.ai-square-blog-boxes-{{ ai_gen_id }}__actions{display:flex;justify-content:center;margin-top:32px}.ai-square-blog-boxes-{{ ai_gen_id }}__button{justify-content:center;min-width:220px;padding:14px 32px;font-size:15px}@media(max-width:989px){.ai-square-blog-boxes-{{ ai_gen_id }}__grid{grid-template-columns:repeat(2,minmax(0,{{ block.settings.box_size }}px))}}@media(max-width:749px){.ai-square-blog-boxes-{{ ai_gen_id }}__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.ai-square-blog-boxes-{{ ai_gen_id }}__content{padding:10px}.ai-square-blog-boxes-{{ ai_gen_id }}__title{margin-top:12px;font-size:14px}.ai-square-blog-boxes-{{ ai_gen_id }}__article{margin-bottom:2px;font-size:11px;line-height:1.35}}
/* Mobile: tighter section spacing */@media screen and (max-width: 749px){.ai-square-blog-boxes-{{ ai_gen_id }}{padding-top:{{ block.settings.section_padding | at_most: 24 }}px;padding-bottom:{{ block.settings.section_padding | at_most: 24 }}px}.ai-square-blog-boxes-{{ ai_gen_id }}__actions{margin-top:20px}}{% endstyle %}
<div class="ai-square-blog-boxes-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{% if block.settings.heading != blank %}<h2 class="ai-square-blog-boxes-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-square-blog-boxes-{{ ai_gen_id }}__grid">{% for number in blog_numbers %}{% assign blog_key = 'blog_' | append: number %}{% assign selected_blog = block.settings[blog_key] %}{% if selected_blog == blank and request.design_mode == false %}{% continue %}{% endif %}<article class="ai-square-blog-boxes-{{ ai_gen_id }}__card">{% if selected_blog != blank %}{% assign article = selected_blog.articles.first %}<a href="{{ selected_blog.url }}" aria-label="View {{ selected_blog.title | escape }}">{% if article.image %}<img class="ai-square-blog-boxes-{{ ai_gen_id }}__media" src="{{ article.image | image_url: width: 1080 }}" alt="{{ article.image.alt | default: selected_blog.title | escape }}" loading="lazy" width="1080" height="1080">{% else %}<div class="ai-square-blog-boxes-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</a><div class="ai-square-blog-boxes-{{ ai_gen_id }}__content"><h3 class="ai-square-blog-boxes-{{ ai_gen_id }}__title"><a href="{{ selected_blog.url }}">{{ selected_blog.title | escape }}</a></h3>{% if article != blank %}<p class="ai-square-blog-boxes-{{ ai_gen_id }}__article"><a href="{{ article.url }}">{{ article.title | escape }}</a></p>{% endif %}</div>{% else %}<div class="ai-square-blog-boxes-{{ ai_gen_id }}__empty">Select blog {{ number }} in this section's settings (only visible in the theme editor).</div>{% endif %}</article>{% endfor %}</div>{% assign all_articles_url = block.settings.button_link %}{% if all_articles_url == blank %}{% if pages['all-articles'].url != blank %}{% assign all_articles_url = pages['all-articles'].url | append: '?view=all-articles' %}{% else %}{% assign all_articles_url = block.settings.blog_1.url %}{% endif %}{% endif %}{% if block.settings.button_label != blank and all_articles_url != blank %}<div class="ai-square-blog-boxes-{{ ai_gen_id }}__actions"><a class="btn btn--dark ai-square-blog-boxes-{{ ai_gen_id }}__button" href="{{ all_articles_url }}">{{ block.settings.button_label | escape }}</a></div>{% endif %}</div>
{% schema %}{"name":"Square blog boxes","settings":[{"type":"blog","id":"blog_1","label":"Blog 1"},{"type":"blog","id":"blog_2","label":"Blog 2"},{"type":"blog","id":"blog_3","label":"Blog 3"},{"type":"blog","id":"blog_4","label":"Blog 4","info":"Create the blog first in Online Store > Blog posts > Manage blogs"},{"type":"text","id":"heading","label":"Heading","default":"Explore our blogs"},{"type":"text","id":"button_label","label":"Button label","default":"View all articles"},{"type":"url","id":"button_link","label":"Button link","info":"Leave empty to link to the All articles page (/pages/all-articles), or Blog 1 until that page exists."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"box_size","label":"Box size","min":120,"max":360,"step":10,"unit":"px","default":220},{"type":"range","id":"section_padding","label":"Section spacing","min":20,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"gap","label":"Box gap","min":10,"max":40,"step":5,"unit":"px","default":15},{"type":"range","id":"card_radius","label":"Box radius","min":0,"max":32,"step":2,"unit":"px","default":10},{"type":"range","id":"heading_size","label":"Heading size","min":22,"max":56,"step":2,"unit":"px","default":30},{"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},{"type":"color","id":"card_color","label":"Box","default":"#ffffff"},{"type":"color","id":"heading_color","label":"Heading","default":"#0d3a1d"}],"presets":[{"name":"Square blog boxes"}],"tag":null,"class":"square-blog-boxes-block"}{% endschema %}