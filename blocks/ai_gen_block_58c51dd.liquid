    { "type": "text", "id": "plants_category_2_title", "label": "Category 2", "default": "Outdoor plants" }, { "type": "url", "id": "plants_category_2_link", "label": "Category 2 link" },
    { "type": "text", "id": "plants_category_3_title", "label": "Category 3", "default": "Flowering plants" }, { "type": "url", "id": "plants_category_3_link", "label": "Category 3 link" },
    { "type": "text", "id": "plants_category_4_title", "label": "Category 4", "default": "Succulents" }, { "type": "url", "id": "plants_category_4_link", "label": "Category 4 link" },
    { "type": "text", "id": "plants_category_5_title", "label": "Category 5", "default": "Cacti" }, { "type": "url", "id": "plants_category_5_link", "label": "Category 5 link" },
    { "type": "text", "id": "plants_category_6_title", "label": "Category 6", "default": "Fruit plants" }, { "type": "url", "id": "plants_category_6_link", "label": "Category 6 link" },
    { "type": "text", "id": "plants_category_7_title", "label": "Category 7", "default": "Medicinal plants" }, { "type": "url", "id": "plants_category_7_link", "label": "Category 7 link" },
    { "type": "text", "id": "plants_category_8_title", "label": "Category 8", "default": "Air-purifying plants" }, { "type": "url", "id": "plants_category_8_link", "label": "Category 8 link" },
    { "type": "text", "id": "plants_category_9_title", "label": "Category 9", "default": "Climbers" }, { "type": "url", "id": "plants_category_9_link", "label": "Category 9 link" },
    { "type": "text", "id": "plants_category_10_title", "label": "Category 10", "default": "Bonsai plants" }, { "type": "url", "id": "plants_category_10_link", "label": "Category 10 link" },
