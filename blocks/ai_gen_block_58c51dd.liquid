{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign logo_image = block.settings.logo %}
{% style %}
  .ai-nursery-header-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-bottom: 1px solid {{ block.settings.divider_color }};
    position: relative;
    z-index: 20;
  }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    min-height: {{ block.settings.header_height }}px;
    padding: {{ block.settings.header_padding }}px 20px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__brand { display: inline-flex; align-items: center; flex: 0 0 auto; text-decoration: none; color: inherit; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__brand { display: flex; align-items: center; flex-shrink: 0; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__brand img { display: block; height: {{ block.settings.logo_height }}px; width: auto; max-width: 40vw; object-fit: contain; transform: scale({{ block.settings.logo_zoom | divided_by: 100.0 }}); transform-origin: left center; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__brand-text { color: {{ block.settings.text_color }}; font-size: 21px; line-height: 1.1; font-weight: 700; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__nav { display: flex; align-items: center; justify-content: center; gap: {{ block.settings.nav_gap }}px; flex: 1 1 auto; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__item { position: relative; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__link,
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__toggle { color: {{ block.settings.text_color }}; font: inherit; font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; background: transparent; border: 0; padding: 10px 0; cursor: pointer; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__link:hover,
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__toggle:hover { color: {{ block.settings.accent_color }}; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__chevron { display: inline-block; width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); margin: 0 0 3px 7px; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__dropdown { display: none; position: absolute; top: 100%; left: -16px; width: 460px; max-width: min(80vw, 460px); padding: 18px 20px; background: {{ block.settings.background_color }}; box-shadow: 0 12px 28px rgba(20, 35, 26, .14); border-top: 2px solid {{ block.settings.accent_color }}; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 22px; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__item.is-open .ai-nursery-header__dropdown,
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__item:hover .ai-nursery-header__dropdown,
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__item:focus-within .ai-nursery-header__dropdown { display: grid; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__dropdown a { display: block; color: {{ block.settings.text_color }}; padding: 8px 0; font-size: 13px; text-decoration: none; border-bottom: 1px solid {{ block.settings.divider_color }}; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__dropdown a:hover { color: {{ block.settings.accent_color }}; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__actions { display: flex; align-items: center; gap: 14px; flex: 0 0 auto; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__search { display: flex; align-items: center; border-bottom: 1px solid {{ block.settings.text_color }}; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__search input { width: 112px; border: 0; outline: none; background: transparent; color: {{ block.settings.text_color }}; padding: 7px 2px; font: inherit; font-size: 12px; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__icon-link,
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__mobile-toggle { width: 28px; height: 34px; color: {{ block.settings.text_color }}; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; background: transparent; border: 0; padding: 0; cursor: pointer; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__icon-link svg,
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__search svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.7; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__mobile-toggle { display: none; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__mobile-search { display: none; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__overlay { display: none; position: fixed; inset: 0; z-index: 1000; background: rgba(0, 0, 0, .45); }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__drawer-head { display: none; }
  .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__drawer-close { display: inline-flex; padding: 4px; border: 0; background: transparent; color: inherit; cursor: pointer; }
  @media screen and (max-width: 1100px) {
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__inner { gap: 16px; padding-inline: 14px; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__nav { gap: 13px; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__link,
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__toggle { font-size: 12px; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__search input { width: 75px; }
  }
  @media screen and (max-width: 749px) {
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__inner { width: 100%; box-sizing: border-box; min-height: 64px; display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px 10px; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__mobile-toggle { display: inline-flex; grid-column: 1; justify-self: start; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__brand { grid-column: 2; justify-self: center; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__brand img { transform-origin: center center; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__mobile-search { display: flex; align-items: center; gap: 10px; grid-column: 1 / -1; grid-row: 2; margin: 2px 0 10px; padding: 0 16px; height: 46px; border-radius: 10px; background: rgba(0, 0, 0, .05); color: {{ block.settings.text_color }}; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__mobile-search svg { width: 20px; height: 20px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.7; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__mobile-search input { flex: 1 1 auto; min-width: 0; border: 0; outline: none; background: transparent; color: inherit; font: inherit; font-size: 15px; padding: 0; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__mobile-search button { display: inline-flex; padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__nav { position: fixed; top: 0; bottom: 0; left: 0; z-index: 1001; width: min(85vw, 340px); box-sizing: border-box; display: flex; align-items: stretch; justify-content: flex-start; flex-direction: column; gap: 0; padding: 0 20px 24px; background: {{ block.settings.background_color }}; overflow-y: auto; overscroll-behavior: contain; box-shadow: 4px 0 24px rgba(0, 0, 0, .15); transform: translateX(-100%); visibility: hidden; transition: transform .3s ease, visibility .3s; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__nav.is-open { transform: none; visibility: visible; }
    .ai-nursery-header-{{ ai_gen_id }}.is-menu-open { z-index: 1000; }
    .ai-nursery-header-{{ ai_gen_id }}.is-menu-open .ai-nursery-header__overlay { display: block; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__drawer-head { display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 1; margin: 0 -20px; padding: 14px 20px; background: inherit; border-bottom: 1px solid {{ block.settings.divider_color }}; font-size: 18px; font-weight: 700; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__item { width: 100%; border-top: 1px solid {{ block.settings.divider_color }}; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__link,
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__toggle { display: block; width: 100%; text-align: left; padding: 12px 2px; font-size: 14px; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__dropdown { position: static; width: 100%; max-width: none; box-shadow: none; border-top: 0; padding: 0 12px 10px; grid-template-columns: 1fr 1fr; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__actions { grid-column: 3; grid-row: 1; justify-self: end; gap: 6px; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__actions .ai-nursery-header__icon-link { width: 26px; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__search { display: none; }
    .ai-nursery-header-{{ ai_gen_id }} .ai-nursery-header__brand img { height: {{ block.settings.logo_height | at_most: 48 }}px; max-width: 36vw; }
  }
{% endstyle %}

<site-navigation-{{ ai_gen_id }} class="ai-nursery-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-nursery-header__inner">
    <button class="ai-nursery-header__mobile-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="SiteNav-{{ ai_gen_id }}" data-menu-toggle>
      <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <a class="ai-nursery-header__brand" href="{{ block.settings.logo_link | default: routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if logo_image != blank %}<img src="{{ logo_image | image_url: width: 600 }}" alt="{{ logo_image.alt | default: shop.name | escape }}" width="{{ logo_image.width }}" height="{{ logo_image.height }}" loading="lazy">{% else %}<span class="ai-nursery-header__brand-text">{{ shop.name | escape }}</span>{% endif %}
    </a>
    <div class="ai-nursery-header__overlay" data-menu-close></div>
    <nav class="ai-nursery-header__nav" id="SiteNav-{{ ai_gen_id }}" aria-label="Main navigation" data-navigation>
      <div class="ai-nursery-header__drawer-head">
        <span>Menu</span>
        <button class="ai-nursery-header__drawer-close" type="button" aria-label="Close navigation" data-menu-close>
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
      {% assign nav_groups = 'plants,seeds,pots,gifting,services' | split: ',' %}
      {% for group in nav_groups %}
        {% assign title_key = group | append: '_title' %}
        {% assign menu_key = group | append: '_menu' %}
        {% assign menu_object = block.settings[menu_key] %}
        <div class="ai-nursery-header__item" data-menu-item>
          <button class="ai-nursery-header__toggle" type="button" aria-expanded="false" data-dropdown-toggle>{{ block.settings[title_key] | escape }}<span class="ai-nursery-header__chevron" aria-hidden="true"></span></button>
          <div class="ai-nursery-header__dropdown">
            {% if menu_object != blank and menu_object.links.size > 0 %}
              {% for link in menu_object.links limit: 20 %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}
            {% else %}
              {% for i in (1..10) %}
                {% assign category_title_key = group | append: '_category_' | append: i | append: '_title' %}
                {% assign category_link_key = group | append: '_category_' | append: i | append: '_link' %}
                {% if block.settings[category_title_key] != blank %}<a href="{{ block.settings[category_link_key] | default: '#' }}">{{ block.settings[category_title_key] | escape }}</a>{% endif %}
              {% endfor %}
            {% endif %}
          </div>
        </div>
      {% endfor %}
      {%- liquid
        assign blog_nav_url = block.settings.blog_link
        if blog_nav_url == blank
          if pages['all-blogs'].url != blank
            assign blog_nav_url = pages['all-blogs'].url | append: '?view=all-blogs'
          elsif pages['all-articles'].url != blank
            assign blog_nav_url = pages['all-articles'].url | append: '?view=all-articles'
          else
            assign blog_nav_url = routes.root_url
          endif
        endif
      -%}
      <a class="ai-nursery-header__link" href="{{ blog_nav_url }}">{{ block.settings.blog_label | escape }}</a>
      <a class="ai-nursery-header__link" href="{{ block.settings.contact_link | default: routes.root_url }}">{{ block.settings.contact_label | escape }}</a>
    </nav>
    <div class="ai-nursery-header__actions">
      <form class="ai-nursery-header__search" action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" placeholder="{{ block.settings.search_placeholder | escape }}" aria-label="{{ block.settings.search_placeholder | escape }}"><button class="ai-nursery-header__icon-link" type="submit" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></button></form>
      <a class="ai-nursery-header__icon-link" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{% if customer %}My account{% else %}Sign in{% endif %}" data-account-popup-open><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 21c.7-4.2 3.3-6.3 7.5-6.3s6.8 2.1 7.5 6.3"/></svg></a>
      <a class="ai-nursery-header__icon-link" href="{{ routes.cart_url }}" aria-label="Cart"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.1 11.2a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 1.9-1.4L21 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg><span class="cart-count-badge" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></a>
      <a class="ai-nursery-header__icon-link" href="{{ block.settings.wishlist_link | default: '/pages/wishlist' }}" aria-label="Wishlist" data-wishlist-link><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.7c0 5.2-8.8 11-8.8 11s-8.8-5.8-8.8-11A4.6 4.6 0 0 1 12 6.4a4.6 4.6 0 0 1 8.8 2.3Z"/></svg><span class="cart-count-badge" data-wishlist-count hidden>0</span></a>
    </div>
    <form class="ai-nursery-header__mobile-search" action="{{ routes.search_url }}" method="get" role="search"><button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></button><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ block.settings.search_placeholder | escape }}" aria-label="{{ block.settings.search_placeholder | escape }}"></form>
  </div>
</site-navigation-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'site-navigation-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class SiteNavigation extends HTMLElement {
      connectedCallback() {
        this.menuButton = this.querySelector('[data-menu-toggle]');
        this.navigation = this.querySelector('[data-navigation]');
        if (this.menuButton) this.menuButton.addEventListener('click', () => {
          this.setMenu(this.menuButton.getAttribute('aria-expanded') !== 'true');
        });
        this.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', () => this.setMenu(false)));
        window.matchMedia('(min-width: 750px)').addEventListener('change', (e) => { if (e.matches) this.setMenu(false); });
        this.querySelectorAll('[data-dropdown-toggle]').forEach((button) => {
          button.addEventListener('click', () => {
            const item = button.closest('[data-menu-item]');
            const expanded = button.getAttribute('aria-expanded') === 'true';
            this.querySelectorAll('[data-dropdown-toggle]').forEach((other) => { other.setAttribute('aria-expanded', 'false'); other.closest('[data-menu-item]').classList.remove('is-open'); });
            button.setAttribute('aria-expanded', String(!expanded));
            item.classList.toggle('is-open', !expanded);
          });
        });
        this.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            if (this.navigation.classList.contains('is-open')) this.setMenu(false);
            this.querySelectorAll('[data-dropdown-toggle]').forEach((button) => { button.setAttribute('aria-expanded', 'false'); button.closest('[data-menu-item]').classList.remove('is-open'); });
            if (this.menuButton) this.menuButton.focus();
          }
        });
      }
      setMenu(open) {
        if (!this.menuButton) return;
        this.menuButton.setAttribute('aria-expanded', String(open));
        this.menuButton.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        this.navigation.classList.toggle('is-open', open);
        this.classList.toggle('is-menu-open', open);
        document.documentElement.style.overflow = open ? 'hidden' : '';
      }
    }
    customElements.define(tagName, SiteNavigation);
  })();
</script>

{% schema %}
{
  "name": "Botanical navigation",
  "settings": [
    { "type": "header", "content": "Brand and layout" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "url", "id": "logo_link", "label": "Logo link" },
    { "type": "range", "id": "logo_height", "label": "Logo size (height)", "min": 30, "max": 120, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "logo_zoom", "label": "Logo zoom", "min": 100, "max": 200, "step": 5, "unit": "%", "default": 100, "info": "Enlarges the logo without making the header taller. Useful if the logo image has empty space around it." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "header_height", "label": "Header height", "min": 40, "max": 150, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "header_padding", "label": "Header top/bottom padding", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "nav_gap", "label": "Navigation spacing", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 18 },
