{% doc %}
  @prompt
    AI generated
    
    
    
    Update the "Think SBL Farms Is Just About Plants?
    Think Again." section to include a background image upload option. The section should allow merchants to upload a background image, with an overlay option for text readability. "Explore a world of nature, adventure, animals, agritour,aquarium,rain dance,DJ,Swimming Pool & unforgettable experiences at SBL Farms".Keep all existing content and settings intact, just add the background image upload functionality., i need one button and link for that,
    give corner border straight
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-farms-experience-{{ ai_gen_id }} {
    position: relative;
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: 360px;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    color: #ffffff;
  }

  .ai-farms-experience-{{ ai_gen_id }}__image,
  .ai-farms-experience-{{ ai_gen_id }}__placeholder,
  .ai-farms-experience-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-farms-experience-{{ ai_gen_id }}__image {
    object-fit: cover;
  }

  .ai-farms-experience-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.background_color }};
  }

  .ai-farms-experience-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-farms-experience-{{ ai_gen_id }}__overlay {
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
  }

  .ai-farms-experience-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 360px;
    box-sizing: border-box;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 56px 24px;
    text-align: center;
  }

  .ai-farms-experience-{{ ai_gen_id }}__heading {
    max-width: 800px;
    margin: 0;
    color: #ffffff;
    font-size: clamp(30px, 5vw, 56px);
    line-height: 1.1;
  }

  .ai-farms-experience-{{ ai_gen_id }}__text {
    max-width: 780px;
    margin: 0;
    color: #ffffff;
    font-size: 18px;
    line-height: 1.6;
  }

  .ai-farms-experience-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 6px;
    padding: 12px 26px;
    border: 2px solid {{ block.settings.button_color }};
    border-radius: 0;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .ai-farms-experience-{{ ai_gen_id }}__button:hover {
    background: transparent;
    color: #ffffff;
  }

  .ai-farms-experience-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-farms-experience-{{ ai_gen_id }} {
      width: 100%;
      min-height: 320px;
    }

    .ai-farms-experience-{{ ai_gen_id }}__content {
      min-height: 320px;
      padding: 40px 20px;
    }

    .ai-farms-experience-{{ ai_gen_id }}__text {
      font-size: 16px;
    }
  }
{% endstyle %}

<div class="ai-farms-experience-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_image != blank %}
    <img
      class="ai-farms-experience-{{ ai_gen_id }}__image"
      src="{{ block.settings.background_image | image_url: width: 2400 }}"
      alt="{{ block.settings.background_image.alt | escape }}"
      loading="lazy"
      width="{{ block.settings.background_image.width }}"
      height="{{ block.settings.background_image.height }}"
    >
  {% else %}
    <div class="ai-farms-experience-{{ ai_gen_id }}__placeholder">
      {{ 'image' | placeholder_svg_tag }}
    </div>
  {% endif %}
  {% if block.settings.show_overlay %}
    <div class="ai-farms-experience-{{ ai_gen_id }}__overlay" aria-hidden="true"></div>
  {% endif %}
  <div class="ai-farms-experience-{{ ai_gen_id }}__content">
    {% if block.settings.heading != blank %}
      <h2 class="ai-farms-experience-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    {% if block.settings.description != blank %}
      <p class="ai-farms-experience-{{ ai_gen_id }}__text">{{ block.settings.description | escape }}</p>
    {% endif %}
    {% if block.settings.button_label != blank and block.settings.button_link != blank %}
      <a class="ai-farms-experience-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "SBL Farms experience",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show dark overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay strength",
      "min": 10,
      "max": 90,
      "step": 10,
      "unit": "%",
      "default": 50
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Placeholder background",
      "default": "#1f5130"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Think SBL Farms Is Just About Plants? Think Again."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore a world of nature, adventure, animals, agritour, aquarium, rain dance, DJ, swimming pool and unforgettable experiences at SBL Farms"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore SBL Farms"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#1f5130"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "SBL Farms experience"
    }
  ],
  "tag": null,
  "class": "sbl-farms-experience-block"
}
{% endschema %}