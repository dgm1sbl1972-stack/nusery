{% doc %}
  @prompt
    Product-specific banner image and icon with automatically displayed product title and editable description.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-banner-{{ ai_gen_id }} {
    display: block;
    position: relative;
    overflow: hidden;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.banner_height }}px;
    border-radius: {{ block.settings.corner_radius }}px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.background_color }};
    isolation: isolate;
  }
  .ai-product-banner-{{ ai_gen_id }}__image,
  .ai-product-banner-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ai-product-banner-{{ ai_gen_id }}__image { object-fit: cover; z-index: -2; }
  .ai-product-banner-{{ ai_gen_id }}__placeholder { position: absolute; inset: 0; z-index: -2; background: {{ block.settings.background_color }}; }
  .ai-product-banner-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; object-fit: cover; }
  .ai-product-banner-{{ ai_gen_id }}__shade { z-index: -1; background: linear-gradient(90deg, {{ block.settings.overlay_color | color_modify: 'alpha', block.settings.overlay_opacity }} 0%, rgba(0,0,0,0) 100%); }
  .ai-product-banner-{{ ai_gen_id }}__content { box-sizing: border-box; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; min-height: {{ block.settings.banner_height }}px; max-width: 680px; padding: 40px; }
  .ai-product-banner-{{ ai_gen_id }}__icon { width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px; object-fit: contain; margin-bottom: 18px; }
  .ai-product-banner-{{ ai_gen_id }}__icon-fallback { display: inline-flex; align-items: center; justify-content: center; width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px; margin-bottom: 18px; color: {{ block.settings.icon_color }}; }
  .ai-product-banner-{{ ai_gen_id }}__icon-fallback svg { width: 100%; height: 100%; }
  .ai-product-banner-{{ ai_gen_id }}__title { color: inherit; margin: 0 0 12px; font-size: clamp(28px, 4vw, {{ block.settings.heading_size }}px); line-height: 1.12; }
  .ai-product-banner-{{ ai_gen_id }}__description { margin: 0; color: inherit; font-size: {{ block.settings.body_size }}px; line-height: 1.6; }
  @media screen and (max-width: 749px) {
    .ai-product-banner-{{ ai_gen_id }} { width: 100%; min-height: {{ block.settings.mobile_height }}px; }
    .ai-product-banner-{{ ai_gen_id }}__content { min-height: {{ block.settings.mobile_height }}px; padding: 28px 22px; }
    .ai-product-banner-{{ ai_gen_id }}__shade { background: linear-gradient(90deg, {{ block.settings.overlay_color | color_modify: 'alpha', block.settings.overlay_opacity }} 0%, {{ block.settings.overlay_color | color_modify: 'alpha', block.settings.overlay_opacity | times: 0.45 }} 100%); }
  }
{% endstyle %}

<div class="ai-product-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.banner_image != blank %}
    <img class="ai-product-banner-{{ ai_gen_id }}__image" src="{{ block.settings.banner_image | image_url: width: 2000 }}" alt="{{ block.settings.banner_image.alt | default: product.title | escape }}" loading="lazy" width="{{ block.settings.banner_image.width }}" height="{{ block.settings.banner_image.height }}">
  {% else %}
    <div class="ai-product-banner-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
  {% endif %}
  <span class="ai-product-banner-{{ ai_gen_id }}__shade" aria-hidden="true"></span>
  <div class="ai-product-banner-{{ ai_gen_id }}__content">
    {% if block.settings.icon_image != blank %}
      <img class="ai-product-banner-{{ ai_gen_id }}__icon" src="{{ block.settings.icon_image | image_url: width: 160 }}" alt="{{ block.settings.icon_image.alt | escape }}" loading="lazy" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}">
    {% elsif block.settings.show_leaf_icon %}
      <span class="ai-product-banner-{{ ai_gen_id }}__icon-fallback" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M39 8C22 8 10 14 10 27c0 7 5 12 12 12C35 39 40 23 39 8Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M8 42c6-10 13-16 24-23" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></span>
    {% endif %}
    {% if product != blank %}
      <h2 class="ai-product-banner-{{ ai_gen_id }}__title">{{ product.title | escape }}</h2>
    {% elsif block.settings.heading != blank %}
      <h2 class="ai-product-banner-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    {% if block.settings.description != blank %}<div class="ai-product-banner-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product image banner",
  "settings": [
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "image_picker", "id": "icon_image", "label": "Icon image" },
    { "type": "checkbox", "id": "show_leaf_icon", "label": "Show leaf icon if no icon image", "default": true },
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "A little more green" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Add a product-specific story or care highlight for this banner.</p>" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "banner_height", "label": "Desktop height", "min": 240, "max": 720, "step": 40, "unit": "px", "default": 440 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 200, "max": 600, "step": 40, "unit": "px", "default": 360 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1f5130" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#0d3a1d" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 1, "step": 0.1, "default": 0.7 },
    { "type": "color", "id": "icon_color", "label": "Leaf icon color", "default": "#ffffff" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 24, "max": 96, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 64, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "body_size", "label": "Description size", "min": 14, "max": 26, "step": 2, "unit": "px", "default": 18 }
  ],
  "presets": [{ "name": "Product image banner" }],
  "tag": null,
  "class": "product-image-banner-block"
}
{% endschema %}