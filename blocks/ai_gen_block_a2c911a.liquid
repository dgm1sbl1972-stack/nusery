{% doc %}
  @prompt
    for each product page i need separate banner image need to add, need icons also
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-banner-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    background: #f8f4ec;
    color: #0d3a1d;
  }
  .ai-product-banner-{{ ai_gen_id }}__media { position: relative; min-height: {{ block.settings.banner_height }}px; }
  .ai-product-banner-{{ ai_gen_id }}__image,
  .ai-product-banner-{{ ai_gen_id }}__placeholder { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ai-product-banner-{{ ai_gen_id }}__image { display: block; object-fit: cover; object-position: center; }
  .ai-product-banner-{{ ai_gen_id }}__placeholder { display: flex; align-items: center; justify-content: center; background: #f4f7dc; }
  .ai-product-banner-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; max-height: {{ block.settings.banner_height }}px; }
  .ai-product-banner-{{ ai_gen_id }}__empty { position: absolute; left: 16px; right: 16px; bottom: 14px; margin: 0; color: #0d3a1d; background: rgba(248,244,236,.96); border-radius: 8px; padding: 10px 14px; text-align: center; font-size: 14px; }
  .ai-product-banner-{{ ai_gen_id }}__overlay { position: absolute; inset: 0; display: flex; align-items: {{ block.settings.content_position }}; justify-content: {% if block.settings.text_alignment == 'center' %}center{% elsif block.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %}; padding: clamp(20px,5vw,64px); background: linear-gradient(90deg,rgba(13,58,29,{{ block.settings.overlay_opacity | divided_by: 100.0 }}) 0%,rgba(13,58,29,0) 100%); pointer-events: none; }
  .ai-product-banner-{{ ai_gen_id }}__copy { width: 100%; max-width: 640px; text-align: {{ block.settings.text_alignment }}; color: #fff; }
  .ai-product-banner-{{ ai_gen_id }}__title { margin: 0; color: inherit; font-size: clamp(28px,5vw,{{ block.settings.heading_size }}px); line-height: 1.12; }
  .ai-product-banner-{{ ai_gen_id }}__description { margin-top: 12px; font-size: 16px; line-height: 1.5; }
  .ai-product-banner-{{ ai_gen_id }}__description p { margin: 0; }
  .ai-product-banner-{{ ai_gen_id }}__features { display: flex; flex-wrap: wrap; gap: 12px 20px; margin-top: 22px; }
  .ai-product-banner-{{ ai_gen_id }}__feature { display: inline-flex; align-items: center; gap: 8px; color: #fff; font-size: 14px; line-height: 1.3; }
  .ai-product-banner-{{ ai_gen_id }}__feature svg { width: 22px; height: 22px; flex: 0 0 22px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  @media screen and (max-width: 749px) {
    .ai-product-banner-{{ ai_gen_id }} { width: 100%; }
    .ai-product-banner-{{ ai_gen_id }}__media { min-height: {{ block.settings.mobile_height }}px; }
    .ai-product-banner-{{ ai_gen_id }}__overlay { position: relative; inset: auto; min-height: {{ block.settings.mobile_height }}px; padding: 28px 20px; }
    .ai-product-banner-{{ ai_gen_id }}__title { font-size: clamp(24px, 7vw, {{ block.settings.heading_size }}px); }
    .ai-product-banner-{{ ai_gen_id }}__description { font-size: 14.5px; }
    .ai-product-banner-{{ ai_gen_id }}__placeholder svg { max-height: {{ block.settings.mobile_height }}px; }
    .ai-product-banner-{{ ai_gen_id }}__features { gap: 10px 14px; margin-top: 16px; }
    .ai-product-banner-{{ ai_gen_id }}__feature { font-size: 13px; }
  }
{% endstyle %}

<div class="ai-product-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-banner-{{ ai_gen_id }}__media">
    {% if block.settings.banner_image != blank %}
      <img class="ai-product-banner-{{ ai_gen_id }}__image" src="{{ block.settings.banner_image | image_url: width: 2200 }}" alt="{{ block.settings.banner_image.alt | default: product.title | escape }}" width="{{ block.settings.banner_image.width }}" height="{{ block.settings.banner_image.height }}" loading="lazy">
    {% else %}
      <div class="ai-product-banner-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
        <p class="ai-product-banner-{{ ai_gen_id }}__empty">Add a banner image for this product in the Theme Editor.</p>
      </div>
    {% endif %}
    {% if block.settings.heading != blank or block.settings.description != blank or block.settings.feature_one != blank or block.settings.feature_two != blank or block.settings.feature_three != blank %}
      <div class="ai-product-banner-{{ ai_gen_id }}__overlay">
        <div class="ai-product-banner-{{ ai_gen_id }}__copy">
          {% if block.settings.use_product_title and product != blank %}<h2 class="ai-product-banner-{{ ai_gen_id }}__title">{{ product.title | escape }}</h2>{% elsif block.settings.heading != blank %}<h2 class="ai-product-banner-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}
          {% if block.settings.description != blank %}<div class="ai-product-banner-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}
          {% if block.settings.feature_one != blank or block.settings.feature_two != blank or block.settings.feature_three != blank %}
            <div class="ai-product-banner-{{ ai_gen_id }}__features" aria-label="Product features">
              {% for i in (1..3) %}
                {% assign feature_key = 'feature_' | append: i | replace: '1', 'one' | replace: '2', 'two' | replace: '3', 'three' %}
                {% assign icon_key = 'icon_' | append: i | replace: '1', 'one' | replace: '2', 'two' | replace: '3', 'three' %}
                {% assign feature_text = block.settings[feature_key] %}
                {% assign feature_icon = block.settings[icon_key] %}
                {% if feature_text != blank %}
                  <span class="ai-product-banner-{{ ai_gen_id }}__feature">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      {% case feature_icon %}
                        {% when 'leaf' %}<path d="M20 4c-8 0-14 3-14 10a6 6 0 0 0 6 6c7 0 10-6 8-16Z"/><path d="M4 21c3-5 7-8 12-11"/>
                        {% when 'sun' %}<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/>
                        {% when 'drop' %}<path d="M12 3s-7 7.2-7 12a7 7 0 0 0 14 0c0-4.8-7-12-7-12Z"/><path d="M9 16a3 3 0 0 0 3 3"/>
                        {% when 'sprout' %}<path d="M12 21v-9"/><path d="M12 14c-5 0-8-3-8-8 5 0 8 3 8 8Zm0-3c0-5 3-8 8-8 0 5-3 8-8 8Z"/>
                        {% when 'heart' %}<path d="M20.8 8.6c0 5.1-8.8 11-8.8 11s-8.8-5.9-8.8-11A4.6 4.6 0 0 1 12 6.1a4.6 4.6 0 0 1 8.8 2.5Z"/>
                        {% else %}<path d="m5 12 4 4L19 6"/>
                      {% endcase %}
                    </svg>
                    <span>{{ feature_text | escape }}</span>
                  </span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product page banner",
  "settings": [
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "use_product_title", "label": "Show product title", "default": true },
    { "type": "text", "id": "heading", "label": "Custom heading", "default": "Discover this plant" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Add a short introduction to this product.</p>" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "select", "id": "content_position", "label": "Vertical position", "options": [{ "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Bottom" }], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "banner_height", "label": "Desktop height", "min": 200, "max": 700, "step": 25, "unit": "px", "default": 400 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 160, "max": 500, "step": 20, "unit": "px", "default": 280 },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Feature icons" },
    { "type": "select", "id": "icon_one", "label": "Icon 1", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "sun", "label": "Sun" }, { "value": "drop", "label": "Water drop" }, { "value": "sprout", "label": "Sprout" }, { "value": "heart", "label": "Heart" }, { "value": "check", "label": "Check" }], "default": "leaf" },
    { "type": "text", "id": "feature_one", "label": "Feature 1", "default": "Easy to care for" },
    { "type": "select", "id": "icon_two", "label": "Icon 2", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "sun", "label": "Sun" }, { "value": "drop", "label": "Water drop" }, { "value": "sprout", "label": "Sprout" }, { "value": "heart", "label": "Heart" }, { "value": "check", "label": "Check" }], "default": "sun" },
    { "type": "text", "id": "feature_two", "label": "Feature 2", "default": "Bright indirect light" },
    { "type": "select", "id": "icon_three", "label": "Icon 3", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "sun", "label": "Sun" }, { "value": "drop", "label": "Water drop" }, { "value": "sprout", "label": "Sprout" }, { "value": "heart", "label": "Heart" }, { "value": "check", "label": "Check" }], "default": "drop" },
    { "type": "text", "id": "feature_three", "label": "Feature 3", "default": "Water when soil is dry" }
  ],
  "presets": [{ "name": "Product page banner" }],
  "tag": null,
  "class": "product-page-banner-block"
}
{% endschema %}