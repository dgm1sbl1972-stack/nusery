{% doc %}
  @prompt
    Redesign my Shopify product page based on the attached reference image for SBL Nursery.
    
    - Background: #F8F4EC, Green: #1F5130, Accent: #FFD60A
    - Left: product gallery with up to 10 Shopify product images.
    - Show thumbnails vertically on desktop and horizontally on mobile.
    - Clicking any thumbnail should show that image in the large main preview.
    - Add image zoom/click-to-enlarge.
    - Images must come dynamically from Shopify Product Media.
    - Right: reviews, product title, description, plant size, planter, color, price and quantity.
    - Size, Planter and Color must use actual Shopify variants dynamically.
    - Add Gift option + handwritten note.
    - Add Quantity + Add to Cart.
    - Add editable Offers, Benefits, Promotional Banner, Delivery PIN checker, Plant Care and Product Specifications.
    - Use Shopify metafields for plant specifications.
    - Make everything responsive and editable through Shopify Theme Editor.
    - Do not hardcode products, prices, images or variant values.
    - Match the reference layout closely with a clean, premium SBL Nursery style., give to adjust the size of the image, make it whole protrait and which images clicks that should open in that big protrait 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign form_dom_id = 'sbl-product-form-' | append: ai_gen_id %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% style %}
.sbl-product-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background }};color:{{ block.settings.text_color }}}
.sbl-product-{{ ai_gen_id }} .layout{width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;padding:{{ block.settings.section_padding }}px 20px;display:grid;grid-template-columns:minmax(0,1.12fr) minmax(320px,.88fr);gap:clamp(24px,5vw,72px);align-items:start}
.sbl-product-{{ ai_gen_id }} .gallery{display:grid;grid-template-columns:76px minmax(0,1fr);gap:14px}.sbl-product-{{ ai_gen_id }} .thumbs{display:flex;flex-direction:column;gap:10px;max-height:{{ block.settings.image_height }}px;overflow:auto}.sbl-product-{{ ai_gen_id }} .thumb{width:66px;height:80px;padding:3px;flex:none;border:1px solid #aab2aa;border-radius:9px;background:#fff;cursor:pointer}.sbl-product-{{ ai_gen_id }} .thumb[aria-current=true]{border:2px solid {{ block.settings.green }}}.sbl-product-{{ ai_gen_id }} .thumb img{width:100%;height:100%;object-fit:cover;border-radius:6px;display:block}
.sbl-product-{{ ai_gen_id }} .stage{height:{{ block.settings.image_height }}px;max-height:80vh;min-height:360px;position:relative;background:#fff;border-radius:{{ block.settings.corner_radius }}px;overflow:hidden;display:flex;align-items:center;justify-content:center}.sbl-product-{{ ai_gen_id }} .main-image{display:block;width:100%;height:100%;object-fit:{{ block.settings.image_fit }};cursor:zoom-in}.sbl-product-{{ ai_gen_id }} .placeholder{position:absolute;inset:0;display:grid;place-items:center;background:#eee9df}.sbl-product-{{ ai_gen_id }} .placeholder svg{width:70%;height:70%}.sbl-product-{{ ai_gen_id }} .zoom{position:absolute;right:14px;bottom:14px;border:0;border-radius:50%;width:42px;height:42px;background:#fff;color:{{ block.settings.green }};cursor:pointer;font-size:22px}
.sbl-product-{{ ai_gen_id }} .reviews{color:{{ block.settings.green }};margin:0 0 12px;font-size:14px}.sbl-product-{{ ai_gen_id }} .title{margin:0 0 14px;color:{{ block.settings.green }};font-size:clamp(27px,3vw,42px);line-height:1.12}.sbl-product-{{ ai_gen_id }} .description{line-height:1.65;margin-bottom:18px}.sbl-product-{{ ai_gen_id }} .price{font-size:25px;font-weight:700;color:{{ block.settings.green }};margin:14px 0 20px}.sbl-product-{{ ai_gen_id }} .price s{font-size:16px;color:#626b65;font-weight:400;margin-left:8px}.sbl-product-{{ ai_gen_id }} label{font-weight:650;display:block;margin-bottom:7px}.sbl-product-{{ ai_gen_id }} select,.sbl-product-{{ ai_gen_id }} input[type=text],.sbl-product-{{ ai_gen_id }} input[type=number]{width:100%;min-height:46px;border:1px solid #aab2aa;border-radius:8px;padding:10px 12px;background:#fff;color:#17241b;font:inherit}.sbl-product-{{ ai_gen_id }} .option{margin:0 0 14px}.sbl-product-{{ ai_gen_id }} .quantity{width:104px!important}.sbl-product-{{ ai_gen_id }} .gift{padding:14px;border-radius:10px;background:#fff;margin:14px 0}.sbl-product-{{ ai_gen_id }} .gift-toggle{display:flex!important;align-items:center;gap:9px;cursor:pointer;margin-bottom:10px!important}.sbl-product-{{ ai_gen_id }} .gift input[type=checkbox]{width:18px;height:18px;accent-color:{{ block.settings.green }}}.sbl-product-{{ ai_gen_id }} .gift-note[hidden]{display:none}.sbl-product-{{ ai_gen_id }} .submit{width:100%;min-height:54px;border:0;border-radius:9px;background:{{ block.settings.green }};color:#fff;font:inherit;font-weight:700;cursor:pointer}.sbl-product-{{ ai_gen_id }} .submit:hover{background:#173e25}.sbl-product-{{ ai_gen_id }} .banner{background:{{ block.settings.accent }};color:#19251d;padding:12px 16px;border-radius:9px;font-weight:700;margin:18px 0}.sbl-product-{{ ai_gen_id }} .editable{padding:16px 0;border-top:1px solid #d8d5ca}.sbl-product-{{ ai_gen_id }} .editable h3{color:{{ block.settings.green }};font-size:18px;margin:0 0 8px}.sbl-product-{{ ai_gen_id }} .editable p{margin:0;line-height:1.6}.sbl-product-{{ ai_gen_id }} .specs{display:grid;grid-template-columns:1fr 1fr;gap:9px}.sbl-product-{{ ai_gen_id }} .spec{background:#fff;padding:10px;border-radius:8px}.sbl-product-{{ ai_gen_id }} .delivery{display:flex;gap:8px}.sbl-product-{{ ai_gen_id }} .delivery input{min-width:0}.sbl-product-{{ ai_gen_id }} .delivery button{border:1px solid {{ block.settings.green }};color:{{ block.settings.green }};background:transparent;border-radius:8px;padding:0 14px;font-weight:700;cursor:pointer}.sbl-product-{{ ai_gen_id }} .modal{display:none;position:fixed;inset:0;z-index:9999;background:#111e;align-items:center;justify-content:center;padding:24px}.sbl-product-{{ ai_gen_id }} .modal[open]{display:flex}.sbl-product-{{ ai_gen_id }} .modal img{max-width:94vw;max-height:92vh;object-fit:contain}.sbl-product-{{ ai_gen_id }} .modal-close{position:absolute;top:16px;right:20px;background:#fff;border:0;border-radius:50%;width:44px;height:44px;font-size:26px;cursor:pointer}.sbl-product-{{ ai_gen_id }} :focus-visible{outline:3px solid #145b34;outline-offset:3px}
@media(max-width:989px){.sbl-product-{{ ai_gen_id }} .layout{width:100%;padding:20px 16px;grid-template-columns:minmax(0,1fr);gap:24px}.sbl-product-{{ ai_gen_id }} .gallery,.sbl-product-{{ ai_gen_id }} .details{min-width:0;max-width:100%}.sbl-product-{{ ai_gen_id }} .gallery{display:flex;flex-direction:column-reverse;gap:10px}.sbl-product-{{ ai_gen_id }} .thumbs{flex-direction:row;max-height:none;width:100%;overflow-x:auto}.sbl-product-{{ ai_gen_id }} .thumb{width:64px;height:72px}.sbl-product-{{ ai_gen_id }} .stage{height:auto;aspect-ratio:1/1;max-height:{{ block.settings.mobile_image_height }}px;min-height:0;width:100%}}
.sbl-product-{{ ai_gen_id }} .qty-stepper{display:inline-flex;align-items:stretch;border:1px solid #aab2aa;border-radius:8px;background:#fff;overflow:hidden;margin-bottom:4px}.sbl-product-{{ ai_gen_id }} .qty-stepper .quantity{width:56px!important;min-height:46px;border:0!important;border-radius:0!important;text-align:center;padding:0!important;-moz-appearance:textfield;appearance:textfield}.sbl-product-{{ ai_gen_id }} .qty-stepper .quantity::-webkit-outer-spin-button,.sbl-product-{{ ai_gen_id }} .qty-stepper .quantity::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}.sbl-product-{{ ai_gen_id }} .qty-btn{width:44px;border:0;background:#fff;color:{{ block.settings.green }};font-size:20px;font-weight:600;cursor:pointer;line-height:1}.sbl-product-{{ ai_gen_id }} .qty-btn:hover{background:#eef3ec}.sbl-product-{{ ai_gen_id }} .small-banner{padding:16px 0;border-top:1px solid #d8d5ca}.sbl-product-{{ ai_gen_id }} .small-banner img{display:block;width:100%;height:auto;border-radius:10px}.sbl-product-{{ ai_gen_id }} .small-banner--empty{border:1px dashed #aab2aa;border-radius:10px;padding:28px 16px;text-align:center;color:#626b65;font-size:14px;margin-top:16px}.sbl-product-{{ ai_gen_id }} .spec-bar{margin-top:16px;border-radius:9px;overflow:hidden;background:#fff;border:1px solid {{ block.settings.green }}}.sbl-product-{{ ai_gen_id }} .spec-bar summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:12px;background:{{ block.settings.green }};color:#fff;font-weight:700;padding:14px 18px;font-size:16px}.sbl-product-{{ ai_gen_id }} .spec-bar summary::-webkit-details-marker{display:none}.sbl-product-{{ ai_gen_id }} .spec-bar__icon{width:10px;height:10px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg);transition:transform .2s;margin-top:-4px}.sbl-product-{{ ai_gen_id }} .spec-bar[open] .spec-bar__icon{transform:rotate(-135deg);margin-top:4px}.sbl-product-{{ ai_gen_id }} .spec-list{margin:0;padding:6px 18px}.sbl-product-{{ ai_gen_id }} .spec-row{display:grid;grid-template-columns:150px 1fr;gap:12px;padding:12px 0;border-bottom:1px solid #e6e3da}.sbl-product-{{ ai_gen_id }} .spec-row:last-child{border-bottom:0}.sbl-product-{{ ai_gen_id }} .spec-row dt{font-weight:650;color:{{ block.settings.green }}}.sbl-product-{{ ai_gen_id }} .spec-row dd{margin:0;line-height:1.55}.sbl-product-{{ ai_gen_id }} .spec-row a{color:inherit}@media(max-width:749px){.sbl-product-{{ ai_gen_id }} .spec-row{grid-template-columns:1fr;gap:2px}}
{% if block.settings.sticky_gallery %}@media(min-width:990px){.sbl-product-{{ ai_gen_id }} .gallery{position:sticky;top:{{ block.settings.sticky_top }}px;align-self:start}.sbl-product-{{ ai_gen_id }} .stage{height:min({{ block.settings.image_height }}px,calc(100vh - {{ block.settings.sticky_top | times: 2 }}px))}.sbl-product-{{ ai_gen_id }} .thumbs{max-height:min({{ block.settings.image_height }}px,calc(100vh - {{ block.settings.sticky_top | times: 2 }}px))}}{% endif %}
/* Mobile: tighter section spacing */@media screen and (max-width: 749px){.sbl-product-{{ ai_gen_id }} .layout{padding-top:{{ block.settings.section_padding | at_most: 24 }}px;padding-bottom:{{ block.settings.section_padding | at_most: 24 }}px}}{% endstyle %}
<product-detail-{{ ai_gen_id }} class="sbl-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
<div class="layout"><div class="gallery" aria-label="Product images"><div class="thumbs" role="list" aria-label="Choose product image">{% assign image_count = 0 %}{% for media in product.media %}{% if media.media_type == 'image' and image_count < 10 %}{% assign image_count = image_count | plus: 1 %}<button class="thumb" type="button" data-full="{{ media | image_url: width: 1800 }}" aria-label="Show product image {{ image_count }}" aria-current="{% if image_count == 1 %}true{% else %}false{% endif %}"><img src="{{ media | image_url: width: 140, height: 170, crop: 'center' }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy" width="70" height="85"></button>{% endif %}{% endfor %}</div><div class="stage">{% assign first_image = product.featured_media.preview_image %}{% if first_image %}<img class="main-image" src="{{ first_image | image_url: width: 1400 }}" alt="{{ first_image.alt | default: product.title | escape }}" width="{{ first_image.width }}" height="{{ first_image.height }}" data-zoom-image="{{ first_image | image_url: width: 2200 }}">{% else %}<div class="placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}<span>Add product photos in Shopify</span></div>{% endif %}<button class="zoom" type="button" aria-label="Enlarge product image">⌕</button></div></div>
<div class="details"><div class="wl-title-row"><h1 class="title">{{ product.title | escape }}</h1>{% render 'wishlist-button', product: product, class: 'wl-btn--inline' %}</div>{% if block.settings.show_description and product.description != blank %}<div class="description">{{ product.description }}</div>{% endif %}
{% form 'product', product, id: form_dom_id %}<input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<div class="option"><label for="sbl-option-{{ ai_gen_id }}-{{ forloop.index0 }}">{{ option.name | escape }}</label><select id="sbl-option-{{ ai_gen_id }}-{{ forloop.index0 }}" data-option-index="{{ forloop.index0 }}">{% for value in option.values %}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>{% endfor %}</select></div>{% endfor %}{% endunless %}<div class="price" data-price>{{ current_variant.price | money }}{% if current_variant.compare_at_price > current_variant.price %}<s>{{ current_variant.compare_at_price | money }}</s>{% endif %}</div>{% render 'product-rating', product: product %}<label for="sbl-quantity-{{ ai_gen_id }}">Quantity</label><div class="qty-stepper"><button type="button" class="qty-btn" data-qty-minus aria-label="Decrease quantity">−</button><input id="sbl-quantity-{{ ai_gen_id }}" class="quantity" type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric"><button type="button" class="qty-btn" data-qty-plus aria-label="Increase quantity">+</button></div>{% if block.settings.show_gift %}<div class="gift"><label class="gift-toggle"><input type="checkbox" data-gift-toggle> {{ block.settings.gift_label | escape }}</label><div class="gift-note" hidden><label for="sbl-note-{{ ai_gen_id }}">{{ block.settings.gift_note_label | escape }}</label><input id="sbl-note-{{ ai_gen_id }}" type="text" name="properties[Handwritten gift note]" maxlength="250" placeholder="Write your message"></div></div>{% endif %}<button class="submit" type="submit" name="add" data-submit {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{{ block.settings.add_label | escape }}{% else %}Sold out{% endif %}</button>{% endform %}
{% if block.settings.promo_banner != blank %}<div class="banner">{{ block.settings.promo_banner | escape }}</div>{% endif %}{% if block.settings.offers != blank %}<div class="editable"><h3>{{ block.settings.offers_heading | escape }}</h3><p>{{ block.settings.offers | escape | newline_to_br }}</p></div>{% endif %}{% if block.settings.benefits != blank %}<div class="editable"><h3>{{ block.settings.benefits_heading | escape }}</h3><p>{{ block.settings.benefits | escape | newline_to_br }}</p></div>{% endif %}
{% if block.settings.show_delivery %}<div class="editable"><h3>{{ block.settings.delivery_heading | escape }}</h3><div class="delivery"><input type="text" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" placeholder="6-digit PIN code" aria-label="Delivery PIN code"><button type="button" data-pin-check>Check</button></div><p data-pin-result aria-live="polite"></p></div>{% endif %}{% assign small_banner = product.metafields.custom.small_banner.value | default: block.settings.small_banner %}{% if small_banner != blank %}<div class="small-banner">{% if block.settings.small_banner_link != blank %}<a href="{{ block.settings.small_banner_link }}">{% endif %}{{ small_banner | image_url: width: 1200 | image_tag: loading: 'lazy', alt: small_banner.alt, widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 50vw, 100vw' }}{% if block.settings.small_banner_link != blank %}</a>{% endif %}</div>{% elsif request.design_mode %}<div class="small-banner small-banner--empty">Small banner — choose an image in “Small banner” settings</div>{% endif %}
{% if block.settings.show_specs %}<details class="spec-bar"><summary>{{ block.settings.specs_heading | escape }}<span class="spec-bar__icon" aria-hidden="true"></span></summary><dl class="spec-list">{% if block.settings.origin != blank %}<div class="spec-row"><dt>{{ block.settings.origin_label | escape }}</dt><dd>{{ block.settings.origin | escape }}</dd></div>{% endif %}{% if block.settings.manufacturer != blank %}<div class="spec-row"><dt>{{ block.settings.manufacturer_label | escape }}</dt><dd>{{ block.settings.manufacturer | escape | newline_to_br }}</dd></div>{% endif %}{% if block.settings.support_email != blank or block.settings.support_phone != blank %}<div class="spec-row"><dt>{{ block.settings.support_label | escape }}</dt><dd>{% if block.settings.support_email != blank %}Email: <a href="mailto:{{ block.settings.support_email | strip }}">{{ block.settings.support_email | escape }}</a>{% endif %}{% if block.settings.support_email != blank and block.settings.support_phone != blank %}<br>{% endif %}{% if block.settings.support_phone != blank %}Phone: <a href="tel:{{ block.settings.support_phone | remove: ' ' | remove: '-' }}">{{ block.settings.support_phone | escape }}</a>{% endif %}</dd></div>{% endif %}</dl></details>{% endif %}</div></div>
<div class="modal" role="dialog" aria-modal="true" aria-label="Enlarged product image"><button class="modal-close" type="button" aria-label="Close enlarged image">×</button><img src="" alt=""></div>
<script type="application/json" data-product-variants>{{ product.variants | json }}</script></product-detail-{{ ai_gen_id }}>
<script>
(function(){const tag='product-detail-{{ ai_gen_id }}';if(customElements.get(tag))return;class SblProductDetail extends HTMLElement{connectedCallback(){this.main=this.querySelector('.main-image');this.thumbs=this.querySelectorAll('.thumb');this.modal=this.querySelector('.modal');this.thumbs.forEach((button)=>button.addEventListener('click',()=>{if(!this.main)return;const im=button.querySelector('img');this.main.src=button.dataset.full;this.main.dataset.zoomImage=button.dataset.full;this.main.alt=im.alt;this.thumbs.forEach((item)=>item.setAttribute('aria-current','false'));button.setAttribute('aria-current','true')}));const zoom=()=>{if(!this.main||!this.modal)return;const im=this.modal.querySelector('img');im.src=this.main.dataset.zoomImage||this.main.src;im.alt=this.main.alt;this.modal.setAttribute('open','')};this.querySelector('.zoom')?.addEventListener('click',zoom);this.main?.addEventListener('click',zoom);this.querySelector('.modal-close')?.addEventListener('click',()=>this.modal.removeAttribute('open'));this.modal?.addEventListener('click',(e)=>{if(e.target===this.modal)this.modal.removeAttribute('open')});document.addEventListener('keydown',(e)=>{if(e.key==='Escape')this.modal?.removeAttribute('open')});const qty=this.querySelector('.quantity');const step=(d)=>{if(!qty)return;const v=Math.max(1,(parseInt(qty.value,10)||1)+d);qty.value=v;qty.dispatchEvent(new Event('change',{bubbles:true}))};this.querySelector('[data-qty-minus]')?.addEventListener('click',()=>step(-1));this.querySelector('[data-qty-plus]')?.addEventListener('click',()=>step(1));const gift=this.querySelector('[data-gift-toggle]');gift?.addEventListener('change',()=>{this.querySelector('.gift-note').hidden=!gift.checked});this.setupVariants();this.querySelector('[data-pin-check]')?.addEventListener('click',()=>{const input=this.querySelector('.delivery input'),result=this.querySelector('[data-pin-result]');result.textContent=/^\d{6}$/.test(input.value)?'PIN code entered. Delivery availability will be confirmed at checkout.':'Please enter a valid 6-digit PIN code.'})}setupVariants(){const data=this.querySelector('[data-product-variants]'),id=this.querySelector('[data-variant-id]');if(!data||!id)return;let variants=[];try{variants=JSON.parse(data.textContent)}catch(e){return}const selects=[...this.querySelectorAll('[data-option-index]')],price=this.querySelector('[data-price]'),submit=this.querySelector('[data-submit]');const update=()=>{const values=selects.map((s)=>s.value),variant=variants.find((v)=>v.options.every((value,index)=>value===values[index]));if(!variant){submit.disabled=true;submit.textContent='Unavailable';return}id.value=variant.id;price.innerHTML=Shopify.formatMoney?Shopify.formatMoney(variant.price):new Intl.NumberFormat(undefined,{style:'currency',currency:'{{ cart.currency.iso_code }}'}).format(variant.price/100);if(variant.compare_at_price>variant.price)price.innerHTML+='<s>'+ (Shopify.formatMoney?Shopify.formatMoney(variant.compare_at_price):new Intl.NumberFormat(undefined,{style:'currency',currency:'{{ cart.currency.iso_code }}'}).format(variant.compare_at_price/100))+'</s>';submit.disabled=!variant.available;submit.textContent=variant.available?{{ block.settings.add_label | json }}:'Sold out'};selects.forEach((s)=>s.addEventListener('change',update))}}customElements.define(tag,SblProductDetail)})();
</script>
{% schema %}{"name":"SBL product detail","tag":null,"class":"sbl-product-detail-block","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Gallery and colors"},{"type":"range","id":"image_height","label":"Desktop image height","min":400,"max":900,"step":50,"unit":"px","default":650},{"type":"range","id":"mobile_image_height","label":"Mobile image height","min":280,"max":700,"step":20,"unit":"px","default":480},{"type":"checkbox","id":"sticky_gallery","label":"Keep images fixed while details scroll (desktop)","default":true},{"type":"range","id":"sticky_top","label":"Gap above fixed images","min":0,"max":120,"step":4,"unit":"px","default":20},{"type":"select","id":"image_fit","label":"Image fit","options":[{"value":"contain","label":"Whole image"},{"value":"cover","label":"Fill portrait frame"}],"default":"contain"},{"type":"range","id":"corner_radius","label":"Image corner radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"range","id":"section_padding","label":"Vertical spacing","min":0,"max":80,"step":5,"unit":"px","default":30},{"type":"color","id":"background","label":"Background","default":"#F8F4EC"},{"type":"color","id":"green","label":"Green","default":"#1F5130"},{"type":"color","id":"accent","label":"Accent","default":"#FFD60A"},{"type":"color","id":"text_color","label":"Text","default":"#14231A"},{"type":"checkbox","id":"show_description","label":"Show product description","default":true},{"type":"header","content":"Gift and purchase"},{"type":"checkbox","id":"show_gift","label":"Show gift option","default":true},{"type":"text","id":"gift_label","label":"Gift option label","default":"Send as a gift with a handwritten note"},{"type":"text","id":"gift_note_label","label":"Gift note label","default":"Handwritten note"},{"type":"text","id":"add_label","label":"Add to cart label","default":"Add to cart"},{"type":"header","content":"Promotions and delivery"},{"type":"text","id":"promo_banner","label":"Promotional banner","default":"A little greenery, delivered with care"},{"type":"text","id":"offers_heading","label":"Offers heading","default":"Available offers"},{"type":"textarea","id":"offers","label":"Offers","default":"Add current offers or coupon details here."},{"type":"text","id":"benefits_heading","label":"Benefits heading","default":"Why you’ll love it"},{"type":"textarea","id":"benefits","label":"Benefits","default":"Describe the plant’s key benefits and what makes it special."},{"type":"checkbox","id":"show_delivery","label":"Show PIN checker","default":true},{"type":"text","id":"delivery_heading","label":"Delivery heading","default":"Check delivery availability"},{"type":"header","content":"Small banner"},{"type":"image_picker","id":"small_banner","label":"Banner image","info":"Shown where Plant care used to be. A product metafield custom.small_banner (file) overrides it per product."},{"type":"url","id":"small_banner_link","label":"Banner link"},{"type":"header","content":"Plant specification"},{"type":"checkbox","id":"show_specs","label":"Show plant specification","default":true},{"type":"text","id":"specs_heading","label":"Bar title","default":"Plant specification"},{"type":"text","id":"origin_label","label":"Country of origin label","default":"Country of origin"},{"type":"text","id":"origin","label":"Country of origin","default":"India"},{"type":"text","id":"manufacturer_label","label":"Manufacturer label","default":"Manufactured by"},{"type":"textarea","id":"manufacturer","label":"Manufacturer name and address","default":"SBL Nursery\nAdd your address here"},{"type":"text","id":"support_label","label":"Customer support label","default":"Customer support"},{"type":"text","id":"support_email","label":"Support email","default":"support@example.com"},{"type":"text","id":"support_phone","label":"Support phone","default":"+91 00000 00000"}],"presets":[{"name":"SBL product detail"}]}{% endschema %}