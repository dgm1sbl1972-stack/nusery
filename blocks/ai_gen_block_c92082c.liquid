{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-nursery-{{ ai_gen_id }}{display:block;width:100%;background:#f8f4ec;color:#0d3a1d;border-bottom:1px solid #d9dfd2}.ai-nursery-{{ ai_gen_id }} .inner{display:flex;align-items:center;gap:24px;width:100%;max-width:1400px;margin:auto;padding:12px 20px}.ai-nursery-{{ ai_gen_id }} .logo{flex:none;color:inherit;text-decoration:none}.ai-nursery-{{ ai_gen_id }} .logo img{display:block;width:{{ block.settings.logo_width }}px;height:auto;max-width:30vw}.ai-nursery-{{ ai_gen_id }} ul{list-style:none;margin:0;padding:0}.ai-nursery-{{ ai_gen_id }} .links{display:flex;justify-content:center;align-items:center;gap:{{ block.settings.link_gap }}px;flex:1}.ai-nursery-{{ ai_gen_id }} .item{position:relative}.ai-nursery-{{ ai_gen_id }} .link{display:flex;align-items:center;gap:5px;padding:10px 0;color:#0d3a1d;text-decoration:none;white-space:nowrap}.ai-nursery-{{ ai_gen_id }} .dropdown{display:none;position:absolute;top:100%;left:0;min-width:220px;max-height:70vh;overflow:auto;background:#f8f4ec;padding:8px 0;border:1px solid #d9dfd2;border-radius:0 0 8px 8px;box-shadow:0 8px 20px #14231a22}.ai-nursery-{{ ai_gen_id }} .item:hover .dropdown,.ai-nursery-{{ ai_gen_id }} .item:focus-within .dropdown,.ai-nursery-{{ ai_gen_id }} .item.is-open .dropdown{display:block}.ai-nursery-{{ ai_gen_id }} .dropdown a{display:block;padding:9px 16px;color:#0d3a1d;text-decoration:none}.ai-nursery-{{ ai_gen_id }} a:hover{color:#1f5130}.ai-nursery-{{ ai_gen_id }} .tools{display:flex;align-items:center;gap:12px}.ai-nursery-{{ ai_gen_id }} .search{display:flex;align-items:center;border-bottom:1px solid #0d3a1d}.ai-nursery-{{ ai_gen_id }} .search input{width:{{ block.settings.search_width }}px;border:0;background:transparent;padding:7px 0;color:#0d3a1d}.ai-nursery-{{ ai_gen_id }} .icon,.ai-nursery-{{ ai_gen_id }} .toggle,.ai-nursery-{{ ai_gen_id }} .search button{border:0;background:none;color:#0d3a1d;padding:4px;display:inline-flex;cursor:pointer}.ai-nursery-{{ ai_gen_id }} svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ai-nursery-{{ ai_gen_id }} .toggle{display:none}@media(max-width:990px){.ai-nursery-{{ ai_gen_id }} .inner{flex-wrap:wrap;gap:12px;padding:12px 16px}.ai-nursery-{{ ai_gen_id }} .toggle{display:inline-flex}.ai-nursery-{{ ai_gen_id }} .links{display:none;flex:1 0 100%;order:4;align-items:stretch;flex-direction:column;gap:0}.ai-nursery-{{ ai_gen_id }} .links.is-visible{display:flex}.ai-nursery-{{ ai_gen_id }} .tools{margin-left:auto;gap:6px}.ai-nursery-{{ ai_gen_id }} .search{display:flex}.ai-nursery-{{ ai_gen_id }} .search input{width:100px}.ai-nursery-{{ ai_gen_id }} .item{border-top:1px solid #d9dfd2}.ai-nursery-{{ ai_gen_id }} .link{justify-content:space-between;padding:12px 2px}.ai-nursery-{{ ai_gen_id }} .dropdown{display:none;position:static;border:0;box-shadow:none;border-radius:0;padding-left:12px}.ai-nursery-{{ ai_gen_id }} .item:hover .dropdown{display:none}.ai-nursery-{{ ai_gen_id }} .item.is-open .dropdown{display:block}}
{% endstyle %}
<nursery-nav-{{ ai_gen_id }} class="ai-nursery-{{ ai_gen_id }}" style="width:{{ block.settings.desktop_width_percent }}%" {{ block.shopify_attributes }}><div class="inner"><button class="toggle" type="button" aria-label="Open menu" aria-expanded="false" data-toggle><svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button><a class="logo" href="{{ block.settings.logo_link | default: routes.root_url }}">{% if block.settings.logo %}<img src="{{ block.settings.logo | image_url: width: 600 }}" alt="{{ block.settings.logo.alt | default: shop.name | escape }}">{% else %}{{ shop.name | escape }}{% endif %}</a><ul class="links" data-links>{% assign groups = 'plants,seeds,pots,gifting,services' | split: ',' %}{% for group in groups %}{% assign title_key = group | append: '_title' %}{% assign url_key = group | append: '_url' %}{% assign menu_key = group | append: '_menu' %}{% assign navmenu = block.settings[menu_key] %}<li class="item" data-item><a class="link" href="{{ block.settings[url_key] | default: routes.all_products_collection_url }}">{{ block.settings[title_key] | escape }}⌄</a>{% if navmenu != blank %}<ul class="dropdown">{% for entry in navmenu.links %}<li><a href="{{ entry.url }}">{{ entry.title | escape }}</a></li>{% endfor %}</ul>{% else %}<ul class="dropdown">{% for i in (1..10) %}{% assign label_key = group | append: '_label_' | append: i %}{% assign dest_key = group | append: '_dest_' | append: i %}{% assign label = block.settings[label_key] %}{% if label != blank %}<li><a href="{{ block.settings[dest_key] | default: routes.all_products_collection_url }}">{{ label | escape }}</a></li>{% endif %}{% endfor %}</ul>{% endif %}</li>{% endfor %}{% for i in (1..2) %}{% assign label_key = 'extra_label_' | append: i %}{% assign dest_key = 'extra_dest_' | append: i %}<li><a class="link" href="{{ block.settings[dest_key] | default: routes.root_url }}">{{ block.settings[label_key] | escape }}</a></li>{% endfor %}</ul><div class="tools"><form class="search" action="{{ routes.search_url }}" method="get" role="search"><input name="q" type="search" placeholder="{{ block.settings.search_placeholder | escape }}" aria-label="Search products"><button type="submit" aria-label="Submit search"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></button></form><a class="icon" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c.6-4 3.5-6 8-6s7.4 2 8 6"/></svg></a><a class="icon" href="{{ routes.cart_url }}" aria-label="Cart"><svg viewBox="0 0 24 24"><path d="M3 4h2l2.2 11.2h10.5L22 8H6"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg></a><a class="icon" href="{{ block.settings.wishlist_link | default: routes.root_url }}" aria-label="Wishlist"><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5.2-8.8 11-8.8 11s-8.8-5.8-8.8-11A4.8 4.8 0 0 1 12 6.1a4.8 4.8 0 0 1 8.8 2.7Z"/></svg></a></div></div></nursery-nav-{{ ai_gen_id }}>
<script>(()=>{const n='nursery-nav-{{ ai_gen_id }}';if(customElements.get(n))return;customElements.define(n,class extends HTMLElement{connectedCallback(){const b=this.querySelector('[data-toggle]'),l=this.querySelector('[data-links]');b.addEventListener('click',()=>{const o=l.classList.toggle('is-visible');b.setAttribute('aria-expanded',o)});this.querySelectorAll('[data-item]').forEach(i=>{const a=i.querySelector('.link'),d=i.querySelector('.dropdown');if(a&&d)a.addEventListener('click',e=>{if(matchMedia('(max-width:990px)').matches){e.preventDefault();i.classList.toggle('is-open')}})})}})})();</script>
{% schema %}
{"name":"Nursery navigation","settings":[{"type":"header","content":"Brand and layout"},{"type":"image_picker","id":"logo","label":"Logo"},{"type":"url","id":"logo_link","label":"Logo link"},{"type":"range","id":"logo_width","label":"Logo width","min":60,"max":240,"step":10,"unit":"px","default":140},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"link_gap","label":"Link spacing","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"search_width","label":"Search width","min":80,"max":220,"step":10,"unit":"px","default":130},{"type":"text","id":"search_placeholder","label":"Search placeholder","default":"Search plants"},{"type":"url","id":"wishlist_link","label":"Wishlist link"},{"type":"header","content":"Main categories"},{"type":"text","id":"plants_title","label":"Plants label","default":"Plants"},{"type":"url","id":"plants_url","label":"Plants destination"},{"type":"link_list","id":"plants_menu","label":"Plants dropdown"},{"type":"text","id":"seeds_title","label":"Seeds label","default":"Seeds"},{"type":"url","id":"seeds_url","label":"Seeds destination"},{"type":"link_list","id":"seeds_menu","label":"Seeds dropdown"},{"type":"text","id":"pots_title","label":"Pots label","default":"Pots"},{"type":"url","id":"pots_url","label":"Pots destination"},{"type":"link_list","id":"pots_menu","label":"Pots dropdown"},{"type":"text","id":"gifting_title","label":"Gifting label","default":"Gifting"},{"type":"url","id":"gifting_url","label":"Gifting destination"},{"type":"link_list","id":"gifting_menu","label":"Gifting dropdown"},{"type":"text","id":"services_title","label":"Services label","default":"Services"},{"type":"url","id":"services_url","label":"Services destination"},{"type":"link_list","id":"services_menu","label":"Services dropdown"},{"type":"header","content":"Blog and contact"},{"type":"text","id":"extra_label_1","label":"Link 1 text","default":"Blog"},{"type":"url","id":"extra_dest_1","label":"Link 1 destination"},{"type":"text","id":"extra_label_2","label":"Link 2 text","default":"Contact"},{"type":"url","id":"extra_dest_2","label":"Link 2 destination"}],"presets":[{"name":"Nursery navigation"}],"tag":null,"class":"nursery-navigation-block"}
{% endschema %}