{% doc %}
  @prompt
    Redesign my Shopify product page based on the attached reference image for SBL Nursery.
    
    - Background: #F8F4EC, Green: #1F5130, Accent: #FFD60A
    - Left: product gallery with up to 10 Shopify product images.
    - Show thumbnails vertically on desktop and horizontally on mobile.
    - Clicking any thumbnail should show that image in the large main preview.
    - Add image zoom/click-to-enlarge.
    - Images must come dynamically from Shopify Product Media.
    - Right: reviews, product title, description, plant size, planter, color, price and quantity.
    - Size, Planter and Color must use actual Shopify variants dynamically.
    - Add Gift option + handwritten note.
    - Add Quantity + Add to Cart.
    - Add editable Offers, Benefits, Promotional Banner, Delivery PIN checker, Plant Care and Product Specifications.
    - Use Shopify metafields for plant specifications.
    - Make everything responsive and editable through Shopify Theme Editor.
    - Do not hardcode products, prices, images or variant values.
    - Match the reference layout closely with a clean, premium SBL Nursery style.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign ai_form_id = 'sbl-product-form-' | append: ai_gen_id %}
{% style %}
.sbl-product-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background }};color:{{ block.settings.text_color }};padding:clamp(16px,3vw,42px)}.sbl-product-{{ ai_gen_id }} *{box-sizing:border-box}.sbl-product-{{ ai_gen_id }}__layout{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(340px,.95fr);gap:clamp(24px,4vw,64px);max-width:1280px;margin:auto;align-items:start}.sbl-product-{{ ai_gen_id }}__gallery{display:grid;grid-template-columns:76px minmax(0,1fr);gap:14px;position:sticky;top:20px}.sbl-product-{{ ai_gen_id }}__thumbs{display:flex;flex-direction:column;gap:10px;max-height:680px;overflow:auto}.sbl-product-{{ ai_gen_id }}__thumb{padding:0;border:1px solid #d5d9d1;background:#fff;border-radius:8px;cursor:pointer;overflow:hidden;aspect-ratio:1}.sbl-product-{{ ai_gen_id }}__thumb[aria-current=true]{border:2px solid {{ block.settings.green }}}.sbl-product-{{ ai_gen_id }}__thumb img{width:100%;height:100%;object-fit:cover;display:block}.sbl-product-{{ ai_gen_id }}__main-image{position:relative;border-radius:{{ block.settings.card_radius }}px;overflow:hidden;background:#eee;aspect-ratio:1;cursor:zoom-in}.sbl-product-{{ ai_gen_id }}__main-image img{width:100%;height:100%;object-fit:cover;display:block}.sbl-product-{{ ai_gen_id }}__main-image svg{width:100%;height:100%}.sbl-product-{{ ai_gen_id }}__empty{position:absolute;bottom:14px;left:12px;right:12px;text-align:center;background:#fff;color:#263b2c;padding:8px;border-radius:6px;font-size:13px}.sbl-product-{{ ai_gen_id }}__details{min-width:0}.sbl-product-{{ ai_gen_id }}__reviews{color:{{ block.settings.green }};font-size:14px;margin:0 0 10px}.sbl-product-{{ ai_gen_id }}__title{color:{{ block.settings.green }};font-size:clamp(28px,3vw,42px);line-height:1.15;margin:0 0 14px}.sbl-product-{{ ai_gen_id }}__description{line-height:1.65;margin:0 0 18px}.sbl-product-{{ ai_gen_id }}__price{font-size:25px;font-weight:700;color:{{ block.settings.green }};margin:16px 0}.sbl-product-{{ ai_gen_id }}__field{margin:14px 0}.sbl-product-{{ ai_gen_id }}__field label{display:block;font-size:14px;font-weight:650;margin-bottom:7px}.sbl-product-{{ ai_gen_id }}__field select,.sbl-product-{{ ai_gen_id }}__quantity,.sbl-product-{{ ai_gen_id }}__pin-input{width:100%;min-height:46px;border:1px solid #aeb8af;border-radius:8px;background:#fff;padding:10px 12px;color:#17231a;font:inherit}.sbl-product-{{ ai_gen_id }}__quantity{width:88px}.sbl-product-{{ ai_gen_id }}__gift{display:flex;gap:9px;align-items:center;margin:16px 0;font-size:14px}.sbl-product-{{ ai_gen_id }}__gift-note{display:none}.sbl-product-{{ ai_gen_id }}__gift-note.is-visible{display:block}.sbl-product-{{ ai_gen_id }}__gift-note textarea{width:100%;min-height:78px;padding:10px;border:1px solid #aeb8af;border-radius:8px;font:inherit}.sbl-product-{{ ai_gen_id }}__cart{width:100%;min-height:52px;background:{{ block.settings.green }};color:#fff;border:0;border-radius:8px;font:inherit;font-weight:700;cursor:pointer}.sbl-product-{{ ai_gen_id }}__cart:hover{background:#143d22}.sbl-product-{{ ai_gen_id }}__banner{background:{{ block.settings.accent }};color:#202512;padding:13px 16px;border-radius:9px;margin:18px 0;font-weight:650}.sbl-product-{{ ai_gen_id }}__panel{margin-top:13px;padding:16px;background:#fff;border-radius:10px;border:1px solid #e5e3dc}.sbl-product-{{ ai_gen_id }}__panel h3{font-size:17px;color:{{ block.settings.green }};margin:0 0 9px}.sbl-product-{{ ai_gen_id }}__panel p{margin:6px 0;line-height:1.55}.sbl-product-{{ ai_gen_id }}__pin-row{display:flex;gap:8px}.sbl-product-{{ ai_gen_id }}__pin-row input{flex:1;min-width:0}.sbl-product-{{ ai_gen_id }}__pin-row button{background:{{ block.settings.green }};color:#fff;border:0;border-radius:8px;padding:0 15px;font-weight:650;cursor:pointer}.sbl-product-{{ ai_gen_id }}__pin-result{min-height:1.4em;font-size:13px;margin-top:8px}.sbl-product-{{ ai_gen_id }}__modal{position:fixed;inset:0;background:rgba(10,20,12,.9);z-index:9999;display:none;align-items:center;justify-content:center;padding:24px;cursor:zoom-out}.sbl-product-{{ ai_gen_id }}__modal.is-open{display:flex}.sbl-product-{{ ai_gen_id }}__modal img{max-width:95vw;max-height:90vh;object-fit:contain}.sbl-product-{{ ai_gen_id }}__modal button{position:absolute;top:16px;right:16px;background:#fff;color:#111;border:0;border-radius:50%;width:44px;height:44px;font-size:25px;cursor:pointer}.sbl-product-{{ ai_gen_id }}__placeholder{height:100%;position:relative}.sbl-product-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}
@media(max-width:749px){.sbl-product-{{ ai_gen_id }}{padding:16px}.sbl-product-{{ ai_gen_id }}__layout{grid-template-columns:1fr;gap:24px}.sbl-product-{{ ai_gen_id }}__gallery{position:static;display:flex;flex-direction:column-reverse;gap:10px}.sbl-product-{{ ai_gen_id }}__thumbs{flex-direction:row;max-height:none;overflow-x:auto}.sbl-product-{{ ai_gen_id }}__thumb{flex:0 0 66px}.sbl-product-{{ ai_gen_id }}__main-image{width:100%}}
{% endstyle %}
{% if product %}<sbl-product-{{ ai_gen_id }} class="sbl-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="sbl-product-{{ ai_gen_id }}__layout"><div class="sbl-product-{{ ai_gen_id }}__gallery"><div class="sbl-product-{{ ai_gen_id }}__thumbs" aria-label="Product images">{% assign image_count = 0 %}{% for media in product.media %}{% if media.media_type == 'image' and image_count < 10 %}{% assign image_count = image_count | plus: 1 %}<button type="button" class="sbl-product-{{ ai_gen_id }}__thumb" data-image="{{ media | image_url: width: 1600 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="Show product image {{ image_count }}" aria-current="{% if image_count == 1 %}true{% else %}false{% endif %}"><img src="{{ media | image_url: width: 140 }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy" width="140" height="140"></button>{% endif %}{% endfor %}</div><div class="sbl-product-{{ ai_gen_id }}__main-image" role="button" tabindex="0" aria-label="Enlarge product image">{% assign first_image = product.featured_image %}{% if first_image %}<img class="sbl-product-{{ ai_gen_id }}__hero" src="{{ first_image | image_url: width: 1600 }}" alt="{{ first_image.alt | default: product.title | escape }}" width="{{ first_image.width }}" height="{{ first_image.height }}">{% else %}<div class="sbl-product-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}<div class="sbl-product-{{ ai_gen_id }}__empty">Add product images in Shopify to display the gallery.</div></div>{% endif %}</div></div><div class="sbl-product-{{ ai_gen_id }}__details">{% if block.settings.reviews_text != blank %}<p class="sbl-product-{{ ai_gen_id }}__reviews">{{ block.settings.reviews_text | escape }}</p>{% endif %}<h1 class="sbl-product-{{ ai_gen_id }}__title">{{ product.title | escape }}</h1>{% if block.settings.show_description and product.description != blank %}<div class="sbl-product-{{ ai_gen_id }}__description">{{ product.description }}</div>{% endif %}{% form 'product', product, id: ai_form_id %}<div class="sbl-product-{{ ai_gen_id }}__price" data-price>{{ product.selected_or_first_available_variant.price | money }}</div>{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<div class="sbl-product-{{ ai_gen_id }}__field"><label for="sbl-opt-{{ ai_gen_id }}-{{ forloop.index0 }}">{{ option.name | escape }}</label><select id="sbl-opt-{{ ai_gen_id }}-{{ forloop.index0 }}" data-option-index="{{ forloop.index0 }}" aria-label="{{ option.name | escape }}">{% for value in option.values %}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>{% endfor %}</select></div>{% endfor %}{% endunless %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id><label class="sbl-product-{{ ai_gen_id }}__gift"><input type="checkbox" name="properties[Gift option]" value="Yes" data-gift-toggle> {{ block.settings.gift_label | escape }}</label><div class="sbl-product-{{ ai_gen_id }}__field sbl-product-{{ ai_gen_id }}__gift-note" data-gift-note><label for="sbl-note-{{ ai_gen_id }}">{{ block.settings.note_label | escape }}</label><textarea id="sbl-note-{{ ai_gen_id }}" name="properties[Handwritten gift note]" maxlength="300" placeholder="{{ block.settings.note_placeholder | escape }}"></textarea></div><div class="sbl-product-{{ ai_gen_id }}__field"><label for="sbl-qty-{{ ai_gen_id }}">Quantity</label><input id="sbl-qty-{{ ai_gen_id }}" class="sbl-product-{{ ai_gen_id }}__quantity" type="number" name="quantity" value="1" min="1"></div><button class="sbl-product-{{ ai_gen_id }}__cart" type="submit"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>{{ block.settings.cart_label | escape }}</button>{% endform %}{% if block.settings.promo_text != blank %}<div class="sbl-product-{{ ai_gen_id }}__banner">{{ block.settings.promo_text | escape }}</div>{% endif %}{% if block.settings.offers != blank %}<div class="sbl-product-{{ ai_gen_id }}__panel"><h3>{{ block.settings.offers_heading | escape }}</h3>{{ block.settings.offers }}</div>{% endif %}{% if block.settings.benefits != blank %}<div class="sbl-product-{{ ai_gen_id }}__panel"><h3>{{ block.settings.benefits_heading | escape }}</h3>{{ block.settings.benefits }}</div>{% endif %}<div class="sbl-product-{{ ai_gen_id }}__panel"><h3>{{ block.settings.delivery_heading | escape }}</h3><div class="sbl-product-{{ ai_gen_id }}__pin-row"><input class="sbl-product-{{ ai_gen_id }}__pin-input" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="{{ block.settings.pin_placeholder | escape }}" aria-label="Delivery PIN code"><button type="button" data-pin-check>{{ block.settings.pin_button | escape }}</button></div><div class="sbl-product-{{ ai_gen_id }}__pin-result" aria-live="polite" data-pin-result></div></div>{% if block.settings.care_content != blank %}<div class="sbl-product-{{ ai_gen_id }}__panel"><h3>{{ block.settings.care_heading | escape }}</h3>{{ block.settings.care_content }}</div>{% endif %}{% assign spec_key = block.settings.spec_metafield | strip | split: '.' %}{% assign spec_value = blank %}{% if spec_key.size == 2 %}{% assign spec_value = product.metafields[spec_key[0]][spec_key[1]] %}{% endif %}{% if spec_value != blank or block.settings.spec_content != blank %}<div class="sbl-product-{{ ai_gen_id }}__panel"><h3>{{ block.settings.spec_heading | escape }}</h3>{% if spec_value != blank %}<p>{{ spec_value | metafield_tag }}</p>{% endif %}{{ block.settings.spec_content }}</div>{% endif %}</div></div><div class="sbl-product-{{ ai_gen_id }}__modal" data-modal role="dialog" aria-modal="true" aria-label="Enlarged product image"><button type="button" data-modal-close aria-label="Close enlarged image">×</button><img src="" alt="" data-modal-image></div><script type="application/json" data-variants>{{ product.variants | json }}</script></sbl-product-{{ ai_gen_id }}>{% endif %}
<script>(function(){const tag='sbl-product-{{ ai_gen_id }}';if(customElements.get(tag))return;class SblProduct extends HTMLElement{connectedCallback(){if(this.dataset.ready)return;this.dataset.ready='true';const hero=this.querySelector('.sbl-product-{{ ai_gen_id }}__hero');this.querySelectorAll('[data-image]').forEach(button=>button.addEventListener('click',()=>{if(hero){hero.src=button.dataset.image;hero.alt=button.dataset.alt}this.querySelectorAll('[data-image]').forEach(item=>item.setAttribute('aria-current',item===button?'true':'false'))}));const modal=this.querySelector('[data-modal]'),modalImg=this.querySelector('[data-modal-image]');const open=()=>{if(hero){modalImg.src=hero.src;modalImg.alt=hero.alt;modal.classList.add('is-open');this.querySelector('[data-modal-close]').focus()}};this.querySelector('.sbl-product-{{ ai_gen_id }}__main-image')?.addEventListener('click',open);this.querySelector('.sbl-product-{{ ai_gen_id }}__main-image')?.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();open()}});const close=()=>modal.classList.remove('is-open');this.querySelector('[data-modal-close]')?.addEventListener('click',close);modal?.addEventListener('click',event=>{if(event.target===modal)close()});document.addEventListener('keydown',event=>{if(event.key==='Escape')close()});const gift=this.querySelector('[data-gift-toggle]');gift?.addEventListener('change',()=>this.querySelector('[data-gift-note]').classList.toggle('is-visible',gift.checked));const variants=JSON.parse(this.querySelector('[data-variants]').textContent),selectors=[...this.querySelectorAll('[data-option-index]')];const update=()=>{const selected=selectors.map(select=>select.value),match=variants.find(variant=>variant.options.every((value,index)=>value===selected[index]));if(match){this.querySelector('[data-variant-id]').value=match.id;this.querySelector('[data-price]').textContent=new Intl.NumberFormat(undefined,{style:'currency',currency:'{{ cart.currency.iso_code }}'}).format(match.price/100);this.querySelector('.sbl-product-{{ ai_gen_id }}__cart').disabled=!match.available}};selectors.forEach(select=>select.addEventListener('change',update));this.querySelector('[data-pin-check]')?.addEventListener('click',()=>{const input=this.querySelector('.sbl-product-{{ ai_gen_id }}__pin-input'),result=this.querySelector('[data-pin-result]');result.textContent=/^[0-9]{6}$/.test(input.value)?{{ block.settings.pin_response | json }}:{{ block.settings.pin_invalid | json }}})}}customElements.define(tag,SblProduct)})();</script>
{% schema %}{"name":"SBL product detail","tag":null,"class":"sbl-product-detail-block","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Product appearance"},{"type":"color","id":"background","label":"Background","default":"#F8F4EC"},{"type":"color","id":"green","label":"Green","default":"#1F5130"},{"type":"color","id":"accent","label":"Accent","default":"#FFD60A"},{"type":"color","id":"text_color","label":"Text","default":"#14231A"},{"type":"range","id":"card_radius","label":"Image corner radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"checkbox","id":"show_description","label":"Show product description","default":true},{"type":"text","id":"reviews_text","label":"Reviews text","default":"★★★★★ Customer reviews"},{"type":"header","content":"Purchase options"},{"type":"text","id":"gift_label","label":"Gift option label","default":"Send as a gift"},{"type":"text","id":"note_label","label":"Gift note label","default":"Handwritten note"},{"type":"text","id":"note_placeholder","label":"Gift note placeholder","default":"Write your message"},{"type":"text","id":"cart_label","label":"Add to cart label","default":"Add to cart"},{"type":"header","content":"Offers and information"},{"type":"text","id":"promo_text","label":"Promotional banner","default":"A thoughtful green gift for every home"},{"type":"text","id":"offers_heading","label":"Offers heading","default":"Available offers"},{"type":"richtext","id":"offers","label":"Offers","default":"<p>Add current product offers here.</p>"},{"type":"text","id":"benefits_heading","label":"Benefits heading","default":"Why you’ll love it"},{"type":"richtext","id":"benefits","label":"Benefits","default":"<p>Add the key benefits of this plant here.</p>"},{"type":"text","id":"delivery_heading","label":"Delivery heading","default":"Check delivery availability"},{"type":"text","id":"pin_placeholder","label":"PIN input placeholder","default":"Enter 6-digit PIN code"},{"type":"text","id":"pin_button","label":"PIN button label","default":"Check"},{"type":"text","id":"pin_response","label":"Valid PIN response","default":"PIN format looks valid. Contact us to confirm service availability."},{"type":"text","id":"pin_invalid","label":"Invalid PIN response","default":"Enter a valid 6-digit PIN code."},{"type":"text","id":"care_heading","label":"Plant care heading","default":"Plant care"},{"type":"richtext","id":"care_content","label":"Plant care","default":"<p>Add care and watering guidance here.</p>"},{"type":"text","id":"spec_heading","label":"Specifications heading","default":"Plant specifications"},{"type":"text","id":"spec_metafield","label":"Metafield namespace.key","default":"custom.plant_specifications"},{"type":"richtext","id":"spec_content","label":"Additional specifications","default":"<p>Add additional specifications if needed.</p>"}],"presets":[{"name":"SBL product detail"}]}{% endschema %}