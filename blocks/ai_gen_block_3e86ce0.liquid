{% doc %}
  @prompt
    Build a complete custom header section for SBL Farms nursery with these exact requirements:
    
    **NAVIGATION (Desktop centered, no Home):**
    Plants ⌄ | Seeds ⌄ | Pots ⌄ | Services ⌄ | Gifting ⌄ | Blog | Contact
    
    **DESKTOP LAYOUT:** Logo → Centered Navigation → Search → Account → Wishlist → Cart
    
    **MOBILE LAYOUT:** Logo → Search → Cart → Hamburger (no Home anywhere)
    
    **CHEVRON ICONS:** Replace all dropdown arrows with thin SVG chevrons, dark green, 5-7px gap from text, rotate 180° when open, smooth CSS animation, no borders or backgrounds on nav items, same chevron on desktop and mobile, editable size/color/speed in Theme Editor.
    
    **DROPDOWN MENUS (5 parents, 10 items each, fully editable in Theme Editor, no hard-coded links):**
    Each item has: editable label, Shopify URL, enable/disable toggle. Dropdown opens below its own parent only.
    Plants: Indoor Plants, Outdoor Plants, Flowering Plants, Succulents, Cacti, Fruit Plants, Herbs, Air-Purifying Plants, Bonsai Plants, Climbers and Creepers
    Seeds: Vegetable Seeds, Flower Seeds, Herb Seeds, Fruit Seeds, Organic Seeds, Microgreen Seeds, Hybrid Seeds, Flower Mix Seeds, Lawn Grass Seeds, Seasonal Seeds
    Pots: Terracotta Pots, Ceramic Pots, Plastic Pots, Hanging Planters, Self-Watering Pots, Grow Bags, Window Planters, Decorative Planters, Seedling Trays, Plant Stands
    Services: Landscaping, Green Walls, AMC (Annual Maintenance Contract), Plant Rental, Indoor Plant Maintenance, Outdoor Plant Maintenance, Garden Maintenance, Terrace Gardening, Vertical Garden Installation, Plant Consultation
    Gifting: Corporate Gifting, Bulk Gifting, Plant Gifting, Personalized Plant Gifts, Employee Gifting, Client Gifting, Festive Plant Gifting, Wedding Plant Gifting, Eco-Friendly Gifts, Custom Gift Hampers
    
    **HEADER ELEMENTS:** SBL Farms logo left, navigation centered, search bar right, account icon, wishlist/heart icon, cart icon with dynamic cart count badge (Shopify cart API).
    
    **THEME EDITOR SETTINGS:** Desktop/tablet/mobile header height, logo size, navigation gap, search bar width/height, icon sizes, header padding, dropdown width, dropdown item height, dropdown font size, dropdown spacing, header background color, dropdown background color, dropdown text color, chevron size/color/animation speed, mobile sidebar width.
    
    **MOBILE SIDEBAR:** Full-height slide-in, Plants/Seeds/Pots/Services/Gifting as accordion menus with animated chevron, all 10 items per accordion, editable (no hard-coded links), 44px min touch targets, no horizontal scroll, background scroll locked, close via X or overlay, no Home.
    
    **BRANDING:** Preserve SBL Farms branding. Premium, clean, responsive, lightweight. Dark green accent color.with bold text font, remove the extra search bar and button in the header section 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.sbl-header-{{ ai_gen_id }}{display:block;width:100%;position:relative;z-index:30;background:{{ block.settings.header_bg }};color:{{ block.settings.dropdown_text }};font-weight:700}.sbl-header-{{ ai_gen_id }} *{box-sizing:border-box}.sbl-header__bar-{{ ai_gen_id }}{min-height:{{ block.settings.desktop_height }}px;padding:0 {{ block.settings.header_padding }}px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:22px}.sbl-header__logo-{{ ai_gen_id }}{display:inline-flex;align-items:center;justify-self:start;color:inherit;text-decoration:none}.sbl-header__logo-{{ ai_gen_id }} img{display:block;width:{{ block.settings.logo_size }}px;max-width:100%;height:auto}.sbl-header__logo-text-{{ ai_gen_id }}{font-size:21px;letter-spacing:.04em}.sbl-header__nav-{{ ai_gen_id }}{display:flex;align-items:center;justify-content:center;gap:{{ block.settings.nav_gap }}px;white-space:nowrap}.sbl-header__parent-{{ ai_gen_id }}{position:relative}.sbl-header__trigger-{{ ai_gen_id }},.sbl-header__plain-{{ ai_gen_id }}{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:0;border:0;background:transparent;color:inherit;font:inherit;font-weight:700;text-decoration:none;cursor:pointer}.sbl-header__chevron-{{ ai_gen_id }}{width:{{ block.settings.chevron_size }}px;height:{{ block.settings.chevron_size }}px;color:{{ block.settings.chevron_color }};transition:transform {{ block.settings.chevron_speed }}ms ease}.sbl-header__trigger-{{ ai_gen_id }}[aria-expanded=true] .sbl-header__chevron-{{ ai_gen_id }},.sbl-header__mobile-accordion-{{ ai_gen_id }}[aria-expanded=true] .sbl-header__chevron-{{ ai_gen_id }}{transform:rotate(180deg)}.sbl-header__dropdown-{{ ai_gen_id }}{position:absolute;top:100%;left:50%;transform:translateX(-50%);width:{{ block.settings.dropdown_width }}px;padding:{{ block.settings.dropdown_spacing }}px;background:{{ block.settings.dropdown_bg }};box-shadow:0 12px 30px rgba(13,58,29,.13);border-radius:10px;display:none;z-index:40}.sbl-header__parent-{{ ai_gen_id }}:hover .sbl-header__dropdown-{{ ai_gen_id }},.sbl-header__parent-{{ ai_gen_id }}:focus-within .sbl-header__dropdown-{{ ai_gen_id }},.sbl-header__parent-{{ ai_gen_id }}.is-open .sbl-header__dropdown-{{ ai_gen_id }}{display:block}.sbl-header__dropdown-link-{{ ai_gen_id }}{display:flex;align-items:center;min-height:{{ block.settings.dropdown_item_height }}px;padding:6px 10px;color:{{ block.settings.dropdown_text }};font-size:{{ block.settings.dropdown_font_size }}px;text-decoration:none;border-radius:6px}.sbl-header__actions-{{ ai_gen_id }}{display:flex;align-items:center;justify-content:end;gap:16px}.sbl-header__search-{{ ai_gen_id }}{display:flex;align-items:center;height:{{ block.settings.search_height }}px;width:{{ block.settings.search_width }}px;border:1px solid rgba(13,58,29,.24);border-radius:22px;overflow:hidden}.sbl-header__search-{{ ai_gen_id }} input{width:100%;min-width:0;height:100%;padding:0 12px;border:0;background:transparent;color:inherit;font:inherit;font-weight:400}.sbl-header__search-{{ ai_gen_id }} button{height:100%;padding:0 11px;border:0;background:transparent;color:{{ block.settings.chevron_color }};cursor:pointer}.sbl-header__icon-{{ ai_gen_id }}{width:{{ block.settings.icon_size }}px;height:{{ block.settings.icon_size }}px;display:inline-flex;align-items:center;justify-content:center;color:inherit;position:relative;text-decoration:none}.sbl-header__icon-{{ ai_gen_id }} svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.sbl-header__count-{{ ai_gen_id }}{position:absolute;top:-7px;right:-9px;min-width:17px;height:17px;padding:0 4px;display:flex;align-items:center;justify-content:center;border-radius:50px;color:#fff;background:{{ block.settings.chevron_color }};font-size:10px}.sbl-header__mobile-controls-{{ ai_gen_id }},.sbl-header__drawer-{{ ai_gen_id }}{display:none}.sbl-header-{{ ai_gen_id }} a:focus-visible,.sbl-header-{{ ai_gen_id }} button:focus-visible{outline:2px solid {{ block.settings.chevron_color }};outline-offset:3px}
@media(max-width:1100px){.sbl-header__bar-{{ ai_gen_id }}{min-height:{{ block.settings.tablet_height }}px;gap:12px}.sbl-header__nav-{{ ai_gen_id }}{gap:12px}.sbl-header__search-{{ ai_gen_id }}{width:min(180px,17vw)}.sbl-header__actions-{{ ai_gen_id }}{gap:12px}}
@media(max-width:749px){.sbl-header__bar-{{ ai_gen_id }}{min-height:{{ block.settings.mobile_height }}px;padding:0 {{ block.settings.header_padding | at_most: 24 }}px;display:flex;justify-content:space-between;gap:12px}.sbl-header__nav-{{ ai_gen_id }},.sbl-header__actions-{{ ai_gen_id }}{display:none}.sbl-header__logo-{{ ai_gen_id }} img{width:min({{ block.settings.logo_size }}px,38vw)}.sbl-header__mobile-controls-{{ ai_gen_id }}{display:flex;align-items:center;gap:17px}.sbl-header__mobile-menu-{{ ai_gen_id }}{width:44px;height:44px;border:0;background:transparent;color:inherit;padding:9px}.sbl-header__mobile-menu-{{ ai_gen_id }} svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.8}.sbl-header__drawer-{{ ai_gen_id }}{display:block;position:fixed;inset:0;z-index:1000;visibility:hidden;pointer-events:none}.sbl-header__drawer-{{ ai_gen_id }}.is-open{visibility:visible;pointer-events:auto}.sbl-header__overlay-{{ ai_gen_id }}{position:absolute;inset:0;border:0;background:rgba(0,0,0,.42);opacity:0;transition:opacity .25s ease}.sbl-header__drawer-{{ ai_gen_id }}.is-open .sbl-header__overlay-{{ ai_gen_id }}{opacity:1}.sbl-header__panel-{{ ai_gen_id }}{position:absolute;inset:0 0 0 auto;width:min({{ block.settings.mobile_sidebar_width }}px,90vw);overflow-y:auto;overscroll-behavior:contain;background:{{ block.settings.dropdown_bg }};padding:18px 20px 32px;transform:translateX(100%);transition:transform .25s ease}.sbl-header__drawer-{{ ai_gen_id }}.is-open .sbl-header__panel-{{ ai_gen_id }}{transform:translateX(0)}.sbl-header__drawer-head-{{ ai_gen_id }}{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;font-size:18px}.sbl-header__close-{{ ai_gen_id }}{width:44px;height:44px;border:0;background:transparent;color:inherit;font-size:28px}.sbl-header__mobile-accordion-{{ ai_gen_id }}{width:100%;min-height:48px;display:flex;align-items:center;justify-content:space-between;border:0;padding:0;background:transparent;color:{{ block.settings.dropdown_text }};font:inherit;font-weight:700;text-align:left}.sbl-header__mobile-list-{{ ai_gen_id }}{display:none;padding:0 0 8px 14px}.sbl-header__mobile-list-{{ ai_gen_id }}.is-open{display:block}.sbl-header__mobile-list-{{ ai_gen_id }} a{display:flex;min-height:44px;align-items:center;color:{{ block.settings.dropdown_text }};font-size:{{ block.settings.dropdown_font_size }}px;text-decoration:none}body.sbl-menu-locked-{{ ai_gen_id }}{overflow:hidden}}
{% endstyle %}
<sbl-header-{{ ai_gen_id }} class="sbl-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
<div class="sbl-header__bar-{{ ai_gen_id }}"><a class="sbl-header__logo-{{ ai_gen_id }}" href="{{ routes.root_url }}" aria-label="SBL Farms home">{% if block.settings.logo != blank %}<img src="{{ block.settings.logo | image_url: width: 600 }}" alt="{{ shop.name | escape }}" width="{{ block.settings.logo_size }}" height="auto">{% else %}<span class="sbl-header__logo-text-{{ ai_gen_id }}">SBL Farms</span>{% endif %}</a>
{% assign group_names = 'Plants|Seeds|Pots|Services|Gifting' | split: '|' %}{% assign group_keys = 'plants|seeds|pots|services|gifting' | split: '|' %}<nav class="sbl-header__nav-{{ ai_gen_id }}" aria-label="Main navigation">{% for group_name in group_names %}{% assign group_index = forloop.index0 %}{% assign group_key = group_keys[group_index] %}{% assign list_key = group_key | append: '_items' %}{% assign lines = block.settings[list_key] | split: '\n' %}<div class="sbl-header__parent-{{ ai_gen_id }}"><button class="sbl-header__trigger-{{ ai_gen_id }}" type="button" aria-expanded="false">{{ group_name }}<svg class="sbl-header__chevron-{{ ai_gen_id }}" viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button><div class="sbl-header__dropdown-{{ ai_gen_id }}">{% for line in lines %}{% assign parts = line | split: '|' %}{% assign item_label = parts[0] | strip %}{% assign item_url = parts[1] | strip %}{% if item_label != blank and item_url != blank %}<a class="sbl-header__dropdown-link-{{ ai_gen_id }}" href="{{ item_url | escape }}">{{ item_label | escape }}</a>{% endif %}{% endfor %}</div></div>{% endfor %}<a class="sbl-header__plain-{{ ai_gen_id }}" href="{{ block.settings.blog_url | default: '/blogs' }}">Blog</a><a class="sbl-header__plain-{{ ai_gen_id }}" href="{{ block.settings.contact_url | default: '/pages/contact' }}">Contact</a></nav>
<div class="sbl-header__actions-{{ ai_gen_id }}"><form class="sbl-header__search-{{ ai_gen_id }}" action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" placeholder="Search" aria-label="Search products"><button type="submit" aria-label="Submit search"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></button></form><a class="sbl-header__icon-{{ ai_gen_id }}" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg></a><a class="sbl-header__icon-{{ ai_gen_id }}" href="{{ block.settings.wishlist_url | default: '/pages/wishlist' }}" aria-label="Wishlist"><svg viewBox="0 0 24 24"><path d="M20.5 8.5c0 5-8.5 11-8.5 11s-8.5-6-8.5-11a4.5 4.5 0 0 1 8.5-2.2 4.5 4.5 0 0 1 8.5 2.2Z"/></svg></a><a class="sbl-header__icon-{{ ai_gen_id }}" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items"><svg viewBox="0 0 24 24"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.6L22 8H6"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg><span class="sbl-header__count-{{ ai_gen_id }}">{{ cart.item_count }}</span></a></div>
<div class="sbl-header__mobile-controls-{{ ai_gen_id }}"><a class="sbl-header__icon-{{ ai_gen_id }}" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items"><svg viewBox="0 0 24 24"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.6L22 8H6"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg><span class="sbl-header__count-{{ ai_gen_id }}">{{ cart.item_count }}</span></a><button class="sbl-header__mobile-menu-{{ ai_gen_id }}" type="button" aria-label="Open menu" aria-expanded="false"><svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button></div></div>
<div class="sbl-header__drawer-{{ ai_gen_id }}" aria-hidden="true"><button class="sbl-header__overlay-{{ ai_gen_id }}" type="button" aria-label="Close menu"></button><div class="sbl-header__panel-{{ ai_gen_id }}" role="dialog" aria-modal="true" aria-label="Mobile navigation"><div class="sbl-header__drawer-head-{{ ai_gen_id }}"><span>Menu</span><button class="sbl-header__close-{{ ai_gen_id }}" type="button" aria-label="Close menu">×</button></div>{% for group_name in group_names %}{% assign group_index = forloop.index0 %}{% assign group_key = group_keys[group_index] %}{% assign list_key = group_key | append: '_items' %}{% assign lines = block.settings[list_key] | split: '\n' %}<div><button class="sbl-header__mobile-accordion-{{ ai_gen_id }}" type="button" aria-expanded="false">{{ group_name }}<svg class="sbl-header__chevron-{{ ai_gen_id }}" viewBox="0 0 12 8"><path d="m1 1 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button><div class="sbl-header__mobile-list-{{ ai_gen_id }}">{% for line in lines %}{% assign parts = line | split: '|' %}{% assign item_label = parts[0] | strip %}{% assign item_url = parts[1] | strip %}{% if item_label != blank and item_url != blank %}<a href="{{ item_url | escape }}">{{ item_label | escape }}</a>{% endif %}{% endfor %}</div></div>{% endfor %}<a class="sbl-header__mobile-accordion-{{ ai_gen_id }}" href="{{ block.settings.blog_url | default: '/blogs' }}">Blog</a><a class="sbl-header__mobile-accordion-{{ ai_gen_id }}" href="{{ block.settings.contact_url | default: '/pages/contact' }}">Contact</a></div></div>
</sbl-header-{{ ai_gen_id }}>
<script>(()=>{const tag='sbl-header-{{ ai_gen_id }}';if(customElements.get(tag))return;class SblHeader extends HTMLElement{connectedCallback(){this.drawer=this.querySelector('.sbl-header__drawer-{{ ai_gen_id }}');this.menuButton=this.querySelector('.sbl-header__mobile-menu-{{ ai_gen_id }}');this.menuButton.addEventListener('click',()=>this.setDrawer(true));this.querySelector('.sbl-header__overlay-{{ ai_gen_id }}').addEventListener('click',()=>this.setDrawer(false));this.querySelector('.sbl-header__close-{{ ai_gen_id }}').addEventListener('click',()=>this.setDrawer(false));this.querySelectorAll('.sbl-header__trigger-{{ ai_gen_id }}').forEach(button=>button.addEventListener('click',()=>{const parent=button.closest('.sbl-header__parent-{{ ai_gen_id }}');const open=parent.classList.toggle('is-open');button.setAttribute('aria-expanded',String(open));this.querySelectorAll('.sbl-header__parent-{{ ai_gen_id }}').forEach(other=>{if(other!==parent){other.classList.remove('is-open');other.querySelector('.sbl-header__trigger-{{ ai_gen_id }}').setAttribute('aria-expanded','false')}})}));this.querySelectorAll('.sbl-header__mobile-accordion-{{ ai_gen_id }}[aria-expanded]').forEach(button=>button.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(open));button.nextElementSibling.classList.toggle('is-open',open)}));this.onKey=event=>{if(event.key==='Escape')this.setDrawer(false)};document.addEventListener('keydown',this.onKey)}disconnectedCallback(){document.removeEventListener('keydown',this.onKey)}setDrawer(open){this.drawer.classList.toggle('is-open',open);this.drawer.setAttribute('aria-hidden',String(!open));this.menuButton.setAttribute('aria-expanded',String(open));document.body.classList.toggle('sbl-menu-locked-{{ ai_gen_id }}',open);if(open)this.querySelector('.sbl-header__close-{{ ai_gen_id }}').focus();else this.menuButton.focus()}}customElements.define(tag,SblHeader)})();</script>
{% schema %}
{"name":"SBL Farms header","settings":[{"type":"header","content":"Brand and links"},{"type":"image_picker","id":"logo","label":"Logo"},{"type":"url","id":"blog_url","label":"Blog link"},{"type":"url","id":"contact_url","label":"Contact link"},{"type":"url","id":"wishlist_url","label":"Wishlist link"},{"type":"paragraph","content":"Enter dropdown items on separate lines as Label|Shopify URL. Leave a line empty to disable it."},{"type":"textarea","id":"plants_items","label":"Plants menu items"},{"type":"textarea","id":"seeds_items","label":"Seeds menu items"},{"type":"textarea","id":"pots_items","label":"Pots menu items"},{"type":"textarea","id":"services_items","label":"Services menu items"},{"type":"textarea","id":"gifting_items","label":"Gifting menu items"},{"type":"header","content":"Header sizing"},{"type":"range","id":"desktop_height","label":"Desktop header height","min":60,"max":120,"step":5,"unit":"px","default":85},{"type":"range","id":"tablet_height","label":"Tablet header height","min":55,"max":110,"step":5,"unit":"px","default":70},{"type":"range","id":"mobile_height","label":"Mobile header height","min":50,"max":90,"step":5,"unit":"px","default":65},{"type":"range","id":"logo_size","label":"Logo size","min":60,"max":240,"step":10,"unit":"px","default":150},{"type":"range","id":"nav_gap","label":"Navigation gap","min":8,"max":40,"step":2,"unit":"px","default":22},{"type":"range","id":"search_width","label":"Search bar width","min":120,"max":300,"step":10,"unit":"px","default":190},{"type":"range","id":"search_height","label":"Search bar height","min":32,"max":56,"step":2,"unit":"px","default":40},{"type":"range","id":"icon_size","label":"Icon size","min":18,"max":32,"step":2,"unit":"px","default":22},{"type":"range","id":"header_padding","label":"Header padding","min":8,"max":48,"step":2,"unit":"px","default":28},{"type":"range","id":"dropdown_width","label":"Dropdown width","min":180,"max":360,"step":10,"unit":"px","default":250},{"type":"range","id":"dropdown_item_height","label":"Dropdown item height","min":36,"max":56,"step":2,"unit":"px","default":42},{"type":"range","id":"dropdown_font_size","label":"Dropdown font size","min":12,"max":20,"step":1,"unit":"px","default":15},{"type":"range","id":"dropdown_spacing","label":"Dropdown spacing","min":4,"max":24,"step":2,"unit":"px","default":10},{"type":"range","id":"chevron_size","label":"Chevron size","min":8,"max":16,"step":1,"unit":"px","default":11},{"type":"range","id":"chevron_speed","label":"Chevron animation speed","min":100,"max":600,"step":50,"unit":"ms","default":250},{"type":"range","id":"mobile_sidebar_width","label":"Mobile sidebar width","min":260,"max":420,"step":10,"unit":"px","default":340},{"type":"color","id":"header_bg","label":"Header background","default":"#F8F4EC"},{"type":"color","id":"dropdown_bg","label":"Dropdown background","default":"#FFFFFF"},{"type":"color","id":"dropdown_text","label":"Dropdown text","default":"#0D3A1D"},{"type":"color","id":"chevron_color","label":"Chevron color","default":"#0D3A1D"}],"presets":[{"name":"SBL Farms header"}],"tag":null,"class":"sbl-farms-header"}
{% endschema %}