{% doc %}
  @prompt
    Create a visually stunning Google Reviews style testimonials section for a plant/nursery store. Each testimonial card should include: a Google 'G' logo/icon to indicate it's a Google review, a customer profile photo upload option (with a fallback to initials avatar), the customer's name, star rating (1-5 stars in Google's yellow color), the review text with decorative quotation marks, and the review date. The cards should have smooth hover animations, subtle shadow effects, and an auto-scrolling carousel slider. Use soft earthy greens and warm natural tones matching a nursery store. Include fade-in scroll animations. The section should have a header like 'What Our Customers Say' with a Google Reviews badge showing the overall rating. Make it fully customizable from the theme editor so merchants can add/edit each review's photo, name, rating, and text.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign reviews_id = 'ai-google-reviews-' | append: ai_gen_id %}

{% style %}
  .{{ reviews_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding }}px 0;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .{{ reviews_id }}__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .{{ reviews_id }}__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .{{ reviews_id }}__eyebrow {
    margin: 0 0 8px;
    color: {{ block.settings.eyebrow_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .{{ reviews_id }}__heading {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(28px, 4vw, 46px);
    line-height: 1.08;
  }

  .{{ reviews_id }}__badge {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.badge_border_color }};
    border-radius: 999px;
    background: {{ block.settings.badge_background }};
  }

  .{{ reviews_id }}__google {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fff;
    color: #4285f4;
    font-family: Arial, sans-serif;
    font-size: 19px;
    font-weight: 700;
  }

  .{{ reviews_id }}__badge strong { color: {{ block.settings.heading_color }}; font-size: 16px; }
  .{{ reviews_id }}__stars { color: #fbbc04; letter-spacing: 2px; white-space: nowrap; }
  .{{ reviews_id }}__count { color: {{ block.settings.muted_color }}; font-size: 12px; }

  .{{ reviews_id }}__viewport { overflow: hidden; }
  .{{ reviews_id }}__track {
    display: flex;
    gap: 18px;
    width: max-content;
    animation: {{ reviews_id }}-scroll {{ block.settings.scroll_speed }}s linear infinite;
  }
  .{{ reviews_id }}__track:hover { animation-play-state: paused; }

  .{{ reviews_id }}__card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(340px, calc(100vw - 56px));
    min-height: 270px;
    padding: 24px;
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_radius }}px;
    background: {{ block.settings.card_background }};
    box-shadow: 0 8px 24px rgba(31, 81, 48, .08);
    opacity: 0;
    transform: translateY(22px);
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .{{ reviews_id }}__card.is-visible { opacity: 1; transform: translateY(0); transition: opacity .7s ease, transform .7s ease, box-shadow .3s ease; }
  .{{ reviews_id }}__card:hover { transform: translateY(-6px); box-shadow: 0 16px 34px rgba(31, 81, 48, .16); }
  .{{ reviews_id }}__card::before { content: '“'; position: absolute; top: 10px; right: 20px; color: {{ block.settings.quote_color }}; font: 700 72px/1 Georgia, serif; opacity: .45; }

  .{{ reviews_id }}__person { display: flex; align-items: center; gap: 12px; }
  .{{ reviews_id }}__avatar, .{{ reviews_id }}__avatar img { width: 48px; height: 48px; border-radius: 50%; }
  .{{ reviews_id }}__avatar { display: grid; place-items: center; flex: 0 0 48px; overflow: hidden; background: {{ block.settings.avatar_background }}; color: {{ block.settings.avatar_text_color }}; font-size: 16px; font-weight: 700; }
  .{{ reviews_id }}__avatar img { display: block; object-fit: cover; }
  .{{ reviews_id }}__name { margin: 0 0 4px; color: {{ block.settings.heading_color }}; font-size: 15px; font-weight: 700; }
  .{{ reviews_id }}__date { color: {{ block.settings.muted_color }}; font-size: 12px; }
  .{{ reviews_id }}__rating { margin: 20px 0 12px; }
  .{{ reviews_id }}__text { margin: 0; color: {{ block.settings.text_color }}; font-size: 15px; line-height: 1.65; }

  @keyframes {{ reviews_id }}-scroll { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 9px)); } }
  @media (prefers-reduced-motion: reduce) { .{{ reviews_id }}__track { animation: none; } .{{ reviews_id }}__card { opacity: 1; transform: none; transition: none; } }
  @media screen and (max-width: 749px) { .{{ reviews_id }}__header { align-items: flex-start; flex-direction: column; } .{{ reviews_id }}__inner { padding: 0 16px; } }
{% endstyle %}

<google-reviews-{{ ai_gen_id }} class="{{ reviews_id }}" {{ block.shopify_attributes }}>
  <div class="{{ reviews_id }}__inner">
    <div class="{{ reviews_id }}__header">
      <div>
        {% if block.settings.eyebrow != blank %}<p class="{{ reviews_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
        <h2 class="{{ reviews_id }}__heading">{{ block.settings.heading }}</h2>
      </div>
      <div class="{{ reviews_id }}__badge" aria-label="{{ block.settings.overall_rating }} out of 5 stars from {{ block.settings.review_count }} reviews">
        <span class="{{ reviews_id }}__google" aria-hidden="true">G</span>
        <span><strong>{{ block.settings.overall_rating }}</strong><br><span class="{{ reviews_id }}__stars" aria-hidden="true">★★★★★</span> <span class="{{ reviews_id }}__count">{{ block.settings.review_count }} reviews</span></span>
      </div>
    </div>
    <div class="{{ reviews_id }}__viewport">
      <div class="{{ reviews_id }}__track">
        {% for copy in (1..2) %}
          {% for i in (1..6) %}
            {% liquid
              assign name_key = 'review_' | append: i | append: '_name'
              assign photo_key = 'review_' | append: i | append: '_photo'
              assign rating_key = 'review_' | append: i | append: '_rating'
              assign text_key = 'review_' | append: i | append: '_text'
              assign date_key = 'review_' | append: i | append: '_date'
              assign name = block.settings[name_key]
              assign photo = block.settings[photo_key]
              assign rating = block.settings[rating_key]
              assign review_text = block.settings[text_key]
              assign review_date = block.settings[date_key]
              assign name_parts = name | split: ' '
              assign first_initial = name | slice: 0, 1 | upcase
              assign last_name = name_parts | last
              assign last_initial = last_name | slice: 0, 1 | upcase
            %}
            {% if name != blank or review_text != blank %}
              <article class="{{ reviews_id }}__card">
                <div class="{{ reviews_id }}__person">
                  {% if photo != blank %}<div class="{{ reviews_id }}__avatar"><img src="{{ photo | image_url: width: 96 }}" alt="{{ name | escape }}" loading="lazy" width="96" height="96"></div>{% else %}<div class="{{ reviews_id }}__avatar" aria-hidden="true">{{ first_initial }}{{ last_initial }}</div>{% endif %}
                  <div><h3 class="{{ reviews_id }}__name">{{ name }}</h3><div class="{{ reviews_id }}__date">{{ review_date }}</div></div>
                </div>
                <div class="{{ reviews_id }}__rating" aria-label="{{ rating }} out of 5 stars"><span class="{{ reviews_id }}__stars" aria-hidden="true">{% for star in (1..5) %}{% if star <= rating %}★{% else %}☆{% endif %}{% endfor %}</span></div>
                <p class="{{ reviews_id }}__text">{{ review_text }}</p>
              </article>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>
</google-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class GoogleReviews{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        const cards = this.querySelectorAll('.{{ reviews_id }}__card');
        if (!('IntersectionObserver' in window)) { cards.forEach((card) => card.classList.add('is-visible')); return; }
        const observer = new IntersectionObserver((entries, instance) => {
          entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); instance.unobserve(entry.target); } });
        }, { threshold: 0.12 });
        cards.forEach((card) => observer.observe(card));
      }
    }
    customElements.define('google-reviews-{{ ai_gen_id }}', GoogleReviews{{ ai_gen_id }});
  })();
</script>

{% schema %}
