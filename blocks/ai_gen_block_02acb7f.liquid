x","default":18},{"type":"range","id":"card_spacing","label":"Card spacing","min":8,"max":36,"step":4,"unit":"px","default":20},{"type":"range","id":"section_padding","label":"Section padding","min":16,"max":80,"step":8,"unit":"px","default":40},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":12,"max":40,"step":4,"unit":"px","default":24},{"type":"range","id":"content_width","label":"Content width","min":1000,"max":1600,"step":100,"unit":"px","default":1200},{"type":"color","id":"card_background","label":"Card background","default":"#fffdf8"},{"type":"color","id":"text_color","label":"Price and heading","default":"#0d3a1d"},{"type":"color","id":"title_color","label":"Product title","default":"#14231a"},{"type":"color","id":"muted_color","label":"Muted text","default":"#5b6660"},{"type":"color","id":"control_background","label":"Control background","default":"#fffdf8"},{"type":"color","id":"filter_background","label":"Filter background","default":"#fffdf8"},{"type":"color","id":"control_border_color","label":"Control border","default":"#d5ddd1"},{"type":"color","id":"button_background","label":"Button background","default":"#1f5130"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"badge_background","label":"Badge background","default":"#0d3a1d"}],"presets":[{"name":"Collection product grid"}],"tag":null,"class":"collection-product-grid-block"}{% endschema %}