{% doc %}
  @prompt
    Create a Shopify collection product-grid section that closely matches the uploaded reference image.
    
    SECTION BACKGROUND:
    - Add a customizable background image upload option for the entire section.
    - The uploaded background image should cover the full section width.
    - Add a soft/light overlay if needed so the product cards remain easy to read.
    - Also allow a fallback background color.
    
    LAYOUT:
    - Full-width responsive product collection grid.
    - Desktop: 4 product cards per row.
    - Tablet: 2–3 cards per row.
    - Mobile: 2 cards per row.
    - Add consistent spacing between cards.
    - Product cards should have rounded corners, approximately 18–20px.
    
    TOP BAR:
    - Left side: FILTER with a small filter/sliders icon.
    - Right side: SORT BY with a dropdown arrow.
    - Make both functional.
    - Filter should open Shopify's collection filtering options.
    - Sort By should use Shopify's native collection sorting options.
    
    PRODUCT CARDS:
    Each card must dynamically pull products from a selected Shopify collection.
    
    Include:
    - Product image at the top.
    - Rounded top corners.
    - Discount badge in the top-right corner when a compare-at price exists.
    - Product rating and review count near the bottom of the image when available.
    - Product title below the image.
    - Current price.
    - Compare-at/original price with strikethrough.
    - "View Product" rounded button aligned to the bottom-right.
    - Button should link to the product page.
    - Entire product image/title can also link to the product page.
    
    IMPORTANT:
    - Do NOT hardcode product names, prices, ratings, discounts or images.
    - Everything must be dynamically pulled from Shopify product/collection data.
    - Allow the merchant to select the collection from the Shopify Theme Editor.
    - Add settings for number of products displayed.
    - Add settings for desktop/tablet/mobile columns.
    - Add settings for card border radius, spacing, background image, background overlay opacity and button styling.
    - Make the section fully responsive.
    - Match the visual style of the uploaded reference: clean premium gardening/plant-store aesthetic, soft off-white cards, dark green buttons and subtle rounded corners.
    - Use Shopify Liquid, HTML, CSS and JavaScript only.
    - Make it compatible with Shopify Online Store 2.0.
    - The section must work independently when added through the Shopify Theme Editor., need heading
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-cg-{{ ai_gen_id }}{display:block;width:100%;padding:{{ block.settings.section_padding }}px 20px;background:{{ block.settings.background_color }};{% if block.settings.background_image %}background-image:linear-gradient(rgba(255,255,255,{{ block.settings.overlay_opacity | divided_by:100.0 }}),rgba(255,255,255,{{ block.settings.overlay_opacity | divided_by:100.0 }})),url('{{ block.settings.background_image | image_url:width:2400 }}');background-size:cover;background-position:center;{% endif %}}.ai-cg__inner-{{ ai_gen_id }}{max-width:{{ block.settings.content_width }}px;margin:auto}.ai-cg__heading-{{ ai_gen_id }}{margin:0 0 8px;color:{{ block.settings.text_color }};font-size:{{ block.settings.heading_size }}px;text-align:{{ block.settings.heading_alignment }}}.ai-cg__intro-{{ ai_gen_id }}{margin:0 0 24px;color:{{ block.settings.muted_color }};text-align:{{ block.settings.heading_alignment }}}.ai-cg__bar-{{ ai_gen_id }}{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;padding:6px 6px 6px 8px;border:1px solid {{ block.settings.control_border_color }};border-radius:999px;background:{{ block.settings.control_background }};color:{{ block.settings.text_color }}}.ai-cg__filter-btn-{{ ai_gen_id }}{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border:0;border-radius:999px;background:transparent;color:inherit;font:inherit;font-size:15px;font-weight:600;cursor:pointer}.ai-cg__filter-btn-{{ ai_gen_id }}[aria-expanded=true]{background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }}}.ai-cg__count-{{ ai_gen_id }}{min-width:20px;height:20px;padding:0 6px;border-radius:99px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};font-size:11px;line-height:20px;text-align:center}.ai-cg__filter-btn-{{ ai_gen_id }}[aria-expanded=true] .ai-cg__count-{{ ai_gen_id }}{background:{{ block.settings.button_text_color }};color:{{ block.settings.button_background }}}.ai-cg__sort-{{ ai_gen_id }}{position:relative;display:inline-flex;align-items:center;gap:6px;min-width:0;padding:8px 0 8px 12px;font-size:15px;cursor:pointer}.ai-cg__sort-label-{{ ai_gen_id }}{color:{{ block.settings.muted_color }};white-space:nowrap}.ai-cg__sort-{{ ai_gen_id }} select{min-width:0;min-height:0;max-width:200px;padding:4px 0;margin-right:-6px;border:0;background:transparent;color:{{ block.settings.text_color }};font:inherit;font-weight:600;-webkit-appearance:none;appearance:none;cursor:pointer;text-overflow:ellipsis}.ai-cg__sort-{{ ai_gen_id }} select:focus-visible{outline:2px solid {{ block.settings.button_background }};outline-offset:4px;border-radius:4px}.ai-cg__price-filter-{{ ai_gen_id }}{display:flex;flex-direction:column;color:{{ block.settings.text_color }};font-size:13px;font-weight:700}.ai-cg__price-filter-{{ ai_gen_id }} .price-range{margin-top:6px;font-weight:400}.ai-cg__filter-actions-{{ ai_gen_id }}{display:flex;align-items:center;justify-content:flex-end;gap:16px;margin-top:16px}.ai-cg__filter-actions-{{ ai_gen_id }} a{color:{{ block.settings.text_color }};font-size:13px}.ai-cg__filter-actions-{{ ai_gen_id }} button{padding:10px 22px;border:0;border-radius:99px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};font:inherit;font-size:13px;font-weight:700;cursor:pointer}.ai-cg__filter-{{ ai_gen_id }}{display:none;margin-bottom:24px;padding:18px;border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.filter_background }}}.ai-cg__filter-{{ ai_gen_id }}.open{display:block}.ai-cg__filters-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px}.ai-cg__filters-{{ ai_gen_id }} label{display:flex;flex-direction:column;gap:6px;color:{{ block.settings.text_color }};font-size:13px;font-weight:700}.ai-cg__filters-{{ ai_gen_id }} .sheet-select,.ai-cg__filters-{{ ai_gen_id }} select{width:100%;padding:9px;border:1px solid {{ block.settings.control_border_color }};border-radius:8px}.ai-cg__grid-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat({{ block.settings.desktop_columns }},minmax(0,1fr));gap:{{ block.settings.card_spacing }}px}.ai-cg__card-{{ ai_gen_id }}{display:flex;flex-direction:column;min-width:0;overflow:hidden;border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.card_background }};color:{{ block.settings.text_color }};box-shadow:0 5px 18px rgba(22,45,30,.08);transition:transform .25s ease,box-shadow .25s ease}.ai-cg__card-{{ ai_gen_id }}:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(22,45,30,.13)}.ai-cg__image-{{ ai_gen_id }}{position:relative;aspect-ratio:1;overflow:hidden;background:#eeeee7}.ai-cg__image-{{ ai_gen_id }} img{width:100%;height:100%;object-fit:cover;display:block}.ai-cg__image-{{ ai_gen_id }} svg{width:100%;height:100%;display:block}.ai-cg__best-{{ ai_gen_id }},.ai-cg__badge-{{ ai_gen_id }}{position:absolute;top:12px;z-index:1;padding:6px 10px;border-radius:999px;font-size:10px;font-weight:700;letter-spacing:.06em;line-height:1.2}.ai-cg__best-{{ ai_gen_id }}{left:12px;background:#fff;color:#163c25}.ai-cg__badge-{{ ai_gen_id }}{right:12px;background:{{ block.settings.badge_background }};color:#fff}.ai-cg__body-{{ ai_gen_id }}{display:flex;flex:1;flex-direction:column;padding:16px}.ai-cg__title-{{ ai_gen_id }}{margin:0 0 4px;color:{{ block.settings.title_color }};font-size:17px;line-height:1.3}.ai-cg__title-{{ ai_gen_id }} a{color:inherit;text-decoration:none}.ai-cg__price-{{ ai_gen_id }}{margin-top:auto;color:{{ block.settings.text_color }};font-size:16px;font-weight:700}.ai-cg__compare-{{ ai_gen_id }}{margin-left:7px;color:{{ block.settings.muted_color }};font-size:13px;font-weight:400}.ai-cg__card-{{ ai_gen_id }} .card-rating{margin:6px 0 0}.ai-cg__actions-{{ ai_gen_id }}{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:14px}.ai-cg__button-{{ ai_gen_id }}{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:0 14px;border:1px solid {{ block.settings.button_background }};border-radius:999px;background:transparent;color:{{ block.settings.button_background }};font-size:13px;font-weight:650;text-decoration:none;white-space:nowrap;transition:background-color .2s ease,color .2s ease}.ai-cg__button-{{ ai_gen_id }}:hover{background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }}}.ai-cg__add-{{ ai_gen_id }}{display:inline-flex;align-items:center;gap:9px;padding:0;border:0;background:transparent;color:{{ block.settings.title_color }};font:inherit;font-size:13px;font-weight:650;cursor:pointer;white-space:nowrap}.ai-cg__cart-{{ ai_gen_id }}{display:grid;place-items:center;flex:0 0 38px;width:38px;height:38px;border-radius:50%;background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};transition:transform .2s ease}.ai-cg__add-{{ ai_gen_id }}:hover .ai-cg__cart-{{ ai_gen_id }}{transform:scale(1.06)}.ai-cg__add-{{ ai_gen_id }}[disabled]{opacity:.65;cursor:wait}.ai-cg__soldout-{{ ai_gen_id }}{color:{{ block.settings.muted_color }};font-size:13px;font-weight:600}.ai-cg__button-{{ ai_gen_id }}:focus-visible,.ai-cg__add-{{ ai_gen_id }}:focus-visible{outline:3px solid #b77800;outline-offset:3px}@media(max-width:989px){.ai-cg__grid-{{ ai_gen_id }}{grid-template-columns:repeat({{ block.settings.tablet_columns }},minmax(0,1fr))}}@media(max-width:749px){.ai-cg-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px 12px}.ai-cg__bar-{{ ai_gen_id }}{gap:4px;padding:4px}.ai-cg__filter-btn-{{ ai_gen_id }}{font-size:14px;padding:8px 10px}.ai-cg__sort-{{ ai_gen_id }}{font-size:14px;padding-left:8px}.ai-cg__sort-{{ ai_gen_id }} select{max-width:150px}.ai-cg__filters-{{ ai_gen_id }}{grid-template-columns:1fr}.ai-cg__grid-{{ ai_gen_id }}{grid-template-columns:repeat({{ block.settings.mobile_columns }},minmax(0,1fr));gap:12px}.ai-cg__body-{{ ai_gen_id }}{padding:12px}.ai-cg__title-{{ ai_gen_id }}{font-size:15px}.ai-cg__add-text-{{ ai_gen_id }}{display:none}.ai-cg__best-{{ ai_gen_id }},.ai-cg__badge-{{ ai_gen_id }}{top:8px;padding:4px 7px;font-size:9px;letter-spacing:.03em}.ai-cg__best-{{ ai_gen_id }}{left:8px}.ai-cg__badge-{{ ai_gen_id }}{right:8px}.ai-cg__button-{{ ai_gen_id }}{min-height:34px;padding:0 12px;font-size:12px}.ai-cg__cart-{{ ai_gen_id }}{flex-basis:34px;width:34px;height:34px}}/* Mobile: tighter section spacing */@media screen and (max-width: 749px){.ai-cg-{{ ai_gen_id }}{padding-top:{{ block.settings.mobile_padding | at_most: 24 }}px;padding-bottom:{{ block.settings.mobile_padding | at_most: 24 }}px}}{% endstyle %}
<collection-grid-{{ ai_gen_id }} class="ai-cg-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-cg__inner-{{ ai_gen_id }}">{% if block.settings.heading != blank %}<h2 class="ai-cg__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>{% endif %}{% if block.settings.intro != blank %}<div class="ai-cg__intro-{{ ai_gen_id }}">{{ block.settings.intro }}</div>{% endif %}{% if block.settings.collection != blank %}{% assign c=block.settings.collection %}<form class="ai-cg__form-{{ ai_gen_id }}" method="get" action="{{ c.url }}">{% assign active_count=0 %}{% for f in c.filters %}{% assign active_count=active_count | plus:f.active_values.size %}{% if f.min_value.value or f.max_value.value %}{% assign active_count=active_count | plus:1 %}{% endif %}{% endfor %}<div class="ai-cg__bar-{{ ai_gen_id }}"><button type="button" class="ai-cg__filter-btn-{{ ai_gen_id }} js-filter" aria-expanded="false" aria-controls="ai-cg-filter-{{ ai_gen_id }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="16" cy="7" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="8" cy="17" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>Filter{% if active_count > 0 %}<span class="ai-cg__count-{{ ai_gen_id }}">{{ active_count }}</span>{% endif %}</button><label class="ai-cg__sort-{{ ai_gen_id }}"><span class="ai-cg__sort-label-{{ ai_gen_id }}">Sort by</span><select name="sort_by" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">{% assign selected_sort=c.sort_by | default:c.default_sort_by %}{% for o in c.sort_options %}<option value="{{ o.value }}" {% if o.value==selected_sort %}selected{% endif %}>{{ o.name }}</option>{% endfor %}</select></label></div><div class="ai-cg__filter-{{ ai_gen_id }}" id="ai-cg-filter-{{ ai_gen_id }}"><div class="ai-cg__filters-{{ ai_gen_id }}">{% for f in c.filters %}{% if f.type=='list' or f.type=='boolean' %}<label>{{ f.label }}<select data-sheet-select data-sheet-title="{{ f.label | escape }}" name="{{ f.param_name }}" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()"><option value="">All</option>{% for v in f.values %}<option value="{{ v.value }}" {% if v.active %}selected{% endif %}>{{ v.label }} ({{ v.count }})</option>{% endfor %}</select></label>{% elsif f.type=='price_range' %}<div class="ai-cg__price-filter-{{ ai_gen_id }}"><span>{{ f.label }}</span>{% render 'price-range-slider', filter: f %}</div>{% endif %}{% endfor %}</div><div class="ai-cg__filter-actions-{{ ai_gen_id }}"><a href="{{ c.url }}{% if c.sort_by != blank %}?sort_by={{ c.sort_by }}{% endif %}">Clear all</a><button type="submit">Apply</button></div></div></form><div class="ai-cg__grid-{{ ai_gen_id }}">{% for p in c.products limit:block.settings.products_to_show %}{%- assign v = p.selected_or_first_available_variant -%}<article class="ai-cg__card-{{ ai_gen_id }}"><div class="ai-cg__image-{{ ai_gen_id }}">{% render 'wishlist-button', product: p, class: 'wl-btn--bottom' %}<a href="{{ p.url }}" aria-label="View {{ p.title | escape }}">{% if p.featured_image %}<img src="{{ p.featured_image | image_url:width:800 }}" alt="{{ p.featured_image.alt | default:p.title | escape }}" loading="lazy" width="800" height="800">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</a>{% if block.settings.show_bestseller and block.settings.bestseller_text != blank %}<span class="ai-cg__best-{{ ai_gen_id }}">{{ block.settings.bestseller_text | escape }}</span>{% endif %}{% if block.settings.show_discount and p.compare_at_price > p.price %}{% assign pct = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round %}<span class="ai-cg__badge-{{ ai_gen_id }}">{{ pct }}% OFF</span>{% endif %}</div><div class="ai-cg__body-{{ ai_gen_id }}"><h3 class="ai-cg__title-{{ ai_gen_id }}"><a href="{{ p.url }}">{{ p.title | escape }}</a></h3>{% if block.settings.show_description %}{% render 'card-subtext', product: p, class: 'ai-favourites-subtext' %}{% endif %}<div class="ai-cg__price-{{ ai_gen_id }}">{{ p.price | money }}{% if p.compare_at_price > p.price %}<s class="ai-cg__compare-{{ ai_gen_id }}">{{ p.compare_at_price | money }}</s>{% endif %}</div>{% if block.settings.show_ratings %}{% render 'card-rating', product: p %}{% endif %}<div class="ai-cg__actions-{{ ai_gen_id }}"><a class="ai-cg__button-{{ ai_gen_id }}" href="{{ p.url }}" aria-label="View product: {{ p.title | escape }}">View product</a>{% if v != blank and v.available %}<button class="ai-cg__add-{{ ai_gen_id }}" type="button" data-variant-id="{{ v.id }}" aria-label="Add {{ p.title | escape }} to cart"><span class="ai-cg__add-text-{{ ai_gen_id }}" data-button-label>Add to Cart</span><span class="ai-cg__cart-{{ ai_gen_id }}" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></span></button>{% elsif v != blank %}<span class="ai-cg__soldout-{{ ai_gen_id }}">Sold out</span>{% endif %}</div></div></article>{% endfor %}</div>{% else %}<p>Select a collection.</p>{% endif %}</div></collection-grid-{{ ai_gen_id }}><script>(function(){class C{{ ai_gen_id }} extends HTMLElement{connectedCallback(){const b=this.querySelector('.js-filter'),p=this.querySelector('.ai-cg__filter-{{ ai_gen_id }}');if(b&&p)b.onclick=()=>{const o=p.classList.toggle('open');b.setAttribute('aria-expanded',o)};this.querySelectorAll('[data-variant-id]').forEach(btn=>btn.addEventListener('click',async()=>{if(btn.disabled)return;btn.disabled=true;const l=btn.querySelector('[data-button-label]'),t=l?l.textContent:'';if(l)l.textContent='Adding…';const root=window.Shopify&&Shopify.routes&&Shopify.routes.root?Shopify.routes.root:'/';try{const r=await fetch(root+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:Number(btn.dataset.variantId),quantity:1}]})});if(!r.ok)throw new Error();if(window.SBLCart&&window.SBLCart.enabled()){btn.disabled=false;if(l)l.textContent=t;window.SBLCart.open()}else{window.location.assign(root+'cart')}}catch(e){btn.disabled=false;if(l)l.textContent='Try again'}}))}}if(!customElements.get('collection-grid-{{ ai_gen_id }}'))customElements.define('collection-grid-{{ ai_gen_id }}',C{{ ai_gen_id }})})();</script>
