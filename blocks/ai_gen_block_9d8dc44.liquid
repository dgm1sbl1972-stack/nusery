    { "type": "image_picker", "id": "tile_2_cover", "label": "Cover image" },
    { "type": "url", "id": "tile_2_url", "label": "Video URL" },
    { "type": "header", "content": "Tile 3" },
    { "type": "video", "id": "tile_3_video", "label": "Video" },
    { "type": "image_picker", "id": "tile_3_cover", "label": "Cover image" },
    { "type": "url", "id": "tile_3_url", "label": "Video URL" },
    { "type": "header", "content": "Tile 4" },
    { "type": "video", "id": "tile_4_video", "label": "Video" },
    { "type": "image_picker", "id": "tile_4_cover", "label": "Cover image" },
    { "type": "url", "id": "tile_4_url", "label": "Video URL" },
    { "type": "header", "content": "Tile 5" },
    { "type": "video", "id": "tile_5_video", "label": "Video" },
    { "type": "image_picker", "id": "tile_5_cover", "label": "Cover image" },
    { "type": "url", "id": "tile_5_url", "label": "Video URL" },
    { "type": "header", "content": "Tile 6" },
    { "type": "video", "id": "tile_6_video", "label": "Video" },
    { "type": "image_picker", "id": "tile_6_cover", "label": "Cover image" },
    { "type": "url", "id": "tile_6_url", "label": "Video URL" }
  ],
  "presets": [{ "name": "Trending reels" }],
  "tag": null,
  "class": "trending-reels-block"
}
