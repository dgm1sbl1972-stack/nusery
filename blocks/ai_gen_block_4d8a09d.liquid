{% doc %}
  @prompt
    Add a background image setting to the Services banner section. The background image should display behind all banner content, with options to control overlay opacity and background position (e.g., center, top, bottom). The image should cover the full width of the banner section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-services-banner-{{ ai_gen_id }} {
    position: relative;
    display: block;
    overflow: hidden;
    width: {{ block.settings.desktop_width_percent }}%;
    min-height: {{ block.settings.min_height }}px;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-services-banner-{{ ai_gen_id }}__media,
  .ai-services-banner-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
  }

  .ai-services-banner-{{ ai_gen_id }}__media img,
  .ai-services-banner-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.background_position }};
  }

  .ai-services-banner-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    background: {{ block.settings.background_color }};
  }

  .ai-services-banner-{{ ai_gen_id }}__placeholder svg {
    opacity: 0.18;
  }

  .ai-services-banner-{{ ai_gen_id }}__overlay {
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-services-banner-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment }};
    justify-content: center;
    gap: 14px;
    min-height: {{ block.settings.min_height }}px;
    padding: 48px 32px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-services-banner-{{ ai_gen_id }}__heading {
    max-width: 760px;
    margin: 0;
    color: inherit;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.12;
  }

  .ai-services-banner-{{ ai_gen_id }}__text {
    max-width: 680px;
    margin: 0;
    color: inherit;
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-services-banner-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
    padding: 12px 22px;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-weight: 700;
    text-decoration: none;
  }

  .ai-services-banner-{{ ai_gen_id }}__link:hover {
    background: {{ block.settings.button_hover_color }};
  }

  .ai-services-banner-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-services-banner-{{ ai_gen_id }} {
      width: 100%;
      min-height: {{ block.settings.mobile_min_height }}px;
    }

    .ai-services-banner-{{ ai_gen_id }}__content {
      min-height: {{ block.settings.mobile_min_height }}px;
      padding: 36px 20px;
    }

    .ai-services-banner-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<div class="ai-services-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-services-banner-{{ ai_gen_id }}__media" aria-hidden="true">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2400 }}"
        alt=""
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-services-banner-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>
  <div class="ai-services-banner-{{ ai_gen_id }}__overlay" aria-hidden="true"></div>
  <div class="ai-services-banner-{{ ai_gen_id }}__content">
    {% if block.settings.heading != blank %}
      <h2 class="ai-services-banner-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.description != blank %}
      <div class="ai-services-banner-{{ ai_gen_id }}__text">{{ block.settings.description }}</div>
    {% endif %}
    {% if block.settings.button_label != blank and block.settings.button_link != blank %}
      <a class="ai-services-banner-{{ ai_gen_id }}__link" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Services banner",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Services for your garden" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Discover practical support and expert care for healthier plants.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore services" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "select", "id": "background_position", "label": "Background position", "options": [ { "value": "center center", "label": "Center" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }, { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" } ], "default": "center center" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 35 },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#0d3a1d" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "min_height", "label": "Banner height", "min": 240, "max": 700, "step": 20, "unit": "px", "default": 420 },
    { "type": "range", "id": "mobile_min_height", "label": "Mobile height", "min": 220, "max": 600, "step": 20, "unit": "px", "default": 340 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "options": [ { "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" } ], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 72, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 22, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "color", "id": "background_color", "label": "Fallback background", "default": "#1f5130" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#ffd60a" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#14231a" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover", "default": "#ffffff" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#ffd60a" },
    { "type": "range", "id": "border_radius", "label": "Banner corners", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "button_radius", "label": "Button corners", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [ { "name": "Services banner" } ],
  "tag": null,
  "class": "services-banner-block"
}
{% endschema %}