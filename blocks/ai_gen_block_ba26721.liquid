{% doc %}
  @prompt
    need a testimonial of 6 slides where google logo and profile pic upload with name and text ratings and 3 image upload for each slides and the heading customer testimonial should come in the middle and need the testimonials automatic scroling from end to end of the desktop
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-testimonials-{{ ai_gen_id }}__heading {
    margin: 0 auto {{ block.settings.heading_spacing }}px;
    max-width: 900px;
    padding: 0 20px;
    color: {{ block.settings.heading_color }};
    text-align: center;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .ai-testimonials-{{ ai_gen_id }}__viewport {
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }

  .ai-testimonials-{{ ai_gen_id }}__track {
    display: flex;
    width: max-content;
    gap: {{ block.settings.card_gap }}px;
    animation: ai-testimonials-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-testimonials-{{ ai_gen_id }}__viewport:hover .ai-testimonials-{{ ai_gen_id }}__track,
  .ai-testimonials-{{ ai_gen_id }}__viewport:focus-within .ai-testimonials-{{ ai_gen_id }}__track {
    animation-play-state: paused;
  }

  .ai-testimonials-{{ ai_gen_id }}__card {
    flex: 0 0 min(390px, 82vw);
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_radius }}px;
    background: {{ block.settings.card_background }};
    box-shadow: 0 8px 24px rgba(20, 35, 26, 0.08);
  }

  .ai-testimonials-{{ ai_gen_id }}__top {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-testimonials-{{ ai_gen_id }}__profile,
  .ai-testimonials-{{ ai_gen_id }}__profile-placeholder {
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    border-radius: 50%;
    object-fit: cover;
  }

  .ai-testimonials-{{ ai_gen_id }}__profile-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.placeholder_background }};
    color: {{ block.settings.muted_color }};
  }

  .ai-testimonials-{{ ai_gen_id }}__identity {
    min-width: 0;
    flex: 1;
  }

  .ai-testimonials-{{ ai_gen_id }}__name {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: 16px;
    font-weight: 700;
  }

  .ai-testimonials-{{ ai_gen_id }}__google {
    width: 48px;
    height: 24px;
    object-fit: contain;
  }

  .ai-testimonials-{{ ai_gen_id }}__google-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 24px;
    border-radius: 4px;
    background: {{ block.settings.placeholder_background }};
    color: {{ block.settings.muted_color }};
    font-size: 10px;
    font-weight: 700;
  }

  .ai-testimonials-{{ ai_gen_id }}__rating {
    color: {{ block.settings.rating_color }};
    letter-spacing: 2px;
    font-size: 17px;
    line-height: 1;
  }

  .ai-testimonials-{{ ai_gen_id }}__text {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 15px;
    line-height: 1.6;
  }

  .ai-testimonials-{{ ai_gen_id }}__gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: auto;
  }

  .ai-testimonials-{{ ai_gen_id }}__gallery img,
  .ai-testimonials-{{ ai_gen_id }}__gallery-placeholder {
    width: 100%;
    aspect-ratio: 1 / 0.72;
    border-radius: 8px;
    object-fit: cover;
  }

  .ai-testimonials-{{ ai_gen_id }}__gallery-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: {{ block.settings.placeholder_background }};
  }

  .ai-testimonials-{{ ai_gen_id }}__gallery-placeholder svg {
    width: 100%;
    height: 100%;
    color: {{ block.settings.muted_color }};
  }

  @keyframes ai-testimonials-scroll-{{ ai_gen_id }} {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - {{ block.settings.card_gap | divided_by: 2 }}px)); }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px 0;
    }

    .ai-testimonials-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-testimonials-{{ ai_gen_id }}__track {
      animation-duration: {{ block.settings.mobile_scroll_speed }}s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-testimonials-{{ ai_gen_id }}__track {
      animation: none;
    }
  }
{% endstyle %}

<testimonial-slider-{{ ai_gen_id }} class="ai-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-testimonials-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
  <div class="ai-testimonials-{{ ai_gen_id }}__viewport" tabindex="0" aria-label="Customer testimonials">
    <div class="ai-testimonials-{{ ai_gen_id }}__track">
      {% for copy in (1..2) %}
        {% for i in (1..6) %}
          {% liquid
            assign name_key = 'slide_' | append: i | append: '_name'
            assign text_key = 'slide_' | append: i | append: '_text'
            assign rating_key = 'slide_' | append: i | append: '_rating'
            assign profile_key = 'slide_' | append: i | append: '_profile'
            assign google_key = 'slide_' | append: i | append: '_google_logo'
            assign image_one_key = 'slide_' | append: i | append: '_image_one'
            assign image_two_key = 'slide_' | append: i | append: '_image_two'
            assign image_three_key = 'slide_' | append: i | append: '_image_three'
            assign customer_name = block.settings[name_key]
            assign customer_text = block.settings[text_key]
            assign customer_rating = block.settings[rating_key]
            assign profile_image = block.settings[profile_key]
            assign google_logo = block.settings[google_key]
            assign image_one = block.settings[image_one_key]
            assign image_two = block.settings[image_two_key]
            assign image_three = block.settings[image_three_key]
          %}
          <article class="ai-testimonials-{{ ai_gen_id }}__card" aria-label="Testimonial from {{ customer_name | escape }}">
            <div class="ai-testimonials-{{ ai_gen_id }}__top">
              {% if profile_image %}
                <img class="ai-testimonials-{{ ai_gen_id }}__profile" src="{{ profile_image | image_url: width: 120 }}" alt="{{ customer_name | escape }}" loading="lazy" width="52" height="52">
              {% else %}
                <div class="ai-testimonials-{{ ai_gen_id }}__profile-placeholder" aria-hidden="true">{{ customer_name | slice: 0, 1 | upcase }}</div>
              {% endif %}
              <div class="ai-testimonials-{{ ai_gen_id }}__identity">
                <h3 class="ai-testimonials-{{ ai_gen_id }}__name">{{ customer_name }}</h3>
                <div class="ai-testimonials-{{ ai_gen_id }}__rating" aria-label="{{ customer_rating }} out of 5 stars">{% case customer_rating %}{% when '1' %}★☆☆☆☆{% when '2' %}★★☆☆☆{% when '3' %}★★★☆☆{% when '4' %}★★★★☆{% else %}★★★★★{% endcase %}</div>
              </div>
              {% if google_logo %}
                <img class="ai-testimonials-{{ ai_gen_id }}__google" src="{{ google_logo | image_url: width: 120 }}" alt="Google review" loading="lazy" width="48" height="24">
              {% else %}
                <span class="ai-testimonials-{{ ai_gen_id }}__google-placeholder" aria-label="Google review">Google</span>
              {% endif %}
            </div>
            <p class="ai-testimonials-{{ ai_gen_id }}__text">{{ customer_text }}</p>
            <div class="ai-testimonials-{{ ai_gen_id }}__gallery">
              {% for gallery_image in (1..3) %}
                {% liquid
                  case gallery_image
                    when 1
                      assign current_image = image_one
                    when 2
                      assign current_image = image_two
                    when 3
                      assign current_image = image_three
                  endcase
                %}
                {% if current_image %}
                  <img src="{{ current_image | image_url: width: 360 }}" alt="" loading="lazy" width="360" height="260">
                {% else %}
                  <div class="ai-testimonials-{{ ai_gen_id }}__gallery-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
                {% endif %}
              {% endfor %}
            </div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</testimonial-slider-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('testimonial-slider-{{ ai_gen_id }}')) {
      class TestimonialSlider{{ ai_gen_id }} extends HTMLElement {
        connectedCallback() {
          this.setAttribute('role', 'region');
        }
      }
      customElements.define('testimonial-slider-{{ ai_gen_id }}', TestimonialSlider{{ ai_gen_id }});
    }
  })();
</script>

