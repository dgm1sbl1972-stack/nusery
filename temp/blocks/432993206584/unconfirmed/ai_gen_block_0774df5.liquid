{% doc %}
  @prompt
    Create a Shopify custom Liquid section inspired by the uploaded reference image.
    
    IMPORTANT: This section is for PLANT POTS / PLANTERS, NOT seeds. Replace all seed-related content, names, images, and wording with pots and planters.
    
    SECTION DESIGN:
    - Create a clean, premium product collection grid for plant pots.
    - Use a 4-column product grid on desktop.
    - 2 columns on tablet.
    - 2 columns on mobile.
    - Maintain the same overall visual structure and spacing as the reference image.
    - Use rounded corners on product cards.
    - Use large product images at the top of each card.
    - Product image should have a fixed aspect ratio and use object-fit: cover.
    - Use a soft, warm off-white/cream background for the section.
    - Keep the design minimal, elegant and plant-focused.
    
    TOP BAR:
    - Left side: filter icon + "FILTER"
    - Right side: "Sort by" with a dropdown arrow.
    - Make the filter and sorting controls functional.
    - Sort dropdown should include:
      - Featured
      - Most relevant
      - Best selling
      - Alphabetically, A-Z
      - Alphabetically, Z-A
      - Price, low to high
      - Price, high to low
      - Date, old to new
      - Date, new to old
    
    PRODUCT CARDS:
    Each card should contain:
    1. Product image
    2. Optional discount badge in the top-right corner, such as "20% OFF"
    3. Product rating below the image
    4. Product title
    5. Current price
    6. Original price with strikethrough when there is a discount
    7. Dark green rounded "View Product" button
    
    POT PRODUCT EXAMPLES:
    Use example content such as:
    - Classic Ceramic Pot
    - Minimal White Planter
    - Terracotta Plant Pot
    - Ribbed Ceramic Planter
    - Self-Watering Pot
    - Hanging Planter
    - Indoor Decorative Pot
    - Outdoor Garden Planter
    
    PRODUCT DATA:
    - Make the section dynamic and compatible with Shopify products/collections.
    - Allow the merchant to select a Shopify collection from the Theme Editor.
    - Pull the actual product image, title, price, compare-at price, rating if available, and product URL dynamically.
    - Do not hard-code seed products.
    - The section should work with any selected POT / PLANTER collection.
    
    FILTER:
    Create a working filter interface suitable for pot products. Include useful filters such as:
    - Price
    - Size
    - Material
    - Color
    - Pot Type
    - Indoor / Outdoor
    - Availability
    
    DESIGN:
    - Premium gardening/lifestyle aesthetic.
    - Use dark green for buttons and important accents.
    - Use a warm cream/off-white background.
    - Typography should be clean and elegant.
    - Keep product titles clearly readable.
    - Buttons should have rounded pill-style corners.
    - Add subtle hover effects to product cards.
    - On hover, slightly lift the card and add a soft shadow.
    - Product images can have a subtle zoom effect on hover.
    - Keep animations smooth and lightweight.
    
    RESPONSIVE:
    - Desktop: 4 products per row.
    - Tablet: 2–3 products per row.
    - Mobile: 2 products per row.
    - Ensure there is no horizontal scrolling.
    - Maintain good spacing and readable text on mobile.
    
    SHOPIFY REQUIREMENTS:
    - Provide complete Shopify Liquid, HTML, CSS and JavaScript in ONE section file.
    - Use Shopify's collection/product objects wherever possible.
    - Add Theme Editor schema settings for:
      - Collection selection
      - Number of products
      - Products per row
      - Section heading
      - Background color
      - Button color
      - Border radius
    - Make the code self-contained and avoid external libraries.
    - Make sure the code can be pasted directly into a Shopify Custom Liquid/section environment.
    - Do not include any seed-related terminology anywhere in the final section.
    
    SECTION HEADING:
    Use:
    "Find Your Perfect Pot"
    
    The final result should visually resemble the uploaded reference image's product listing section, but clearly represent a premium PLANT POTS & PLANTERS collection.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign selected_collection = block.settings.collection %}

{% style %}
  .ai-pot-collection-{{ ai_gen_id }} { display:block; width:100%; background:{{ block.settings.background_color }}; color:#0d3a1d; padding:clamp(28px,5vw,64px) 20px; }
  .ai-pot-collection__inner-{{ ai_gen_id }} { width:{{ block.settings.desktop_width_percent }}%; max-width:1200px; margin:0 auto; }
  .ai-pot-collection__heading-{{ ai_gen_id }} { margin:0 0 28px; font-size:clamp(28px,4vw,48px); line-height:1.05; letter-spacing:-.03em; font-weight:600; }
  .ai-pot-collection__toolbar-{{ ai_gen_id }} { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:22px; border-bottom:1px solid rgba(13,58,29,.16); padding-bottom:16px; }
  .ai-pot-collection__control-{{ ai_gen_id }} { display:inline-flex; align-items:center; gap:9px; color:#0d3a1d; font-size:12px; font-weight:700; letter-spacing:.08em; background:none; border:0; padding:8px 0; cursor:pointer; }
  .ai-pot-collection__control-{{ ai_gen_id }} svg { width:17px; height:17px; }
  .ai-pot-collection__sort-{{ ai_gen_id }} { display:flex; align-items:center; gap:8px; font-size:13px; color:#526158; }
  .ai-pot-collection__select-{{ ai_gen_id }} { border:0; background:transparent; color:#0d3a1d; font:inherit; cursor:pointer; padding:6px 22px 6px 0; }
  .ai-pot-collection__filters-{{ ai_gen_id }} { display:none; grid-template-columns:repeat(4,1fr); gap:12px; padding:18px; margin-bottom:22px; background:#fffdf8; border-radius:{{ block.settings.border_radius }}px; border:1px solid rgba(13,58,29,.1); }
  .ai-pot-collection__filters-{{ ai_gen_id }}.is-open { display:grid; }
  .ai-pot-collection__filter-label-{{ ai_gen_id }} { display:flex; flex-direction:column; gap:6px; color:#526158; font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; }
  .ai-pot-collection__filter-{{ ai_gen_id }} { width:100%; border:1px solid #d7ddd3; border-radius:8px; padding:9px; color:#0d3a1d; background:#fff; font-size:13px; }
  .ai-pot-collection__grid-{{ ai_gen_id }} { display:grid; grid-template-columns:repeat({{ block.settings.products_per_row }},minmax(0,1fr)); gap:22px 16px; }
  .ai-pot-card-{{ ai_gen_id }} { position:relative; min-width:0; background:#fffdf8; border-radius:{{ block.settings.border_radius }}px; overflow:hidden; transition:transform .25s ease,box-shadow .25s ease; }
  .ai-pot-card-{{ ai_gen_id }}:hover { transform:translateY(-4px); box-shadow:0 12px 28px rgba(13,58,29,.12); }
  .ai-pot-card__media-{{ ai_gen_id }} { position:relative; aspect-ratio:1 / 1.08; overflow:hidden; background:#eee9df; }
  .ai-pot-card__media-{{ ai_gen_id }} img { width:100%; height:100%; display:block; object-fit:cover; transition:transform .4s ease; }
  .ai-pot-card:hover .ai-pot-card__media-{{ ai_gen_id }} img { transform:scale(1.04); }
  .ai-pot-card__placeholder-{{ ai_gen_id }} { width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#829083; }
  .ai-pot-card__placeholder-{{ ai_gen_id }} svg { width:58%; height:58%; }
  .ai-pot-card__badge-{{ ai_gen_id }} { position:absolute; top:12px; right:12px; padding:6px 9px; border-radius:999px; background:#e9f0d9; color:#0d3a1d; font-size:10px; font-weight:800; letter-spacing:.04em; }
  .ai-pot-card__body-{{ ai_gen_id }} { padding:14px 14px 16px; }
  .ai-pot-card__rating-{{ ai_gen_id }} { color:#b27424; font-size:12px; letter-spacing:1px; min-height:18px; }
  .ai-pot-card__rating-{{ ai_gen_id }} span { color:#66736a; letter-spacing:0; margin-left:4px; }
  .ai-pot-card__title-{{ ai_gen_id }} { display:block; margin:4px 0 8px; color:#0d3a1d; font-size:15px; line-height:1.3; font-weight:600; text-decoration:none; }
  .ai-pot-card__prices-{{ ai_gen_id }} { display:flex; align-items:center; gap:8px; min-height:22px; }
  .ai-pot-card__price-{{ ai_gen_id }} { color:#0d3a1d; font-size:14px; font-weight:700; }
  .ai-pot-card__compare-{{ ai_gen_id }} { color:#7b857e; font-size:12px; text-decoration:line-through; }
  .ai-pot-card__button-{{ ai_gen_id }} { display:block; margin-top:14px; padding:11px 14px; border-radius:999px; background:{{ block.settings.button_color }}; color:#fff; text-align:center; font-size:12px; font-weight:700; text-decoration:none; transition:opacity .2s ease; }
  .ai-pot-card__button-{{ ai_gen_id }}:hover { opacity:.86; }
  .ai-pot-collection__empty-{{ ai_gen_id }} { padding:36px; text-align:center; color:#526158; grid-column:1/-1; }
  @media (max-width: 989px) { .ai-pot-collection__grid-{{ ai_gen_id }} { grid-template-columns:repeat(2,minmax(0,1fr)); } .ai-pot-collection__filters-{{ ai_gen_id }} { grid-template-columns:repeat(2,1fr); } }
  @media (max-width: 749px) { .ai-pot-collection-{{ ai_gen_id }} { padding-left:14px; padding-right:14px; } .ai-pot-collection__inner-{{ ai_gen_id }} { width:100%; } .ai-pot-collection__toolbar-{{ ai_gen_id }} { margin-bottom:16px; } .ai-pot-collection__filters-{{ ai_gen_id }} { grid-template-columns:1fr 1fr; gap:8px; padding:12px; } .ai-pot-card__body-{{ ai_gen_id }} { padding:11px 10px 12px; } .ai-pot-card__title-{{ ai_gen_id }} { font-size:13px; } .ai-pot-card__button-{{ ai_gen_id }} { font-size:11px; padding:10px 8px; } }
{% endstyle %}

<pot-collection-{{ ai_gen_id }} class="ai-pot-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pot-collection__inner-{{ ai_gen_id }}">
    <h2 class="ai-pot-collection__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    <div class="ai-pot-collection__toolbar-{{ ai_gen_id }}">
      <button class="ai-pot-collection__control-{{ ai_gen_id }}" type="button" data-filter-toggle aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 6h16M7 12h10M10 18h4"/></svg>FILTER</button>
      <label class="ai-pot-collection__sort-{{ ai_gen_id }}">Sort by <select class="ai-pot-collection__select-{{ ai_gen_id }}" data-sort aria-label="Sort products"><option value="featured">Featured</option><option value="relevance">Most relevant</option><option value="best-selling">Best selling</option><option value="title-asc">Alphabetically, A-Z</option><option value="title-desc">Alphabetically, Z-A</option><option value="price-asc">Price, low to high</option><option value="price-desc">Price, high to low</option><option value="date-asc">Date, old to new</option><option value="date-desc">Date, new to old</option></select></label>
    </div>
    <div class="ai-pot-collection__filters-{{ ai_gen_id }}" data-filters>
      <label class="ai-pot-collection__filter-label-{{ ai_gen_id }}">Price<select class="ai-pot-collection__filter-{{ ai_gen_id }}" data-filter="price"><option value="">All prices</option><option value="under-1000">Under ₹1,000</option><option value="1000-2500">₹1,000–₹2,500</option><option value="over-2500">Over ₹2,500</option></select></label>
      <label class="ai-pot-collection__filter-label-{{ ai_gen_id }}">Size<select class="ai-pot-collection__filter-{{ ai_gen_id }}" data-filter="size"><option value="">All sizes</option><option value="small">Small</option><option value="medium">Medium</option><option value="large">Large</option></select></label>
      <label class="ai-pot-collection__filter-label-{{ ai_gen_id }}">Material<select class="ai-pot-collection__filter-{{ ai_gen_id }}" data-filter="material"><option value="">All materials</option><option value="ceramic">Ceramic</option><option value="terracotta">Terracotta</option><option value="plastic">Plastic</option><option value="metal">Metal</option></select></label>
      <label class="ai-pot-collection__filter-label-{{ ai_gen_id }}">Color<select class="ai-pot-collection__filter-{{ ai_gen_id }}" data-filter="color"><option value="">All colors</option><option value="white">White</option><option value="green">Green</option><option value="brown">Brown</option><option value="black">Black</option></select></label>
      <label class="ai-pot-collection__filter-label-{{ ai_gen_id }}">Pot type<select class="ai-pot-collection__filter-{{ ai_gen_id }}" data-filter="type"><option value="">All types</option><option value="decorative">Decorative</option><option value="hanging">Hanging</option><option value="self-watering">Self-watering</option><option value="planter">Planter</option></select></label>
      <label class="ai-pot-collection__filter-label-{{ ai_gen_id }}">Location<select class="ai-pot-collection__filter-{{ ai_gen_id }}" data-filter="location"><option value="">Indoor & outdoor</option><option value="indoor">Indoor</option><option value="outdoor">Outdoor</option></select></label>
      <label class="ai-pot-collection__filter-label-{{ ai_gen_id }}">Availability<select class="ai-pot-collection__filter-{{ ai_gen_id }}" data-filter="availability"><option value="">All products</option><option value="available">In stock</option><option value="sold-out">Sold out</option></select></label>
    </div>
    <div class="ai-pot-collection__grid-{{ ai_gen_id }}" data-grid>
      {% if selected_collection != blank %}
        {% for product in selected_collection.products limit: block.settings.products_to_show %}
          {% assign rating = product.metafields.reviews.rating.value | default: product.metafields.custom.rating.value %}
          {% assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.custom.rating_count.value %}
          {% assign product_tags = product.tags | join: ' ' | downcase %}
          {% assign discount = 0 %}
          {% if product.compare_at_price_max > product.price %}{% assign discount = product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max %}{% endif %}
          <article class="ai-pot-card-{{ ai_gen_id }}" data-card data-title="{{ product.title | escape }}" data-price="{{ product.price }}" data-date="{{ product.created_at | date: '%s' }}" data-tags="{{ product_tags | escape }}" data-available="{% if product.available %}available{% else %}sold-out{% endif %}">
            <a href="{{ product.url }}" class="ai-pot-card__media-{{ ai_gen_id }}">
              {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="972">{% else %}<div class="ai-pot-card__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
              {% if discount > 0 %}<span class="ai-pot-card__badge-{{ ai_gen_id }}">{{ discount }}% OFF</span>{% endif %}
            </a>
            <div class="ai-pot-card__body-{{ ai_gen_id }}">
              <div class="ai-pot-card__rating-{{ ai_gen_id }}">{% if rating != blank %}★★★★★<span>{{ rating | round: 1 }}{% if rating_count != blank %} ({{ rating_count }}){% endif %}</span>{% else %}<span>New arrival</span>{% endif %}</div>
              <a href="{{ product.url }}" class="ai-pot-card__title-{{ ai_gen_id }}">{{ product.title }}</a>
              <div class="ai-pot-card__prices-{{ ai_gen_id }}"><span class="ai-pot-card__price-{{ ai_gen_id }}">{{ product.price | money }}</span>{% if product.compare_at_price_max > product.price %}<span class="ai-pot-card__compare-{{ ai_gen_id }}">{{ product.compare_at_price_max | money }}</span>{% endif %}</div>
              <a href="{{ product.url }}" class="ai-pot-card__button-{{ ai_gen_id }}">View Product</a>
            </div>
          </article>
        {% else %}<div class="ai-pot-collection__empty-{{ ai_gen_id }}">No pots or planters found in this collection.</div>{% endfor %}
      {% else %}<div class="ai-pot-collection__empty-{{ ai_gen_id }}">Select a pots and planters collection to display products.</div>{% endif %}
    </div>
  </div>
</pot-collection-{{ ai_gen_id }}>

<script>
(function(){
  class PotCollection{{ ai_gen_id }} extends HTMLElement {
    connectedCallback(){
      this.grid=this.querySelector('[data-grid]'); this.cards=[...this.querySelectorAll('[data-card]')];
      this.querySelector('[data-filter-toggle]').addEventListener('click',e=>{const panel=this.querySelector('[data-filters]'); const open=panel.classList.toggle('is-open'); e.currentTarget.setAttribute('aria-expanded',open);});
      this.querySelector('[data-sort]').addEventListener('change',e=>this.sort(e.target.value));
      this.querySelectorAll('[data-filter]').forEach(el=>el.addEventListener('change',()=>this.filter()));
    }
    sort(value){const cards=[...this.cards]; cards.sort((a,b)=>{if(value==='title-asc')return a.dataset.title.localeCompare(b.dataset.title);if(value==='title-desc')return b.dataset.title.localeCompare(a.dataset.title);if(value==='price-asc')return +a.dataset.price-+b.dataset.price;if(value==='price-desc')return +b.dataset.price-+a.dataset.price;if(value==='date-asc')return +a.dataset.date-+b.dataset.date;if(value==='date-desc')return +b.dataset.date-+a.dataset.date;return 0;}); cards.forEach(card=>this.grid.appendChild(card));}
    filter(){this.cards.forEach(card=>{let show=true;this.querySelectorAll('[data-filter]').forEach(filter=>{const value=filter.value;if(!value)return; if(filter.dataset.filter==='price'){const price=+card.dataset.price;if(value==='under-1000'&&price>=100000)return show=false;if(value==='1000-2500'&&(price<100000||price>250000))return show=false;if(value==='over-2500'&&price<=250000)return show=false;}else if(filter.dataset.filter==='availability'){if(card.dataset.available!==value)show=false;}else if(!card.dataset.tags.includes(value))show=false;});card.hidden=!show;});}
  }
  customElements.define('pot-collection-{{ ai_gen_id }}',PotCollection{{ ai_gen_id }});
})();
</script>

{% schema %}
{"name":"Pot collection grid","settings":[{"type":"collection","id":"collection","label":"Pot collection"},{"type":"text","id":"heading","label":"Heading","default":"Find Your Perfect Pot"},{"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":24,"step":4,"default":12},{"type":"select","id":"products_per_row","label":"Products per row","options":[{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},{"type":"color","id":"button_color","label":"Button","default":"#0d3a1d"},{"type":"range","id":"border_radius","label":"Border radius","min":0,"max":32,"step":2,"unit":"px","default":16}],"presets":[{"name":"Pot collection grid"}],"tag":null,"class":"pot-collection-grid"}
{% endschema %}