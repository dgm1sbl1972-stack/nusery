{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .sbl-header-{{ ai_gen_id }} { display:block; width:100%; background:#f8f4ec; color:#0d3a1d; border-bottom:1px solid rgba(13,58,29,.12); position:relative; z-index:20; }
  .sbl-header-{{ ai_gen_id }} * { box-sizing:border-box; }
  .sbl-header-{{ ai_gen_id }}__inner { width:{{ block.settings.desktop_width_percent }}%; max-width:1600px; min-height:72px; margin:0 auto; padding:10px 20px; display:flex; align-items:center; justify-content:space-between; gap:22px; }
  .sbl-header-{{ ai_gen_id }}__brand { flex:0 0 auto; display:flex; align-items:center; }
  .sbl-header-{{ ai_gen_id }}__brand img { display:block; width:{{ block.settings.logo_width }}px; max-width:100%; height:auto; object-fit:contain; }
  .sbl-header-{{ ai_gen_id }}__nav { display:flex; align-items:center; justify-content:center; gap:clamp(12px,1.5vw,24px); margin:0 auto; }
  .sbl-header-{{ ai_gen_id }}__item { position:relative; }
  .sbl-header-{{ ai_gen_id }}__link { display:inline-flex; align-items:center; gap:5px; color:#0d3a1d; font-size:14px; line-height:1.3; text-decoration:none; white-space:nowrap; padding:10px 0; }
  .sbl-header-{{ ai_gen_id }}__link:hover, .sbl-header-{{ ai_gen_id }}__link:focus-visible { color:#1f5130; text-decoration:underline; text-underline-offset:4px; }
  .sbl-header-{{ ai_gen_id }}__chevron { width:10px; height:10px; }
  .sbl-header-{{ ai_gen_id }}__dropdown { position:absolute; top:100%; left:0; width:220px; padding:9px; margin:0; list-style:none; background:#fffefa; border-radius:10px; box-shadow:0 10px 28px rgba(13,58,29,.14); opacity:0; visibility:hidden; transform:translateY(5px); transition:opacity .16s ease,transform .16s ease,visibility .16s; z-index:30; }
  .sbl-header-{{ ai_gen_id }}__item--services .sbl-header-{{ ai_gen_id }}__dropdown,.sbl-header-{{ ai_gen_id }}__item--gifting .sbl-header-{{ ai_gen_id }}__dropdown { width:200px; }
  .sbl-header-{{ ai_gen_id }}__item:hover .sbl-header-{{ ai_gen_id }}__dropdown,.sbl-header-{{ ai_gen_id }}__item:focus-within .sbl-header-{{ ai_gen_id }}__dropdown,.sbl-header-{{ ai_gen_id }}__item.is-open .sbl-header-{{ ai_gen_id }}__dropdown { opacity:1;visibility:visible;transform:translateY(0); }
  .sbl-header-{{ ai_gen_id }}__dropdown a { display:block; padding:9px 10px; color:#0d3a1d; border-radius:6px; font-size:13px; text-decoration:none; }
  .sbl-header-{{ ai_gen_id }}__dropdown a:hover,.sbl-header-{{ ai_gen_id }}__dropdown a:focus-visible { background:#f1f5eb; outline:none; }
  .sbl-header-{{ ai_gen_id }}__actions { display:flex; align-items:center; gap:14px; flex:0 0 auto; }
  .sbl-header-{{ ai_gen_id }}__search { display:flex; align-items:center; border:1px solid rgba(13,58,29,.28); border-radius:20px; padding:0 10px; height:34px; }
  .sbl-header-{{ ai_gen_id }}__search input { width:105px; border:0; outline:0; background:transparent; color:#0d3a1d; font:inherit; font-size:12px; }
  .sbl-header-{{ ai_gen_id }}__icon { position:relative; color:#0d3a1d; display:inline-flex; align-items:center; justify-content:center; width:25px; height:30px; text-decoration:none; }
  .sbl-header-{{ ai_gen_id }}__icon svg,.sbl-header-{{ ai_gen_id }}__search svg { width:19px;height:19px; fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round; }
  .sbl-header-{{ ai_gen_id }}__count { position:absolute; top:-2px; right:-7px; min-width:16px; height:16px; padding:0 4px; display:flex; align-items:center; justify-content:center; border-radius:9px; background:#1f5130; color:#fff; font-size:10px; line-height:1; }
  .sbl-header-{{ ai_gen_id }}__mobile-toggle { display:none; border:0;background:transparent;color:#0d3a1d;padding:5px; }
  .sbl-header-{{ ai_gen_id }}__drawer { display:none; }
  @media(max-width:1100px) { .sbl-header-{{ ai_gen_id }}__inner { gap:12px;padding-left:14px;padding-right:14px; } .sbl-header-{{ ai_gen_id }}__nav { gap:12px; } .sbl-header-{{ ai_gen_id }}__search input { width:70px; } }
  @media(max-width:850px) {
    .sbl-header-{{ ai_gen_id }}__inner { min-height:64px; }
    .sbl-header-{{ ai_gen_id }}__nav { display:none; }
    .sbl-header-{{ ai_gen_id }}__mobile-toggle { display:inline-flex;align-items:center;justify-content:center;order:-1; }
    .sbl-header-{{ ai_gen_id }}__actions { gap:10px; }
    .sbl-header-{{ ai_gen_id }}__search { width:34px;padding:0;justify-content:center;border:0; }
    .sbl-header-{{ ai_gen_id }}__search input { position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0); }
    .sbl-header-{{ ai_gen_id }}__drawer { position:absolute;left:0;right:0;top:100%;max-height:calc(100vh - 64px);overflow:auto;background:#fffefa;padding:14px 20px 22px;box-shadow:0 10px 22px rgba(13,58,29,.14); }
    .sbl-header-{{ ai_gen_id }}__drawer[hidden] { display:none; }
    .sbl-header-{{ ai_gen_id }}__drawer .sbl-header-{{ ai_gen_id }}__item { border-bottom:1px solid rgba(13,58,29,.12); }
    .sbl-header-{{ ai_gen_id }}__drawer .sbl-header-{{ ai_gen_id }}__link { width:100%;justify-content:space-between;padding:12px 0; }
    .sbl-header-{{ ai_gen_id }}__drawer .sbl-header-{{ ai_gen_id }}__dropdown { position:static;width:100%;box-shadow:none;border-radius:0;padding:0 0 8px 12px;display:none;opacity:1;visibility:visible;transform:none; }
    .sbl-header-{{ ai_gen_id }}__drawer .sbl-header-{{ ai_gen_id }}__item.is-open .sbl-header-{{ ai_gen_id }}__dropdown { display:block; }
  }
  @media(prefers-reduced-motion:reduce) { .sbl-header-{{ ai_gen_id }}__dropdown { transition:none; } }
{% endstyle %}
<sbl-farms-header-{{ ai_gen_id }} class="sbl-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="sbl-header-{{ ai_gen_id }}__inner">
    <button class="sbl-header-{{ ai_gen_id }}__mobile-toggle" type="button" aria-label="Open navigation" aria-expanded="false"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
    <a class="sbl-header-{{ ai_gen_id }}__brand" href="{{ routes.root_url }}" aria-label="SBL Farms home">{% if block.settings.logo %}<img src="{{ block.settings.logo | image_url: width: 500 }}" alt="{{ block.settings.logo.alt | default: 'SBL Farms' | escape }}" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}">{% else %}<span>SBL Farms</span>{% endif %}</a>
    <nav class="sbl-header-{{ ai_gen_id }}__nav" aria-label="Main navigation">
      {% assign menus = 'plants,seeds,pots,services,gifting' | split: ',' %}{% for menu in menus %}{% assign menu_label = menu | capitalize %}
        <div class="sbl-header-{{ ai_gen_id }}__item sbl-header-{{ ai_gen_id }}__item--{{ menu }}"><a class="sbl-header-{{ ai_gen_id }}__link" href="#{{ menu }}" aria-haspopup="true" aria-expanded="false">{{ menu_label }}<svg class="sbl-header-{{ ai_gen_id }}__chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m2 4 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></a><ul class="sbl-header-{{ ai_gen_id }}__dropdown">
          {% assign labels = '' %}{% case menu %}{% when 'plants' %}{% assign labels = 'Indoor Plants|Outdoor Plants|Flowering Plants|Succulents|Cacti|Fruit Plants|Herbs|Air-Purifying Plants|Bonsai Plants|Climbers and Creepers' | split: '|' %}{% when 'seeds' %}{% assign labels = 'Vegetable Seeds|Flower Seeds|Herb Seeds|Fruit Seeds|Organic Seeds|Microgreen Seeds|Hybrid Seeds|Flower Mix Seeds|Lawn Grass Seeds|Seasonal Seeds' | split: '|' %}{% when 'pots' %}{% assign labels = 'Terracotta Pots|Ceramic Pots|Plastic Pots|Hanging Planters|Self-Watering Pots|Grow Bags|Window Planters|Decorative Planters|Seedling Trays|Plant Stands' | split: '|' %}{% when 'services' %}{% assign labels = 'Landscaping|Green Walls|AMC (Annual Maintenance Contract)|Plant Rental' | split: '|' %}{% when 'gifting' %}{% assign labels = 'Corporate Gifting|Bulk Gifting' | split: '|' %}{% endcase %}
          {% for label in labels %}{% assign url_key = menu | append: '_' | append: forloop.index %}<li><a href="{{ block.settings[url_key] | default: routes.all_products_collection_url }}">{{ label }}</a></li>{% endfor %}
        </ul></div>{% endfor %}
      <div class="sbl-header-{{ ai_gen_id }}__item"><a class="sbl-header-{{ ai_gen_id }}__link" href="{{ block.settings.blog_url | default: blogs['news'].url | default: routes.root_url }}">Blog</a></div>
      <div class="sbl-header-{{ ai_gen_id }}__item"><a class="sbl-header-{{ ai_gen_id }}__link" href="{{ block.settings.contact_url | default: routes.root_url }}">Contact</a></div>
    </nav>
    <div class="sbl-header-{{ ai_gen_id }}__actions">
      <form class="sbl-header-{{ ai_gen_id }}__search" action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" placeholder="Search" aria-label="Search products"><button type="submit" aria-label="Submit search" style="border:0;background:none;color:inherit;padding:0;display:flex"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></button></form>
      <a class="sbl-header-{{ ai_gen_id }}__icon" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg></a>
      <a class="sbl-header-{{ ai_gen_id }}__icon" href="{{ block.settings.wishlist_url | default: '/pages/wishlist' }}" aria-label="Wishlist"><svg viewBox="0 0 24 24"><path d="M20.8 8.7c0 5.1-8.8 11-8.8 11s-8.8-5.9-8.8-11a4.5 4.5 0 0 1 8.8-1.3 4.5 4.5 0 0 1 8.8 1.3Z"/></svg></a>
      <a class="sbl-header-{{ ai_gen_id }}__icon" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items"><svg viewBox="0 0 24 24"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.6L22 8H6"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg><span class="sbl-header-{{ ai_gen_id }}__count">{{ cart.item_count }}</span></a>
    </div>
  </div>
  <nav class="sbl-header-{{ ai_gen_id }}__drawer" hidden aria-label="Mobile navigation">
    {% assign menus = 'plants,seeds,pots,services,gifting' | split: ',' %}{% for menu in menus %}{% assign menu_label = menu | capitalize %}<div class="sbl-header-{{ ai_gen_id }}__item sbl-header-{{ ai_gen_id }}__item--{{ menu }}"><a class="sbl-header-{{ ai_gen_id }}__link" href="#{{ menu }}" aria-haspopup="true" aria-expanded="false">{{ menu_label }}<svg class="sbl-header-{{ ai_gen_id }}__chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m2 4 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></a><ul class="sbl-header-{{ ai_gen_id }}__dropdown">{% assign labels = '' %}{% case menu %}{% when 'plants' %}{% assign labels = 'Indoor Plants|Outdoor Plants|Flowering Plants|Succulents|Cacti|Fruit Plants|Herbs|Air-Purifying Plants|Bonsai Plants|Climbers and Creepers' | split: '|' %}{% when 'seeds' %}{% assign labels = 'Vegetable Seeds|Flower Seeds|Herb Seeds|Fruit Seeds|Organic Seeds|Microgreen Seeds|Hybrid Seeds|Flower Mix Seeds|Lawn Grass Seeds|Seasonal Seeds' | split: '|' %}{% when 'pots' %}{% assign labels = 'Terracotta Pots|Ceramic Pots|Plastic Pots|Hanging Planters|Self-Watering Pots|Grow Bags|Window Planters|Decorative Planters|Seedling Trays|Plant Stands' | split: '|' %}{% when 'services' %}{% assign labels = 'Landscaping|Green Walls|AMC (Annual Maintenance Contract)|Plant Rental' | split: '|' %}{% when 'gifting' %}{% assign labels = 'Corporate Gifting|Bulk Gifting' | split: '|' %}{% endcase %}{% for label in labels %}{% assign url_key = menu | append: '_' | append: forloop.index %}<li><a href="{{ block.settings[url_key] | default: routes.all_products_collection_url }}">{{ label }}</a></li>{% endfor %}</ul></div>{% endfor %}<div class="sbl-header-{{ ai_gen_id }}__item"><a class="sbl-header-{{ ai_gen_id }}__link" href="{{ block.settings.blog_url | default: routes.root_url }}">Blog</a></div><div class="sbl-header-{{ ai_gen_id }}__item"><a class="sbl-header-{{ ai_gen_id }}__link" href="{{ block.settings.contact_url | default: routes.root_url }}">Contact</a></div>
  </nav>
</sbl-farms-header-{{ ai_gen_id }}>
<script>
(function(){const tag='sbl-farms-header-{{ ai_gen_id }}';if(customElements.get(tag))return;class SblFarmsHeader extends HTMLElement{connectedCallback(){this.toggle=this.querySelector('.sbl-header-{{ ai_gen_id }}__mobile-toggle');this.drawer=this.querySelector('.sbl-header-{{ ai_gen_id }}__drawer');this.toggle.addEventListener('click',()=>{const open=this.toggle.getAttribute('aria-expanded')==='true';this.toggle.setAttribute('aria-expanded',String(!open));this.toggle.setAttribute('aria-label',open?'Open navigation':'Close navigation');this.drawer.hidden=open});this.querySelectorAll('.sbl-header-{{ ai_gen_id }}__item > .sbl-header-{{ ai_gen_id }}__link[aria-haspopup]').forEach(link=>link.addEventListener('click',event=>{if(matchMedia('(max-width: 850px)').matches){event.preventDefault();const item=link.parentElement;const open=item.classList.toggle('is-open');link.setAttribute('aria-expanded',String(open))}}))}}customElements.define(tag,SblFarmsHeader)})();
</script>
