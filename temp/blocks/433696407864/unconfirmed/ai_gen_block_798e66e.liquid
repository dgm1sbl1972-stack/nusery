{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-plant-categories-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }
  .ai-plant-categories-{{ ai_gen_id }} *, .ai-plant-categories-{{ ai_gen_id }} *::before, .ai-plant-categories-{{ ai_gen_id }} *::after { box-sizing: border-box; }
  .ai-plant-categories-{{ ai_gen_id }}__inner { width: 100%; max-width: 1200px; margin: 0 auto; }
  .ai-plant-categories-{{ ai_gen_id }}__heading { margin: 0 0 38px; text-align: center; color: {{ block.settings.heading_color }}; font-size: {{ block.settings.heading_size }}px; font-weight: {{ block.settings.heading_weight }}; line-height: 1.15; }
  .ai-plant-categories-{{ ai_gen_id }}__italic { {% if block.settings.italic_category %}font-style: italic; font-family: Georgia, 'Times New Roman', serif;{% endif %} }
  .ai-plant-categories-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat({{ block.settings.desktop_columns }}, minmax(0, 1fr)); gap: {{ block.settings.grid_gap }}px; align-items: start; }
  .ai-plant-categories-{{ ai_gen_id }}__card { min-width: 0; text-align: center; }
  .ai-plant-categories-{{ ai_gen_id }}__link { display: block; width: 100%; color: {{ block.settings.category_color }}; text-decoration: none; }
  .ai-plant-categories-{{ ai_gen_id }}__media { position: relative; width: {{ block.settings.image_size }}px; max-width: 100%; aspect-ratio: 1 / 1; margin: 0 auto 15px; overflow: hidden; border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }}; border-radius: {{ block.settings.border_radius }}%; background: #fff; {% if block.settings.show_shadow %}box-shadow: 0 5px 18px rgba(20, 35, 26, .12);{% endif %} }
  .ai-plant-categories-{{ ai_gen_id }}__media img, .ai-plant-categories-{{ ai_gen_id }}__placeholder svg { display: block; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .ai-plant-categories-{{ ai_gen_id }}__hover { opacity: 0; transition: opacity {{ block.settings.transition_speed }}ms ease; }
  .ai-plant-categories-{{ ai_gen_id }}__link:hover .ai-plant-categories-{{ ai_gen_id }}__hover, .ai-plant-categories-{{ ai_gen_id }}__link:focus-visible .ai-plant-categories-{{ ai_gen_id }}__hover { opacity: 1; }
  .ai-plant-categories-{{ ai_gen_id }}__name { display: block; font-size: {{ block.settings.category_size }}px; font-weight: {{ block.settings.category_weight }}; line-height: 1.35; overflow-wrap: anywhere; }
  .ai-plant-categories-{{ ai_gen_id }}__cta { display: flex; min-height: 100%; flex-direction: column; justify-content: center; align-items: center; gap: 11px; padding: 22px; border-radius: {{ block.settings.cta_radius }}px; background: {{ block.settings.cta_background }}; color: {{ block.settings.cta_text_color }}; text-align: center; text-decoration: none; }
  .ai-plant-categories-{{ ai_gen_id }}__cta-title { margin: 0; font-size: 22px; line-height: 1.2; }
  .ai-plant-categories-{{ ai_gen_id }}__cta-copy { margin: 0; font-size: 14px; line-height: 1.45; }
  .ai-plant-categories-{{ ai_gen_id }}__cta-button { display: inline-flex; justify-content: center; align-items: center; padding: 10px 18px; border-radius: {{ block.settings.cta_radius }}px; background: {{ block.settings.cta_button_color }}; color: {{ block.settings.cta_button_text }}; font-weight: 600; }
  .ai-plant-categories-{{ ai_gen_id }}__link:focus-visible, .ai-plant-categories-{{ ai_gen_id }}__cta:focus-visible { outline: 3px solid #1f5130; outline-offset: 4px; }
  @media (max-width: 989px) { .ai-plant-categories-{{ ai_gen_id }}__grid { grid-template-columns: repeat({{ block.settings.tablet_columns }}, minmax(0, 1fr)); } }
  @media (max-width: 749px) {
    .ai-plant-categories-{{ ai_gen_id }} { padding-left: 14px; padding-right: 14px; }
    .ai-plant-categories-{{ ai_gen_id }}__grid { grid-template-columns: repeat({{ block.settings.mobile_columns }}, minmax(0, 1fr)); gap: {{ block.settings.grid_gap | times: 0.7 }}px; }
    .ai-plant-categories-{{ ai_gen_id }}__heading { margin-bottom: 26px; }
    .ai-plant-categories-{{ ai_gen_id }}__media { width: min({{ block.settings.image_size }}px, 100%); }
    .ai-plant-categories-{{ ai_gen_id }}__cta { padding: 16px 10px; }
  }
  @media (hover: none) { .ai-plant-categories-{{ ai_gen_id }}__hover { display: none; } }
{% endstyle %}
<section class="ai-plant-categories-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-plant-categories-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-plant-categories-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}{% if block.settings.italic_category %} <span class="ai-plant-categories-{{ ai_gen_id }}__italic">{{ block.settings.italic_word | escape }}</span>{% endif %}</h2>{% endif %}
    <div class="ai-plant-categories-{{ ai_gen_id }}__grid">
      {% for i in (1..8) %}
        {% liquid
          assign enabled_key = 'category_' | append: i | append: '_enabled'
          assign title_key = 'category_' | append: i | append: '_name'
          assign image_key = 'category_' | append: i | append: '_image'
          assign hover_key = 'category_' | append: i | append: '_hover_image'
          assign link_key = 'category_' | append: i | append: '_link'
          assign enabled = block.settings[enabled_key]
          assign title = block.settings[title_key]
          assign image = block.settings[image_key]
          assign hover_image = block.settings[hover_key]
          assign category_link = block.settings[link_key]
        %}
        {% if enabled and title != blank %}
          <div class="ai-plant-categories-{{ ai_gen_id }}__card">
            {% if category_link != blank %}<a class="ai-plant-categories-{{ ai_gen_id }}__link" href="{{ category_link }}" aria-label="{{ title | escape }}">{% else %}<div class="ai-plant-categories-{{ ai_gen_id }}__link">{% endif %}
              <div class="ai-plant-categories-{{ ai_gen_id }}__media">
                {% if image %}<img src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | default: title | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">{% else %}<div class="ai-plant-categories-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
                {% if hover_image %}<img class="ai-plant-categories-{{ ai_gen_id }}__hover" src="{{ hover_image | image_url: width: 900 }}" alt="" loading="lazy" width="{{ hover_image.width }}" height="{{ hover_image.height }}">{% endif %}
              </div>
              <span class="ai-plant-categories-{{ ai_gen_id }}__name">{{ title | escape }}</span>
            {% if category_link != blank %}</a>{% else %}</div>{% endif %}
          </div>
        {% endif %}
      {% endfor %}
      {% if block.settings.show_cta %}
        <div class="ai-plant-categories-{{ ai_gen_id }}__card">
          {% if block.settings.cta_link != blank %}<a class="ai-plant-categories-{{ ai_gen_id }}__cta" href="{{ block.settings.cta_link }}">{% else %}<div class="ai-plant-categories-{{ ai_gen_id }}__cta">{% endif %}
            {% if block.settings.cta_heading != blank %}<h3 class="ai-plant-categories-{{ ai_gen_id }}__cta-title">{{ block.settings.cta_heading | escape }}</h3>{% endif %}
            {% if block.settings.cta_subtext != blank %}<p class="ai-plant-categories-{{ ai_gen_id }}__cta-copy">{{ block.settings.cta_subtext | escape }}</p>{% endif %}
            {% if block.settings.cta_label != blank %}<span class="ai-plant-categories-{{ ai_gen_id }}__cta-button">{{ block.settings.cta_label | escape }}</span>{% endif %}
          {% if block.settings.cta_link != blank %}</a>{% else %}</div>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
