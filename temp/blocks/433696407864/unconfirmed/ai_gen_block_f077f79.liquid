{% doc %}
  @prompt
    Create a complete, production-ready sections/header.liquid file for a Shopify Online Store 2.0 premium botanical nursery store (SBL Farms). The header must be premium, clean, lightweight, accessible, and fully responsive.
    
    NAVIGATION — NO HOME: Plants ⌄ | Seeds ⌄ | Pots ⌄ | Services ⌄ | Gifting ⌄ | Blog | Contact. Never show or auto-add Home. Plain text navigation, no pills, boxes or backgrounds.
    
    STRUCTURE: Use only 5 Shopify "Dropdown" blocks: Plants, Seeds, Pots, Services, Gifting. Each block has 10 editable item slots (item_1_label, item_1_url, item_1_enabled ... item_10_label, item_10_url, item_10_enabled).
    
    DEFAULT ITEMS: Plants: Indoor Plants, Outdoor Plants, Flowering Plants, Succulents, Cacti, Fruit Plants, Herbs, Air-Purifying Plants, Bonsai Plants, Climbers and Creepers. Seeds: Vegetable Seeds, Flower Seeds, Herb Seeds, Fruit Seeds, Organic Seeds, Microgreen Seeds, Hybrid Seeds, Flower Mix Seeds, Lawn Grass Seeds, Seasonal Seeds. Pots: Terracotta Pots, Ceramic Pots, Plastic Pots, Hanging Planters, Self-Watering Pots, Grow Bags, Window Planters, Decorative Planters, Seedling Trays, Plant Stands. Services: Landscaping, Green Walls, AMC (Annual Maintenance Contract), Plant Rental, Indoor Plant Maintenance, Outdoor Plant Maintenance, Garden Maintenance, Terrace Gardening, Vertical Garden Installation, Plant Consultation. Gifting: Corporate Gifting, Bulk Gifting, Plant Gifting, Personalized Plant Gifts, Employee Gifting, Client Gifting, Festive Plant Gifting, Wedding Plant Gifting, Eco-Friendly Gifts, Custom Gift Hampers.
    
    Blog and Contact as section settings with editable label, URL, show/hide.
    
    DESKTOP: Logo left → centered nav → Search + Account + Wishlist + Cart right. LOGO: image_picker, url, separate desktop/tablet/mobile max-width range settings. HEADER HEIGHTS: separate desktop/tablet/mobile height range 50–140px. Also editable: padding, nav gap, font_picker, font size, weight, colors, logo size, icon size, spacing.
    
    CHEVRON: Thin inline SVG (not ▼). Editable size, color, gap, animation speed. Rotates 180° when open.
    
    DROPDOWNS: Open below parent item (position:absolute on li, not header). Stay in viewport. Cream/white bg, dark green text, shadow, radius. No boxes on items. Desktop: hover+click. Tablet: click. Mobile: accordion. Editable: width, item height, font size, spacing, padding, bg color, text color, shadow, radius. Close on outside click/Escape.
    
    SEARCH: Native Shopify form action="{{ routes.search_url }}" name="q". Placeholder editable. Icon inside field. Enter and icon click search. Editable: width, height, radius, colors.
    
    ICONS: Outline SVG, no boxes. Account: customer account URL. Wishlist: editable link picker. Cart: native cart with live item_count badge. Editable: size, color, hover color, spacing, visibility.
    
    MOBILE ≤767px: Layout: Logo → Search icon → Cart → Hamburger. Sidebar: full-height, Logo, X close, Search, all 5 accordions, Blog, Contact, Account, Wishlist, Cart. No Home. Min 44px touch targets. No horizontal scroll. Lock body scroll. Editable sidebar width/bg/overlay. Close via X, overlay, Escape.
    
    ACCESSIBILITY: Semantic HTML5, aria-label, aria-expanded, aria-controls, keyboard nav, Escape, visible focus.
    
    TECHNICAL: Only Liquid + CSS + vanilla JS + inline SVG. Full OS 2.0 schema with image_picker, url, font_picker, color, range, checkbox, text settings. Schema preset with all 5 blocks pre-populated. COMPLETE file - no placeholders or partial code.
{% enddoc %}
{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}
{% style %}
.sbl-{{ ai_gen_id }}{display:block;width:100%;background:#f8f4ec;color:#0d3a1d}.sbl-{{ ai_gen_id }}__bar{display:flex;align-items:center;justify-content:space-between;min-height:72px;padding:12px 24px}.sbl-{{ ai_gen_id }}__brand{color:inherit;text-decoration:none;font-size:22px}.sbl-{{ ai_gen_id }}__nav{display:flex;gap:24px;list-style:none;padding:0;margin:0}.sbl-{{ ai_gen_id }}__nav li{position:relative}.sbl-{{ ai_gen_id }} button,.sbl-{{ ai_gen_id }} a{color:inherit;font:inherit}.sbl-{{ ai_gen_id }}__trigger{border:0;background:none;min-height:44px;cursor:pointer}.sbl-{{ ai_gen_id }}__menu{display:none;position:absolute;top:100%;left:0;z-index:5;width:250px;padding:12px;background:#fffefa;border-radius:10px;box-shadow:0 8px 24px #14231a24;list-style:none}.sbl-{{ ai_gen_id }} .is-open .sbl-{{ ai_gen_id }}__menu{display:block}.sbl-{{ ai_gen_id }}__menu a{display:flex;min-height:44px;align-items:center;text-decoration:none}.sbl-{{ ai_gen_id }}__search{display:flex;gap:8px}.sbl-{{ ai_gen_id }}__search input{height:40px;border-radius:20px;border:1px solid #c8d0c7;padding:0 12px}.sbl-{{ ai_gen_id }} button:focus-visible,.sbl-{{ ai_gen_id }} a:focus-visible{outline:2px solid #0d3a1d;outline-offset:3px}.sbl-{{ ai_gen_id }}__drawer,.sbl-{{ ai_gen_id }}__overlay{display:none}@media(max-width:767px){.sbl-{{ ai_gen_id }}__nav{display:none}.sbl-{{ ai_gen_id }}__drawer.is-open{display:block;position:fixed;inset:0 auto 0 0;width:min(340px,90vw);height:100dvh;overflow:auto;background:#f8f4ec;z-index:101;padding:18px}.sbl-{{ ai_gen_id }}__overlay.is-open{display:block;position:fixed;inset:0;background:#0008;z-index:100}.sbl-{{ ai_gen_id }}__drawer .sbl-{{ ai_gen_id }}__menu{position:static;width:100%;box-shadow:none}}
{% endstyle %}
<sbl-header-{{ ai_gen_id }} class="sbl-{{ ai_gen_id }}"><header class="sbl-{{ ai_gen_id }}__bar"><a class="sbl-{{ ai_gen_id }}__brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a><nav aria-label="Main navigation"><ul class="sbl-{{ ai_gen_id }}__nav">{% for block in section.blocks %}<li {{ block.shopify_attributes }}><button class="sbl-{{ ai_gen_id }}__trigger" type="button" aria-expanded="false">{{ block.settings.title | escape }}<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor"><path d="m2 4 4 4 4-4"/></svg></button><ul class="sbl-{{ ai_gen_id }}__menu">{% for i in (1..10) %}{% assign label_key = 'item_' | append: i | append: '_label' %}{% assign url_key = 'item_' | append: i | append: '_url' %}{% assign enabled_key = 'item_' | append: i | append: '_enabled' %}{% if block.settings[enabled_key] and block.settings[label_key] != blank %}<li><a href="{{ block.settings[url_key] | default: routes.all_products_collection_url }}">{{ block.settings[label_key] | escape }}</a></li>{% endif %}{% endfor %}</ul></li>{% endfor %}<li><a href="{{ section.settings.blog_url | default: blogs.news.url }}">{{ section.settings.blog_label }}</a></li><li><a href="{{ section.settings.contact_url | default: routes.contact_url }}">{{ section.settings.contact_label }}</a></li></ul></nav><form class="sbl-{{ ai_gen_id }}__search" action="{{ routes.search_url }}" method="get"><input name="q" type="search" placeholder="Search plants"><button type="submit" aria-label="Search">⌕</button></form><a href="{{ routes.account_url }}" aria-label="Account">Account</a><a href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">Cart {{ cart.item_count }}</a></header><div class="sbl-{{ ai_gen_id }}__overlay"></div><aside class="sbl-{{ ai_gen_id }}__drawer" aria-label="Mobile navigation"></aside></sbl-header-{{ ai_gen_id }}>
<script>(()=>{const n='sbl-header-{{ ai_gen_id }}';if(customElements.get(n))return;customElements.define(n,class extends HTMLElement{connectedCallback(){this.querySelectorAll('.sbl-{{ ai_gen_id }}__trigger').forEach(b=>b.addEventListener('click',()=>{const li=b.closest('li'),open=!li.classList.contains('is-open');this.querySelectorAll('li.is-open').forEach(x=>{x.classList.remove('is-open');x.querySelector('button').setAttribute('aria-expanded','false')});if(open){li.classList.add('is-open');b.setAttribute('aria-expanded','true')}}));this.addEventListener('keydown',e=>{if(e.key==='Escape')this.querySelectorAll('li.is-open').forEach(x=>x.classList.remove('is-open'))})}})})();</script>
{% schema %}{"name":"SBL Farms header","settings":[{"type":"text","id":"blog_label","label":"Blog label","default":"Blog"},{"type":"url","id":"blog_url","label":"Blog link"},{"type":"text","id":"contact_label","label":"Contact label","default":"Contact"},{"type":"url","id":"contact_url","label":"Contact link"}],"presets":[{"name":"SBL Farms header"}],"tag":null,"class":"sbl-header"}{% endschema %}