{% doc %}
  @prompt
    Create a full-width edge-to-edge hero slider/banner section that stretches across the entire screen with no margins or padding on the sides. It should include automatic scrolling every 3-5 seconds (configurable). Each slide must have its OWN individual settings for: background image, heading text, subheading/body text, heading font size (editable per slide), body text font size (editable per slide), text colour (editable per slide), a customizable button with label and link, and button colour. Also include navigation dots and arrows. The banner must be fully responsive on mobile and desktop. Poppins font should be used throughout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-slider-{{ ai_gen_id }} {
    --ai-hero-height: {{ block.settings.desktop_height }}px;
    position: relative;
    display: block;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow: hidden;
    font-family: 'Poppins', sans-serif;
    background: {{ block.settings.fallback_color }};
  }

  .ai-hero-slider__track-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: var(--ai-hero-height);
  }

  .ai-hero-slider__slide-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: {{ block.settings.content_position }};
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease;
    background-color: {{ block.settings.fallback_color }};
  }

  .ai-hero-slider__slide-{{ ai_gen_id }}.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .ai-hero-slider__image-{{ ai_gen_id }},
  .ai-hero-slider__placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-slider__placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.fallback_text_color }};
  }

  .ai-hero-slider__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ai-hero-slider__overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,{{ block.settings.overlay_opacity }}) 0%, rgba(0,0,0,0.08) 75%);
  }

  .ai-hero-slider__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    width: min(100% - 48px, 760px);
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-hero-slider__heading-{{ ai_gen_id }} {
    margin: 0 0 14px;
    color: var(--slide-text-color);
    font-size: var(--slide-heading-size);
    line-height: 1.12;
    font-weight: 700;
  }

  .ai-hero-slider__body-{{ ai_gen_id }} {
    margin: 0 0 24px;
    color: var(--slide-text-color);
    font-size: var(--slide-body-size);
    line-height: 1.55;
  }

  .ai-hero-slider__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 26px;
    border-radius: {{ block.settings.button_radius }}px;
    background: var(--slide-button-color);
    color: {{ block.settings.button_text_color }};
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .ai-hero-slider__button-{{ ai_gen_id }}:focus-visible,
  .ai-hero-slider__arrow-{{ ai_gen_id }}:focus-visible,
  .ai-hero-slider__dot-{{ ai_gen_id }}:focus-visible { outline: 3px solid {{ block.settings.focus_color }}; outline-offset: 3px; }

  .ai-hero-slider__arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    z-index: 3;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    color: {{ block.settings.arrow_color }};
    cursor: pointer;
    transform: translateY(-50%);
    font-size: 25px;
    line-height: 1;
  }

  .ai-hero-slider__arrow-{{ ai_gen_id }}--prev { left: 20px; }
  .ai-hero-slider__arrow-{{ ai_gen_id }}--next { right: 20px; }

  .ai-hero-slider__dots-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    bottom: 20px;
    z-index: 3;
    display: flex;
    gap: 8px;
    transform: translateX(-50%);
  }

  .ai-hero-slider__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 2px solid {{ block.settings.dot_color }};
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .ai-hero-slider__dot-{{ ai_gen_id }}.is-active { background: {{ block.settings.dot_color }}; }

  @media screen and (max-width: 749px) {
    .ai-hero-slider-{{ ai_gen_id }} { --ai-hero-height: {{ block.settings.mobile_height }}px; }
    .ai-hero-slider__content-{{ ai_gen_id }} { width: calc(100% - 88px); }
    .ai-hero-slider__heading-{{ ai_gen_id }} { font-size: calc(var(--slide-heading-size) * 0.72); }
    .ai-hero-slider__body-{{ ai_gen_id }} { font-size: calc(var(--slide-body-size) * 0.9); }
    .ai-hero-slider__arrow-{{ ai_gen_id }} { width: 36px; height: 36px; font-size: 20px; }
    .ai-hero-slider__arrow-{{ ai_gen_id }}--prev { left: 12px; }
    .ai-hero-slider__arrow-{{ ai_gen_id }}--next { right: 12px; }
  }
{% endstyle %}

<hero-slider-{{ ai_gen_id }} class="ai-hero-slider-{{ ai_gen_id }}" data-interval="{{ block.settings.autoplay_seconds | times: 1000 }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-slider__track-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign enabled_key = 'slide_' | append: i | append: '_enabled'
        assign image_key = 'slide_' | append: i | append: '_image'
        assign heading_key = 'slide_' | append: i | append: '_heading'
        assign body_key = 'slide_' | append: i | append: '_body'
        assign heading_size_key = 'slide_' | append: i | append: '_heading_size'
        assign body_size_key = 'slide_' | append: i | append: '_body_size'
        assign text_color_key = 'slide_' | append: i | append: '_text_color'
        assign button_label_key = 'slide_' | append: i | append: '_button_label'
        assign button_link_key = 'slide_' | append: i | append: '_button_link'
        assign button_color_key = 'slide_' | append: i | append: '_button_color'
      %}
      {% if block.settings[enabled_key] %}
        <article class="ai-hero-slider__slide-{{ ai_gen_id }}{% if i == 1 %} is-active{% endif %}" data-slide="{{ i }}" style="--slide-heading-size: {{ block.settings[heading_size_key] }}px; --slide-body-size: {{ block.settings[body_size_key] }}px; --slide-text-color: {{ block.settings[text_color_key] }}; --slide-button-color: {{ block.settings[button_color_key] }};">
          {% if block.settings[image_key] %}
            <img class="ai-hero-slider__image-{{ ai_gen_id }}" src="{{ block.settings[image_key] | image_url: width: 2400 }}" alt="{{ block.settings[image_key].alt | escape }}" loading="lazy" width="{{ block.settings[image_key].width }}" height="{{ block.settings[image_key].height }}">
          {% else %}
            <div class="ai-hero-slider__placeholder-{{ ai_gen_id }}">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>
          {% endif %}
          <div class="ai-hero-slider__overlay-{{ ai_gen_id }}"></div>
          <div class="ai-hero-slider__content-{{ ai_gen_id }}">
            {% if block.settings[heading_key] != blank %}<h2 class="ai-hero-slider__heading-{{ ai_gen_id }}">{{ block.settings[heading_key] | escape }}</h2>{% endif %}
            {% if block.settings[body_key] != blank %}<div class="ai-hero-slider__body-{{ ai_gen_id }}">{{ block.settings[body_key] | escape | newline_to_br }}</div>{% endif %}
            {% if block.settings[button_label_key] != blank and block.settings[button_link_key] != blank %}<a class="ai-hero-slider__button-{{ ai_gen_id }}" href="{{ block.settings[button_link_key] }}">{{ block.settings[button_label_key] | escape }}</a>{% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
  <button class="ai-hero-slider__arrow-{{ ai_gen_id }} ai-hero-slider__arrow-{{ ai_gen_id }}--prev" type="button" aria-label="Previous slide">&#8249;</button>
  <button class="ai-hero-slider__arrow-{{ ai_gen_id }} ai-hero-slider__arrow-{{ ai_gen_id }}--next" type="button" aria-label="Next slide">&#8250;</button>
  <div class="ai-hero-slider__dots-{{ ai_gen_id }}" role="tablist" aria-label="Hero slides">
    {% for i in (1..3) %}{% liquid assign enabled_key = 'slide_' | append: i | append: '_enabled' %}{% if block.settings[enabled_key] %}<button class="ai-hero-slider__dot-{{ ai_gen_id }}{% if i == 1 %} is-active{% endif %}" type="button" data-dot="{{ i }}" aria-label="Go to slide {{ i }}" aria-selected="{% if i == 1 %}true{% else %}false{% endif %}"></button>{% endif %}{% endfor %}
  </div>
</hero-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroSlider{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-hero-slider__slide-{{ ai_gen_id }}'));
        this.dots = Array.from(this.querySelectorAll('.ai-hero-slider__dot-{{ ai_gen_id }}'));
        this.index = 0;
        this.timer = null;
        if (this.slides.length < 2) return;
        this.querySelector('.ai-hero-slider__arrow-{{ ai_gen_id }}--prev').addEventListener('click', () => this.go(-1));
        this.querySelector('.ai-hero-slider__arrow-{{ ai_gen_id }}--next').addEventListener('click', () => this.go(1));
        this.dots.forEach((dot, index) => dot.addEventListener('click', () => this.show(index)));
        this.start();
        this.addEventListener('mouseenter', () => this.stop());
        this.addEventListener('mouseleave', () => this.start());
      }
      show(index) {
        this.index = (index + this.slides.length) % this.slides.length;
        this.slides.forEach((slide, i) => slide.classList.toggle('is-active', i === this.index));
        this.dots.forEach((dot, i) => { dot.classList.toggle('is-active', i === this.index); dot.setAttribute('aria-selected', i === this.index ? 'true' : 'false'); });
      }
      go(direction) { this.show(this.index + direction); this.start(); }
      start() { this.stop(); this.timer = setInterval(() => this.go(1), Number(this.dataset.interval)); }
      stop() { if (this.timer) clearInterval(this.timer); }
    }
    customElements.define('hero-slider-{{ ai_gen_id }}', HeroSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Full-width hero slider",
  "tag": null,
  "class": "hero-slider-block",
  "settings": [
    { "type": "header", "content": "Slider settings" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "autoplay_seconds", "label": "Autoplay interval", "min": 3, "max": 5, "step": 1, "unit": "s", "default": 4 },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 300, "max": 800, "step": 50, "unit": "px", "default": 550 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 300, "max": 700, "step": 50, "unit": "px", "default": 500 },
    { "type": "select", "id": "content_position", "label": "Content position", "options": [{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}], "default": "center" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left" },
