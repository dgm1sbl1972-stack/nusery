{% doc %}
  @prompt
    In the Garden categories section (section ID: template--28088459395384__1790157062db4cdf4d), find the heading "Find your plants categories" and make only the word "categories" display in yellow (#ffd60a) colour. Wrap that specific word in a styled span tag with the yellow colour. Keep all other text in the heading the same colour as before. Add a theme editor setting to allow the highlight colour to be customizable., NEED STROKE COLOUR GREEN FOR THE CATERGORIES TEXT
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-garden-category-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-garden-category-heading-{{ ai_gen_id }}__highlight {
    color: {{ block.settings.highlight_color }};
    -webkit-text-stroke: {{ block.settings.stroke_width }}px {{ block.settings.stroke_color }};
    paint-order: stroke fill;
  }

  @media screen and (max-width: 749px) {
    .ai-garden-category-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<div class="ai-garden-category-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2>
    Find your plants <span class="ai-garden-category-heading-{{ ai_gen_id }}__highlight">categories</span>
  </h2>
</div>

{% schema %}
{
  "name": "Garden categories heading",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "sans-serif"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "radio",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#14231a"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight",
      "default": "#ffd60a"
    },
    {
      "type": "color",
      "id": "stroke_color",
      "label": "Stroke",
      "default": "#1f5130"
    },
    {
      "type": "range",
      "id": "stroke_width",
      "label": "Stroke width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    }
  ],
  "presets": [
    {
      "name": "Garden categories heading"
    }
  ],
  "tag": null,
  "class": "garden-categories-heading-block"
}
{% endschema %}