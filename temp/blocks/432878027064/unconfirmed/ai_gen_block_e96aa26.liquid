{% doc %}
  @prompt
    need one edge to edge banner with arrow option like if we click the banner schould be scroll and also make it 3 to 5 sec scroll automatic, and need text and button option also 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
    overflow: hidden;
    background: {{ block.settings.fallback_background }};
  }

  .ai-hero-slider__track-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    transition: transform 0.45s ease;
  }

  .ai-hero-slider__slide-{{ ai_gen_id }} {
    position: relative;
    min-width: 100%;
    min-height: {{ block.settings.banner_height }}px;
    display: flex;
    align-items: {{ block.settings.content_position }};
    justify-content: {{ block.settings.text_alignment }};
    overflow: hidden;
  }

  .ai-hero-slider__image-{{ ai_gen_id }},
  .ai-hero-slider__placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-slider__placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.fallback_background }};
  }

  .ai-hero-slider__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.22;
  }

  .ai-hero-slider__overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .ai-hero-slider__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    width: min(90%, 720px);
    padding: 40px 6%;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-hero-slider__heading-{{ ai_gen_id }} {
    margin: 0 0 12px;
    font-size: clamp(28px, 5vw, {{ block.settings.heading_size }}px);
    line-height: 1.1;
    color: inherit;
  }

  .ai-hero-slider__text-{{ ai_gen_id }} {
    margin: 0 0 22px;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  .ai-hero-slider__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-weight: 700;
    text-decoration: none;
  }

  .ai-hero-slider__button-{{ ai_gen_id }}:focus-visible,
  .ai-hero-slider__arrow-{{ ai_gen_id }}:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-hero-slider__arrow-{{ ai_gen_id }} {
    position: absolute;
    z-index: 2;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
  }

  .ai-hero-slider__arrow-{{ ai_gen_id }}--prev { left: 18px; }
  .ai-hero-slider__arrow-{{ ai_gen_id }}--next { right: 18px; }
  .ai-hero-slider__arrow-{{ ai_gen_id }} svg { width: 22px; height: 22px; }

  .ai-hero-slider__dots-{{ ai_gen_id }} {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
  }

  .ai-hero-slider__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 1px solid {{ block.settings.dot_color }};
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .ai-hero-slider__dot-{{ ai_gen_id }}.is-active { background: {{ block.settings.dot_color }}; }

  @media screen and (max-width: 749px) {
    .ai-hero-slider__slide-{{ ai_gen_id }} { min-height: {{ block.settings.mobile_height }}px; }
    .ai-hero-slider__content-{{ ai_gen_id }} { padding: 32px 12%; }
    .ai-hero-slider__arrow-{{ ai_gen_id }} { width: 36px; height: 36px; }
    .ai-hero-slider__arrow-{{ ai_gen_id }}--prev { left: 10px; }
    .ai-hero-slider__arrow-{{ ai_gen_id }}--next { right: 10px; }
  }
{% endstyle %}

<hero-slider-{{ ai_gen_id }} class="ai-hero-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-slider__track-{{ ai_gen_id }}" data-track>
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'slide_' | append: i | append: '_image'
        assign heading_key = 'slide_' | append: i | append: '_heading'
        assign text_key = 'slide_' | append: i | append: '_text'
        assign button_key = 'slide_' | append: i | append: '_button'
        assign link_key = 'slide_' | append: i | append: '_link'
        assign image = block.settings[image_key]
        assign heading = block.settings[heading_key]
        assign text = block.settings[text_key]
        assign button = block.settings[button_key]
        assign link = block.settings[link_key]
      %}
      <div class="ai-hero-slider__slide-{{ ai_gen_id }}" aria-hidden="{% if i == 1 %}false{% else %}true{% endif %}">
        {% if image != blank %}
          <img class="ai-hero-slider__image-{{ ai_gen_id }}" src="{{ image | image_url: width: 2400 }}" alt="{{ image.alt | escape }}" loading="{% if i == 1 %}eager{% else %}lazy{% endif %}" width="{{ image.width }}" height="{{ image.height }}">
        {% else %}
          <div class="ai-hero-slider__placeholder-{{ ai_gen_id }}">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>
        {% endif %}
        <div class="ai-hero-slider__overlay-{{ ai_gen_id }}"></div>
        <div class="ai-hero-slider__content-{{ ai_gen_id }}">
          {% if heading != blank %}<h2 class="ai-hero-slider__heading-{{ ai_gen_id }}">{{ heading | escape }}</h2>{% endif %}
          {% if text != blank %}<div class="ai-hero-slider__text-{{ ai_gen_id }}">{{ text }}</div>{% endif %}
          {% if button != blank and link != blank %}<a class="ai-hero-slider__button-{{ ai_gen_id }}" href="{{ link }}">{{ button | escape }}</a>{% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  <button class="ai-hero-slider__arrow-{{ ai_gen_id }} ai-hero-slider__arrow-{{ ai_gen_id }}--prev" type="button" aria-label="Previous slide" data-prev><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button>
  <button class="ai-hero-slider__arrow-{{ ai_gen_id }} ai-hero-slider__arrow-{{ ai_gen_id }}--next" type="button" aria-label="Next slide" data-next><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button>
  <div class="ai-hero-slider__dots-{{ ai_gen_id }}" role="tablist" aria-label="Banner slides">
    {% for i in (1..3) %}<button class="ai-hero-slider__dot-{{ ai_gen_id }}{% if i == 1 %} is-active{% endif %}" type="button" role="tab" aria-label="Go to slide {{ i }}" aria-selected="{% if i == 1 %}true{% else %}false{% endif %}" data-slide="{{ i | minus: 1 }}"></button>{% endfor %}
  </div>
</hero-slider-{{ ai_gen_id }}>

<script>
(function() {
  class HeroSlider{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-track]');
      this.slides = this.querySelectorAll('.ai-hero-slider__slide-{{ ai_gen_id }}');
      this.dots = this.querySelectorAll('[data-slide]');
      this.index = 0;
      this.timer = null;
      this.querySelector('[data-prev]').addEventListener('click', () => this.goTo(this.index - 1));
      this.querySelector('[data-next]').addEventListener('click', () => this.goTo(this.index + 1));
      this.dots.forEach(dot => dot.addEventListener('click', () => this.goTo(Number(dot.dataset.slide))));
      this.start();
      this.addEventListener('mouseenter', () => this.stop());
      this.addEventListener('mouseleave', () => this.start());
      this.addEventListener('focusin', () => this.stop());
      this.addEventListener('focusout', () => this.start());
    }
    goTo(index) {
      this.index = (index + this.slides.length) % this.slides.length;
      this.track.style.transform = 'translateX(-' + (this.index * 100) + '%)';
      this.slides.forEach((slide, i) => slide.setAttribute('aria-hidden', i === this.index ? 'false' : 'true'));
      this.dots.forEach((dot, i) => { dot.classList.toggle('is-active', i === this.index); dot.setAttribute('aria-selected', i === this.index ? 'true' : 'false'); });
    }
    start() { this.stop(); this.timer = setInterval(() => this.goTo(this.index + 1), {{ block.settings.autoplay_seconds | times: 1000 }}); }
    stop() { if (this.timer) clearInterval(this.timer); }
  }
  customElements.define('hero-slider-{{ ai_gen_id }}', HeroSlider{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Edge-to-edge hero slider",
  "tag": null,
  "class": "edge-to-edge-hero-slider",
  "settings": [
    { "type": "header", "content": "Slider" },
    { "type": "range", "id": "autoplay_seconds", "label": "Autoplay interval", "min": 3, "max": 5, "step": 1, "unit": "s", "default": 4 },
    { "type": "range", "id": "banner_height", "label": "Banner height", "min": 300, "max": 800, "step": 50, "unit": "px", "default": 550 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 240, "max": 600, "step": 30, "unit": "px", "default": 420 },
    { "type": "select", "id": "content_position", "label": "Content position", "options": [{ "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Middle" }, { "value": "flex-end", "label": "Bottom" }], "default": "center" },
    { "type": "radio", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "header", "content": "Slide 1" },
    { "type": "image_picker", "id": "slide_1_image", "label": "Image" },
    { "type": "text", "id": "slide_1_heading", "label": "Heading", "default": "Bring your garden to life" },
    { "type": "textarea", "id": "slide_1_text", "label": "Text", "default": "Discover beautiful plants and everything you need to grow." },
    { "type": "text", "id": "slide_1_button", "label": "Button", "default": "Shop plants" },
    { "type": "url", "id": "slide_1_link", "label": "Button link" },
    { "type": "header", "content": "Slide 2" },
    { "type": "image_picker", "id": "slide_2_image", "label": "Image" },
    { "type": "text", "id": "slide_2_heading", "label": "Heading", "default": "Create a greener home" },
    { "type": "textarea", "id": "slide_2_text", "label": "Text", "default": "Fresh ideas and healthy plants for every space." },
    { "type": "text", "id": "slide_2_button", "label": "Button", "default": "Explore now" },
    { "type": "url", "id": "slide_2_link", "label": "Button link" },
    { "type": "header", "content": "Slide 3" },
    { "type": "image_picker", "id": "slide_3_image", "label": "Image" },
    { "type": "text", "id": "slide_3_heading", "label": "Heading", "default": "Grow something wonderful" },
    { "type": "textarea", "id": "slide_3_text", "label": "Text", "default": "Find simple ways to make your garden thrive." },
    { "type": "text", "id": "slide_3_button", "label": "Button", "default": "Get started" },
    { "type": "url", "id": "slide_3_link", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "fallback_background", "label": "Fallback background", "default": "#1f5130" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#0d3a1d" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "button_background", "label": "Button", "default": "#ffd60a" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#14231a" },
    { "type": "color", "id": "arrow_background", "label": "Arrow background", "default": "#ffffff" },
    { "type": "color", "id": "arrow_color", "label": "Arrow", "default": "#14231a" },
    { "type": "color", "id": "dot_color", "label": "Pagination dots", "default": "#ffffff" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#ffd60a" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Edge-to-edge hero slider" }]
}
{% endschema %}