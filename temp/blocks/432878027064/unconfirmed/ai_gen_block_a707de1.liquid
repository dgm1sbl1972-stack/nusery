{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-pc-{{ai_gen_id}}{display:block;width:100%;max-width:{{block.settings.content_width}}px;margin:0 auto;padding:{{block.settings.section_padding}}px {{block.settings.side_padding}}px;background:{{block.settings.background_color}};box-sizing:border-box}.ai-pc-{{ai_gen_id}}__in{width:100%}.ai-pc-{{ai_gen_id}} h2{text-align:{{block.settings.heading_alignment}};color:{{block.settings.text_color}};font-size:{{block.settings.heading_size}}px;margin:0 0 28px}.ai-pc-{{ai_gen_id}}__grid{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:{{block.settings.category_gap}}px}.ai-pc-{{ai_gen_id}} a{text-align:center;text-decoration:none;color:{{block.settings.text_color}};cursor:pointer;perspective:900px;min-width:0}.ai-pc-{{ai_gen_id}}__visual{aspect-ratio:.86;display:flex;align-items:center;justify-content:center;overflow:hidden;background:{{block.settings.card_color}};border:1px solid transparent;border-radius:58% 42% 46% 54%/48% 54% 46% 52%;box-shadow:0 8px 20px #1f513014;transform:rotateX(var(--x,0deg)) rotateY(var(--y,0deg));transform-style:preserve-3d;transition:all .35s ease}.ai-pc-{{ai_gen_id}} a:hover .ai-pc-{{ai_gen_id}}__visual,.ai-pc-{{ai_gen_id}} a:focus-visible .ai-pc-{{ai_gen_id}}__visual,.ai-pc-{{ai_gen_id}} a.active .ai-pc-{{ai_gen_id}}__visual{transform:rotateX(var(--x,0deg)) rotateY(var(--y,0deg)) scale(1.08) translateZ(16px);border-color:{{block.settings.accent_color}};box-shadow:0 16px 28px #1f513033,0 0 0 5px #1f513014}.ai-pc-{{ai_gen_id}} img,.ai-pc-{{ai_gen_id}}__visual>span{width:82%;height:82%;object-fit:contain;transform:translateZ(28px);transition:all .35s ease}.ai-pc-{{ai_gen_id}} a:hover img,.ai-pc-{{ai_gen_id}} a:hover .ai-pc-{{ai_gen_id}}__visual>span{transform:translateZ(52px) scale(1.04);filter:drop-shadow(8px 12px 8px #14321b38)}.ai-pc-{{ai_gen_id}}__label{display:block;margin-top:14px;font-size:{{block.settings.label_size}}px;font-weight:500;transition:all .2