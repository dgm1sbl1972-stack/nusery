{% doc %}
  @prompt
    I NEED ONE HEADER SECTION WHERE LOGO SHOULD COME IN THE CENTER AND LEFT SIDE NEED 4 LIKE HOME,PLANTS,POTS,SEEDS,BLOGAND AFTER LOGO RIGHT SIDE CONATCT CART PROILE,SEARCH BAR,WISHLIST, NEED OPTION FOR LOGO SIZE INCREASE ALSO
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-header-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};border-bottom:1px solid {{ block.settings.border_color }};margin:0 auto}.ai-header-{{ ai_gen_id }}__inner{width:min(100%,{{ block.settings.content_max_width }}px);min-height:{{ block.settings.header_height }}px;margin:auto;padding:12px 24px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px}.ai-header-{{ ai_gen_id }}__nav,.ai-header-{{ ai_gen_id }}__actions{display:flex;align-items:center;gap:{{ block.settings.item_gap }}px;flex-wrap:wrap}.ai-header-{{ ai_gen_id }}__actions{justify-content:flex-end}.ai-header-{{ ai_gen_id }}__link,.ai-header-{{ ai_gen_id }}__action{color:{{ block.settings.text_color }};text-decoration:none;font-size:{{ block.settings.text_size }}px;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}.ai-header-{{ ai_gen_id }}__link:hover,.ai-header-{{ ai_gen_id }}__action:hover{color:{{ block.settings.accent_color }}}.ai-header-{{ ai_gen_id }}__logo{display:inline-flex;align-items:center;justify-content:center;color:{{ block.settings.logo_text_color }};text-decoration:none;font-size:{{ block.settings.logo_size }}px;font-weight:700}.ai-header-{{ ai_gen_id }}__logo img{display:block;width:auto;max-width:{{ block.settings.logo_width }}px;max-height:{{ block.settings.logo_height }}px;object-fit:contain}.ai-header-{{ ai_gen_id }}__logo-placeholder{width:{{ block.settings.logo_width }}px;min-height:48px;display:flex;align-items:center;justify-content:center;padding:6px;background:{{ block.settings.placeholder_color }};border-radius:8px}.ai-header-{{ ai_gen_id }}__logo-placeholder svg{width:100%;height:{{ block.settings.logo_height }}px}.ai-header-{{ ai_gen_id }}__search{display:inline-flex;align-items:center;border:1px solid {{ block.settings.border_color }};border-radius:999px;padding:7px 10px;background:{{ block.settings.search_background }}}.ai-header-{{ ai_gen_id }}__search input{width:{{ block.settings.search_width }}px;border:0;outline:0;background:transparent;color:{{ block.settings.text_color }};font:inherit}.ai-header-{{ ai_gen_id }}__search button{border:0;background:transparent;color:{{ block.settings.text_color }};cursor:pointer}.ai-header-{{ ai_gen_id }}__icon{width:18px;height:18px;vertical-align:middle}@media(max-width:1100px){.ai-header-{{ ai_gen_id }}__inner{grid-template-columns:1fr auto}.ai-header-{{ ai_gen_id }}__nav{grid-column:1/-1;grid-row:2;justify-content:center}.ai-header-{{ ai_gen_id }}__logo{justify-content:flex-start}.ai-header-{{ ai_gen_id }}__actions{grid-column:2;grid-row:1}}@media(max-width:749px){.ai-header-{{ ai_gen_id }}__inner{padding:10px 16px}.ai-header-{{ ai_gen_id }}__action span,.ai-header-{{ ai_gen_id }}__search input{display:none}.ai-header-{{ ai_gen_id }}__nav{gap:14px;overflow:auto;flex-wrap:nowrap;justify-content:flex-start}.ai-header-{{ ai_gen_id }}__link{font-size:13px}.ai-header-{{ ai_gen_id }}__search{padding:8px}}
{% endstyle %}
<header class="ai-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-header-{{ ai_gen_id }}__inner"><nav class="ai-header-{{ ai_gen_id }}__nav" aria-label="Main navigation"><a class="ai-header-{{ ai_gen_id }}__link" href="{{ block.settings.home_link | default: routes.root_url }}">Home</a><a class="ai-header-{{ ai_gen_id }}__link" href="{{ block.settings.plants_link | default: routes.all_products_collection_url }}">Plants</a><a class="ai-header-{{ ai_gen_id }}__link" href="{{ block.settings.pots_link | default: routes.all_products_collection_url }}">Pots</a><a class="ai-header-{{ ai_gen_id }}__link" href="{{ block.settings.seeds_link | default: routes.all_products_collection_url }}">Seeds</a><a class="ai-header-{{ ai_gen_id }}__link" href="{{ block.settings.blog_link | default: routes.blogs_url }}">Blog</a></nav><a class="ai-header-{{ ai_gen_id }}__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{% if block.settings.logo %}<img src="{{ block.settings.logo | image_url: width: 800 }}" alt="{{ block.settings.logo.alt | default: shop.name | escape }}" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}">{% else %}<span class="ai-header-{{ ai_gen_id }}__logo-placeholder">{{ 'image' | placeholder_svg_tag }}</span>{% endif %}</a><div class="ai-header-{{ ai_gen_id }}__actions"><a class="ai-header-{{ ai_gen_id }}__action" href="{{ block.settings.contact_link | default: routes.contact_url }}"><span>Contact</span></a><a class="ai-header-{{ ai_gen_id }}__action" href="{{ routes.account_url }}" aria-label="Profile">♙<span>Profile</span></a><a class="ai-header-{{ ai_gen_id }}__action" href="{{ routes.cart_url }}" aria-label="Cart">🛒<span>Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</span></a><form class="ai-header-{{ ai_gen_id }}__search" action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" placeholder="Search" aria-label="Search"><button type="submit" aria-label="Submit search">⌕</button></form><a class="ai-header-{{ ai_gen_id }}__action" href="{{ block.settings.wishlist_link | default: routes.root_url }}" aria-label="Wishlist">♡<span>Wishlist</span></a></div></div></header>
{% schema %}{"name":"Navigation header","settings":[{"type":"header","content":"Brand"},{"type":"image_picker","id":"logo","label":"Logo"},{"type":"range","id":"logo_width","label":"Logo width","min":80,"max":500,"step":10,"unit":"px","default":180},{"type":"range","id":"logo_height","label":"Logo height","min":40,"max":160,"step":10,"unit":"px","default":80},{"type":"range","id":"logo_size","label":"Logo text size","min":16,"max":36,"step":2,"unit":"px","default":24},{"type":"url","id":"home_link","label":"Home link"},{"type":"header","content":"Navigation links"},{"type":"url","id":"plants_link","label":"Plants link"},{"type":"url","id":"pots_link","label":"Pots link"},{"type":"url","id":"seeds_link","label":"Seeds link"},{"type":"url","id":"blog_link","label":"Blog link"},{"type":"url","id":"contact_link","label":"Contact link"},{"type":"url","id":"wishlist_link","label":"Wishlist link"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"content_max_width","label":"Content width","min":900,"max":1600,"step":50,"unit":"px","default":1200},{"type":"range","id":"header_height","label":"Header height","min":60,"max":140,"step":10,"unit":"px","default":90},{"type":"range","id":"item_gap","label":"Item spacing","min":6,"max":30,"step":2,"unit":"px","default":14},{"type":"range","id":"text_size","label":"Text size","min":12,"max":20,"step":1,"unit":"px","default":14},{"type":"range","id":"search_width","label":"Search width","min":100,"max":240,"step":10,"unit":"px","default":150},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},{"type":"color","id":"text_color","label":"Text","default":"#14231a"},{"type":"color","id":"logo_text_color","label":"Logo text","default":"#1f5130"},{"type":"color","id":"accent_color","label":"Accent","default":"#0d3a1d"},{"type":"color","id":"border_color","label":"Border","default":"#c8d0c8"},{"type":"color","id":"search_background","label":"Search background","default":"#ffffff"},{"type":"color","id":"placeholder_color","label":"Logo placeholder","default":"#e8eee5"}],"presets":[{"name":"Navigation header"}],"tag":null,"class":"navigation-header"}{% endschema %}