{% doc %}
  @prompt
    view more products section 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-view-more-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-view-more-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 20px;
    text-align: {{ block.settings.alignment }};
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-view-more-{{ ai_gen_id }}__heading {
    margin: 0 0 10px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-view-more-{{ ai_gen_id }}__copy {
    margin: 0 auto 22px;
    max-width: 560px;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.5;
  }

  .ai-view-more-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 24px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: 2px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-view-more-{{ ai_gen_id }}__link:hover {
    background: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
  }

  .ai-view-more-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-view-more-{{ ai_gen_id }}__icon {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  @media screen and (max-width: 749px) {
    .ai-view-more-{{ ai_gen_id }}__inner {
      width: 100%;
      padding: {{ block.settings.vertical_padding | times: 0.75 | round }}px 16px;
    }

    .ai-view-more-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | times: 0.85 | round }}px;
    }
  }
{% endstyle %}

<div class="ai-view-more-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-view-more-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-view-more-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    {% if block.settings.description != blank %}
      <p class="ai-view-more-{{ ai_gen_id }}__copy">{{ block.settings.description | escape }}</p>
    {% endif %}
    {% if block.settings.link != blank %}
      <a class="ai-view-more-{{ ai_gen_id }}__link" href="{{ block.settings.link }}">
        <span>{{ block.settings.button_label | escape }}</span>
        <svg class="ai-view-more-{{ ai_gen_id }}__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path d="M3.5 10h12m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "View more products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your next favourite plant" },
    { "type": "text", "id": "description", "label": "Description", "default": "Explore our full collection of plants, seeds and garden essentials." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all products" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical spacing", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 25 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "corner_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f8f4ec" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14231a" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#1f5130" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover", "default": "#0d3a1d" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#ffd60a" }
  ],
  "presets": [{ "name": "View more products" }],
  "tag": null,
  "class": "view-more-products-block"
}
{% endschema %}