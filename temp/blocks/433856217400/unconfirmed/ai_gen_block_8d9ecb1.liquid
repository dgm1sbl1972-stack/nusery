{% doc %}
  @prompt
    need an banner image to upload, no text only image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-only-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    background: {{ block.settings.background_color }};
  }

  .ai-image-only-banner-{{ ai_gen_id }}__media {
    display: block;
    width: 100%;
    height: {{ block.settings.banner_height }}px;
    overflow: hidden;
  }

  .ai-image-only-banner-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    object-position: center;
  }

  .ai-image-only-banner-{{ ai_gen_id }}__placeholder {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    background: {{ block.settings.background_color }};
  }

  .ai-image-only-banner-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: #e7e2d7;
  }

  .ai-image-only-banner-{{ ai_gen_id }}__empty {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    padding: 10px 14px;
    border-radius: 8px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: center;
    font-size: 14px;
  }

  .ai-image-only-banner-{{ ai_gen_id }}__link {
    display: block;
  }

  .ai-image-only-banner-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid {{ block.settings.text_color }};
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-image-only-banner-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-image-only-banner-{{ ai_gen_id }}__media {
      height: {{ block.settings.mobile_height }}px;
    }
  }
{% endstyle %}

<div class="ai-image-only-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.banner_link != blank %}<a class="ai-image-only-banner-{{ ai_gen_id }}__link" href="{{ block.settings.banner_link }}" aria-label="{{ block.settings.banner_image.alt | default: 'Open banner link' | escape }}">{% endif %}
    <div class="ai-image-only-banner-{{ ai_gen_id }}__media">
      {% if block.settings.banner_image != blank %}
        <img class="ai-image-only-banner-{{ ai_gen_id }}__image" src="{{ block.settings.banner_image | image_url: width: 2400 }}" alt="{{ block.settings.banner_image.alt | escape }}" loading="lazy" width="{{ block.settings.banner_image.width }}" height="{{ block.settings.banner_image.height }}">
      {% else %}
        <div class="ai-image-only-banner-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-only-banner-{{ ai_gen_id }}__empty">Upload a banner image in the block settings.</div>
        </div>
      {% endif %}
    </div>
  {% if block.settings.banner_link != blank %}</a>{% endif %}
</div>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "banner_height", "label": "Desktop height", "min": 200, "max": 700, "step": 25, "unit": "px", "default": 400 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 180, "max": 500, "step": 20, "unit": "px", "default": 280 },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [{ "value": "cover", "label": "Fill banner" }, { "value": "contain", "label": "Show full image" }], "default": "cover" },
    { "type": "url", "id": "banner_link", "label": "Optional image link" },
    { "type": "color", "id": "background_color", "label": "Placeholder background", "default": "#F8F4EC" },
    { "type": "color", "id": "text_color", "label": "Placeholder text", "default": "#1F5130" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "Image banner" }],
  "tag": null,
  "class": "image-banner-block"
}
{% endschema %}