{% doc %}
  @prompt
    view more products section , like related products showcase plants collection
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-related-plants-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-related-plants-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 32px 20px;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-related-plants-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 22px;
  }

  .ai-related-plants-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-related-plants-{{ ai_gen_id }}__intro {
    margin: 8px 0 0;
    color: {{ block.settings.muted_color }};
    font-size: 15px;
    line-height: 1.5;
  }

  .ai-related-plants-{{ ai_gen_id }}__all-link {
    flex: 0 0 auto;
    color: {{ block.settings.text_color }};
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ai-related-plants-{{ ai_gen_id }}__all-link:focus-visible,
  .ai-related-plants-{{ ai_gen_id }}__card-link:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
    border-radius: 3px;
  }

  .ai-related-plants-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 18px;
  }

  .ai-related-plants-{{ ai_gen_id }}__card {
    min-width: 0;
    overflow: hidden;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
  }

  .ai-related-plants-{{ ai_gen_id }}__card-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .ai-related-plants-{{ ai_gen_id }}__image-wrap {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: {{ block.settings.image_background }};
  }

  .ai-related-plants-{{ ai_gen_id }}__image-wrap img,
  .ai-related-plants-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-related-plants-{{ ai_gen_id }}__image-wrap svg {
    background: {{ block.settings.image_background }};
  }

  .ai-related-plants-{{ ai_gen_id }}__details {
    padding: 15px;
  }

  .ai-related-plants-{{ ai_gen_id }}__product-title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.4;
    font-weight: 600;
  }

  .ai-related-plants-{{ ai_gen_id }}__price {
    margin-top: 7px;
    color: {{ block.settings.text_color }};
    font-size: 15px;
  }

  .ai-related-plants-{{ ai_gen_id }}__empty {
    padding: 22px;
    border: 1px dashed {{ block.settings.muted_color }};
    border-radius: {{ block.settings.card_radius }}px;
    color: {{ block.settings.muted_color }};
    text-align: center;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-related-plants-{{ ai_gen_id }}__inner {
      width: 100%;
      padding: 24px 16px;
    }

    .ai-related-plants-{{ ai_gen_id }}__header {
      align-items: flex-start;
      flex-direction: column;
      margin-bottom: 16px;
    }

    .ai-related-plants-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.heading_size | times: 0.8 | round }}px;
    }

    .ai-related-plants-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 12px;
    }

    .ai-related-plants-{{ ai_gen_id }}__details {
      padding: 11px;
    }

    .ai-related-plants-{{ ai_gen_id }}__product-title,
    .ai-related-plants-{{ ai_gen_id }}__price {
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-related-plants-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-related-plants-{{ ai_gen_id }}__inner">
    <div class="ai-related-plants-{{ ai_gen_id }}__header">
      <div>
        {% if block.settings.heading != blank %}
          <h2 class="ai-related-plants-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <p class="ai-related-plants-{{ ai_gen_id }}__intro">{{ block.settings.description | escape }}</p>
        {% endif %}
      </div>
      {% if block.settings.collection != blank %}
        <a class="ai-related-plants-{{ ai_gen_id }}__all-link" href="{{ block.settings.collection.url }}">{{ block.settings.link_label | escape }}</a>
      {% endif %}
    </div>

    {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
      <div class="ai-related-plants-{{ ai_gen_id }}__grid">
        {% for product in block.settings.collection.products limit: block.settings.product_limit %}
          <article class="ai-related-plants-{{ ai_gen_id }}__card">
            <a class="ai-related-plants-{{ ai_gen_id }}__card-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              <span class="ai-related-plants-{{ ai_gen_id }}__image-wrap">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
                {% else %}
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                {% endif %}
              </span>
              <span class="ai-related-plants-{{ ai_gen_id }}__details">
                <span class="ai-related-plants-{{ ai_gen_id }}__product-title">{{ product.title | escape }}</span>
                {% if block.settings.show_price %}
                  <span class="ai-related-plants-{{ ai_gen_id }}__price">{{ product.price | money }}</span>
                {% endif %}
              </span>
            </a>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-related-plants-{{ ai_gen_id }}__empty">Choose a plant collection in the block settings to show related products here.</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Related plants",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Plant collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "text", "id": "description", "label": "Description", "default": "Discover more plants to bring a little green home." },
    { "type": "text", "id": "link_label", "label": "Collection link label", "default": "View collection" },
    { "type": "checkbox", "id": "show_price", "label": "Show prices", "default": true },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 44, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "corner_radius", "label": "Section corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "Product corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#f8f4ec" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#f4f7dc" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14231a" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5b6660" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#ffd60a" }
  ],
  "presets": [{ "name": "Related plants" }],
  "tag": null,
  "class": "related-plants-block"
}
{% endschema %}