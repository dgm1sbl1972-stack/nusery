{% doc %}
  @prompt
    view more products section , like related products showcase plants collection, give plant collection card with view product option add to cart option bestseller tag discount tag, give view all collection option  and that add to cart option give at the right side of the card
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-plant-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-plant-collection-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 30px 20px;
    background: {{ block.settings.section_background }};
    border-radius: {{ block.settings.section_radius }}px;
  }

  .ai-plant-collection-{{ ai_gen_id }}__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }

  .ai-plant-collection-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-plant-collection-{{ ai_gen_id }}__view-all {
    flex: 0 0 auto;
    color: {{ block.settings.secondary_text }};
    font-size: 14px;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-plant-collection-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 18px;
  }

  .ai-plant-collection-{{ ai_gen_id }}__card {
    min-width: 0;
    overflow: hidden;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-plant-collection-{{ ai_gen_id }}__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: {{ block.settings.image_background }};
  }

  .ai-plant-collection-{{ ai_gen_id }}__media img,
  .ai-plant-collection-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-plant-collection-{{ ai_gen_id }}__media svg {
    background: {{ block.settings.image_background }};
  }

  .ai-plant-collection-{{ ai_gen_id }}__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    z-index: 1;
  }

  .ai-plant-collection-{{ ai_gen_id }}__badge {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 999px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text }};
    font-size: 12px;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-plant-collection-{{ ai_gen_id }}__badge--discount {
    background: {{ block.settings.discount_background }};
    color: {{ block.settings.discount_text }};
  }

  .ai-plant-collection-{{ ai_gen_id }}__body {
    padding: 15px;
  }

  .ai-plant-collection-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.4;
    font-weight: 650;
  }

  .ai-plant-collection-{{ ai_gen_id }}__title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-plant-collection-{{ ai_gen_id }}__prices {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 7px;
    color: {{ block.settings.text_color }};
    font-size: 15px;
  }

  .ai-plant-collection-{{ ai_gen_id }}__compare {
    color: {{ block.settings.muted_color }};
    text-decoration: line-through;
  }

  .ai-plant-collection-{{ ai_gen_id }}__actions {
    display: flex;
    align-items: stretch;
    gap: 9px;
    margin-top: 14px;
  }

  .ai-plant-collection-{{ ai_gen_id }}__button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: 9px 12px;
    border: 1px solid {{ block.settings.button_background }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text }};
    font: inherit;
    font-size: 14px;
    font-weight: 650;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .ai-plant-collection-{{ ai_gen_id }}__button--secondary {
    background: transparent;
    color: {{ block.settings.secondary_text }};
    border-color: {{ block.settings.secondary_border }};
  }

  .ai-plant-collection-{{ ai_gen_id }}__actions > a {
    flex: 1 1 auto;
  }

  .ai-plant-collection-{{ ai_gen_id }}__actions form {
    flex: 0 0 auto;
    margin: 0;
  }

  .ai-plant-collection-{{ ai_gen_id }}__actions form .ai-plant-collection-{{ ai_gen_id }}__button {
    min-width: 46px;
    padding-left: 13px;
    padding-right: 13px;
  }

  .ai-plant-collection-{{ ai_gen_id }}__button[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .ai-plant-collection-{{ ai_gen_id }}__button:focus-visible,
  .ai-plant-collection-{{ ai_gen_id }}__view-all:focus-visible,
  .ai-plant-collection-{{ ai_gen_id }}__title a:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-plant-collection-{{ ai_gen_id }}__empty {
    padding: 22px;
    color: {{ block.settings.muted_color }};
    border: 1px dashed {{ block.settings.muted_color }};
    border-radius: {{ block.settings.card_radius }}px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-plant-collection-{{ ai_gen_id }}__inner {
      width: 100%;
      padding: 24px 16px;
    }

    .ai-plant-collection-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 12px;
    }

    .ai-plant-collection-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | times: 0.8 | round }}px;
    }

    .ai-plant-collection-{{ ai_gen_id }}__body {
      padding: 11px;
    }

    .ai-plant-collection-{{ ai_gen_id }}__actions {
      gap: 6px;
    }

    .ai-plant-collection-{{ ai_gen_id }}__button {
      padding: 8px 9px;
      font-size: 12px;
    }
  }
{% endstyle %}

<div class="ai-plant-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-plant-collection-{{ ai_gen_id }}__inner">
    <div class="ai-plant-collection-{{ ai_gen_id }}__header">
      {% if block.settings.heading != blank %}<h2 class="ai-plant-collection-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.show_view_all and block.settings.collection != blank %}
        <a class="ai-plant-collection-{{ ai_gen_id }}__view-all" href="{{ block.settings.collection.url }}">{{ block.settings.view_all_label | escape }}</a>
      {% endif %}
    </div>
    {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
      <div class="ai-plant-collection-{{ ai_gen_id }}__grid">
        {% for product in block.settings.collection.products limit: block.settings.product_limit %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          <article class="ai-plant-collection-{{ ai_gen_id }}__card">
            <div class="ai-plant-collection-{{ ai_gen_id }}__media">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
              <div class="ai-plant-collection-{{ ai_gen_id }}__badges">
                {% if block.settings.show_bestseller and product.tags contains block.settings.bestseller_tag %}<span class="ai-plant-collection-{{ ai_gen_id }}__badge">{{ block.settings.bestseller_label | escape }}</span>{% endif %}
                {% if block.settings.show_discount and product.compare_at_price_max > product.price %}
                  {% assign discount_amount = product.compare_at_price_max | minus: product.price %}
                  {% assign discount_percent = discount_amount | times: 100 | divided_by: product.compare_at_price_max %}
                  <span class="ai-plant-collection-{{ ai_gen_id }}__badge ai-plant-collection-{{ ai_gen_id }}__badge--discount">{{ discount_percent }}% {{ block.settings.discount_label | escape }}</span>
                {% endif %}
              </div>
            </div>
            <div class="ai-plant-collection-{{ ai_gen_id }}__body">
              <h3 class="ai-plant-collection-{{ ai_gen_id }}__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              {% if block.settings.show_price %}
                <div class="ai-plant-collection-{{ ai_gen_id }}__prices">
                  <span>{{ product.price | money }}</span>
                  {% if product.compare_at_price_max > product.price %}<span class="ai-plant-collection-{{ ai_gen_id }}__compare">{{ product.compare_at_price_max | money }}</span>{% endif %}
                </div>
              {% endif %}
              <div class="ai-plant-collection-{{ ai_gen_id }}__actions">
                <a class="ai-plant-collection-{{ ai_gen_id }}__button ai-plant-collection-{{ ai_gen_id }}__button--secondary" href="{{ product.url }}">{{ block.settings.view_label | escape }}</a>
                {% if current_variant != blank and current_variant.available %}
                  <form method="post" action="{{ routes.cart_add_url }}">
                    <input type="hidden" name="id" value="{{ current_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
                    <button class="ai-plant-collection-{{ ai_gen_id }}__button" type="submit" aria-label="{{ block.settings.add_label | escape }} — {{ product.title | escape }}">{{ block.settings.add_label | escape }}</button>
                  </form>
                {% else %}
                  <button class="ai-plant-collection-{{ ai_gen_id }}__button" type="button" disabled>{{ block.settings.sold_out_label | escape }}</button>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-plant-collection-{{ ai_gen_id }}__empty">Select a plant collection in the block settings to display products.</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Plant collection cards",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Plant collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore our plants" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "checkbox", "id": "show_price", "label": "Show prices", "default": true },
    { "type": "text", "id": "view_label", "label": "View product label", "default": "View product" },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all collection", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all plants" },
    { "type": "checkbox", "id": "show_bestseller", "label": "Show bestseller tag", "default": true },
    { "type": "text", "id": "bestseller_tag", "label": "Bestseller product tag", "default": "bestseller" },
    { "type": "text", "id": "bestseller_label", "label": "Bestseller badge text", "default": "Bestseller" },
    { "type": "checkbox", "id": "show_discount", "label": "Show discount tag", "default": true },
    { "type": "text", "id": "discount_label", "label": "Discount badge suffix", "default": "off" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 44, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "section_radius", "label": "Section corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#f8f4ec" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#f4f7dc" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0d3a1d" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5b6660" },
    { "type": "color", "id": "border_color", "label": "Card border", "default": "#dce3d4" },
    { "type": "color", "id": "badge_background", "label": "Bestseller badge background", "default": "#1f5130" },
    { "type": "color", "id": "badge_text", "label": "Bestseller badge text", "default": "#ffffff" },
    { "type": "color", "id": "discount_background", "label": "Discount badge background", "default": "#0d3a1d" },
    { "type": "color", "id": "discount_text", "label": "Discount badge text", "default": "#ffffff" },
    { "type": "color", "id": "button_background", "label": "Add button background", "default": "#1f5130" },
    { "type": "color", "id": "button_text", "label": "Add button text", "default": "#ffffff" },
    { "type": "color", "id": "secondary_text", "label": "View button text", "default": "#1f5130" },
    { "type": "color", "id": "secondary_border", "label": "View button border", "default": "#1f5130" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#ffd60a" }
  ],
  "presets": [{ "name": "Plant collection cards" }],
  "tag": null,
  "class": "plant-collection-cards"
}
{% endschema %}