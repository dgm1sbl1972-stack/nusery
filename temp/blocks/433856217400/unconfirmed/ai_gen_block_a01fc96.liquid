{% doc %}
  @prompt
    need an banner image to upload
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    background: {{ block.settings.background_color }};
  }

  .ai-image-banner-{{ ai_gen_id }}__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-image-banner-{{ ai_gen_id }}__media {
    position: relative;
    width: 100%;
    height: {{ block.settings.banner_height }}px;
    overflow: hidden;
  }

  .ai-image-banner-{{ ai_gen_id }}__image,
  .ai-image-banner-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-image-banner-{{ ai_gen_id }}__image {
    object-fit: {{ block.settings.image_fit }};
    object-position: center;
  }

  .ai-image-banner-{{ ai_gen_id }}__placeholder {
    position: relative;
    background: {{ block.settings.background_color }};
  }

  .ai-image-banner-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: #e7e2d7;
  }

  .ai-image-banner-{{ ai_gen_id }}__empty {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: 10px 14px;
    text-align: center;
    font-size: 14px;
    border-radius: 8px;
  }

  .ai-image-banner-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_position }};
    align-items: {{ block.settings.text_alignment }};
    padding: clamp(20px, 5vw, 64px);
    text-align: {{ block.settings.text_alignment }};
    background: linear-gradient(90deg, rgba(13, 58, 29, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 0%, rgba(13, 58, 29, 0) 100%);
    color: {{ block.settings.text_color }};
  }

  .ai-image-banner-{{ ai_gen_id }}__heading {
    max-width: 700px;
    margin: 0 0 10px;
    color: inherit;
    font-size: clamp(26px, 4vw, {{ block.settings.heading_size }}px);
    line-height: 1.15;
  }

  .ai-image-banner-{{ ai_gen_id }}__copy {
    max-width: 560px;
    font-size: 16px;
    line-height: 1.5;
  }

  .ai-image-banner-{{ ai_gen_id }}__copy p { margin: 0; }

  .ai-image-banner-{{ ai_gen_id }}__button {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 22px;
    color: #ffffff;
    background: {{ block.settings.button_color }};
    border-radius: 999px;
    font-weight: 600;
  }

  .ai-image-banner-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid {{ block.settings.button_color }};
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner-{{ ai_gen_id }} { width: 100%; }
    .ai-image-banner-{{ ai_gen_id }}__media { height: {{ block.settings.mobile_height }}px; }
    .ai-image-banner-{{ ai_gen_id }}__overlay { padding: 22px; }
  }
{% endstyle %}

<div class="ai-image-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.banner_link != blank %}<a class="ai-image-banner-{{ ai_gen_id }}__link" href="{{ block.settings.banner_link }}">{% endif %}
    <div class="ai-image-banner-{{ ai_gen_id }}__media">
      {% if block.settings.banner_image != blank %}
        <img class="ai-image-banner-{{ ai_gen_id }}__image" src="{{ block.settings.banner_image | image_url: width: 2400 }}" alt="{{ block.settings.banner_image.alt | escape }}" loading="lazy" width="{{ block.settings.banner_image.width }}" height="{{ block.settings.banner_image.height }}">
      {% else %}
        <div class="ai-image-banner-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-banner-{{ ai_gen_id }}__empty">Upload a banner image in the block settings.</div>
        </div>
      {% endif %}
      {% if block.settings.heading != blank or block.settings.description != blank or block.settings.button_label != blank %}
        <div class="ai-image-banner-{{ ai_gen_id }}__overlay">
          {% if block.settings.heading != blank %}<h2 class="ai-image-banner-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
          {% if block.settings.description != blank %}<div class="ai-image-banner-{{ ai_gen_id }}__copy">{{ block.settings.description }}</div>{% endif %}
          {% if block.settings.button_label != blank %}<span class="ai-image-banner-{{ ai_gen_id }}__button">{{ block.settings.button_label | escape }}</span>{% endif %}
        </div>
      {% endif %}
    </div>
  {% if block.settings.banner_link != blank %}</a>{% endif %}
</div>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "banner_height", "label": "Desktop height", "min": 200, "max": 700, "step": 25, "unit": "px", "default": 400 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 180, "max": 500, "step": 20, "unit": "px", "default": 280 },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [{ "value": "cover", "label": "Fill banner" }, { "value": "contain", "label": "Show full image" }], "default": "cover" },
    { "type": "header", "content": "Banner content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring your garden to life" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Discover plants and essentials for your growing space.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore now" },
    { "type": "url", "id": "banner_link", "label": "Banner link" },
    { "type": "select", "id": "content_position", "label": "Vertical content position", "options": [{ "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Middle" }, { "value": "flex-end", "label": "Bottom" }], "default": "center" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 64, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 80, "step": 10, "unit": "%", "default": 50 },
    { "type": "header", "content": "Colors and shape" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#1F5130" },
    { "type": "color", "id": "background_color", "label": "Placeholder background", "default": "#F8F4EC" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "Image banner" }],
  "tag": null,
  "class": "image-banner-block"
}
{% endschema %}