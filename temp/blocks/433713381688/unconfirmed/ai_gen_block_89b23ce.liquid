{% doc %}
  @prompt
    i need view all products button with link in the middle of the page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-view-all-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    text-align: center;
    padding: {{ block.settings.vertical_spacing }}px 16px;
  }

  .ai-view-all-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: 48px;
    padding: 12px 28px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .ai-view-all-{{ ai_gen_id }}__link:hover {
    background: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-view-all-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-view-all-{{ ai_gen_id }}__link {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-view-all-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.button_link != blank %}
    <a class="ai-view-all-{{ ai_gen_id }}__link" href="{{ block.settings.button_link }}">
      {{ block.settings.button_label | escape }}
    </a>
  {% else %}
    <span class="ai-view-all-{{ ai_gen_id }}__link" aria-disabled="true">
      {{ block.settings.button_label | escape }}
    </span>
  {% endif %}
</div>

{% schema %}
{
  "name": "View all products",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#1f5130"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Hover background",
      "default": "#0d3a1d"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus outline",
      "default": "#ffd60a"
    }
  ],
  "presets": [
    {
      "name": "View all products"
    }
  ],
  "tag": null,
  "class": "view-all-products-block"
}
{% endschema %}