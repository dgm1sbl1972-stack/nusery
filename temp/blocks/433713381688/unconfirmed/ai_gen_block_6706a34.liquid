{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-plant-carousel-{{ ai_gen_id }} { display:block; width:100%; background:{{ block.settings.section_background }}; padding:{{ block.settings.padding_top }}px 22px {{ block.settings.padding_bottom }}px; overflow:hidden; }
  .ai-plant-carousel-{{ ai_gen_id }}__inner { max-width:1200px; margin:0 auto; }
  .ai-plant-carousel-{{ ai_gen_id }}__heading { margin:0 0 30px; color:{{ block.settings.heading_color }}; text-align:{{ block.settings.heading_alignment }}; font-size:{{ block.settings.heading_size }}px; line-height:1.12; font-weight:{{ block.settings.heading_weight }}; }
  .ai-plant-carousel-{{ ai_gen_id }}__viewport { position:relative; }
  .ai-plant-carousel-{{ ai_gen_id }}__track { display:grid; grid-auto-flow:column; grid-auto-columns:calc((100% - {{ block.settings.card_gap | times: 2 }}px) / 3); gap:{{ block.settings.card_gap }}px; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; scrollbar-width:none; padding:3px 2px 12px; }
  .ai-plant-carousel-{{ ai_gen_id }}__track::-webkit-scrollbar { display:none; }
  .ai-plant-carousel-{{ ai_gen_id }}__card { position:relative; min-width:0; overflow:hidden; scroll-snap-align:start; border-radius:{{ block.settings.card_radius }}px; background:{{ block.settings.card_background }}; color:{{ block.settings.text_color }}; box-shadow:{% if block.settings.card_shadow %}0 8px 26px rgba(17,50,29,.12){% else %}none{% endif %}; }
  .ai-plant-carousel-{{ ai_gen_id }}__image-link { display:block; height:{{ block.settings.image_height }}px; position:relative; overflow:hidden; }
  .ai-plant-carousel-{{ ai_gen_id }}__image-link img { width:100%; height:100%; object-fit:cover; display:block; {% if block.settings.image_zoom %}transition:transform .35s ease;{% endif %} }
  {% if block.settings.image_zoom %}.ai-plant-carousel-{{ ai_gen_id }}__image-link:hover img { transform:scale(1.04); }{% endif %}
  .ai-plant-carousel-{{ ai_gen_id }}__image-placeholder { height:100%; background:#edf0e7; }
  .ai-plant-carousel-{{ ai_gen_id }}__image-placeholder svg { height:100%; width:100%; }
  .ai-plant-carousel-{{ ai_gen_id }}__badge { position:absolute; top:13px; padding:7px 10px; border-radius:30px; font-size:11px; font-weight:700; line-height:1; }
  .ai-plant-carousel-{{ ai_gen_id }}__badge--best { left:12px; background:{{ block.settings.best_badge_bg }}; color:{{ block.settings.best_badge_text }}; }
  .ai-plant-carousel-{{ ai_gen_id }}__badge--discount { right:12px; background:{{ block.settings.discount_badge_bg }}; color:{{ block.settings.discount_badge_text }}; }
  .ai-plant-carousel-{{ ai_gen_id }}__body { padding:17px 17px 20px; min-height:175px; }
  .ai-plant-carousel-{{ ai_gen_id }}__rating { margin:0 0 8px; font-size:13px; color:{{ block.settings.rating_color }}; }
  .ai-plant-carousel-{{ ai_gen_id }}__title { margin:0 48px 7px 0; font-size:18px; font-weight:700; line-height:1.3; }
  .ai-plant-carousel-{{ ai_gen_id }}__title a { color:inherit; text-decoration:none; }
  .ai-plant-carousel-{{ ai_gen_id }}__subtitle { margin:0 0 11px; font-size:14px; line-height:1.45; color:{{ block.settings.subtitle_color }}; }
  .ai-plant-carousel-{{ ai_gen_id }}__prices { display:flex; gap:9px; align-items:baseline; padding-right:44px; }
  .ai-plant-carousel-{{ ai_gen_id }}__price { font-size:17px; font-weight:700; color:{{ block.settings.price_color }}; }
  .ai-plant-carousel-{{ ai_gen_id }}__compare { font-size:14px; color:#68756b; text-decoration:line-through; }
  .ai-plant-carousel-{{ ai_gen_id }}__cart { position:absolute; right:14px; bottom:14px; width:{{ block.settings.cart_size }}px; height:{{ block.settings.cart_size }}px; border:0; border-radius:50%; display:grid; place-items:center; background:{{ block.settings.cart_background }}; color:{{ block.settings.cart_icon_color }}; cursor:pointer; }
  .ai-plant-carousel-{{ ai_gen_id }}__cart svg { width:21px; height:21px; }
  .ai-plant-carousel-{{ ai_gen_id }}__cart:disabled { opacity:.6; cursor:wait; }
  .ai-plant-carousel-{{ ai_gen_id }}__arrow { position:absolute; z-index:2; top:40%; width:44px; height:44px; border:0; border-radius:50%; background:#fff; color:#0d3a1d; box-shadow:0 3px 14px rgba(0,0,0,.15); display:grid; place-items:center; cursor:pointer; }
  .ai-plant-carousel-{{ ai_gen_id }}__prev { left:-18px; } .ai-plant-carousel-{{ ai_gen_id }}__next { right:-18px; }
  .ai-plant-carousel-{{ ai_gen_id }}__actions { display:flex; justify-content:flex-end; align-items:center; gap:14px; margin-top:20px; }
  .ai-plant-carousel-{{ ai_gen_id }}__view { display:inline-flex; align-items:center; justify-content:center; padding:{{ block.settings.button_padding }}px 24px; border-radius:{{ block.settings.button_radius }}px; background:{{ block.settings.button_background }}; color:{{ block.settings.button_text_color }}; font-size:{{ block.settings.button_font_size }}px; font-weight:700; text-decoration:none; transition:background .2s ease, transform .2s ease; }
  .ai-plant-carousel-{{ ai_gen_id }}__view:hover { background:{{ block.settings.button_hover_background }}; transform:translateY(-1px); }
  .ai-plant-carousel-{{ ai_gen_id }} :focus-visible { outline:3px solid #9b7613; outline-offset:3px; }
  @media(max-width:989px) { .ai-plant-carousel-{{ ai_gen_id }}__track { grid-auto-columns:calc((100% - {{ block.settings.card_gap }}px)/2); } }
  @media(max-width:600px) { .ai-plant-carousel-{{ ai_gen_id }} { padding-left:18px; padding-right:18px; } .ai-plant-carousel-{{ ai_gen_id }}__track { grid-auto-columns:100%; } .ai-plant-carousel-{{ ai_gen_id }}__prev { left:-10px; } .ai-plant-carousel-{{ ai_gen_id }}__next { right:-10px; } .ai-plant-carousel-{{ ai_gen_id }}__actions { justify-content:center; } }
  @media(prefers-reduced-motion:reduce) { .ai-plant-carousel-{{ ai_gen_id }}__track { scroll-behavior:auto; } .ai-plant-carousel-{{ ai_gen_id }}__image-link img,.ai-plant-carousel-{{ ai_gen_id }}__view { transition:none; } }
{% endstyle %}

<plant-carousel-{{ ai_gen_id }} class="ai-plant-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-plant-carousel-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-plant-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <div class="ai-plant-carousel-{{ ai_gen_id }}__viewport">
      <button class="ai-plant-carousel-{{ ai_gen_id }}__arrow ai-plant-carousel-{{ ai_gen_id }}__prev" type="button" aria-label="Previous products"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button>
      <div class="ai-plant-carousel-{{ ai_gen_id }}__track" data-track>
        {% for product in block.settings.products limit: block.settings.product_limit %}
          {% assign variant = product.selected_or_first_available_variant %}
          {% assign percent_off = 0 %}
          {% if variant.compare_at_price > variant.price and variant.compare_at_price > 0 %}{% assign amount_off = variant.compare_at_price | minus: variant.price | times: 100.0 %}{% assign percent_off = amount_off | divided_by: variant.compare_at_price | round %}{% endif %}
          {% assign rating = product.metafields.reviews.rating.value %}
          {% assign review_count = product.metafields.reviews.rating_count | default: product.metafields.reviews.count %}
          <article class="ai-plant-carousel-{{ ai_gen_id }}__card">
            <a class="ai-plant-carousel-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if block.settings.show_bestseller and product.tags contains 'Bestseller' %}<span class="ai-plant-carousel-{{ ai_gen_id }}__badge ai-plant-carousel-{{ ai_gen_id }}__badge--best">{{ block.settings.bestseller_text | escape }}</span>{% endif %}
              {% if block.settings.show_discount and percent_off > 0 %}<span class="ai-plant-carousel-{{ ai_gen_id }}__badge ai-plant-carousel-{{ ai_gen_id }}__badge--discount">{{ percent_off }}% OFF</span>{% endif %}
              {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% else %}<div class="ai-plant-carousel-{{ ai_gen_id }}__image-placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
            </a>
            <div class="ai-plant-carousel-{{ ai_gen_id }}__body">
              {% if block.settings.show_rating and rating != blank %}<p class="ai-plant-carousel-{{ ai_gen_id }}__rating" aria-label="Rated {{ rating }} out of 5">★ {{ rating }}{% if review_count != blank %} | {{ review_count }}{% endif %}</p>{% endif %}
              <h3 class="ai-plant-carousel-{{ ai_gen_id }}__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              {% if block.settings.show_subtitle and product.description != blank %}<p class="ai-plant-carousel-{{ ai_gen_id }}__subtitle">{{ product.description | strip_html | truncate: 72 | escape }}</p>{% endif %}
              <div class="ai-plant-carousel-{{ ai_gen_id }}__prices"><span class="ai-plant-carousel-{{ ai_gen_id }}__price">{{ block.settings.currency_symbol }}{{ variant.price | money_without_currency }}</span>{% if variant.compare_at_price > variant.price %}<span class="ai-plant-carousel-{{ ai_gen_id }}__compare">{{ block.settings.currency_symbol }}{{ variant.compare_at_price | money_without_currency }}</span>{% endif %}</div>
              {% if block.settings.show_cart %}<form action="{{ routes.cart_add_url }}" method="post" data-cart-form><input type="hidden" name="id" value="{{ variant.id }}"><input type="hidden" name="quantity" value="1"><button class="ai-plant-carousel-{{ ai_gen_id }}__cart" type="submit" aria-label="Add {{ product.title | escape }} to cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h2l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 1.9-1.4L22 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg></button></form>{% endif %}
            </div>
          </article>
        {% else %}<p>Select products in this block's product picker.</p>{% endfor %}
      </div>
      <button class="ai-plant-carousel-{{ ai_gen_id }}__arrow ai-plant-carousel-{{ ai_gen_id }}__next" type="button" aria-label="Next products"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button>
    </div>
    {% if block.settings.view_text != blank and block.settings.view_url != blank %}<div class="ai-plant-carousel-{{ ai_gen_id }}__actions"><a class="ai-plant-carousel-{{ ai_gen_id }}__view" href="{{ block.settings.view_url }}">{{ block.settings.view_text | escape }}</a></div>{% endif %}
  </div>
</plant-carousel-{{ ai_gen_id }}>

<script>
(function(){
  const tag='plant-carousel-{{ ai_gen_id }}';
  if(customElements.get(tag)) return;
  class PlantCarousel extends HTMLElement {
    connectedCallback(){
      this.track=this.querySelector('[data-track]');
      if(!this.track)return;
      this.querySelector('.ai-plant-carousel-{{ ai_gen_id }}__prev').addEventListener('click',()=>this.shift(-1));
      this.querySelector('.ai-plant-carousel-{{ ai_gen_id }}__next').addEventListener('click',()=>this.shift(1));
      this.querySelectorAll('[data-cart-form]').forEach(form=>form.addEventListener('submit',async event=>{
        event.preventDefault();
        const button=form.querySelector('button'); button.disabled=true;
        try{
          const response=await fetch(`${window.Shopify.routes.root}cart/add.js`,{method:'POST',headers:{Accept:'application/json'},body:new FormData(form)});
          if(!response.ok)throw new Error('Cart update failed');
          document.dispatchEvent(new CustomEvent('cart:refresh',{bubbles:true}));
          form.dispatchEvent(new CustomEvent('cart:item-added',{bubbles:true}));
        }catch(error){form.submit();}finally{button.disabled=false;}
      }));
    }
    shift(direction){const first=this.track.querySelector('.ai-plant-carousel-{{ ai_gen_id }}__card');if(!first)return;this.track.scrollBy({left:direction*(first.getBoundingClientRect().width+(parseFloat(getComputedStyle(this.track).columnGap)||0)),behavior:'smooth'});}
  }
  customElements.define(tag,PlantCarousel);
})();
</script>

