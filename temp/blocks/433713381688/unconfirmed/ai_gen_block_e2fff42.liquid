{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-plant-cta-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding:12px 0}.ai-plant-cta-{{ ai_gen_id }}__inner{display:flex;justify-content:center;align-items:center;gap:14px;flex-wrap:wrap}.ai-plant-cta-{{ ai_gen_id }}__add{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:0 18px;border:0;border-radius:24px;background:#1f5130;color:#fff;font:600 14px/1.2 inherit;text-decoration:none;cursor:pointer}.ai-plant-cta-{{ ai_gen_id }}__add svg{width:17px;height:17px;flex:none}.ai-plant-cta-{{ ai_gen_id }}__view{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 20px;border:1px solid #1f5130;border-radius:24px;color:#1f5130;font-weight:700;text-decoration:none}.ai-plant-cta-{{ ai_gen_id }}__add:hover,.ai-plant-cta-{{ ai_gen_id }}__view:hover{background:#0d3a1d;color:#fff}.ai-plant-cta-{{ ai_gen_id }}__add:focus-visible,.ai-plant-cta-{{ ai_gen_id }}__view:focus-visible{outline:3px solid #ffd60a;outline-offset:3px}.ai-plant-cta-{{ ai_gen_id }}__form{margin:0}@media(max-width:600px){.ai-plant-cta-{{ ai_gen_id }}__inner{gap:10px}}
{% endstyle %}<div class="ai-plant-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-plant-cta-{{ ai_gen_id }}__inner">{% assign selected_product = block.settings.product %}{% if selected_product != blank and selected_product.available %}{% assign selected_variant = selected_product.selected_or_first_available_variant %}<form class="ai-plant-cta-{{ ai_gen_id }}__form" method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ selected_variant.id }}"><input type="hidden" name="quantity" value="1"><input type="hidden" name="return_to" value="{{ routes.cart_url }}"><button class="ai-plant-cta-{{ ai_gen_id }}__add" type="submit" aria-label="{{ block.settings.add_label | escape }} — {{ selected_product.title | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l1 12H4L5 8Z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>{{ block.settings.add_label | escape }}</button></form>{% else %}<a class="ai-plant-cta-{{ ai_gen_id }}__add" href="{{ selected_product.url | default: routes.all_products_collection_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l1 12H4L5 8Z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>{{ block.settings.add_label | escape }}</a>{% endif %}<a class="ai-plant-cta-{{ ai_gen_id }}__view" href="{{ block.settings.view_all_link | default: routes.all_products_collection_url }}">{{ block.settings.view_all_label | escape }}</a></div></div>
{% schema %}{"name":"Plant cart and view all","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"product","id":"product","label":"Product for add to cart"},{"type":"text","id":"add_label","label":"Add button text","default":"Add to cart"},{"type":"text","id":"view_all_label","label":"View all button text","default":"View all products"},{"type":"url","id":"view_all_link","label":"View all products link"}],"presets":[{"name":"Plant cart and view all"}],"tag":null,"class":"plant-cart-and-view-all"}{% endschema %}