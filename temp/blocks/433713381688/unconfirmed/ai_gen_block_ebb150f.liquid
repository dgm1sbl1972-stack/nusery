{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-plant-slider-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;background:#fff9e8;padding:24px 16px}.ai-plant-slider-{{ ai_gen_id }}__track{display:flex;gap:16px;max-width:1200px;margin:auto;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:4px 2px 16px}.ai-plant-slider-{{ ai_gen_id }}__card{flex:0 0 calc((100% - 32px)/3);scroll-snap-align:start;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 16px #1f51301a;transition:transform .2s,box-shadow .2s}.ai-plant-slider-{{ ai_gen_id }}__card:hover{transform:translateY(-4px);box-shadow:0 12px 26px #1f513033}.ai-plant-slider-{{ ai_gen_id }}__image{height:270px;position:relative;overflow:hidden;background:#f2efe6}.ai-plant-slider-{{ ai_gen_id }}__image img,.ai-plant-slider-{{ ai_gen_id }}__image svg{width:100%;height:100%;object-fit:cover;transition:transform .25s}.ai-plant-slider-{{ ai_gen_id }}__card:hover .ai-plant-slider-{{ ai_gen_id }}__image img{transform:scale(1.03)}.ai-plant-slider-{{ ai_gen_id }}__body{padding:14px}.ai-plant-slider-{{ ai_gen_id }}__name{font:21px Georgia,serif;color:#1f5130;margin:0 0 5px}.ai-plant-slider-{{ ai_gen_id }}__rating{font:13px Arial,sans-serif;color:#5b6660;margin:0 0 8px}.ai-plant-slider-{{ ai_gen_id }}__price{font:600 15px Arial,sans-serif;color:#14231a;margin:0}.ai-plant-slider-{{ ai_gen_id }}__cart-form{position:absolute;left:12px;bottom:12px;margin:0}.ai-plant-slider-{{ ai_gen_id }}__cart{position:absolute;left:12px;bottom:12px;display:grid;place-items:center;width:40px;height:40px;border:0;border-radius:50%;background:#1f5130;color:#fff;cursor:pointer;box-shadow:0 3px 10px #0003;transition:transform .2s,background .2s,box-shadow .2s}.ai-plant-slider-{{ ai_gen_id }}__cart:hover:not(:disabled){background:#0d3a1d;transform:scale(1.1);box-shadow:0 5px 14px #0004}.ai-plant-slider-{{ ai_gen_id }}__cart:disabled{opacity:.62;cursor:not-allowed}.ai-plant-slider-{{ ai_gen_id }}__cart:focus-visible,.ai-plant-slider-{{ ai_gen_id }}__view:focus-visible{outline:3px solid #ffd60a;outline-offset:3px}.ai-plant-slider-{{ ai_gen_id }}__view-wrap{display:flex;justify-content:center;margin:20px auto 0}.ai-plant-slider-{{ ai_gen_id }}__view{padding:11px 23px;border-radius:99px;background:#1f5130;color:#fff;text-decoration:none;font:600 14px Arial,sans-serif;transition:background .2s,transform .2s,box-shadow .2s}.ai-plant-slider-{{ ai_gen_id }}__view:hover{background:#0d3a1d;transform:translateY(-2px);box-shadow:0 5px 14px #1f513033}@media(max-width:900px){.ai-plant-slider-{{ ai_gen_id }}__card{flex-basis:calc((100% - 16px)/2)}}@media(max-width:600px){.ai-plant-slider-{{ ai_gen_id }}__card{flex-basis:86%}.ai-plant-slider-{{ ai_gen_id }}__image{height:245px}}{% endstyle %}
<div class="ai-plant-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-plant-slider-{{ ai_gen_id }}__track">{% for i in (1..6) %}{% liquid
assign image_key='image_' | append:i
assign product_key='product_' | append:i
assign title_key='title_' | append:i
assign price_key='price_' | append:i
assign rating_key='rating_' | append:i
assign reviews_key='reviews_' | append:i
assign image=block.settings[image_key]
assign product=block.settings[product_key]
assign title=block.settings[title_key]
assign price=block.settings[price_key]
assign rating=block.settings[rating_key]
assign reviews=block.settings[reviews_key]
if product != blank
assign title=product.title
assign price=product.price | money
endif
%}{% if image != blank or product != blank or title != blank %}<article class="ai-plant-slider-{{ ai_gen_id }}__card"><div class="ai-plant-slider-{{ ai_gen_id }}__image">{% if image != blank %}<img src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | default:title | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">{% elsif product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">{% else %}<div>{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}{% if product != blank %}<form class="ai-plant-slider-{{ ai_gen_id }}__cart-form" method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button class="ai-plant-slider-{{ ai_gen_id }}__cart" type="submit" aria-label="Add {{ product.title | escape }} to cart" {% unless product.available %}disabled{% endunless %}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z" stroke="currentColor" stroke-width="1.8"/><path d="M9 9V6a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.8"/></svg></button></form>{% else %}<button class="ai-plant-slider-{{ ai_gen_id }}__cart" type="button" aria-label="Select a Shopify product to enable add to cart" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z" stroke="currentColor" stroke-width="1.8"/><path d="M9 9V6a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.8"/></svg></button>{% endif %}</div><div class="ai-plant-slider-{{ ai_gen_id }}__body"><h3 class="ai-plant-slider-{{ ai_gen_id }}__name">{{ title | escape }}</h3>{% if rating != blank %}<p class="ai-plant-slider-{{ ai_gen_id }}__rating">★ {{ rating }}{% if reviews != blank %} | {{ reviews }}{% endif %}</p>{% endif %}{% if price != blank %}<p class="ai-plant-slider-{{ ai_gen_id }}__price">{{ price }}</p>{% endif %}</div></article>{% endif %}{% endfor %}</div>{% if block.settings.view_all_link != blank %}<div class="ai-plant-slider-{{ ai_gen_id }}__view-wrap"><a class="ai-plant-slider-{{ ai_gen_id }}__view" href="{{ block.settings.view_all_link }}">{{ block.settings.view_all_label | escape }}</a></div>{% endif %}</div>
{% schema %}{"name":"Plant slider","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"text","id":"view_all_label","label":"Button label","default":"View all products"},{"type":"url","id":"view_all_link","label":"View all products link"},{"type":"header","content":"Plant 1"},{"type":"image_picker","id":"image_1","label":"Plant image"},{"type":"text","id":"title_1","label":"Title","default":"Plant one"},{"type":"text","id":"price_1","label":"Price","default":"₹299"},{"type":"text","id":"rating_1","label":"Rating","default":"4.8"},{"type":"text","id":"reviews_1","label":"Review count","default":"440"},{"type":"product","id":"product_1","label":"Shopify product"},{"type":"header","content":"Plant 2"},{"type":"image_picker","id":"image_2","label":"Plant image"},{"type":"text","id":"title_2","label":"Title","default":"Plant two"},{"type":"text","id":"price_2","label":"Price","default":"₹699"},{"type":"text","id":"rating_2","label":"Rating","default":"4.8"},{"type":"text","id":"reviews_2","label":"Review count","default":"111"},{"type":"product","id":"product_2","label":"Shopify product"},{"type":"header","content":"Plant 3"},{"type":"image_picker","id":"image_3","label":"Plant image"},{"type":"text","id":"title_3","label":"Title","default":"Plant three"},{"type":"text","id":"price_3","label":"Price","default":"₹249"},{"type":"text","id":"rating_3","label":"Rating","default":"4.8"},{"type":"text","id":"reviews_3","label":"Review count","default":"414"},{"type":"product","id":"product_3","label":"Shopify product"},{"type":"header","content":"Plant 4"},{"type":"image_picker","id":"image_4","label":"Plant image"},{"type":"text","id":"title_4","label":"Title","default":"Plant four"},{"type":"text","id":"price_4","label":"Price","default":"₹299"},{"type":"text","id":"rating_4","label":"Rating","default":"4.8"},{"type":"text","id":"reviews_4","label":"Review count","default":"10"},{"type":"product","id":"product_4","label":"Shopify product"},{"type":"header","content":"Plant 5"},{"type":"image_picker","id":"image_5","label":"Plant image"},{"type":"text","id":"title_5","label":"Title","default":"Plant five"},{"type":"text","id":"price_5","label":"Price","default":"₹399"},{"type":"text","id":"rating_5","label":"Rating","default":"4.8"},{"type":"text","id":"reviews_5","label":"Review count","default":"10"},{"type":"product","id":"product_5","label":"Shopify product"},{"type":"header","content":"Plant 6"},{"type":"image_picker","id":"image_6","label":"Plant image"},{"type":"text","id":"title_6","label":"Title","default":"Plant six"},{"type":"text","id":"price_6","label":"Price","default":"₹499"},{"type":"text","id":"rating_6","label":"Rating","default":"4.8"},{"type":"text","id":"reviews_6","label":"Review count","default":"10"},{"type":"product","id":"product_6","label":"Shopify product"}],"presets":[{"name":"Plant slider"}],"tag":null,"class":"plant-slider"}{% endschema %}