{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-plant-carousel-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; position:relative; background:#fff9e8; padding:32px 18px; }
  .ai-plant-carousel-{{ ai_gen_id }}__track { display:flex; gap:20px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; padding:8px 4px 16px; }
  .ai-plant-carousel-{{ ai_gen_id }}__track::-webkit-scrollbar { display:none; }
  .ai-plant-carousel-{{ ai_gen_id }}__card { position:relative; box-sizing:border-box; flex:0 0 calc((100% - 40px)/3); min-width:0; overflow:hidden; scroll-snap-align:start; background:#fff; border-radius:16px; box-shadow:0 3px 14px rgba(31,81,48,.10); padding-bottom:72px; }
  .ai-plant-carousel-{{ ai_gen_id }}__image { display:block; width:100%; aspect-ratio:4/3; object-fit:cover; }
  .ai-plant-carousel-{{ ai_gen_id }}__placeholder { aspect-ratio:4/3; background:#f4f7dc; }
  .ai-plant-carousel-{{ ai_gen_id }}__placeholder svg { display:block; width:100%; height:100%; }
  .ai-plant-carousel-{{ ai_gen_id }}__info { padding:16px; }
  .ai-plant-carousel-{{ ai_gen_id }}__title { margin:0 0 6px; color:#14231a; font-family:Georgia,serif; font-size:20px; }
  .ai-plant-carousel-{{ ai_gen_id }}__description { margin:0 0 10px; color:#5b6660; font-size:14px; }
  .ai-plant-carousel-{{ ai_gen_id }}__price { color:#14231a; font-weight:700; }
  .ai-plant-carousel-{{ ai_gen_id }}__cart-form { position:absolute; right:14px; bottom:14px; z-index:2; margin:0; }
  .ai-plant-carousel-{{ ai_gen_id }}__cart { display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:44px; padding:0 16px; border:0; border-radius:24px; background:#1f5130; color:#fff; font:600 14px/1 sans-serif; text-decoration:none; cursor:pointer; }
  .ai-plant-carousel-{{ ai_gen_id }}__cart:hover { background:#0d3a1d; }
  .ai-plant-carousel-{{ ai_gen_id }}__cart:focus-visible,.ai-plant-carousel-{{ ai_gen_id }}__view:focus-visible { outline:3px solid #ffd60a; outline-offset:3px; }
  .ai-plant-carousel-{{ ai_gen_id }}__cart svg { width:18px; height:18px; flex:none; }
  .ai-plant-carousel-{{ ai_gen_id }}__view-wrap { text-align:center; padding:12px 0 0; }
  .ai-plant-carousel-{{ ai_gen_id }}__view { display:inline-block; padding:12px 24px; border:1px solid #1f5130; border-radius:24px; color:#1f5130; font-weight:600; text-decoration:none; }
  @media(max-width:989px) { .ai-plant-carousel-{{ ai_gen_id }}__card { flex-basis:calc((100% - 20px)/2); } }
  @media(max-width:600px) { .ai-plant-carousel-{{ ai_gen_id }} { width:100%; padding:24px 12px; } .ai-plant-carousel-{{ ai_gen_id }}__card { flex-basis:84%; } }
{% endstyle %}
<div class="ai-plant-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-plant-carousel-{{ ai_gen_id }}__track">
    {% for plant in block.settings.plants %}
      <article class="ai-plant-carousel-{{ ai_gen_id }}__card">
        {% if plant.featured_image %}<img class="ai-plant-carousel-{{ ai_gen_id }}__image" src="{{ plant.featured_image | image_url: width: 900 }}" alt="{{ plant.featured_image.alt | escape }}" loading="lazy" width="{{ plant.featured_image.width }}" height="{{ plant.featured_image.height }}">{% else %}<div class="ai-plant-carousel-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
        <div class="ai-plant-carousel-{{ ai_gen_id }}__info"><h3 class="ai-plant-carousel-{{ ai_gen_id }}__title">{{ plant.title | escape }}</h3>{% if plant.description != blank %}<p class="ai-plant-carousel-{{ ai_gen_id }}__description">{{ plant.description | strip_html | truncate: 100 | escape }}</p>{% endif %}<span class="ai-plant-carousel-{{ ai_gen_id }}__price">{{ plant.price | money }}</span></div>
        {% form 'product', plant %}<input type="hidden" name="id" value="{{ plant.selected_or_first_available_variant.id }}"><button class="ai-plant-carousel-{{ ai_gen_id }}__cart-form ai-plant-carousel-{{ ai_gen_id }}__cart" type="submit" name="add" {% unless plant.available %}disabled{% endunless %} aria-label="Add {{ plant.title | escape }} to cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 1.9-1.4L22 9H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>{{ block.settings.cart_label | escape }}</button>{% endform %}
      </article>
    {% endfor %}
  </div>
  {% if block.settings.view_all_url != blank %}<div class="ai-plant-carousel-{{ ai_gen_id }}__view-wrap"><a class="ai-plant-carousel-{{ ai_gen_id }}__view" href="{{ block.settings.view_all_url }}">{{ block.settings.view_all_label | escape }}</a></div>{% endif %}
</div>
{% schema %}
{"name":"Plant carousel","settings":[{"type":"product_list","id":"plants","label":"Plant products","limit":12},{"type":"text","id":"cart_label","label":"Cart button text","default":"Add to cart"},{"type":"text","id":"view_all_label","label":"View all text","default":"View all products"},{"type":"url","id":"view_all_url","label":"View all link"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Plant carousel"}],"tag":null,"class":"plant-carousel-block"}
{% endschema %}