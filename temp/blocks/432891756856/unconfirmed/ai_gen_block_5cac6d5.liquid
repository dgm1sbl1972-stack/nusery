{% doc %}
  @prompt
    Add a heading text size and text alignment setting to the Plant carousel block for the heading "Bring home a little green". The block should include: 1) A text size option with small, medium, large, and extra-large choices. 2) A text alignment option with left, center, and right choices. Settings should only affect the heading in this carousel block.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-plant-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ settings.color_text }};
  }

  .ai-plant-carousel__heading-{{ ai_gen_id }} {
    margin: 0 0 24px;
    color: {{ settings.color_primary_dark }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    text-align: {{ block.settings.heading_alignment }};
    font-weight: 700;
  }

  .ai-plant-carousel__viewport-{{ ai_gen_id }} {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: {{ settings.color_primary }} {{ settings.color_lime }};
    padding-bottom: 10px;
  }

  .ai-plant-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: 18px;
    min-width: max-content;
  }

  .ai-plant-carousel__card-{{ ai_gen_id }} {
    width: 220px;
    background: {{ settings.color_lime }};
    border-radius: {{ settings.card_radius }}px;
    overflow: hidden;
    flex: 0 0 220px;
  }

  .ai-plant-carousel__image-wrap-{{ ai_gen_id }} {
    aspect-ratio: 1 / 1;
    background: {{ settings.color_cream }};
  }

  .ai-plant-carousel__image-wrap-{{ ai_gen_id }} img,
  .ai-plant-carousel__image-wrap-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-plant-carousel__content-{{ ai_gen_id }} {
    padding: 16px;
  }

  .ai-plant-carousel__title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ settings.color_primary_dark }};
    font-size: 17px;
    line-height: 1.3;
  }

  .ai-plant-carousel__link-{{ ai_gen_id }} {
    display: inline-block;
    margin-top: 10px;
    color: {{ settings.color_primary_dark }};
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .ai-plant-carousel__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-plant-carousel__card-{{ ai_gen_id }} {
      width: 190px;
      flex-basis: 190px;
    }
  }
{% endstyle %}

<div class="ai-plant-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-plant-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>

  <div class="ai-plant-carousel__viewport-{{ ai_gen_id }}">
    <div class="ai-plant-carousel__track-{{ ai_gen_id }}">
      {% for product in block.settings.products %}
        <article class="ai-plant-carousel__card-{{ ai_gen_id }}">
          <a href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
            <div class="ai-plant-carousel__image-wrap-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="500" height="500">
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
          </a>
          <div class="ai-plant-carousel__content-{{ ai_gen_id }}">
            <h3 class="ai-plant-carousel__title-{{ ai_gen_id }}">{{ product.title | escape }}</h3>
            <a class="ai-plant-carousel__link-{{ ai_gen_id }}" href="{{ product.url }}">Shop plant</a>
          </div>
        </article>
      {% else %}
        {% for i in (1..4) %}
          <article class="ai-plant-carousel__card-{{ ai_gen_id }}">
            <div class="ai-plant-carousel__image-wrap-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            <div class="ai-plant-carousel__content-{{ ai_gen_id }}"><h3 class="ai-plant-carousel__title-{{ ai_gen_id }}">Add a plant product</h3></div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Plant carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bring home a little green"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Text size",
      "options": [
        { "value": "24", "label": "Small" },
        { "value": "32", "label": "Medium" },
        { "value": "40", "label": "Large" },
        { "value": "48", "label": "Extra-large" }
      ],
      "default": "32"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile text size",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Plants",
      "limit": 12
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Plant carousel"
    }
  ],
  "tag": null,
  "class": "plant-carousel-block"
}
{% endschema %}