xt","id":"product_6_title","label":"Title 6","default":"Bird of Paradise Plant - XL"},{"type":"text","id":"product_6_description","label":"Description 6","default":"Bold tropical indoor centrepiece"},{"type":"text","id":"product_6_price","label":"Price 6","default":"₹2,499"},{"type":"text","id":"product_6_compare","label":"Original price 6","default":"₹3,000"},{"type":"text","id":"product_6_discount","label":"Discount 6","default":"17% OFF"},{"type":"text","id":"product_6_rating","label":"Rating 6","default":"4.8"},{"type":"text","id":"product_6_reviews","label":"Reviews 6","default":"12"},{"type":"text","id":"product_6_badge","label":"Badge 6","default":"BESTSELLER"},{"type":"url","id":"product_6_link","label":"Product link 6"}],"presets":[{"name":"Plant product carousel"}]}{% endschema %}