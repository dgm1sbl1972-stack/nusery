{% doc %}
  @prompt
    Add a heading text size setting to the Plant carousel block that allows merchants to control the font size of the heading "Bring home a little green". The setting should offer options like small, medium, large, and extra-large sizes, and apply only to the heading within this carousel block without affecting other sections.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-plant-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ settings.color_text | default: '#0d3a1d' }};
  }

  .ai-plant-carousel__heading-{{ ai_gen_id }} {
    margin: 0 0 24px;
    color: {{ settings.color_primary_dark | default: '#0d3a1d' }};
    line-height: 1.1;
    font-weight: 700;
  }

  .ai-plant-carousel__heading-{{ ai_gen_id }}--small { font-size: 28px; }
  .ai-plant-carousel__heading-{{ ai_gen_id }}--medium { font-size: 36px; }
  .ai-plant-carousel__heading-{{ ai_gen_id }}--large { font-size: 46px; }
  .ai-plant-carousel__heading-{{ ai_gen_id }}--extra-large { font-size: 58px; }

  .ai-plant-carousel__viewport-{{ ai_gen_id }} {
    overflow: hidden;
  }

  .ai-plant-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 6px;
  }

  .ai-plant-carousel__track-{{ ai_gen_id }}::-webkit-scrollbar { display: none; }

  .ai-plant-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - 48px) / 4);
    min-width: 180px;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
  }

  .ai-plant-carousel__image-{{ ai_gen_id }},
  .ai-plant-carousel__placeholder-{{ ai_gen_id }} {
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
    border-radius: {{ settings.card_radius | default: 16 }}px;
    background: {{ settings.color_lime | default: '#f4f7dc' }};
  }

  .ai-plant-carousel__image-{{ ai_gen_id }} { display: block; object-fit: cover; }
  .ai-plant-carousel__placeholder-{{ ai_gen_id }} { display: flex; align-items: center; justify-content: center; }
  .ai-plant-carousel__placeholder-{{ ai_gen_id }} svg { width: 65%; height: 65%; color: {{ settings.color_muted | default: '#5b6660' }}; }

  .ai-plant-carousel__title-{{ ai_gen_id }} {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 600;
  }

  .ai-plant-carousel__price-{{ ai_gen_id }} { margin-top: 5px; color: {{ settings.color_muted | default: '#5b6660' }}; font-size: 14px; }

  .ai-plant-carousel__controls-{{ ai_gen_id }} { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }
  .ai-plant-carousel__button-{{ ai_gen_id }} { width: 38px; height: 38px; border: 1px solid {{ settings.color_primary | default: '#1f5130' }}; border-radius: 50%; background: transparent; color: {{ settings.color_primary_dark | default: '#0d3a1d' }}; cursor: pointer; font-size: 20px; line-height: 1; }
  .ai-plant-carousel__button-{{ ai_gen_id }}:focus-visible { outline: 3px solid {{ settings.color_accent | default: '#ffd60a' }}; outline-offset: 3px; }

  @media screen and (max-width: 749px) {
    .ai-plant-carousel__heading-{{ ai_gen_id }}--small { font-size: 24px; }
    .ai-plant-carousel__heading-{{ ai_gen_id }}--medium { font-size: 30px; }
    .ai-plant-carousel__heading-{{ ai_gen_id }}--large { font-size: 36px; }
    .ai-plant-carousel__heading-{{ ai_gen_id }}--extra-large { font-size: 42px; }
    .ai-plant-carousel__card-{{ ai_gen_id }} { flex-basis: 72%; }
  }
{% endstyle %}

<plant-carousel-{{ ai_gen_id }} class="ai-plant-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-plant-carousel__heading-{{ ai_gen_id }} ai-plant-carousel__heading-{{ ai_gen_id }}--{{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
  <div class="ai-plant-carousel__viewport-{{ ai_gen_id }}">
    <div class="ai-plant-carousel__track-{{ ai_gen_id }}" data-track>
      {% for product in block.settings.products %}
        <a class="ai-plant-carousel__card-{{ ai_gen_id }}" href="{{ product.url }}">
          {% if product.featured_image %}
            <img class="ai-plant-carousel__image-{{ ai_gen_id }}" src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="700" height="700">
          {% else %}
            <div class="ai-plant-carousel__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
          {% endif %}
          <h3 class="ai-plant-carousel__title-{{ ai_gen_id }}">{{ product.title }}</h3>
          <div class="ai-plant-carousel__price-{{ ai_gen_id }}">{{ product.price | money }}</div>
        </a>
      {% else %}
        {% for i in (1..4) %}<div class="ai-plant-carousel__card-{{ ai_gen_id }}"><div class="ai-plant-carousel__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div><h3 class="ai-plant-carousel__title-{{ ai_gen_id }}">Add a plant product</h3></div>{% endfor %}
      {% endfor %}
    </div>
  </div>
  <div class="ai-plant-carousel__controls-{{ ai_gen_id }}">
    <button class="ai-plant-carousel__button-{{ ai_gen_id }}" type="button" data-direction="prev" aria-label="Previous plants">&#8592;</button>
    <button class="ai-plant-carousel__button-{{ ai_gen_id }}" type="button" data-direction="next" aria-label="Next plants">&#8594;</button>
  </div>
</plant-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PlantCarousel{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.querySelectorAll('[data-direction]').forEach((button) => {
          button.addEventListener('click', () => {
            const distance = this.track.clientWidth * 0.8;
            this.track.scrollBy({ left: button.dataset.direction === 'next' ? distance : -distance, behavior: 'smooth' });
          });
        });
      }
    }
    if (!customElements.get('plant-carousel-{{ ai_gen_id }}')) customElements.define('plant-carousel-{{ ai_gen_id }}', PlantCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Plant carousel",
  "tag": null,
  "class": "plant-carousel-block",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring home a little green" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }, { "value": "extra-large", "label": "Extra-large" } ], "default": "medium" },
    { "type": "product_list", "id": "products", "label": "Plants", "limit": 12 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [ { "name": "Plant carousel" } ]
}
{% endschema %}