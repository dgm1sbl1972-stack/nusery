{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-farm-banner-{{ ai_gen_id }}{position:relative;isolation:isolate;display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;box-sizing:border-box;overflow:hidden;padding:clamp(48px,8vw,112px) 24px;background-color:{{ block.settings.fallback_color }};{% if block.settings.background_image != blank %}background-image:url('{{ block.settings.background_image | image_url:width:2400 }}');background-position:{{ block.settings.background_position }};background-size:cover;background-repeat:no-repeat;{% endif %}}
.ai-farm-banner__overlay-{{ ai_gen_id }}{position:absolute;inset:0;z-index:0;background-color:{{ block.settings.overlay_color }};opacity:{{ block.settings.overlay_opacity | divided_by:100.0 }};pointer-events:none}
.ai-farm-banner__content-{{ ai_gen_id }}{position:relative;z-index:1;max-width:900px;margin:0 auto;text-align:{{ block.settings.text_alignment }};color:{{ block.settings.text_color }}}
.ai-farm-banner__heading-{{ ai_gen_id }}{margin:0 0 18px;font-size:clamp(32px,5vw,64px);line-height:1.08;color:inherit}
.ai-farm-banner__text-{{ ai_gen_id }}{max-width:760px;margin:0 auto;font-size:clamp(16px,2vw,21px);line-height:1.6;color:inherit}
.ai-farm-banner__text-{{ ai_gen_id }} p{margin:0}
.ai-farm-banner__button-{{ ai_gen_id }}{display:inline-flex;align-items:center;justify-content:center;margin-top:28px;padding:14px 26px;min-height:48px;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};font-size:16px;font-weight:600;text-decoration:none;transition:filter .2s ease}
.ai-farm-banner__button-{{ ai_gen_id }}:hover{filter:brightness(.9)}
.ai-farm-banner__button-{{ ai_gen_id }}:focus-visible{outline:3px solid {{ block.settings.button_text_color }};outline-offset:3px}
@media(max-width:749px){.ai-farm-banner-{{ ai_gen_id }}{padding:56px 20px}}
{% endstyle %}
<section class="ai-farm-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% if block.settings.background_image != blank %}<div class="ai-farm-banner__overlay-{{ ai_gen_id }}" aria-hidden="true"></div>{% endif %}
<div class="ai-farm-banner__content-{{ ai_gen_id }}">
{% if block.settings.heading != blank %}<h2 class="ai-farm-banner__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
{% if block.settings.subtext != blank %}<div class="ai-farm-banner__text-{{ ai_gen_id }}">{{ block.settings.subtext }}</div>{% endif %}
{% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="ai-farm-banner__button-{{ ai_gen_id }}" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
</div>
</section>
{% schema %}
{
  "name": "SBL Farms banner",
  "settings": [
    {"type":"header","content":"Content"},
    {"type":"text","id":"heading","label":"Heading","default":"Think SBL Farms is about plants? Think again"},
    {"type":"richtext","id":"subtext","label":"Subtext","default":"<p>Explore a world of nature, adventure, animals, agritourism, and unforgettable experiences at SBL Farms.</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"Explore SBL Farms"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"color","id":"button_background","label":"Button background","default":"#1f5130"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},
    {"type":"range","id":"button_radius","label":"Button corner radius","min":0,"max":24,"step":2,"unit":"px","default":8},
    {"type":"header","content":"Background image"},
    {"type":"image_picker","id":"background_image","label":"Background image"},
    {"type":"select","id":"background_position","label":"Image position","options":[{"value":"center","label":"Center"},{"value":"top","label":"Top"},{"value":"bottom","label":"Bottom"},{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"center"},
    {"type":"color","id":"fallback_color","label":"Fallback background","default":"#f8f4ec"},
    {"type":"color","id":"overlay_color","label":"Overlay color","default":"#0d3a1d"},
    {"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":100,"step":5,"unit":"%","default":45},
    {"type":"color","id":"text_color","label":"Text color","default":"#ffffff"},
    {"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}
  ],
  "presets": [{"name":"SBL Farms banner"}],
  "tag": null,
  "class": "sbl-farms-banner-block"
}
{% endschema %}