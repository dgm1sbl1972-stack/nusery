{% doc %}
  @prompt
    BACKGROUND CUSTOMIZATION:
    Add complete background customization options in the Shopify Theme Editor.
    
    Provide:
    - Background type selector with:
      1. Solid Color
      2. Background Image
    
    If “Solid Color” is selected:
    - Show a background color picker.
    - Default background should be a warm cream/off-white.
    
    If “Background Image” is selected:
    - Show a Shopify image picker to upload/select a background image.
    - The background image must cover the entire section.
    - Add background position controls such as:
      - Center
      - Top
      - Bottom
      - Left
      - Right
    - Add background size option:
      - Cover
      - Contain
    - Add background overlay color picker.
    - Add overlay opacity slider from 0–100%.
    - Make sure the overlay can improve text readability without hiding the background image.
    
    The background must apply to the complete section, including:
    - The 3-image Our Story area
    - Our Story text
    - Statistics/cards
    - The 8-item ticker
    
    Add section settings for:
    - Background type
    - Background color
    - Background image
    - Background position
    - Background size
    - Overlay color
    - Overlay opacity
    - Section top padding
    - Section bottom padding
    - Desktop spacing
    - Mobile spacing
    
    All background settings must be editable from the Shopify Theme Editor without editing code., stats should be ticker not the other 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-story-{{ ai_gen_id }} { display:block; position:relative; isolation:isolate; overflow:hidden; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; padding:{{ block.settings.section_padding_top }}px 24px {{ block.settings.section_padding_bottom }}px; color:{{ block.settings.text_color }}; {% if block.settings.background_type == 'solid' %}background-color:{{ block.settings.background_color }};{% elsif block.settings.background_image != blank %}background-image:url('{{ block.settings.background_image | image_url: width: 2400 }}'); background-position:{{ block.settings.background_position }}; background-size:{{ block.settings.background_size }}; background-repeat:no-repeat;{% else %}background-color:{{ block.settings.background_color }};{% endif %} }
  .ai-story-{{ ai_gen_id }}::before { content:''; position:absolute; inset:0; z-index:-1; pointer-events:none; {% if block.settings.background_type == 'image' and block.settings.background_image != blank %}background-color:{{ block.settings.overlay_color }}; opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }};{% endif %} }
  .ai-story__inner-{{ ai_gen_id }} { position:relative; z-index:0; width:100%; max-width:1200px; margin:0 auto; display:grid; gap:{{ block.settings.desktop_spacing }}px; }
  .ai-story__intro-{{ ai_gen_id }} { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); align-items:center; gap:{{ block.settings.desktop_spacing }}px; }
  .ai-story__gallery-{{ ai_gen_id }} { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
  .ai-story__image-wrap-{{ ai_gen_id }} { aspect-ratio:4/5; overflow:hidden; border-radius:16px; background:rgba(31,81,48,.08); }
  .ai-story__image-wrap-{{ ai_gen_id }} img,.ai-story__image-wrap-{{ ai_gen_id }} svg { display:block; width:100%; height:100%; object-fit:cover; }
  .ai-story__copy-{{ ai_gen_id }} { max-width:520px; }
  .ai-story__eyebrow-{{ ai_gen_id }} { margin:0 0 10px; color:{{ block.settings.eyebrow_color }}; font-size:13px; letter-spacing:.12em; text-transform:uppercase; }
  .ai-story__heading-{{ ai_gen_id }} { margin:0 0 16px; color:inherit; font-size:clamp(28px,4vw,48px); line-height:1.12; }
  .ai-story__body-{{ ai_gen_id }} { font-size:16px; line-height:1.7; }
  .ai-story__body-{{ ai_gen_id }} p { margin:0 0 12px; }
  .ai-story__stats-{{ ai_gen_id }} { display:flex; align-items:stretch; width:100%; overflow-x:auto; border-top:1px solid {{ block.settings.ticker_border }}; border-bottom:1px solid {{ block.settings.ticker_border }}; scrollbar-width:thin; }
  .ai-story__stat-{{ ai_gen_id }} { flex:1 0 180px; min-width:0; padding:20px 24px; text-align:center; border-right:1px solid {{ block.settings.ticker_border }}; }
  .ai-story__stat-{{ ai_gen_id }}:last-child { border-right:0; }
  .ai-story__stat-value-{{ ai_gen_id }} { margin:0 0 5px; color:{{ block.settings.stat_color }}; font-size:26px; line-height:1.15; font-weight:700; }
  .ai-story__stat-label-{{ ai_gen_id }} { margin:0; line-height:1.45; font-size:14px; }
  .ai-story__ticker-{{ ai_gen_id }} { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; }
  .ai-story__ticker-item-{{ ai_gen_id }} { padding:12px 14px; border:1px solid {{ block.settings.ticker_border }}; border-radius:999px; text-align:center; font-size:14px; line-height:1.35; }
  @media screen and (max-width:749px) { .ai-story-{{ ai_gen_id }} { padding:{{ block.settings.section_padding_top | divided_by: 2 }}px 18px {{ block.settings.section_padding_bottom | divided_by: 2 }}px; } .ai-story__inner-{{ ai_gen_id }} { gap:{{ block.settings.mobile_spacing }}px; } .ai-story__intro-{{ ai_gen_id }} { grid-template-columns:1fr; gap:{{ block.settings.mobile_spacing }}px; } .ai-story__gallery-{{ ai_gen_id }} { gap:8px; } .ai-story__stat-{{ ai_gen_id }} { flex-basis:150px; padding:16px 14px; } .ai-story__stat-value-{{ ai_gen_id }} { font-size:22px; } .ai-story__ticker-{{ ai_gen_id }} { grid-template-columns:repeat(2,minmax(0,1fr)); } }
{% endstyle %}
<div class="ai-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-story__inner-{{ ai_gen_id }}">
    <div class="ai-story__intro-{{ ai_gen_id }}">
      <div class="ai-story__gallery-{{ ai_gen_id }}">
        {% for i in (1..3) %}{% assign image_key = 'story_image_' | append: i %}{% assign story_image = block.settings[image_key] %}<div class="ai-story__image-wrap-{{ ai_gen_id }}">{% if story_image != blank %}<img src="{{ story_image | image_url: width: 700 }}" alt="{{ story_image.alt | escape }}" loading="lazy" width="{{ story_image.width }}" height="{{ story_image.height }}">{% else %}<div class="ai-story__image-placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div>{% endfor %}
      </div>
      <div class="ai-story__copy-{{ ai_gen_id }}">{% if block.settings.eyebrow != blank %}<p class="ai-story__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow | escape }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="ai-story__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-story__body-{{ ai_gen_id }}">{{ block.settings.story_text }}</div></div>
    </div>
    <div class="ai-story__stats-{{ ai_gen_id }}" aria-label="Statistics ticker">{% for i in (1..3) %}{% assign value_key = 'stat_' | append: i | append: '_value' %}{% assign label_key = 'stat_' | append: i | append: '_label' %}<div class="ai-story__stat-{{ ai_gen_id }}"><p class="ai-story__stat-value-{{ ai_gen_id }}">{{ block.settings[value_key] | escape }}</p><p class="ai-story__stat-label-{{ ai_gen_id }}">{{ block.settings[label_key] | escape }}</p></div>{% endfor %}</div>
    <div class="ai-story__ticker-{{ ai_gen_id }}">{% for i in (1..8) %}{% assign ticker_key = 'ticker_item_' | append: i %}{% if block.settings[ticker_key] != blank %}<div class="ai-story__ticker-item-{{ ai_gen_id }}">{{ block.settings[ticker_key] | escape }}</div>{% endif %}{% endfor %}</div>
  </div>
</div>
{% schema %}
{
  "name":"Our story background",
  "settings":[
    {"type":"header","content":"Background"},{"type":"select","id":"background_type","label":"Background type","options":[{"value":"solid","label":"Solid color"},{"value":"image","label":"Background image"}],"default":"solid"},{"type":"color","id":"background_color","label":"Background color","default":"#f8f4ec"},{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"select","id":"background_position","label":"Background position","options":[{"value":"center","label":"Center"},{"value":"top","label":"Top"},{"value":"bottom","label":"Bottom"},{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"center"},{"type":"select","id":"background_size","label":"Background size","options":[{"value":"cover","label":"Cover"},{"value":"contain","label":"Contain"}],"default":"cover"},{"type":"color","id":"overlay_color","label":"Overlay color","default":"#f8f4ec"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":100,"step":5,"unit":"%","default":25},
    {"type":"header","content":"Spacing"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding_top","label":"Section top padding","min":0,"max":100,"step":5,"unit":"px","default":60},{"type":"range","id":"section_padding_bottom","label":"Section bottom padding","min":0,"max":100,"step":5,"unit":"px","default":60},{"type":"range","id":"desktop_spacing","label":"Desktop spacing","min":10,"max":80,"step":5,"unit":"px","default":35},{"type":"range","id":"mobile_spacing","label":"Mobile spacing","min":8,"max":48,"step":4,"unit":"px","default":24},
    {"type":"header","content":"Our story content"},{"type":"image_picker","id":"story_image_1","label":"Story image 1"},{"type":"image_picker","id":"story_image_2","label":"Story image 2"},{"type":"image_picker","id":"story_image_3","label":"Story image 3"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Rooted in nature"},{"type":"text","id":"heading","label":"Heading","default":"Our story"},{"type":"richtext","id":"story_text","label":"Story text","default":"<p>We believe every home can grow a little greener. Discover plants and garden essentials selected with care.</p>"},{"type":"color","id":"text_color","label":"Text color","default":"#14231a"},{"type":"color","id":"eyebrow_color","label":"Eyebrow color","default":"#1f5130"},
    {"type":"header","content":"Statistics ticker"},{"type":"text","id":"stat_1_value","label":"Stat 1 value","default":"100+"},{"type":"text","id":"stat_1_label","label":"Stat 1 label","default":"Plants to explore"},{"type":"text","id":"stat_2_value","label":"Stat 2 value","default":"Carefully grown"},{"type":"text","id":"stat_2_label","label":"Stat 2 label","default":"Quality you can trust"},{"type":"text","id":"stat_3_value","label":"Stat 3 value","default":"For every space"},{"type":"text","id":"stat_3_label","label":"Stat 3 label","default":"From windowsills to gardens"},{"type":"color","id":"stat_color","label":"Statistic value color","default":"#1f5130"},
    {"type":"header","content":"Ticker items"},{"type":"text","id":"ticker_item_1","label":"Ticker item 1","default":"Thoughtfully selected plants"},{"type":"text","id":"ticker_item_2","label":"Ticker item 2","default":"Grow something beautiful"},{"type":"text","id":"ticker_item_3","label":"Ticker item 3","default":"Care tips for every gardener"},{"type":"text","id":"ticker_item_4","label":"Ticker item 4","default":"Bring nature closer"},{"type":"text","id":"ticker_item_5","label":"Ticker item 5","default":"A greener home starts here"},{"type":"text","id":"ticker_item_6","label":"Ticker item 6","default":"Made for growing together"},{"type":"text","id":"ticker_item_7","label":"Ticker item 7","default":"Find your next favourite"},{"type":"text","id":"ticker_item_8","label":"Ticker item 8","default":"Grow at your own pace"},{"type":"color","id":"ticker_border","label":"Ticker border","default":"#9aa99d"}
  ],
  "presets":[{"name":"Our story background"}],"tag":null,"class":"our-story-background-block"
}
