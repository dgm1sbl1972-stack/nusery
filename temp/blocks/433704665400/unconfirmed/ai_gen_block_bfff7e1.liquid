{% doc %}
  @prompt
    BACKGROUND CUSTOMIZATION:
    Add complete background customization options in the Shopify Theme Editor.
    
    Provide:
    - Background type selector with:
      1. Solid Color
      2. Background Image
    
    If “Solid Color” is selected:
    - Show a background color picker.
    - Default background should be a warm cream/off-white.
    
    If “Background Image” is selected:
    - Show a Shopify image picker to upload/select a background image.
    - The background image must cover the entire section.
    - Add background position controls such as:
      - Center
      - Top
      - Bottom
      - Left
      - Right
    - Add background size option:
      - Cover
      - Contain
    - Add background overlay color picker.
    - Add overlay opacity slider from 0–100%.
    - Make sure the overlay can improve text readability without hiding the background image.
    
    The background must apply to the complete section, including:
    - The 3-image Our Story area
    - Our Story text
    - Statistics/cards
    - The 8-item ticker
    
    Add section settings for:
    - Background type
    - Background color
    - Background image
    - Background position
    - Background size
    - Overlay color
    - Overlay opacity
    - Section top padding
    - Section bottom padding
    - Desktop spacing
    - Mobile spacing
    
    All background settings must be editable from the Shopify Theme Editor without editing code., stats should be ticker not the other , remove those ticker, need that stats keep moving and stats should be 8 and also those should be in white bg  like each separate bg, can the image layout can chnage like one like banner kind one like small one like bigger something, layout for the image can be different not like same size 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-story-{{ ai_gen_id }}{display:block;position:relative;isolation:isolate;overflow:hidden;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding:{{ block.settings.section_padding_top }}px 24px {{ block.settings.section_padding_bottom }}px;color:{{ block.settings.text_color }};{% if block.settings.background_type == 'solid' %}background-color:{{ block.settings.background_color }};{% elsif block.settings.background_image != blank %}background-image:url('{{ block.settings.background_image | image_url:width:2400 }}');background-position:{{ block.settings.background_position }};background-size:{{ block.settings.background_size }};background-repeat:no-repeat;{% else %}background-color:{{ block.settings.background_color }};{% endif %}}
.ai-story-{{ ai_gen_id }}::before{content:'';position:absolute;inset:0;z-index:-1;pointer-events:none;{% if block.settings.background_type == 'image' and block.settings.background_image != blank %}background-color:{{ block.settings.overlay_color }};opacity:{{ block.settings.overlay_opacity | divided_by:100.0 }};{% endif %}}
.ai-story__inner-{{ ai_gen_id }}{position:relative;z-index:0;width:100%;max-width:1200px;margin:0 auto;display:grid;gap:{{ block.settings.desktop_spacing }}px}.ai-story__intro-{{ ai_gen_id }}{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;gap:{{ block.settings.desktop_spacing }}px}.ai-story__gallery-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ai-story__image-wrap-{{ ai_gen_id }}{aspect-ratio:4/5;overflow:hidden;border-radius:16px;background:rgba(31,81,48,.08)}
{% if block.settings.gallery_layout == 'banner' %}.ai-story__gallery-{{ ai_gen_id }}{grid-template-columns:repeat(3,minmax(0,1fr))}.ai-story__image-wrap-{{ ai_gen_id }}{aspect-ratio:16/9}{% elsif block.settings.gallery_layout == 'editorial' %}.ai-story__gallery-{{ ai_gen_id }}{grid-template-columns:1.35fr .8fr;grid-template-rows:repeat(2,minmax(0,1fr))}.ai-story__image-wrap-{{ ai_gen_id }}:first-child{grid-row:span 2;aspect-ratio:auto;min-height:340px}.ai-story__image-wrap-{{ ai_gen_id }}:nth-child(2){aspect-ratio:1/1}.ai-story__image-wrap-{{ ai_gen_id }}:nth-child(3){aspect-ratio:4/3}{% elsif block.settings.gallery_layout == 'large' %}.ai-story__gallery-{{ ai_gen_id }}{grid-template-columns:repeat(2,minmax(0,1fr))}.ai-story__image-wrap-{{ ai_gen_id }}:first-child{grid-column:span 2;aspect-ratio:16/9}.ai-story__image-wrap-{{ ai_gen_id }}:not(:first-child){aspect-ratio:1/1}{% endif %}
.ai-story__image-wrap-{{ ai_gen_id }} img,.ai-story__image-wrap-{{ ai_gen_id }} svg{display:block;width:100%;height:100%;object-fit:cover}.ai-story__copy-{{ ai_gen_id }}{max-width:520px}.ai-story__eyebrow-{{ ai_gen_id }}{margin:0 0 10px;color:{{ block.settings.eyebrow_color }};font-size:13px;letter-spacing:.12em;text-transform:uppercase}.ai-story__heading-{{ ai_gen_id }}{margin:0 0 16px;color:inherit;font-size:clamp(28px,4vw,48px);line-height:1.12}.ai-story__body-{{ ai_gen_id }}{font-size:16px;line-height:1.7}.ai-story__body-{{ ai_gen_id }} p{margin:0 0 12px}.ai-story__ticker-{{ ai_gen_id }}{overflow:hidden;width:100%;padding:8px 0;mask-image:linear-gradient(to right,transparent,black 4%,black 96%,transparent)}.ai-story__ticker-track-{{ ai_gen_id }}{display:flex;width:max-content;gap:16px;animation:ai-story-scroll-{{ ai_gen_id }} {{ block.settings.ticker_speed }}s linear infinite}.ai-story__ticker:hover .ai-story__ticker-track-{{ ai_gen_id }},.ai-story__ticker:focus-within .ai-story__ticker-track-{{ ai_gen_id }}{animation-play-state:paused}.ai-story__ticker-group-{{ ai_gen_id }}{display:flex;gap:16px;flex:none}.ai-story__stat-{{ ai_gen_id }}{width:clamp(170px,18vw,220px);min-height:104px;box-sizing:border-box;padding:18px 20px;display:flex;flex-direction:column;justify-content:center;text-align:center;background:#fff;border-radius:14px;box-shadow:0 4px 18px rgba(13,58,29,.10);color:{{ block.settings.text_color }}}.ai-story__stat-value-{{ ai_gen_id }}{margin:0 0 6px;color:{{ block.settings.stat_color }};font-size:24px;line-height:1.15;font-weight:700}.ai-story__stat-label-{{ ai_gen_id }}{margin:0;line-height:1.4;font-size:14px}@keyframes ai-story-scroll-{{ ai_gen_id }}{from{transform:translateX(0)}to{transform:translateX(-50%)}}@media(prefers-reduced-motion:reduce){.ai-story__ticker-track-{{ ai_gen_id }}{animation:none}}@media screen and (max-width:749px){.ai-story-{{ ai_gen_id }}{padding:{{ block.settings.section_padding_top | divided_by:2 }}px 18px {{ block.settings.section_padding_bottom | divided_by:2 }}px}.ai-story__inner-{{ ai_gen_id }}{gap:{{ block.settings.mobile_spacing }}px}.ai-story__intro-{{ ai_gen_id }}{grid-template-columns:1fr;gap:{{ block.settings.mobile_spacing }}px}.ai-story__gallery-{{ ai_gen_id }}{gap:8px}.ai-story__image-wrap-{{ ai_gen_id }}:first-child{min-height:0}.ai-story__stat-{{ ai_gen_id }}{width:165px;min-height:94px;padding:15px}.ai-story__stat-value-{{ ai_gen_id }}{font-size:21px}}
{% endstyle %}
<div class="ai-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-story__inner-{{ ai_gen_id }}"><div class="ai-story__intro-{{ ai_gen_id }}"><div class="ai-story__gallery-{{ ai_gen_id }}">{% for i in (1..3) %}{% assign image_key='story_image_' | append:i %}{% assign story_image=block.settings[image_key] %}<div class="ai-story__image-wrap-{{ ai_gen_id }}">{% if story_image != blank %}<img src="{{ story_image | image_url:width:900 }}" alt="{{ story_image.alt | escape }}" loading="lazy" width="{{ story_image.width }}" height="{{ story_image.height }}">{% else %}<div class="ai-story__image-placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div>{% endfor %}</div><div class="ai-story__copy-{{ ai_gen_id }}">{% if block.settings.eyebrow != blank %}<p class="ai-story__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow | escape }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="ai-story__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-story__body-{{ ai_gen_id }}">{{ block.settings.story_text }}</div></div></div><div class="ai-story__ticker-{{ ai_gen_id }}" aria-label="Statistics ticker"><div class="ai-story__ticker-track-{{ ai_gen_id }}"><div class="ai-story__ticker-group-{{ ai_gen_id }}">{% for i in (1..8) %}{% assign value_key='stat_' | append:i | append:'_value' %}{% assign label_key='stat_' | append:i | append:'_label' %}<div class="ai-story__stat-{{ ai_gen_id }}"><p class="ai-story__stat-value-{{ ai_gen_id }}">{{ block.settings[value_key] | escape }}</p><p class="ai-story__stat-label-{{ ai_gen_id }}">{{ block.settings[label_key] | escape }}</p></div>{% endfor %}</div><div class="ai-story__ticker-group-{{ ai_gen_id }}" aria-hidden="true">{% for i in (1..8) %}{% assign value_key='stat_' | append:i | append:'_value' %}{% assign label_key='stat_' | append:i | append:'_label' %}<div class="ai-story__stat-{{ ai_gen_id }}"><p class="ai-story__stat-value-{{ ai_gen_id }}">{{ block.settings[value_key] | escape }}</p><p class="ai-story__stat-label-{{ ai_gen_id }}">{{ block.settings[label_key] | escape }}</p></div>{% endfor %}</div></div></div></div></div>
