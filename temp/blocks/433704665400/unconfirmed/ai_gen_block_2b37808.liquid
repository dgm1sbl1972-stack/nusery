{% doc %}
  @prompt
    Update the "Think SBL Farms Is Just About Plants?
    Think Again." section to include a background image upload option. The section should allow merchants to upload a background image, with an overlay option for text readability. "Explore a world of nature, adventure, animals, agritour,aquarium,rain dance,DJ,Swimming Pool & unforgettable experiences at SBL Farms".Keep all existing content and settings intact, just add the background image upload functionality.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-farm-experience-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    border-radius: 16px;
    background-color: #1f5130;
    color: #ffffff;
    isolation: isolate;
  }

  .ai-farm-experience-{{ ai_gen_id }}__background,
  .ai-farm-experience-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .ai-farm-experience-{{ ai_gen_id }}__background img,
  .ai-farm-experience-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-farm-experience-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: #1f5130;
  }

  .ai-farm-experience-{{ ai_gen_id }}__placeholder svg {
    color: #f8f4ec;
    opacity: 0.35;
  }

  .ai-farm-experience-{{ ai_gen_id }}__overlay {
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
  }

  .ai-farm-experience-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 320px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 56px 7%;
    text-align: center;
  }

  .ai-farm-experience-{{ ai_gen_id }}__heading {
    max-width: 850px;
    margin: 0 0 18px;
    color: #ffffff;
    font-size: clamp(30px, 4.5vw, 56px);
    line-height: 1.08;
    font-weight: 700;
  }

  .ai-farm-experience-{{ ai_gen_id }}__description {
    max-width: 760px;
    margin: 0;
    color: #ffffff;
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-farm-experience-{{ ai_gen_id }}__content {
      min-height: 280px;
      padding: 40px 24px;
    }
  }
{% endstyle %}

<div class="ai-farm-experience-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-farm-experience-{{ ai_gen_id }}__background" aria-hidden="true">
    {% if block.settings.background_image != blank %}
      {{ block.settings.background_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000', alt: '' }}
    {% else %}
      <div class="ai-farm-experience-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>
  <div class="ai-farm-experience-{{ ai_gen_id }}__overlay" aria-hidden="true"></div>
  <div class="ai-farm-experience-{{ ai_gen_id }}__content">
    <h2 class="ai-farm-experience-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    <p class="ai-farm-experience-{{ ai_gen_id }}__description">{{ block.settings.description | escape }}</p>
  </div>
</div>

{% schema %}
{
  "name": "SBL Farms experience",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Section content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Think SBL Farms Is Just About Plants? Think Again."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore a world of nature, adventure, animals, agritour, aquarium, rain dance, DJ, swimming pool and unforgettable experiences at SBL Farms."
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Dark overlay",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "%",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "SBL Farms experience"
    }
  ],
  "tag": null,
  "class": "sbl-farms-experience-block"
}
{% endschema %}