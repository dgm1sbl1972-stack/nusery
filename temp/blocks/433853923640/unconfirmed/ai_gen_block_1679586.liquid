{% doc %}
  @prompt
    Redesign my Shopify product page based on the attached reference image for SBL Nursery.
    
    - Background: #F8F4EC, Green: #1F5130, Accent: #FFD60A
    - Left: product gallery with up to 10 Shopify product images.
    - Show thumbnails vertically on desktop and horizontally on mobile.
    - Clicking any thumbnail should show that image in the large main preview.
    - Add image zoom/click-to-enlarge.
    - Images must come dynamically from Shopify Product Media.
    - Right: reviews, product title, description, plant size, planter, color, price and quantity.
    - Size, Planter and Color must use actual Shopify variants dynamically.
    - Add Gift option + handwritten note.
    - Add Quantity + Add to Cart.
    - Add editable Offers, Benefits, Promotional Banner, Delivery PIN checker, Plant Care and Product Specifications.
    - Use Shopify metafields for plant specifications.
    - Make everything responsive and editable through Shopify Theme Editor.
    - Do not hardcode products, prices, images or variant values.
    - Match the reference layout closely with a clean, premium SBL Nursery style., give to adjust the size of the image, make it whole protrait 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign form_id = 'sbl-product-form-' | append: ai_gen_id %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% style %}
.sbl-product-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background }};color:{{ block.settings.text_color }};padding:32px 20px}.sbl-product-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:1200px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(340px,.95fr);gap:48px;align-items:start}.sbl-product-{{ ai_gen_id }}__gallery{display:grid;grid-template-columns:76px minmax(0,1fr);gap:14px;position:sticky;top:24px}.sbl-product-{{ ai_gen_id }}__thumbs{display:flex;flex-direction:column;gap:10px;max-height:680px;overflow:auto}.sbl-product-{{ ai_gen_id }}__thumb{padding:0;border:1px solid #d9d4c9;border-radius:10px;background:#fff;overflow:hidden;cursor:pointer;aspect-ratio:1}.sbl-product-{{ ai_gen_id }}__thumb[aria-current=true]{border:2px solid {{ block.settings.green }}}.sbl-product-{{ ai_gen_id }}__thumb img{width:100%;height:100%;display:block;object-fit:cover}.sbl-product-{{ ai_gen_id }}__stage{min-width:0;width:100%;border:0;background:#fff;border-radius:18px;overflow:hidden;cursor:zoom-in;padding:0}.sbl-product-{{ ai_gen_id }}__stage img{width:100%;height:{{ block.settings.desktop_image_height }}px;aspect-ratio:3/4;display:block;object-fit:{{ block.settings.image_fit }}}.sbl-product-{{ ai_gen_id }}__details{display:flex;flex-direction:column;gap:17px}.sbl-product-{{ ai_gen_id }}__reviews{color:{{ block.settings.green }};font-size:14px}.sbl-product-{{ ai_gen_id }}__title{font-size:clamp(28px,3vw,40px);line-height:1.15;margin:0;color:{{ block.settings.green }}}.sbl-product-{{ ai_gen_id }}__desc{line-height:1.65}.sbl-product-{{ ai_gen_id }}__price{font-size:26px;font-weight:700;color:{{ block.settings.green }}}.sbl-product-{{ ai_gen_id }}__compare{font-size:17px;color:#68736c;text-decoration:line-through;margin-left:8px}.sbl-product-{{ ai_gen_id }}__options{display:flex;flex-direction:column;gap:12px}.sbl-product-{{ ai_gen_id }}__option label,.sbl-product-{{ ai_gen_id }}__label{display:block;font-size:14px;font-weight:700;margin-bottom:7px}.sbl-product-{{ ai_gen_id }}__select,.sbl-product-{{ ai_gen_id }}__pin{width:100%;padding:12px 14px;border:1px solid #c8cec8;border-radius:9px;color:{{ block.settings.text_color }};background:#fff;font:inherit}.sbl-product-{{ ai_gen_id }}__gift{display:flex;flex-direction:column;gap:9px;padding:15px;background:#fff;border-radius:12px}.sbl-product-{{ ai_gen_id }}__gift label{display:flex;gap:9px;align-items:center;font-weight:600}.sbl-product-{{ ai_gen_id }}__gift textarea{width:100%;min-height:76px;padding:10px;border:1px solid #c8cec8;border-radius:8px;font:inherit}.sbl-product-{{ ai_gen_id }}__buy{display:flex;gap:10px}.sbl-product-{{ ai_gen_id }}__qty{width:96px;padding:12px;border:1px solid #c8cec8;border-radius:9px;font:inherit}.sbl-product-{{ ai_gen_id }}__submit{flex:1;border:0;border-radius:9px;padding:14px 20px;background:{{ block.settings.green }};color:#fff;font-weight:700;font:inherit;cursor:pointer}.sbl-product-{{ ai_gen_id }}__submit:disabled{opacity:.55;cursor:not-allowed}.sbl-product-{{ ai_gen_id }}__banner{background:{{ block.settings.accent }};color:#1b241d;border-radius:10px;padding:13px 16px;font-weight:700}.sbl-product-{{ ai_gen_id }}__pinrow{display:flex;gap:8px}.sbl-product-{{ ai_gen_id }}__pinrow button{padding:0 15px;border:1px solid {{ block.settings.green }};border-radius:9px;color:{{ block.settings.green }};background:transparent;font-weight:700;cursor:pointer}.sbl-product-{{ ai_gen_id }}__pinresult{min-height:1em;color:{{ block.settings.green }};font-size:13px}.sbl-product-{{ ai_gen_id }}__info{border-top:1px solid #dedbd2;padding:14px 0}.sbl-product-{{ ai_gen_id }}__info summary{cursor:pointer;font-weight:700;color:{{ block.settings.green }}}.sbl-product-{{ ai_gen_id }}__info-content{padding:12px 0 0;line-height:1.6}.sbl-product-{{ ai_gen_id }}__modal{display:none;position:fixed;inset:0;z-index:9999;background:rgba(15,25,18,.92);align-items:center;justify-content:center;padding:24px;cursor:zoom-out}.sbl-product-{{ ai_gen_id }}__modal.is-open{display:flex}.sbl-product-{{ ai_gen_id }}__modal img{max-width:94vw;max-height:90vh;object-fit:contain}.sbl-product-{{ ai_gen_id }}__modal-close{position:absolute;top:18px;right:22px;color:#fff;background:transparent;border:0;font-size:32px;cursor:pointer}@media(max-width:749px){.sbl-product-{{ ai_gen_id }}{padding:20px 14px}.sbl-product-{{ ai_gen_id }}__inner{width:100%;grid-template-columns:1fr;gap:26px}.sbl-product-{{ ai_gen_id }}__gallery{display:flex;flex-direction:column-reverse;position:static;gap:10px}.sbl-product-{{ ai_gen_id }}__thumbs{flex-direction:row;max-height:none;overflow-x:auto}.sbl-product-{{ ai_gen_id }}__thumb{flex:0 0 62px}.sbl-product-{{ ai_gen_id }}__stage img{height:{{ block.settings.mobile_image_height }}px;aspect-ratio:3/4;object-fit:{{ block.settings.image_fit }}}}
{% endstyle %}
<product-detail-{{ ai_gen_id }} class="sbl-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="sbl-product-{{ ai_gen_id }}__inner"><div class="sbl-product-{{ ai_gen_id }}__gallery"><div class="sbl-product-{{ ai_gen_id }}__thumbs" aria-label="Product images">{% for media in product.media limit: 10 %}{% if media.media_type == 'image' %}<button type="button" class="sbl-product-{{ ai_gen_id }}__thumb" aria-label="Show image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-full="{{ media | image_url: width: 1800 }}"><img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy" width="160" height="160"></button>{% endif %}{% endfor %}</div><button type="button" class="sbl-product-{{ ai_gen_id }}__stage" aria-label="Enlarge product image">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1200" height="1600">{% else %}<div>{{ 'product-1' | placeholder_svg_tag }}</div>{% endif %}</button></div><div class="sbl-product-{{ ai_gen_id }}__details">{% if block.settings.show_reviews %}<div class="sbl-product-{{ ai_gen_id }}__reviews">{{ block.settings.review_text | escape }}</div>{% endif %}<h1 class="sbl-product-{{ ai_gen_id }}__title">{{ product.title | escape }}</h1>{% if block.settings.show_description %}<div class="sbl-product-{{ ai_gen_id }}__desc">{{ product.description }}</div>{% endif %}<div class="sbl-product-{{ ai_gen_id }}__price">{{ current_variant.price | money }}{% if current_variant.compare_at_price > current_variant.price %}<span class="sbl-product-{{ ai_gen_id }}__compare">{{ current_variant.compare_at_price | money }}</span>{% endif %}</div>{% if block.settings.banner != blank %}<div class="sbl-product-{{ ai_gen_id }}__banner">{{ block.settings.banner | escape }}</div>{% endif %}{% form 'product', product, id: form_id %}{% unless product.has_only_default_variant %}<div class="sbl-product-{{ ai_gen_id }}__options">{% for option in product.options_with_values %}<div class="sbl-product-{{ ai_gen_id }}__option"><label for="sbl-option-{{ ai_gen_id }}-{{ forloop.index }}">{{ option.name | escape }}</label><select class="sbl-product-{{ ai_gen_id }}__select" id="sbl-option-{{ ai_gen_id }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]">{% for value in option.values %}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>{% endfor %}</select></div>{% endfor %}</div>{% endunless %}<input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>{% if block.settings.enable_gift %}<div class="sbl-product-{{ ai_gen_id }}__gift"><label><input type="checkbox" name="properties[Gift option]" value="Yes">{{ block.settings.gift_label | escape }}</label><textarea name="properties[Handwritten note]" placeholder="{{ block.settings.note_placeholder | escape }}" aria-label="Handwritten gift note"></textarea></div>{% endif %}<div><label class="sbl-product-{{ ai_gen_id }}__label" for="sbl-qty-{{ ai_gen_id }}">Quantity</label><div class="sbl-product-{{ ai_gen_id }}__buy"><input class="sbl-product-{{ ai_gen_id }}__qty" id="sbl-qty-{{ ai_gen_id }}" type="number" name="quantity" value="1" min="1"><button class="sbl-product-{{ ai_gen_id }}__submit" type="submit"{% unless current_variant.available %} disabled{% endunless %}>{{ block.settings.button_text | escape }}</button></div></div>{% endform %}{% if block.settings.show_pin %}<div><label class="sbl-product-{{ ai_gen_id }}__label" for="sbl-pin-{{ ai_gen_id }}">{{ block.settings.pin_label | escape }}</label><div class="sbl-product-{{ ai_gen_id }}__pinrow"><input id="sbl-pin-{{ ai_gen_id }}" class="sbl-product-{{ ai_gen_id }}__pin" type="text" inputmode="numeric" maxlength="10" placeholder="{{ block.settings.pin_placeholder | escape }}"><button type="button" data-check-pin>{{ block.settings.pin_button | escape }}</button></div><div class="sbl-product-{{ ai_gen_id }}__pinresult" aria-live="polite"></div></div>{% endif %}{% if block.settings.offers != blank %}<div class="sbl-product-{{ ai_gen_id }}__info"><details open><summary>{{ block.settings.offers_title | escape }}</summary><div class="sbl-product-{{ ai_gen_id }}__info-content">{{ block.settings.offers }}</div></details></div>{% endif %}{% if block.settings.benefits != blank %}<div class="sbl-product-{{ ai_gen_id }}__info"><details><summary>{{ block.settings.benefits_title | escape }}</summary><div class="sbl-product-{{ ai_gen_id }}__info-content">{{ block.settings.benefits }}</div></details></div>{% endif %}{% if block.settings.care != blank %}<div class="sbl-product-{{ ai_gen_id }}__info"><details><summary>{{ block.settings.care_title | escape }}</summary><div class="sbl-product-{{ ai_gen_id }}__info-content">{{ block.settings.care }}</div></details></div>{% endif %}{% if block.settings.specifications != blank %}<div class="sbl-product-{{ ai_gen_id }}__info"><details><summary>{{ block.settings.specs_title | escape }}</summary><div class="sbl-product-{{ ai_gen_id }}__info-content">{{ block.settings.specifications }}</div></details></div>{% endif %}{% if product.metafields.custom.plant_specifications != blank %}<div class="sbl-product-{{ ai_gen_id }}__info"><details><summary>{{ block.settings.metafield_title | escape }}</summary><div class="sbl-product-{{ ai_gen_id }}__info-content">{{ product.metafields.custom.plant_specifications | metafield_tag }}</div></details></div>{% endif %}</div></div><div class="sbl-product-{{ ai_gen_id }}__modal" role="dialog" aria-modal="true" aria-label="Enlarged product image"><button type="button" class="sbl-product-{{ ai_gen_id }}__modal-close" aria-label="Close image">&times;</button><img src="" alt=""></div></product-detail-{{ ai_gen_id }}>
<script>(function(){class SblProductDetail{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.stage=this.querySelector('.sbl-product-{{ ai_gen_id }}__stage img');this.modal=this.querySelector('.sbl-product-{{ ai_gen_id }}__modal');this.thumbs=this.querySelectorAll('.sbl-product-{{ ai_gen_id }}__thumb');this.thumbs.forEach((thumb)=>thumb.addEventListener('click',()=>{if(this.stage){this.stage.src=thumb.dataset.full;this.stage.alt=thumb.querySelector('img').alt}this.thumbs.forEach((item)=>item.setAttribute('aria-current','false'));thumb.setAttribute('aria-current','true')}));this.querySelector('.sbl-product-{{ ai_gen_id }}__stage').addEventListener('click',()=>{if(this.stage){const image=this.modal.querySelector('img');image.src=this.stage.src;image.alt=this.stage.alt;this.modal.classList.add('is-open');this.modal.querySelector('button').focus()}});this.modal.addEventListener('click',(event)=>{if(event.target===this.modal||event.target.closest('button'))this.modal.classList.remove('is-open')});document.addEventListener('keydown',(event)=>{if(event.key==='Escape')this.modal.classList.remove('is-open')});const pinButton=this.querySelector('[data-check-pin]');if(pinButton)pinButton.addEventListener('click',()=>{const value=this.querySelector('.sbl-product-{{ ai_gen_id }}__pin').value.trim();this.querySelector('.sbl-product-{{ ai_gen_id }}__pinresult').textContent=value?'{{ block.settings.pin_response | escape }}':'{{ block.settings.pin_empty | escape }}'});const form=this.querySelector('form');if(form){const variants={{ product.variants | json }};const selects=form.querySelectorAll('select[name^="options["]');const update=()=>{const values=Array.from(selects).map((select)=>select.value);const match=variants.find((variant)=>variant.options.every((value,index)=>value===values[index]));if(match){form.querySelector('[data-variant-id]').value=match.id;const button=form.querySelector('button[type="submit"]');button.disabled=!match.available;button.textContent=match.available?'{{ block.settings.button_text | escape }}':'Sold out'}};selects.forEach((select)=>select.addEventListener('change',update))}}}if(!customElements.get('sbl-product-detail-{{ ai_gen_id }}'))customElements.define('sbl-product-detail-{{ ai_gen_id }}',SblProductDetail{{ ai_gen_id }})})();</script>
{% schema %}{"name":"SBL product detail","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"desktop_image_height","label":"Portrait image height desktop","min":300,"max":900,"step":50,"unit":"px","default":700},{"type":"range","id":"mobile_image_height","label":"Portrait image height mobile","min":220,"max":600,"step":20,"unit":"px","default":420},{"type":"select","id":"image_fit","label":"Image fit","options":[{"value":"contain","label":"Show whole image"},{"value":"cover","label":"Fill portrait frame"}],"default":"contain"},{"type":"color","id":"background","label":"Background","default":"#F8F4EC"},{"type":"color","id":"green","label":"Green","default":"#1F5130"},{"type":"color","id":"accent","label":"Accent","default":"#FFD60A"},{"type":"color","id":"text_color","label":"Text","default":"#14231A"},{"type":"checkbox","id":"show_reviews","label":"Show review text","default":true},{"type":"text","id":"review_text","label":"Review text","default":"★★★★★ Customer reviews"},{"type":"checkbox","id":"show_description","label":"Show product description","default":true},{"type":"text","id":"banner","label":"Promotional banner","default":"Carefully packed for a happy arrival"},{"type":"text","id":"button_text","label":"Add to cart label","default":"Add to cart"},{"type":"checkbox","id":"enable_gift","label":"Enable gift option","default":true},{"type":"text","id":"gift_label","label":"Gift checkbox label","default":"Send as a gift"},{"type":"text","id":"note_placeholder","label":"Gift note placeholder","default":"Add a handwritten note"},{"type":"checkbox","id":"show_pin","label":"Show delivery PIN checker","default":true},{"type":"text","id":"pin_label","label":"PIN checker label","default":"Check delivery availability"},{"type":"text","id":"pin_placeholder","label":"PIN placeholder","default":"Enter PIN code"},{"type":"text","id":"pin_button","label":"PIN button label","default":"Check"},{"type":"text","id":"pin_response","label":"PIN response","default":"Please contact us to confirm delivery availability."},{"type":"text","id":"pin_empty","label":"Empty PIN message","default":"Please enter a PIN code."},{"type":"text","id":"offers_title","label":"Offers heading","default":"Offers"},{"type":"richtext","id":"offers","label":"Offers content","default":"<p>Add current offers and terms here.</p>"},{"type":"text","id":"benefits_title","label":"Benefits heading","default":"Benefits heading"},{"type":"richtext","id":"benefits","label":"Benefits content","default":"<p>Share the benefits of this plant.</p>"},{"type":"text","id":"care_title","label":"Plant care heading","default":"Plant care"},{"type":"richtext","id":"care","label":"Plant care content","default":"<p>Provide care guidance for this plant.</p>"},{"type":"text","id":"specs_title","label":"Specifications heading","default":"Product specifications"},{"type":"richtext","id":"specifications","label":"Specifications content","default":"<p>Add specifications here.</p>"},{"type":"text","id":"metafield_title","label":"Plant metafield heading","default":"Plant specifications"}],"presets":[{"name":"SBL product detail"}],"tag":null,"class":"sbl-product-detail-block"}{% endschema %}