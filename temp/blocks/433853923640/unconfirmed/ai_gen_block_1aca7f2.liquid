{% doc %}
  @prompt
    Redesign my Shopify product page based on the attached reference image for SBL Nursery.
    
    - Background: #F8F4EC, Green: #1F5130, Accent: #FFD60A
    - Left: product gallery with up to 10 Shopify product images.
    - Show thumbnails vertically on desktop and horizontally on mobile.
    - Clicking any thumbnail should show that image in the large main preview.
    - Add image zoom/click-to-enlarge.
    - Images must come dynamically from Shopify Product Media.
    - Right: reviews, product title, description, plant size, planter, color, price and quantity.
    - Size, Planter and Color must use actual Shopify variants dynamically.
    - Add Gift option + handwritten note.
    - Add Quantity + Add to Cart.
    - Add editable Offers, Benefits, Promotional Banner, Delivery PIN checker, Plant Care and Product Specifications.
    - Use Shopify metafields for plant specifications.
    - Make everything responsive and editable through Shopify Theme Editor.
    - Do not hardcode products, prices, images or variant values.
    - Match the reference layout closely with a clean, premium SBL Nursery style., give to adjust the size of the image, make it whole protrait , desktop end to end , those product image make some bigger, instead of price and droptdown add pot size and drop down 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% assign form_id = 'sbl-pot-form-' | append: ai_gen_id %}{% assign current_variant = product.selected_or_first_available_variant %}{% style %}.sbl-pot-selector-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;color:#14231a}.sbl-pot-selector-{{ ai_gen_id }}__title{margin:0 0 12px;color:#1f5130;font-size:18px;font-weight:700}.sbl-pot-selector-{{ ai_gen_id }}__select{width:100%;padding:13px 14px;border:1px solid #b9c2b8;border-radius:10px;background:#fff;color:#14231a;font:inherit}.sbl-pot-selector-{{ ai_gen_id }}__price{display:none}.sbl-pot-selector-{{ ai_gen_id }}__buy{display:flex;gap:10px;margin-top:14px}.sbl-pot-selector-{{ ai_gen_id }}__qty{width:90px;padding:12px;border:1px solid #b9c2b8;border-radius:10px;font:inherit}.sbl-pot-selector-{{ ai_gen_id }}__button{flex:1;padding:14px;border:0;border-radius:10px;background:#1f5130;color:#fff;font:inherit;font-weight:700;cursor:pointer}.sbl-pot-selector-{{ ai_gen_id }}__button:focus-visible,.sbl-pot-selector-{{ ai_gen_id }}__select:focus-visible{outline:3px solid #1f5130;outline-offset:3px}@media(max-width:749px){.sbl-pot-selector-{{ ai_gen_id }}{width:100%}}{% endstyle %}<div class="sbl-pot-selector-{{ ai_gen_id }}" {{ block.shopify_attributes }}><form action="{{ routes.cart_add_url }}" method="post" id="{{ form_id }}"><label class="sbl-pot-selector-{{ ai_gen_id }}__title" for="sbl-pot-size-{{ ai_gen_id }}">{{ block.settings.label | escape }}</label>{% if product.has_only_default_variant %}<select class="sbl-pot-selector-{{ ai_gen_id }}__select" id="sbl-pot-size-{{ ai_gen_id }}" disabled><option>{{ block.settings.default_size | escape }}</option></select><input type="hidden" name="id" value="{{ current_variant.id }}">{% else %}<select class="sbl-pot-selector-{{ ai_gen_id }}__select" id="sbl-pot-size-{{ ai_gen_id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{% for value in variant.options %}{% assign option_name = product.options[forloop.index0] | downcase %}{% if option_name contains 'pot' or option_name contains 'size' %}{{ value | escape }}{% endif %}{% endfor %}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select>{% endif %}<div class="sbl-pot-selector-{{ ai_gen_id }}__buy"><label class="visually-hidden" for="sbl-pot-qty-{{ ai_gen_id }}">Quantity</label><input class="sbl-pot-selector-{{ ai_gen_id }}__qty" id="sbl-pot-qty-{{ ai_gen_id }}" type="number" name="quantity" value="1" min="1"><button class="sbl-pot-selector-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button></div></form></div>{% schema %}{"name":"Pot size selector","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"text","id":"label","label":"Dropdown label","default":"Select pot size"},{"type":"text","id":"default_size","label":"Default size if no variants","default":"Standard"},{"type":"text","id":"button_label","label":"Button label","default":"Add to cart"}],"presets":[{"name":"Pot size selector"}],"tag":null,"class":"sbl-pot-size-selector"}{% endschema %}