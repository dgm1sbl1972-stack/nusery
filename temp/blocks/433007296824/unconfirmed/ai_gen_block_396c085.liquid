{% doc %}
  @prompt
    Create a testimonials section with the following features:
    - A centered heading that says "Customer Testimonials"
    - 6 testimonial slides in an autoplay carousel/slider
    - Each slide contains:
      - Google logo displayed prominently
      - Profile picture upload option
      - Customer name
      - Review/testimonial text
      - Star rating (1-5 stars)
      - 3 image upload fields per slide
    - All content should be fully customizable through theme settings
    - The heading should be centered on the page
    - Clean, modern design that works well on both desktop and mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-t-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;max-width:100%;padding:{{block.settings.padding}}px 20px;background:{{block.settings.background}};color:{{block.settings.text}};overflow:hidden}.ai-t-{{ai_gen_id}} h2{text-align:center;color:{{block.settings.heading_color}};margin:0 0 26px;font-size:{{block.settings.heading_size}}px}.ai-t-{{ai_gen_id}}__viewport{max-width:960px;margin:auto;overflow:hidden}.ai-t-{{ai_gen_id}}__track{display:flex;transition:transform .4s ease}.ai-t-{{ai_gen_id}}__slide{min-width:100%;padding:4px 8px;box-sizing:border-box}.ai-t-{{ai_gen_id}}__card{background:{{block.settings.card}};border:1px solid {{block.settings.border}};border-radius:{{block.settings.radius}}px;padding:26px;box-shadow:0 8px 22px #0d3a2914}.ai-t-{{ai_gen_id}}__top{display:flex;align-items:center;gap:14px}.ai-t-{{ai_gen_id}}__avatar,.ai-t-{{ai_gen_id}}__avatar-placeholder{width:58px;height:58px;border-radius:50%;object-fit:cover;background:{{block.settings.placeholder}};display:flex;align-items:center;justify-content:center}.ai-t-{{ai_gen_id}}__name{margin:0 0 4px}.ai-t-{{ai_gen_id}}__google{font-size:13px;color:{{block.settings.muted}}}.ai-t-{{ai_gen_id}}__google svg{width:18px;vertical-align:middle}.ai-t-{{ai_gen_id}}__stars{color:{{block.settings.stars}};font-size:21px;letter-spacing:2px;margin:18px 0 12px}.ai-t-{{ai_gen_id}}__quote{color:{{block.settings.muted}};line-height:1.6;margin:0}.ai-t-{{ai_gen_id}}__images{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:20px}.ai-t-{{ai_gen_id}}__images img,.ai-t-{{ai_gen_id}}__ph{width:100%;aspect-ratio:1;object-fit:cover;border-radius:9px;background:{{block.settings.placeholder}}}.ai-t-{{ai_gen_id}}__ph svg{width:60%;height:60%}.ai-t-{{ai_gen_id}}__controls{text-align:center;margin-top:20px}.ai-t-{{ai_gen_id}}__btn{border:1px solid {{block.settings.border}};background:{{block.settings.card}};border-radius:50%;width:36px;height:36px;font-size:20px;cursor:pointer}.ai-t-{{ai_gen_id}}__dot{border:0;border-radius:50%;width:8px;height:8px;padding:0;margin:0 4px;background:{{block.settings.border}}}.ai-t-{{ai_gen_id}}__dot[aria-current=true]{background:{{block.settings.dot}};transform:scale(1.3)}@media(max-width:749px){.ai-t-{{ai_gen_id}}{padding:{{block.settings.mobile_padding}}px 14px}.ai-t-{{ai_gen_id}} h2{font-size:{{block.settings.mobile_heading_size}}px}.ai-t-{{ai_gen_id}}__card{padding:20px}}{% endstyle %}
<testimonial-slider-{{ai_gen_id}} class="ai-t-{{ai_gen_id}}" data-time="{{block.settings.autoplay_seconds | times:1000}}" {{block.shopify_attributes}}><h2>{{block.settings.heading}}</h2><div class="ai-t-{{ai_gen_id}}__viewport"><div class="ai-t-{{ai_gen_id}}__track">{% for i in (1..6) %}{% assign nk='slide_'|append:i|append:'_name' %}{% assign tk='slide_'|append:i|append:'_text' %}{% assign rk='slide_'|append:i|append:'_rating' %}{% assign ak='slide_'|append:i|append:'_avatar' %}{% assign i1='slide_'|append:i|append:'_image_1' %}{% assign i2='slide_'|append:i|append:'_image_2' %}{% assign i3='slide_'|append:i|append:'_image_3' %}<article class="ai-t-{{ai_gen_id}}__slide"><div class="ai-t-{{ai_gen_id}}__card"><div class="ai-t-{{ai_gen_id}}__top">{% if block.settings[ak] %}<img class="ai-t-{{ai_gen_id}}__avatar" src="{{block.settings[ak]|image_url:width:120}}" alt="{{block.settings[nk]|escape}}" width="120" height="120" loading="lazy">{% else %}<div class="ai-t-{{ai_gen_id}}__avatar-placeholder">{{block.settings[nk]|slice:0}}</div>{% endif %}<div><h3 class="ai-t-{{ai_gen_id}}__name">{{block.settings[nk]}}</h3><span class="ai-t-{{ai_gen_id}}__google"><svg viewBox="0 0 24 24"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.5l-3.2-2.5c-.9.6-2.1 1-3.4 1-2.6 0-4.8-1.8-5.6-4.2H3v2.6A10 10 0 0 0 12 22z"/><path fill="#FBBC05" d="M6.4 13.8A6 6 0 0 1 6 12c0-.6.1-1.3.3-1.8V7.6H3A10 10 0 0 0 2 12c0 1.6.4 3.1 1 4.4l3.4-2.6z"/><path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.9-2.9C17 3 14.7 2 12 2a10 10 0 0 0-9 5.6l3.4 2.6C7.2 7.8 9.4 6 12 6z"/></svg> Google review</span></div></div><div class="ai-t-{{ai_gen_id}}__stars">{% for s in (1..5) %}{% if s<=block.settings[rk] %}★{% else %}☆{% endif %}{% endfor %}</div><p class="ai-t-{{ai_gen_id}}__quote">{{block.settings[tk]}}</p><div class="ai-t-{{ai_gen_id}}__images">{% if block.settings[i1] %}<img src="{{block.settings[i1]|image_url:width:500}}" alt="" loading="lazy">{% else %}<div class="ai-t-{{ai_gen_id}}__ph">{{'image'|placeholder_svg_tag}}</div>{% endif %}{% if block.settings[i2] %}<img src="{{block.settings[i2]|image_url:width:500}}" alt="" loading="lazy">{% else %}<div class="ai-t-{{ai_gen_id}}__ph">{{'image'|placeholder_svg_tag}}</div>{% endif %}{% if block.settings[i3] %}<img src="{{block.settings[i3]|image_url:width:500}}" alt="" loading="lazy">{% else %}<div class="ai-t-{{ai_gen_id}}__ph">{{'image'|placeholder_svg_tag}}</div>{% endif %}</div></div></article>{% endfor %}</div></div><div class="ai-t-{{ai_gen_id}}__controls"><button class="ai-t-{{ai_gen_id}}__btn" data-p type="button" aria-label="Previous testimonial">‹</button>{% for i in (1..6) %}<button class="ai-t-{{ai_gen_id}}__dot" data-d="{{forloop.index0}}" type="button" aria-label="Show testimonial {{i}}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}<button class="ai-t-{{ai_gen_id}}__btn" data-n type="button" aria-label="Next testimonial">›</button></div></testimonial-slider-{{ai_gen_id}}>
<script>(function(){class S{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.t=this.querySelector('.ai-t-{{ai_gen_id}}__track');this.i=0;this.d=this.querySelectorAll('[data-d]');this.querySelector('[data-p]').onclick=()=>this.go(this.i-1);this.querySelector('[data-n]').onclick=()=>this.go(this.i+1);this.d.forEach(x=>x.onclick=()=>this.go(+x.dataset.d));this.x=setInterval(()=>this.go(this.i+1),+this.dataset.time)}go(i){this.i=(i+6)%6;this.t.style.transform='translateX(-'+this.i*100+'%)';this.d.forEach((x,n)=>x.setAttribute('aria-current',n==this.i?'true':'false'))}}customElements.define('testimonial-slider-{{ai_gen_id}}',S{{ai_gen_id}})})();</script>
{% schema %}{"name":"Customer testimonials","settings":[{"type":"text","id":"heading","label":"Heading","default":"Customer Testimonials"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"autoplay_seconds","label":"Autoplay interval","min":3,"max":15,"step":1,"unit":"s","default":6},{"type":"color","id":"background","label":"Background","default":"#f8f4ec"},{"type":"color","id":"card","label":"Card","default":"#ffffff"},{"type":"color","id":"heading_color","label":"Heading color","default":"#0d3a1d"},{"type":"color","id":"text","label":"Text","default":"#14231a"},{"type":"color","id":"muted","label":"Muted text","default":"#5b6660"},{"type":"color","id":"stars","label":"Stars","default":"#d19b00"},{"type":"color","id":"dot","label":"Active dot","default":"#1f5130"},{"type":"color","id":"border","label":"Border","default":"#d8ded8"},{"type":"color","id":"placeholder","label":"Placeholder","default":"#eef1eb"},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":56,"step":2,"unit":"px","default":38},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":20,"max":40,"step":2,"unit":"px","default":28},{"type":"range","id":"padding","label":"Desktop padding","min":20,"max":100,"step":5,"unit":"px","default":60},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":16,"max":60,"step":4,"unit":"px","default":36},{"type":"range","id":"radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"header","content":"Slide 1"},{"type":"text","id":"slide_1_name","label":"Name","default":"Customer one"},{"type":"textarea","id":"slide_1_text","label":"Review","default":"A wonderful experience from start to finish."},{"type":"range","id":"slide_1_rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"image_picker","id":"slide_1_avatar","label":"Profile picture"},{"type":"image_picker","id":"slide_1_image_1","label":"Image 1"},{"type":"image_picker","id":"slide_1_image_2","label":"Image 2"},{"type":"image_picker","id":"slide_1_image_3","label":"Image 3"},{"type":"header","content":"Slide 2"},{"type":"text","id":"slide_2_name","label":"Name","default":"Customer two"},{"type":"textarea","id":"slide_2_text","label":"Review","default":"Beautiful quality and excellent service."},{"type":"range","id":"slide_2_rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"image_picker","id":"slide_2_avatar","label":"Profile picture"},{"type":"image_picker","id":"slide_2_image_1","label":"Image 1"},{"type":"image_picker","id":"slide_2_image_2","label":"Image 2"},{"type":"image_picker","id":"slide_2_image_3","label":"Image 3"},{"type":"header","content":"Slide 3"},{"type":"text","id":"slide_3_name","label":"Name","default":"Customer three"},{"type":"textarea","id":"slide_3_text","label":"Review","default":"Exactly what I hoped for."},{"type":"range","id":"slide_3_rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"image_picker","id":"slide_3_avatar","label":"Profile picture"},{"type":"image_picker","id":"slide_3_image_1","label":"Image 1"},{"type":"image_picker","id":"slide_3_image_2","label":"Image 2"},{"type":"image_picker","id":"slide_3_image_3","label":"Image 3"},{"type":"header","content":"Slide 4"},{"type":"text","id":"slide_4_name","label":"Name","default":"Customer four"},{"type":"textarea","id":"slide_4_text","label":"Review","default":"Friendly support and a product that delivers."},{"type":"range","id":"slide_4_rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"image_picker","id":"slide_4_avatar","label":"Profile picture"},{"type":"image_picker","id":"slide_4_image_1","label":"Image 1"},{"type":"image_picker","id":"slide_4_image_2","label":"Image 2"},{"type":"image_picker","id":"slide_4_image_3","label":"Image 3"},{"type":"header","content":"Slide 5"},{"type":"text","id":"slide_5_name","label":"Name","default":"Customer five"},{"type":"textarea","id":"slide_5_text","label":"Review","default":"Simple, reliable, and a pleasure to use."},{"type":"range","id":"slide_5_rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"image_picker","id":"slide_5_avatar","label":"Profile picture"},{"type":"image_picker","id":"slide_5_image_1","label":"Image 1"},{"type":"image_picker","id":"slide_5_image_2","label":"Image 2"},{"type":"image_picker","id":"slide_5_image_3","label":"Image 3"},{"type":"header","content":"Slide 6"},{"type":"text","id":"slide_6_name","label":"Name","default":"Customer six"},{"type":"textarea","id":"slide_6_text","label":"Review","default":"A lovely addition and great value for money."},{"type":"range","id":"slide_6_rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"image_picker","id":"slide_6_avatar","label":"Profile picture"},{"type":"image_picker","id":"slide_6_image_1","label":"Image 1"},{"type":"image_picker","id":"slide_6_image_2","label":"Image 2"},{"type":"image_picker","id":"slide_6_image_3","label":"Image 3"}],"presets":[{"name":"Customer testimonials"}],"tag":null,"class":"customer-testimonials-block"}{% endschema %}