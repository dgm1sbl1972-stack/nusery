{% doc %}
  @prompt
    need one google testimonial for 6 testimonials auto scrolling and need google logo in the each testimonial with text name profile image upload and 3 images for the upload the product , product image for each testimonials
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-google-testimonials-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.section_padding }}px 0;color:{{ block.settings.text_color }}}
  .ai-google-testimonials-{{ ai_gen_id }}__header{text-align:{{ block.settings.alignment }};margin-bottom:28px}
  .ai-google-testimonials-{{ ai_gen_id }}__heading{margin:0 0 8px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px;line-height:1.2}
  .ai-google-testimonials-{{ ai_gen_id }}__intro{margin:0;color:{{ block.settings.muted_color }};font-size:16px}
  .ai-google-testimonials-{{ ai_gen_id }}__viewport{overflow:hidden;width:100%}
  .ai-google-testimonials-{{ ai_gen_id }}__track{display:flex;gap:{{ block.settings.card_gap }}px;width:max-content;animation:ai-google-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite}
  .ai-google-testimonials-{{ ai_gen_id }}__viewport:hover .ai-google-testimonials-{{ ai_gen_id }}__track,.ai-google-testimonials-{{ ai_gen_id }}__viewport:focus-within .ai-google-testimonials-{{ ai_gen_id }}__track{animation-play-state:paused}
  .ai-google-testimonial-card-{{ ai_gen_id }}{box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between;flex:0 0 min(360px,82vw);min-height:330px;padding:24px;background:{{ block.settings.card_background }};border:1px solid {{ block.settings.card_border }};border-radius:{{ block.settings.card_radius }}px;box-shadow:0 8px 24px rgba(13,58,29,.08)}
  .ai-google-testimonial-card-{{ ai_gen_id }}__top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}
  .ai-google-testimonial-card-{{ ai_gen_id }}__identity{display:flex;align-items:center;gap:12px;min-width:0}
  .ai-google-testimonial-card-{{ ai_gen_id }}__profile,.ai-google-testimonial-card-{{ ai_gen_id }}__profile-placeholder{width:48px;height:48px;flex:0 0 48px;border-radius:50%;object-fit:cover}
  .ai-google-testimonial-card-{{ ai_gen_id }}__profile-placeholder{display:flex;align-items:center;justify-content:center;background:{{ block.settings.placeholder_background }};color:{{ block.settings.muted_color }};overflow:hidden}
  .ai-google-testimonial-card-{{ ai_gen_id }}__profile-placeholder svg{width:24px;height:24px}
  .ai-google-testimonial-card-{{ ai_gen_id }}__name{margin:0;overflow:hidden;color:{{ block.settings.text_color }};font-size:16px;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
  .ai-google-testimonial-card-{{ ai_gen_id }}__verified{margin:3px 0 0;color:{{ block.settings.muted_color }};font-size:12px}
  .ai-google-testimonial-card-{{ ai_gen_id }}__google{width:28px;height:28px;flex:0 0 28px}
  .ai-google-testimonial-card-{{ ai_gen_id }}__stars{margin-bottom:12px;color:{{ block.settings.star_color }};letter-spacing:2px;font-size:18px}
  .ai-google-testimonial-card-{{ ai_gen_id }}__quote{margin:0;color:{{ block.settings.text_color }};font-size:15px;line-height:1.65}
  .ai-google-testimonial-card-{{ ai_gen_id }}__product{width:72px;height:72px;margin-top:22px;border-radius:{{ block.settings.card_radius | divided_by: 2 }}px;overflow:hidden;background:{{ block.settings.placeholder_background }};border:1px solid {{ block.settings.card_border }};align-self:flex-start}
  .ai-google-testimonial-card-{{ ai_gen_id }}__product img{display:block;width:100%;height:100%;object-fit:cover}
  .ai-google-testimonial-card-{{ ai_gen_id }}__product-placeholder{display:flex;align-items:center;justify-content:center;width:100%;height:100%}
  .ai-google-testimonial-card-{{ ai_gen_id }}__product-placeholder svg{width:60%;height:60%}
  @keyframes ai-google-scroll-{{ ai_gen_id }}{from{transform:translateX(0)}to{transform:translateX(calc(-50% - {{ block.settings.card_gap | divided_by: 2 }}px))}}
  @media screen and (max-width:749px){.ai-google-testimonials-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px 0}.ai-google-testimonials-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size | times: 0.8 }}px}}
  @media (prefers-reduced-motion:reduce){.ai-google-testimonials-{{ ai_gen_id }}__track{animation:none;transform:none}}
{% endstyle %}
<google-testimonials-{{ ai_gen_id }} class="ai-google-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-google-testimonials-{{ ai_gen_id }}__header">{% if block.settings.heading != blank %}<h2 class="ai-google-testimonials-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.intro != blank %}<p class="ai-google-testimonials-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}</div>
  <div class="ai-google-testimonials-{{ ai_gen_id }}__viewport" aria-label="Customer testimonials" tabindex="0"><div class="ai-google-testimonials-{{ ai_gen_id }}__track">
    {% for copy in (1..2) %}{% for i in (1..6) %}
      {% liquid
        assign name_key = 'testimonial_' | append: i | append: '_name'
        assign quote_key = 'testimonial_' | append: i | append: '_quote'
        assign profile_key = 'testimonial_' | append: i | append: '_profile'
        assign product_key = 'testimonial_' | append: i | append: '_product'
        assign name = block.settings[name_key]
        assign quote = block.settings[quote_key]
        assign profile = block.settings[profile_key]
        assign product = block.settings[product_key]
      %}
      <article class="ai-google-testimonial-card-{{ ai_gen_id }}" aria-hidden="{% if copy == 2 %}true{% else %}false{% endif %}">
        <div><div class="ai-google-testimonial-card-{{ ai_gen_id }}__top"><div class="ai-google-testimonial-card-{{ ai_gen_id }}__identity">{% if profile %}<img class="ai-google-testimonial-card-{{ ai_gen_id }}__profile" src="{{ profile | image_url: width: 96 }}" alt="{{ name | escape }}" width="48" height="48" loading="lazy">{% else %}<div class="ai-google-testimonial-card-{{ ai_gen_id }}__profile-placeholder" aria-hidden="true">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<div><h3 class="ai-google-testimonial-card-{{ ai_gen_id }}__name">{{ name | escape }}</h3><p class="ai-google-testimonial-card-{{ ai_gen_id }}__verified">Google review</p></div></div><svg class="ai-google-testimonial-card-{{ ai_gen_id }}__google" viewBox="0 0 48 48" role="img" aria-label="Google"><path fill="#4285F4" d="M24 9.5c3.54 0 6.72 1.22 9.22 3.6l6.85-6.85C35.9 2.38 30.3 0 24 0 14.6 0 6.5 5.38 2.54 13.22l7.98 6.2C12.43 13.05 17.74 9.5 24 9.5z"/><path fill="#34A853" d="M46.98 24.55c0-1.64-.15-3.22-.43-4.73H24v9.02h12.94c-.56 3-2.26 5.54-4.82 7.25l7.73 6c4.52-4.18 7.13-10.35 7.13-17.54z"/><path fill="#FBBC05" d="M10.52 28.58A14.46 14.46 0 0 1 9.76 24c0-1.59.27-3.14.76-4.58l-7.98-6.2A23.96 23.96 0 0 0 0 24c0 3.87.93 7.53 2.54 10.78l7.98-6.2z"/><path fill="#EA4335" d="M24 48c6.3 0 11.58-2.08 15.44-5.66l-7.73-6c-2.14 1.44-4.87 2.3-7.71 2.3-6.26 0-11.57-3.55-13.48-8.7l-7.98 6.2C6.5 42.62 14.6 48 24 48z"/></svg></div><div class="ai-google-testimonial-card-{{ ai_gen_id }}__stars" aria-label="5 out of 5 stars">★★★★★</div><p class="ai-google-testimonial-card-{{ ai_gen_id }}__quote">{{ quote | escape }}</p></div>
        {% if product %}<div class="ai-google-testimonial-card-{{ ai_gen_id }}__product"><img src="{{ product | image_url: width: 180 }}" alt="{{ product.alt | escape }}" width="72" height="72" loading="lazy"></div>{% else %}<div class="ai-google-testimonial-card-{{ ai_gen_id }}__product"><div class="ai-google-testimonial-card-{{ ai_gen_id }}__product-placeholder">{{ 'image' | placeholder_svg_tag }}</div></div>{% endif %}
      </article>
    {% endfor %}{% endfor %}
  </div></div>
</google-testimonials-{{ ai_gen_id }}>
<script>(function(){if(!customElements.get('google-testimonials-{{ ai_gen_id }}')){class GoogleTestimonials{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.viewport=this.querySelector('.ai-google-testimonials-{{ ai_gen_id }}__viewport');this.track=this.querySelector('.ai-google-testimonials-{{ ai_gen_id }}__track');this.handleKeydown=(event)=>{if(event.key===' '||event.key==='Enter'){event.preventDefault();this.track.style.animationPlayState=this.track.style.animationPlayState==='paused'?'running':'paused'}};this.viewport.addEventListener('keydown',this.handleKeydown)}disconnectedCallback(){if(this.viewport)this.viewport.removeEventListener('keydown',this.handleKeydown)}}customElements.define('google-testimonials-{{ ai_gen_id }}',GoogleTestimonials{{ ai_gen_id }})}})();</script>
{% schema %}{"name":"Google testimonials","tag":null,"class":"google-testimonials-block","settings":[{"type":"header","content":"Content"},{"type":"text","id":"heading","label":"Heading","default":"What our customers say"},{"type":"textarea","id":"intro","label":"Intro","default":"Real experiences from our happy customers"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"scroll_speed","label":"Scroll speed","min":20,"max":120,"step":5,"unit":"s","default":60},{"type":"header","content":"Testimonials"},{"type":"text","id":"testimonial_1_name","label":"1 name","default":"Customer one"},{"type":"textarea","id":"testimonial_1_quote","label":"1 review","default":"A wonderful experience from start to finish."},{"type":"image_picker","id":"testimonial_1_profile","label":"1 profile image"},{"type":"image_picker","id":"testimonial_1_product","label":"1 product image"},{"type":"text","id":"testimonial_2_name","label":"2 name","default":"Customer two"},{"type":"textarea","id":"testimonial_2_quote","label":"2 review","default":"The quality and service were excellent."},{"type":"image_picker","id":"testimonial_2_profile","label":"2 profile image"},{"type":"image_picker","id":"testimonial_2_product","label":"2 product image"},{"type":"text","id":"testimonial_3_name","label":"3 name","default":"Customer three"},{"type":"textarea","id":"testimonial_3_quote","label":"3 review","default":"Everything arrived beautifully and on time."},{"type":"image_picker","id":"testimonial_3_profile","label":"3 profile image"},{"type":"image_picker","id":"testimonial_3_product","label":"3 product image"},{"type":"text","id":"testimonial_4_name","label":"4 name","default":"Customer four"},{"type":"textarea","id":"testimonial_4_quote","label":"4 review","default":"Friendly support and products I truly recommend."},{"type":"image_picker","id":"testimonial_4_profile","label":"4 profile image"},{"type":"image_picker","id":"testimonial_4_product","label":"4 product image"},{"type":"text","id":"testimonial_5_name","label":"5 name","default":"Customer five"},{"type":"textarea","id":"testimonial_5_quote","label":"5 review","default":"A smooth shopping experience with great results."},{"type":"image_picker","id":"testimonial_5_profile","label":"5 profile image"},{"type":"image_picker","id":"testimonial_5_product","label":"5 product image"},{"type":"text","id":"testimonial_6_name","label":"6 name","default":"Customer six"},{"type":"textarea","id":"testimonial_6_quote","label":"6 review","default":"Beautiful products and thoughtful service."},{"type":"image_picker","id":"testimonial_6_profile","label":"6 profile image"},{"type":"image_picker","id":"testimonial_6_product","label":"6 product image"},{"type":"header","content":"Style"},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":48,"step":2,"unit":"px","default":32},{"type":"range","id":"section_padding","label":"Section spacing","min":0,"max":80,"step":5,"unit":"px","default":40},{"type":"range","id":"mobile_padding","label":"Mobile spacing","min":0,"max":50,"step":5,"unit":"px","default":25},{"type":"range","id":"card_gap","label":"Card gap","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"color","id":"heading_color","label":"Heading color","default":"#0d3a1d"},{"type":"color","id":"text_color","label":"Text color","default":"#14231a"},{"type":"color","id":"muted_color","label":"Muted text","default":"#5b6660"},{"type":"color","id":"card_background","label":"Card background","default":"#ffffff"},{"type":"color","id":"card_border","label":"Card border","default":"#dce5de"},{"type":"color","id":"placeholder_background","label":"Placeholder background","default":"#f4f7dc"},{"type":"color","id":"star_color","label":"Star color","default":"#b77900"}],"presets":[{"name":"Google testimonials"}]}{% endschema %}