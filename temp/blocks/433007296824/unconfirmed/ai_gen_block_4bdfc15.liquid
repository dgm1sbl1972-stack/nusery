    {"type":"header","content":"Ticker item 4"},
    {"type":"image_picker","id":"item_4_plant","label":"Plant image"},{"type":"image_picker","id":"item_4_icon","label":"Icon image"},{"type":"text","id":"item_4_heading","label":"Heading","default":"Professional Garden Services"},{"type":"text","id":"item_4_description","label":"Description","default":"Expert help for thriving gardens"},
    {"type":"header","content":"Ticker item 5"},
    {"type":"image_picker","id":"item_5_plant","label":"Plant image"},{"type":"image_picker","id":"item_5_icon","label":"Icon image"},{"type":"text","id":"item_5_heading","label":"Heading","default":"Landscape & Green Wall Solutions"},{"type":"text","id":"item_5_description","label":"Description","default":"Beautiful spaces, thoughtfully designed"},
    {"type":"header","content":"Ticker item 6"},
    {"type":"image_picker","id":"item_6_plant","label":"Plant image"},{"type":"image_picker","id":"item_6_icon","label":"Icon image"},{"type":"text","id":"item_6_heading","label":"Heading","default":"Quality Plants, Grown with Care"},{"type":"text","id":"item_6_description","label":"Description","default":"Rooted in quality and passion"}
  ],
  "presets": [{"name":"Botanical announcement"}]
}
{% endschema %}