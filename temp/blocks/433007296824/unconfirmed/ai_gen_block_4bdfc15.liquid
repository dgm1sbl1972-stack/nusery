    {"type":"range","id":"section_height","label":"Section height","min":180,"max":600,"step":20,"unit":"px","default":320},
    {"type":"range","id":"mobile_height","label":"Mobile height","min":160,"max":500,"step":20,"unit":"px","default":260},
