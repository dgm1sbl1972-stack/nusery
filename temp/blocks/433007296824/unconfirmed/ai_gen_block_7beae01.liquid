{% doc %}
  @prompt
    need an banner image section smaller 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-small-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-small-banner__link-{{ ai_gen_id }} {
    position: relative;
    display: block;
    min-height: {{ block.settings.banner_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    background: {{ block.settings.background_color }};
  }

  .ai-small-banner__image-{{ ai_gen_id }},
  .ai-small-banner__placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-small-banner__image-{{ ai_gen_id }} {
    object-fit: cover;
  }

  .ai-small-banner__placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.text_color }};
    opacity: 0.25;
  }

  .ai-small-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-small-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
  }

  .ai-small-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    min-height: {{ block.settings.banner_height }}px;
    max-width: 560px;
    flex-direction: column;
    justify-content: center;
    padding: 24px;
  }

  .ai-small-banner__heading-{{ ai_gen_id }} {
    margin: 0 0 8px;
    color: inherit;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .ai-small-banner__text-{{ ai_gen_id }} {
    margin: 0;
    color: inherit;
    font-size: 15px;
    line-height: 1.45;
  }

  .ai-small-banner__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-top: 16px;
    padding: 10px 18px;
    border-radius: 999px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-size: 14px;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-small-banner__link-{{ ai_gen_id }},
    .ai-small-banner__content-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_height }}px;
    }

    .ai-small-banner__content-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-small-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<small-banner-{{ ai_gen_id }} class="ai-small-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="ai-small-banner__link-{{ ai_gen_id }}">{% else %}<div class="ai-small-banner__link-{{ ai_gen_id }}">{% endif %}
    {% if block.settings.image != blank %}
      <img class="ai-small-banner__image-{{ ai_gen_id }}" src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
    {% else %}
      <div class="ai-small-banner__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>
    {% endif %}
    <div class="ai-small-banner__overlay-{{ ai_gen_id }}"></div>
    <div class="ai-small-banner__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}<h2 class="ai-small-banner__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.text != blank %}<p class="ai-small-banner__text-{{ ai_gen_id }}">{{ block.settings.text | escape }}</p>{% endif %}
      {% if block.settings.button_label != blank %}<span class="ai-small-banner__button-{{ ai_gen_id }}">{{ block.settings.button_label | escape }}</span>{% endif %}
    </div>
  {% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}
</small-banner-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Small image banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring home something green" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Discover fresh plants for every space." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop plants" },
    { "type": "url", "id": "link", "label": "Banner link" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "banner_height", "label": "Desktop height", "min": 120, "max": 360, "step": 10, "unit": "px", "default": 220 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 100, "max": 280, "step": 10, "unit": "px", "default": 170 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f4f7dc" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#ffd60a" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#0d3a1d" },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "Small image banner" }],
  "tag": null,
  "class": "small-image-banner-block"
}
{% endschema %}