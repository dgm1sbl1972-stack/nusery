{% doc %}
  @prompt
    Create a customer testimonials section with the following features:
    - End-to-end automatic infinite scrolling carousel (auto-scroll, no pause)
    - Google logo/icon displayed on each testimonial card
    - Customer profile image
    - Customer name
    - Review date showing how many days ago the review was written
    - Star rating display
    - Text review content
    - 3 product image upload options per testimonial card
    - Clean, modern card layout
    - Smooth continuous scrolling animation, need 6 testimonials
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-t-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;max-width:100%;overflow:hidden;padding:40px 0;background:{{block.settings.background}}}.ai-t-{{ai_gen_id}}__head{padding:0 20px 24px;text-align:center}.ai-t-{{ai_gen_id}}__head h2{margin:0 0 8px;color:{{block.settings.text_color}};font-size:{{block.settings.heading_size}}px}.ai-t-{{ai_gen_id}}__head p{margin:0;color:{{block.settings.muted_color}}}.ai-t-{{ai_gen_id}}__view{overflow:hidden}.ai-t-{{ai_gen_id}}__track,.ai-t-{{ai_gen_id}}__set{display:flex;gap:16px}.ai-t-{{ai_gen_id}}__track{width:max-content;animation:ait-{{ai_gen_id}} {{block.settings.duration}}s linear infinite}.ai-t-{{ai_gen_id}}__set{flex-shrink:0}.ai-t-{{ai_gen_id}}__card{display:flex;flex-direction:column;flex:0 0 min(340px,82vw);min-height:280px;padding:20px;background:{{block.settings.card_background}};border:1px solid {{block.settings.border_color}};border-radius:{{block.settings.radius}}px;box-shadow:0 8px 22px #0d3a1d14}.ai-t-{{ai_gen_id}}__person{display:flex;align-items:center;gap:10px}.ai-t-{{ai_gen_id}}__avatar,.ai-t-{{ai_gen_id}}__empty{width:46px;height:46px;flex:0 0 46px;border-radius:50%;object-fit:cover;background:{{block.settings.placeholder}};display:flex;align-items:center;justify-content:center;font-weight:700;color:{{block.settings.muted_color}}}.ai-t-{{ai_gen_id}}__name{margin:0;color:{{block.settings.text_color}};font-size:16px}.ai-t-{{ai_gen_id}}__date{margin:3px 0 0;color:{{block.settings.muted_color}};font-size:12px}.ai-t-{{ai_gen_id}}__google{width:20px;margin-left:auto}.ai-t-{{ai_gen_id}}__stars{margin:15px 0 8px;color:{{block.settings.stars}};font-size:18px}.ai-t-{{ai_gen_id}}__review{flex:1;margin:0 0 16px;color:{{block.settings.text_color}};line-height:1.55}.ai-t-{{ai_gen_id}}__products{display:flex;gap:7px;border-top:1px solid {{block.settings.border_color}};padding-top:14px}.ai-t-{{ai_gen_id}}__products img,.ai-t-{{ai_gen_id}}__products span{width:52px;height:52px;border-radius:7px;object-fit:cover;background:{{block.settings.placeholder}};display:flex;align-items:center;justify-content:center}.ai-t-{{ai_gen_id}}__products svg{width:28px;opacity:.35}@keyframes ait-{{ai_gen_id}}{to{transform:translateX(calc(-50% - 8px))}}{% endstyle %}
<infinite-testimonials-{{ai_gen_id}} class="ai-t-{{ai_gen_id}}" {{block.shopify_attributes}}>{% if block.settings.heading != blank or block.settings.intro != blank %}<header class="ai-t-{{ai_gen_id}}__head"><h2>{{block.settings.heading|escape}}</h2><p>{{block.settings.intro|escape}}</p></header>{% endif %}<div class="ai-t-{{ai_gen_id}}__view"><div class="ai-t-{{ai_gen_id}}__track">{% for copy in (1..2) %}<div class="ai-t-{{ai_gen_id}}__set"{% if copy == 2 %} aria-hidden="true"{% endif %}>{% for i in (1..6) %}{% liquid
assign n='testimonial_'|append:i|append:'_name'
assign d='testimonial_'|append:i|append:'_date'
assign r='testimonial_'|append:i|append:'_rating'
assign v='testimonial_'|append:i|append:'_review'
assign a='testimonial_'|append:i|append:'_avatar'
assign x1='testimonial_'|append:i|append:'_product_1'
assign x2='testimonial_'|append:i|append:'_product_2'
assign x3='testimonial_'|append:i|append:'_product_3'
assign name=block.settings[n]
assign date=block.settings[d]
assign rating=block.settings[r]
assign review=block.settings[v]
assign avatar=block.settings[a]
assign p1=block.settings[x1]
assign p2=block.settings[x2]
assign p3=block.settings[x3]
%}<article class="ai-t-{{ai_gen_id}}__card"><div class="ai-t-{{ai_gen_id}}__person">{% if avatar %}<img class="ai-t-{{ai_gen_id}}__avatar" src="{{avatar|image_url:width:92}}" alt="{{name|escape}}" width="46" height="46" loading="lazy">{% else %}<span class="ai-t-{{ai_gen_id}}__empty">{{name|slice:0,1|upcase}}</span>{% endif %}<div><h3 class="ai-t-{{ai_gen_id}}__name">{{name|escape}}</h3><p class="ai-t-{{ai_gen_id}}__date" data-date="{{date|escape}}">{{date|escape}}</p></div><svg class="ai-t-{{ai_gen_id}}__google" viewBox="0 0 24 24" aria-label="Google review"><path fill="#4285F4" d="M21 12h-9v3h5.2c-.7 2-2.5 3-5.2 3a6 6 0 1 1 4.2-10.2l2.1-2.1A9 9 0 1 0 21 12z"/></svg></div><div class="ai-t-{{ai_gen_id}}__stars" aria-label="{{rating}} out of 5 stars">{% case rating %}{% when '1' %}★☆☆☆☆{% when '2' %}★★☆☆☆{% when '3' %}★★★☆☆{% when '4' %}★★★★☆{% else %}★★★★★{% endcase %}</div><p class="ai-t-{{ai_gen_id}}__review">{{review|escape}}</p><div class="ai-t-{{ai_gen_id}}__products">{% if p1 %}<img src="{{p1|image_url:width:104}}" alt="" width="52" height="52" loading="lazy">{% else %}<span>{{'product-apparel-1'|placeholder_svg_tag}}</span>{% endif %}{% if p2 %}<img src="{{p2|image_url:width:104}}" alt="" width="52" height="52" loading="lazy">{% else %}<span>{{'product-apparel-1'|placeholder_svg_tag}}</span>{% endif %}{% if p3 %}<img src="{{p3|image_url:width:104}}" alt="" width="52" height="52" loading="lazy">{% else %}<span>{{'product-apparel-1'|placeholder_svg_tag}}</span>{% endif %}</div></article>{% endfor %}</div>{% endfor %}</div></div></infinite-testimonials-{{ai_gen_id}}><script>(function(){class T{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.querySelectorAll('[data-date]').forEach(e=>{let d=new Date(e.dataset.date);if(!isNaN(d)){let n=Math.max(0,Math.floor((Date.now()-d)/86400000));e.textContent=n+' day'+(n==1?'':'s')+' ago'}})}}customElements.define('infinite-testimonials-{{ai_gen_id}}',T{{ai_gen_id}})})();</script>
{% schema %}{"name":"Customer testimonials","settings":[{"type":"text","id":"heading","label":"Heading","default":"What our customers say"},{"type":"textarea","id":"intro","label":"Intro","default":"Real feedback from customers who shop with us."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"duration","label":"Scroll duration","min":20,"max":120,"step":10,"unit":"s","default":60},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":52,"step":2,"unit":"px","default":34},{"type":"range","id":"radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"color","id":"background","label":"Background","default":"#f8f4ec"},{"type":"color","id":"card_background","label":"Card background","default":"#ffffff"},{"type":"color","id":"border_color","label":"Card border","default":"#d9e2d8"},{"type":"color","id":"text_color","label":"Text","default":"#0d3a1d"},{"type":"color","id":"muted_color","label":"Muted text","default":"#5b6660"},{"type":"color","id":"stars","label":"Stars","default":"#b87900"},{"type":"color","id":"placeholder","label":"Image placeholder","default":"#e8efe4"},{"type":"header","content":"Testimonials 1-6"},{"type":"paragraph","content":"Complete each testimonial. Use dates such as 2026-09-01 so the relative date can be calculated."},{"type":"text","id":"testimonial_1_name","label":"1 name"},{"type":"text","id":"testimonial_1_date","label":"1 date","default":"2026-09-01"},{"type":"select","id":"testimonial_1_rating","label":"1 rating","options":[{"value":"1","label":"1 star"},{"value":"2","label":"2 stars"},{"value":"3","label":"3 stars"},{"value":"4","label":"4 stars"},{"value":"5","label":"5 stars"}],"default":"5"},{"type":"textarea","id":"testimonial_1_review","label":"1 review"},{"type":"image_picker","id":"testimonial_1_avatar","label":"1 profile image"},{"type":"image_picker","id":"testimonial_1_product_