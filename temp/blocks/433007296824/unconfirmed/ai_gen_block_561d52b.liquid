{% doc %}
  @prompt
    can we create a blog section and need an option like all articles , 3 blogs each should have blog link to past, need the blogs in square shape  from end to end of the desktop
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-blogs-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: {{ block.settings.section_padding }}px 20px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-three-blogs-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: none;
    margin: 0;
  }

  .ai-three-blogs-{{ ai_gen_id }}__heading {
    margin: 0 0 28px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-three-blogs-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
    width: 100%;
  }

  .ai-three-blogs-{{ ai_gen_id }}__card {
    overflow: hidden;
    background: {{ block.settings.card_color }};
    border: 1px solid rgba(20, 35, 26, 0.12);
    border-radius: {{ block.settings.card_radius }}px;
  }

  .ai-three-blogs-{{ ai_gen_id }}__image,
  .ai-three-blogs-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .ai-three-blogs-{{ ai_gen_id }}__placeholder {
    background: {{ settings.color_lime }};
  }

  .ai-three-blogs-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-three-blogs-{{ ai_gen_id }}__content {
    padding: 20px;
  }

  .ai-three-blogs-{{ ai_gen_id }}__blog-title {
    margin: 0 0 12px;
    color: {{ block.settings.heading_color }};
    font-size: 22px;
    line-height: 1.25;
  }

  .ai-three-blogs-{{ ai_gen_id }}__blog-title a,
  .ai-three-blogs-{{ ai_gen_id }}__article-title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-three-blogs-{{ ai_gen_id }}__article-title {
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.45;
  }

  .ai-three-blogs-{{ ai_gen_id }}__link {
    color: {{ block.settings.link_color }};
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-three-blogs-{{ ai_gen_id }}__empty {
    padding: 32px 20px;
    color: {{ settings.color_muted }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-three-blogs-{{ ai_gen_id }} {
      padding: 36px 16px;
    }

    .ai-three-blogs-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% assign selected_blogs = '1,2,3' | split: ',' %}

<div class="ai-three-blogs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-blogs-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-three-blogs-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    <div class="ai-three-blogs-{{ ai_gen_id }}__grid">
      {% for blog_number in selected_blogs %}
        {% assign blog_key = 'blog_' | append: blog_number %}
        {% assign selected_blog = block.settings[blog_key] %}
        <article class="ai-three-blogs-{{ ai_gen_id }}__card">
          {% if selected_blog != blank %}
            {% assign latest_article = selected_blog.articles.first %}
            <a href="{{ selected_blog.url }}" aria-label="View {{ selected_blog.title | escape }}">
              {% if latest_article.image %}
                <img class="ai-three-blogs-{{ ai_gen_id }}__image" src="{{ latest_article.image | image_url: width: 1200 }}" alt="{{ latest_article.image.alt | default: selected_blog.title | escape }}" loading="lazy" width="1200" height="1200">
              {% else %}
                <div class="ai-three-blogs-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {% endif %}
            </a>
            <div class="ai-three-blogs-{{ ai_gen_id }}__content">
              <h3 class="ai-three-blogs-{{ ai_gen_id }}__blog-title"><a href="{{ selected_blog.url }}">{{ selected_blog.title | escape }}</a></h3>
              {% if latest_article != blank %}
                <p class="ai-three-blogs-{{ ai_gen_id }}__article-title"><a href="{{ latest_article.url }}">{{ latest_article.title | escape }}</a></p>
              {% endif %}
              <a class="ai-three-blogs-{{ ai_gen_id }}__link" href="{{ selected_blog.url }}">{{ block.settings.link_label | escape }}</a>
            </div>
          {% else %}
            <div class="ai-three-blogs-{{ ai_gen_id }}__empty">Choose blog {{ blog_number }} in the theme editor.</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Three blogs",
  "settings": [
    {"type":"header","content":"Blogs"},
    {"type":"blog","id":"blog_1","label":"Blog 1"},
    {"type":"blog","id":"blog_2","label":"Blog 2"},
    {"type":"blog","id":"blog_3","label":"Blog 3"},
    {"type":"text","id":"link_label","label":"Blog link label","default":"View all articles"},
    {"type":"text","id":"heading","label":"Heading","default":"Explore our blogs"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"section_padding","label":"Section spacing","min":20,"max":100,"step":5,"unit":"px","default":60},
    {"type":"range","id":"card_gap","label":"Card gap","min":0,"max":40,"step":5,"unit":"px","default":20},
    {"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},
    {"type":"select","id":"heading_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},
    {"type":"range","id":"heading_size","label":"Heading size","min":22,"max":56,"step":2,"unit":"px","default":36},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},
    {"type":"color","id":"card_color","label":"Card","default":"#ffffff"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#0d3a1d"},
    {"type":"color","id":"text_color","label":"Text","default":"#14231a"},
    {"type":"color","id":"link_color","label":"Link","default":"#1f5130"}
  ],
  "presets":[{"name":"Three blogs"}],
  "tag":null,
  "class":"three-blogs-block"
}
{% endschema %}