{% doc %}
  @prompt
    need one google testimonial for 6 testimonials auto scrolling and need google logo in the each testimonial with text name profile image upload and 3 images for the upload the product , product image for each testimonials, need 3 images, original google logo, heading in the middle
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-google-reviews-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding:40px 0;background:#f8f4ec}.ai-google-reviews-{{ ai_gen_id }} h2{text-align:center;color:#0d3a1d;margin:0 0 24px;font-size:30px}.ai-google-reviews-{{ ai_gen_id }}__track{display:flex;gap:20px;overflow:hidden}.ai-google-card-{{ ai_gen_id }}{flex:1;padding:22px;background:#fff;border-radius:16px;border:1px solid #dce5de;color:#14231a}.ai-google-card-{{ ai_gen_id }}__profile{width:44px;height:44px;border-radius:50%;object-fit:cover}.ai-google-card-{{ ai_gen_id }}__products{display:flex;gap:8px}.ai-google-card-{{ ai_gen_id }}__products img{width:70px;height:70px;object-fit:cover;border-radius:8px}.ai-google-card-{{ ai_gen_id }}__logo{width:25px;height:25px;float:right}{% endstyle %}<div class="ai-google-reviews-{{ ai_gen_id }}" {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2><div class="ai-google-reviews-{{ ai_gen_id }}__track">{% for i in (1..6) %}{% assign name_key = 'testimonial_' | append: i | append: '_name' %}{% assign quote_key = 'testimonial_' | append: i | append: '_quote' %}{% assign profile_key = 'testimonial_' | append: i | append: '_profile' %}<article class="ai-google-card-{{ ai_gen_id }}">{% if block.settings[profile_key] %}<img class="ai-google-card-{{ ai_gen_id }}__profile" src="{{ block.settings[profile_key] | image_url: width: 88 }}" alt="{{ block.settings[name_key] | escape }}" width="44" height="44">{% endif %}<svg class="ai-google-card-{{ ai_gen_id }}__logo" viewBox="0 0 48 48" aria-label="Google"><circle cx="24" cy="24" r="20" fill="#4285f4"/><text x="24" y="32" text-anchor="middle" fill="#fff" font-size="24" font-weight="700">G</text></svg><p><strong>{{ block.settings[name_key] | escape }}</strong></p><div aria-label="5 out of 5 stars">★★★★★</div><p>{{ block.settings[quote_key] | escape }}</p><div class="ai-google-card-{{ ai_gen_id }}__products">{% for image_number in (1..3) %}{% assign image_key = 'testimonial_' | append: i | append: '_product_' | append: image_number %}{% if block.settings[image_key] %}<img src="{{ block.settings[image_key] | image_url: width: 140 }}" alt="" width="70" height="70">{% endif %}{% endfor %}</div></article>{% endfor %}</div></div>{% schema %}{"name":"Google testimonials","tag":null,"class":"google-testimonials-block","settings":[{"type":"text","id":"heading","label":"Heading","default":"What our customers say"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"paragraph","content":"Use the testimonial fields to add six customer reviews, profile images, and three product images for each review."}],"presets":[{"name":"Google testimonials"}]}{% endschema %}