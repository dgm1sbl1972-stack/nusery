{% doc %}
  @prompt
    Create a customer testimonials section with the following features:
    - End-to-end automatic infinite scrolling carousel (auto-scroll, no pause)
    - Google logo/icon displayed on each testimonial card
    - Customer profile image
    - Customer name
    - Review date showing how many days ago the review was written
    - Star rating display
    - Text review content
    - 3 product image upload options per testimonial card
    - Clean, modern card layout
    - Smooth continuous scrolling animation, need for 6 testinomials, heading can be center, images also need to be uploaded  and add google logo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-g-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;background:{{block.settings.background_color}};padding:40px 0;overflow:hidden}.ai-g-{{ai_gen_id}} h2{text-align:center;color:{{block.settings.heading_color}}}.ai-g-{{ai_gen_id}}__intro{text-align:center;color:{{block.settings.muted_color}}}.ai-g-{{ai_gen_id}}__track{display:flex;width:max-content;gap:20px;animation:ai-g-{{ai_gen_id}} {{block.settings.scroll_speed}}s linear infinite}.ai-g-{{ai_gen_id}}__set{display:flex;gap:20px}.ai-g-{{ai_gen_id}}__card{width:320px;flex:0 0 320px;padding:22px;background:#fff;border-radius:{{block.settings.card_radius}}px}.ai-g-{{ai_gen_id}}__avatar{width:46px;height:46px;border-radius:50%;object-fit:cover;vertical-align:middle}.ai-g-{{ai_gen_id}}__products{display:flex;gap:6px;margin-top:14px}.ai-g-{{ai_gen_id}}__products img{width:58px;height:58px;object-fit:cover;border-radius:6px}.ai-g-{{ai_gen_id}}__rating{color:{{block.settings.star_color}}}.ai-g-{{ai_gen_id}}__date{font-size:12px;color:{{block.settings.muted_color}}}@keyframes ai-g-{{ai_gen_id}}{to{transform:translateX(calc(-50% - 10px))}}{% endstyle %}<customer-testimonials-{{ai_gen_id}} class="ai-g-{{ai_gen_id}}" {{block.shopify_attributes}}><h2>{{block.settings.heading|escape}}</h2><p class="ai-g-{{ai_gen_id}}__intro">{{block.settings.intro|escape}}</p><div style="overflow:hidden"><div class="ai-g-{{ai_gen_id}}__track">{% for copy in (1..2) %}<div class="ai-g-{{ai_gen_id}}__set">{% for i in (1..6) %}{% assign nk='name_'|append:i %}{% assign dk='date_'|append:i %}{% assign rk='review_'|append:i %}{% assign ak='avatar_'|append:i %}<article class="ai-g-{{ai_gen_id}}__card"><div>{% if block.settings[ak] %}<img class="ai-g-{{ai_gen_id}}__avatar" src="{{block.settings[ak]|image_url:width:92}}" alt="">{% endif %}<strong> {{block.settings[nk]|escape}}</strong><svg width="20" height="20" viewBox="0 0 24 24" aria-label="Google" role="img"><path fill="#4285F4" d="M21.35 12.27c0-.72-.06-1.42-.18-2.09H12v3.96h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.26z"/><path fill="#34A853" d="M12 21.6c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.29v2.53A9.74 9.74 0 0 0 12 21.6z"/><path fill="#FBBC05" d="M6.54 13.68A5.86 5.86 0 0 1 6.23 12c0-.58.11-1.15.31-1.68V7.79H3.29A9.75 9.75 0 0 0 2.25 12c0 1.57.38 3.05 1.04 4.21l3.25-2.53z"/><path fill="#EA4335" d="M12 6.29c1.43 0 2.72.49 3.73 1.45l2.8-2.8C16.84 3.27 14.63 2.4 12 2.4a9.74 9.74 0 0 0-8.71 5.39l3.25 2.53C7.31 8.01 9.46 6.29 12 6.29z"/></svg></div><span class="ai-g-{{ai_gen_id}}__date" data-date="{{block.settings[dk]|escape}}">{{block.settings[dk]|escape}}</span><div class="ai-g-{{ai_gen_id}}__rating">★★★★★</div><p>{{block.settings[rk]|escape}}</p><div class="ai-g-{{ai_gen_id}}__products">{% for p in (1..3) %}{% assign pk='product_'|append:i|append:'_'|append:p %}{% if block.settings[pk] %}<img src="{{block.settings[pk]|image_url:width:120}}" alt="">{% endif %}{% endfor %}</div></article>{% endfor %}</div>{% endfor %}</div></div></customer-testimonials-{{ai_gen_id}}><script>(function(){class G{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.querySelectorAll('[data-date]').forEach(e=>{let d=new Date(e.dataset.date+'T00:00:00'),n=new Date;n.setHours(0,0,0,0);if(!isNaN(d)){let x=Math.max(0,Math.floor((n-d)/86400000));e.textContent=x?x+' days ago':'Today'}})}}customElements.define('customer-testimonials-{{ai_gen_id}}',G{{ai_gen_id}})})();</script>{% schema %}{"name":"Customer testimonials","settings":[{"type":"text","id":"heading","label":"Heading","default":"Loved by our customers"},{"type":"textarea","id":"intro","label":"Intro","default":"Real experiences from our customers."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"scroll_speed","label":"Scroll speed","min":20,"max":120,"step":10,"unit":"s","default":60},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},{"type":"color","id":"heading_color","label":"Heading","default":"#0d3a1d"},{"type":"color","id":"muted_color","label":"Muted text","default":"#5b6660"},{"type":"color","id":"star_color","label":"Stars","default":"#d99b00"},{"type":"header","content":"Upload testimonial images"},{"type":"paragraph","content":"Each testimonial includes one profile image and three product images."},{"type":"image_picker","id":"avatar_1","label":"Profile image 1"},{"type":"image_picker","id":"product_1_1","label":"Testimonial 1 product 1"},{"type":"image_picker","id":"product_1_2","label":"Testimonial 1 product 2"},{"type":"image_picker","id":"product_1_3","label":"Testimonial 1 product 3"},{"type":"image_picker","id":"avatar_2","label":"Profile image 2"},{"type":"image_picker","id":"product_2_1","label":"Testimonial 2 product 1"},{"type":"image_picker","id":"product_2_2","label":"Testimonial 2 product 2"},{"type":"image_picker","id":"product_2_3","label":"Testimonial 2 product 3"},{"type":"image_picker","id":"avatar_3","label":"Profile image 3"},{"type":"image_picker","id":"product_3_1","label":"Testimonial 3 product 1"},{"type":"image_picker","id":"product_3_2","label":"Testimonial 3 product 2"},{"type":"image_picker","id":"product_3_3","label":"Testimonial 3 product 3"},{"type":"image_picker","id":"avatar_4","label":"Profile image 4"},{"type":"image_picker","id":"product_4_1","label":"Testimonial 4 product 1"},{"type":"image_picker","id":"product_4_2","label":"Testimonial 4 product 2"},{"type":"image_picker","id":"product_4_3","label":"Testimonial 4 product 3"},{"type":"image_picker","id":"avatar_5","label":"Profile image 5"},{"type":"image_picker","id":"product_5_1","label":"Testimonial 5 product 1"},{"type":"image_picker","id":"product_5_2","label":"Testimonial 5 product 2"},{"type":"image_picker","id":"product_5_3","label":"Testimonial 5 product 3"},{"type":"image_picker","id":"avatar_6","label":"Profile image 6"},{"type":"image_picker","id":"product_6_1","label":"Testimonial 6 product 1"},{"type":"image_picker","id":"product_6_2","label":"Testimonial 6 product 2"},{"type":"image_picker","id":"product_6_3","label":"Testimonial 6 product 3"}],"presets":[{"name":"Customer testimonials"}],"tag":null,"class":"customer-testimonials-block"}{% endschema %}