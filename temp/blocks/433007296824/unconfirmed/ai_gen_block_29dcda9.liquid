{% doc %}
  @prompt
    Create a customer testimonials section with the following features:
    - End-to-end automatic infinite scrolling carousel (auto-scroll, no pause)
    - Google logo/icon displayed on each testimonial card
    - Customer profile image
    - Customer name
    - Review date showing how many days ago the review was written
    - Star rating display
    - Text review content
    - 3 product image upload options per testimonial card
    - Clean, modern card layout
    - Smooth continuous scrolling animation
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-testimonials-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;overflow:hidden;padding:48px 0;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}
.ai-testimonials-{{ ai_gen_id }}__header{max-width:760px;margin:0 auto 28px;padding:0 20px;text-align:{{ block.settings.heading_alignment }}}
.ai-testimonials-{{ ai_gen_id }}__heading{margin:0 0 10px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px;line-height:1.15}.ai-testimonials-{{ ai_gen_id }}__intro{margin:0;color:{{ block.settings.muted_color }};line-height:1.6}.ai-testimonials-{{ ai_gen_id }}__viewport{overflow:hidden;width:100%}.ai-testimonials-{{ ai_gen_id }}__track,.ai-testimonials-{{ ai_gen_id }}__group{display:flex;gap:18px}.ai-testimonials-{{ ai_gen_id }}__track{width:max-content;animation:ai-scroll-{{ ai_gen_id }} {{ block.settings.scroll_duration }}s linear infinite;will-change:transform}.ai-testimonials-{{ ai_gen_id }}__group{flex-shrink:0}.ai-testimonials-{{ ai_gen_id }}__card{display:flex;flex-direction:column;flex:0 0 min(360px,82vw);min-height:300px;padding:22px;border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.card_background }};box-shadow:0 10px 28px rgba(13,58,29,.08)}.ai-testimonials-{{ ai_gen_id }}__top{display:flex;align-items:center;gap:12px;margin-bottom:16px}.ai-testimonials-{{ ai_gen_id }}__avatar,.ai-testimonials-{{ ai_gen_id }}__avatar-placeholder{width:48px;height:48px;flex:0 0 48px;border-radius:50%;object-fit:cover;background:{{ block.settings.placeholder_color }};display:flex;align-items:center;justify-content:center;color:{{ block.settings.muted_color }};font-weight:700}.ai-testimonials-{{ ai_gen_id }}__name{margin:0;color:{{ block.settings.heading_color }};font-size:16px}.ai-testimonials-{{ ai_gen_id }}__date{margin:3px 0 0;color:{{ block.settings.muted_color }};font-size:13px}.ai-testimonials-{{ ai_gen_id }}__google{width:21px;height:21px;margin-left:auto;flex:0 0 21px}.ai-testimonials-{{ ai_gen_id }}__rating{margin-bottom:13px;color:{{ block.settings.star_color }};font-size:19px;letter-spacing:1px}.ai-testimonials-{{ ai_gen_id }}__review{flex:1;margin:0 0 18px;color:{{ block.settings.heading_color }};font-size:15px;line-height:1.6}.ai-testimonials-{{ ai_gen_id }}__products{display:flex;gap:8px;padding-top:16px;border-top:1px solid {{ block.settings.border_color }}}.ai-testimonials-{{ ai_gen_id }}__product,.ai-testimonials-{{ ai_gen_id }}__product-placeholder{width:54px;height:54px;border-radius:8px;object-fit:cover;background:{{ block.settings.placeholder_color }};display:flex;align-items:center;justify-content:center}.ai-testimonials-{{ ai_gen_id }}__product-placeholder svg{width:30px;height:30px;opacity:.35}@keyframes ai-scroll-{{ ai_gen_id }}{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 9px))}}@media(max-width:749px){.ai-testimonials-{{ ai_gen_id }}{padding:36px 0}.ai-testimonials-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size | times: 0.85 }}px}}
{% endstyle %}
<infinite-testimonials-{{ ai_gen_id }} class="ai-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% if block.settings.heading != blank or block.settings.intro != blank %}<div class="ai-testimonials-{{ ai_gen_id }}__header">{% if block.settings.heading != blank %}<h2 class="ai-testimonials-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.intro != blank %}<p class="ai-testimonials-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}</div>{% endif %}
<div class="ai-testimonials-{{ ai_gen_id }}__viewport"><div class="ai-testimonials-{{ ai_gen_id }}__track">{% for copy in (1..2) %}<div class="ai-testimonials-{{ ai_gen_id }}__group" {% if copy == 2 %}aria-hidden="true"{% endif %}>{% for i in (1..3) %}{% liquid
assign nk='testimonial_' | append:i | append:'_name'
assign dk='testimonial_' | append:i | append:'_date'
assign rk='testimonial_' | append:i | append:'_rating'
assign vk='testimonial_' | append:i | append:'_review'
assign ak='testimonial_' | append:i | append:'_avatar'
assign p1k='testimonial_' | append:i | append:'_product_1'
assign p2k='testimonial_' | append:i | append:'_product_2'
assign p3k='testimonial_' | append:i | append:'_product_3'
assign name=block.settings[nk]
assign date=block.settings[dk]
assign rating=block.settings[rk]
assign review=block.settings[vk]
assign avatar=block.settings[ak]
assign p1=block.settings[p1k]
assign p2=block.settings[p2k]
assign p3=block.settings[p3k]
%}<article class="ai-testimonials-{{ ai_gen_id }}__card"><div class="ai-testimonials-{{ ai_gen_id }}__top">{% if avatar %}<img class="ai-testimonials-{{ ai_gen_id }}__avatar" src="{{ avatar | image_url: width: 96 }}" alt="{{ name | escape }}" loading="lazy" width="48" height="48">{% else %}<div class="ai-testimonials-{{ ai_gen_id }}__avatar-placeholder" aria-hidden="true">{{ name | slice: 0, 1 | upcase }}</div>{% endif %}<div><h3 class="ai-testimonials-{{ ai_gen_id }}__name">{{ name | escape }}</h3><p class="ai-testimonials-{{ ai_gen_id }}__date" data-review-date="{{ date | escape }}">{{ date | escape }}</p></div><svg class="ai-testimonials-{{ ai_gen_id }}__google" viewBox="0 0 24 24" aria-label="Google review"><path fill="#4285F4" d="M21.35 12.27c0-.71-.06-1.4-.18-2.06H12v3.9h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.23z"/><path fill="#34A853" d="M12 21.75c2.63 0 4.84-.87 6.45-2.35l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.3v2.53A9.75 9.75 0 0 0 12 21.75z"/><path fill="#FBBC05" d="M6.54 13.84A5.86 5.86 0 0 1 6.23 12c0-.64.11-1.26.31-1.84V7.63H3.3A9.75 9.75 0 0 0 2.25 12c0 1.57.38 3.05 1.05 4.37l3.24-2.53z"/><path fill="#EA4335" d="M12 6.13c1.43 0 2.71.49 3.72 1.45l2.79-2.79C16.84 3.1 14.63 2.25 12 2.25a9.75 9.75 0 0 0-8.7 5.38l3.24 2.53C7.31 7.85 9.46 6.13 12 6.13z"/></svg></div><div class="ai-testimonials-{{ ai_gen_id }}__rating" aria-label="{{ rating }} out of 5 stars">{% case rating %}{% when '1' %}★☆☆☆☆{% when '2' %}★★☆☆☆{% when '3' %}★★★☆☆{% when '4' %}★★★★☆{% else %}★★★★★{% endcase %}</div><p class="ai-testimonials-{{ ai_gen_id }}__review">{{ review | escape }}</p><div class="ai-testimonials-{{ ai_gen_id }}__products">{% if p1 %}<img class="ai-testimonials-{{ ai_gen_id }}__product" src="{{ p1 | image_url: width: 108 }}" alt="" loading="lazy" width="54" height="54">{% else %}<div class="ai-testimonials-{{ ai_gen_id }}__product-placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}{% if p2 %}<img class="ai-testimonials-{{ ai_gen_id }}__product" src="{{ p2 | image_url: width: 108 }}" alt="" loading="lazy" width="54" height="54">{% else %}<div class="ai-testimonials-{{ ai_gen_id }}__product-placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}{% if p3 %}<img class="ai-testimonials-{{ ai_gen_id }}__product" src="{{ p3 | image_url: width: 108 }}" alt="" loading="lazy" width="54" height="54">{% else %}<div class="ai-testimonials-{{ ai_gen_id }}__product-placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div></article>{% endfor %}</div>{% endfor %}</div></div></infinite-testimonials-{{ ai_gen_id }}>
<script>(function(){class InfiniteTestimonials{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.querySelectorAll('[data-review-date]').forEach(e=>{const d=new Date(e.dataset.reviewDate);if(!Number.isNaN(d.getTime())){const n=Math.max(0,Math.floor((Date.now()-d.getTime())/86400000));e.textContent=n===1?'1 day ago':n+' days ago'}})}}if(!customElements.get('infinite-testimonials-{{ ai_gen_id }}'))customElements.define('infinite-testimonials-{{ ai_gen_id }}',InfiniteTestimonials{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Customer testimonials","settings":[{"type":"text","id":"heading","label":"Heading","default":"What our customers say"},{"type":"textarea","id":"intro","label":"Intro","default":"Real feedback from customers who shop with us."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"scroll_duration","label":"Scroll duration","min":20,"max":120,"step":10,"unit":"s","default":60},{"type":"select","id":"heading_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":52,"step":2,"unit":"px","default":34},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},{"type":"color","id":"card_background","label":"Card background","default":"#ffffff"},{"type":"color","id":"border_color","label":"Card border","default":"#d9e2d8"},{"type":"color","id":"heading_color","label":"Heading and review text","default":"#0d3a1d"},{"type":"color","id":"muted_color","label":"Supporting text","default":"#5b6660"},{"type":"color","id":"star_color","label":"Stars","default":"#b87900"},{"type":"color","id":"placeholder_color","label":"Image placeholder","default":"#e8efe4"},{"type":"header","content":"Testimonial 1"},{"type":"text","id":"testimonial_1_name","label":"Customer name"},{"type":"text","id":"testimonial_1_date","label":"Review date","default":"2026-09-01"},{"type":"select","id":"testimonial_1_rating","label":"Star rating","options":[{"value":"1","label":"1 star"},{"value":"2","label":"2 stars"},{"value":"3","label":"3 stars"},{"value":"4","label":"4 stars"},{"value":"5","label":"5 stars"}],"default":"5"},{"type":"textarea","id":"testimonial_1_review","label":"Review content"},{"type":"image_picker","id":"testimonial_1_avatar","label":"Profile image"},{"type":"image_picker","id":"testimonial_1_product_1","label":"Product image 1"},{"type":"image_picker","id":"testimonial_1_product_2","label":"Product image 2"},{"type":"image_picker","id":"testimonial_1_product_3","label":"Product image 3"},{"type":"header","content":"Testimonial 2"},{"type":"text","id":"testimonial_2_name","label":"Customer name"},{"type":"text","id":"testimonial_2_date","label":"Review date","default":"2026-08-15"},{"type":"select","id":"testimonial_2_rating","label":"Star rating","options":[{"value":"1","label":"1 star"},{"value":"2","label":"2 stars"},{"value":"3","label":"3 stars"},{"value":"4","label":"4 stars"},{"value":"5","label":"5 stars"}],"default":"5"},{"type":"textarea","id":"testimonial_2_review","label":"Review content"},{"type":"image_picker","id":"testimonial_2_avatar","label":"Profile image"},{"type":"image_picker","id":"testimonial_2_product_1","label":"Product image 1"},{"type":"image_picker","id":"testimonial_2_product_2","label":"Product image 2"},{"type":"image_picker","id":"testimonial_2_product_3","label":"Product image 3"},{"type":"header","content":"Testimonial 3"},{"type":"text","id":"testimonial_3_name","label":"Customer name"},{"type":"text","id":"testimonial_3_date","label":"Review date","default":"2026-07-20"},{"type":"select","id":"testimonial_3_rating","label":"Star rating","options":[{"value":"1","label":"1 star"},{"value":"2","label":"2 stars"},{"value":"3","label":"3 stars"},{"value":"4","label":"4 stars"},{"value":"5","label":"5 stars"}],"default":"5"},{"type":"textarea","id":"testimonial_3_review","label":"Review content"},{"type":"image_picker","id":"testimonial_3_avatar","label":"Profile image"},{"type":"image_picker","id":"testimonial_3_product_1","label":"Product image 1"},{"type":"image_picker","id":"testimonial_3_product_2","label":"Product image 2"},{"type":"image_picker","id":"testimonial_3_product_3","label":"Product image 3"}],"presets":[{"name":"Customer testimonials"}],"tag":null,"class":"customer-testimonials-block"}{% endschema %}