{% doc %}
  @prompt
    Create a customer testimonials section with the following features:
    - End-to-end automatic infinite scrolling carousel (auto-scroll, no pause)
    - Google logo/icon displayed on each testimonial card
    - Customer profile image
    - Customer name
    - Review date showing how many days ago the review was written
    - Star rating display
    - Text review content
    - 3 product image upload options per testimonial card
    - Clean, modern card layout
    - Smooth continuous scrolling animation
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    overflow: hidden;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-testimonials-{{ ai_gen_id }}__header {
    max-width: 720px;
    margin: 0 auto 28px;
    padding: 0 24px;
    text-align: center;
  }

  .ai-testimonials-{{ ai_gen_id }}__heading {
    margin: 0 0 10px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .ai-testimonials-{{ ai_gen_id }}__intro {
    margin: 0;
    color: {{ block.settings.muted_color }};
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-testimonials-{{ ai_gen_id }}__viewport {
    overflow: hidden;
    width: 100%;
  }

  .ai-testimonials-{{ ai_gen_id }}__track {
    display: flex;
    width: max-content;
    gap: 20px;
    animation: ai-testimonials-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-testimonials-{{ ai_gen_id }}__set {
    display: flex;
    gap: 20px;
  }

  .ai-testimonials-{{ ai_gen_id }}__card {
    width: min(360px, 78vw);
    flex: 0 0 min(360px, 78vw);
    padding: 24px;
    background: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border }};
    border-radius: {{ block.settings.card_radius }}px;
    box-shadow: 0 8px 24px rgba(13, 58, 29, 0.08);
  }

  .ai-testimonials-{{ ai_gen_id }}__top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .ai-testimonials-{{ ai_gen_id }}__avatar,
  .ai-testimonials-{{ ai_gen_id }}__avatar-placeholder {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    border-radius: 50%;
    object-fit: cover;
    background: {{ block.settings.avatar_background }};
  }

  .ai-testimonials-{{ ai_gen_id }}__avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.muted_color }};
    font-size: 18px;
    font-weight: 700;
  }

  .ai-testimonials-{{ ai_gen_id }}__name {
    margin: 0 0 3px;
    color: {{ block.settings.heading_color }};
    font-size: 16px;
    font-weight: 700;
  }

  .ai-testimonials-{{ ai_gen_id }}__date {
    color: {{ block.settings.muted_color }};
    font-size: 13px;
  }

  .ai-testimonials-{{ ai_gen_id }}__google {
    width: 20px;
    height: 20px;
    margin-left: auto;
    flex: 0 0 20px;
  }

  .ai-testimonials-{{ ai_gen_id }}__rating {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 12px;
    color: {{ block.settings.star_color }};
    font-size: 18px;
    letter-spacing: 1px;
  }

  .ai-testimonials-{{ ai_gen_id }}__review {
    min-height: 84px;
    margin: 0 0 18px;
    color: {{ block.settings.text_color }};
    font-size: 15px;
    line-height: 1.6;
  }

  .ai-testimonials-{{ ai_gen_id }}__products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .ai-testimonials-{{ ai_gen_id }}__product,
  .ai-testimonials-{{ ai_gen_id }}__product-placeholder {
    aspect-ratio: 1;
    width: 100%;
    overflow: hidden;
    border-radius: 8px;
    background: {{ block.settings.avatar_background }};
  }

  .ai-testimonials-{{ ai_gen_id }}__product {
    object-fit: cover;
  }

  .ai-testimonials-{{ ai_gen_id }}__product-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonials-{{ ai_gen_id }}__product-placeholder svg {
    width: 55%;
    height: 55%;
    color: {{ block.settings.muted_color }};
  }

  @keyframes ai-testimonials-scroll-{{ ai_gen_id }} {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 10px)); }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-{{ ai_gen_id }}__heading { font-size: {{ block.settings.heading_size | times: 0.8 }}px; }
    .ai-testimonials-{{ ai_gen_id }}__card { padding: 20px; }
  }
{% endstyle %}

<customer-testimonials-{{ ai_gen_id }} class="ai-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials-{{ ai_gen_id }}__header">
    {% if block.settings.heading != blank %}<h2 class="ai-testimonials-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.intro != blank %}<p class="ai-testimonials-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}
  </div>
  <div class="ai-testimonials-{{ ai_gen_id }}__viewport">
    <div class="ai-testimonials-{{ ai_gen_id }}__track">
      {% for copy in (1..2) %}
        <div class="ai-testimonials-{{ ai_gen_id }}__set">
          {% for i in (1..3) %}
            {% liquid
              assign name_key = 'name_' | append: i
              assign date_key = 'date_' | append: i
              assign rating_key = 'rating_' | append: i
              assign review_key = 'review_' | append: i
              assign avatar_key = 'avatar_' | append: i
              assign product_one_key = 'product_' | append: i | append: '_one'
              assign product_two_key = 'product_' | append: i | append: '_two'
              assign product_three_key = 'product_' | append: i | append: '_three'
              assign review_name = block.settings[name_key]
              assign review_date = block.settings[date_key]
              assign review_rating = block.settings[rating_key]
              assign review_text = block.settings[review_key]
              assign avatar = block.settings[avatar_key]
            %}
            <article class="ai-testimonials-{{ ai_gen_id }}__card" data-review-date="{{ review_date | escape }}">
              <div class="ai-testimonials-{{ ai_gen_id }}__top">
                {% if avatar %}<img class="ai-testimonials-{{ ai_gen_id }}__avatar" src="{{ avatar | image_url: width: 96 }}" alt="{{ review_name | escape }}" loading="lazy" width="48" height="48">{% else %}<div class="ai-testimonials-{{ ai_gen_id }}__avatar-placeholder" aria-hidden="true">{{ review_name | slice: 0 | upcase }}</div>{% endif %}
                <div><p class="ai-testimonials-{{ ai_gen_id }}__name">{{ review_name | escape }}</p><span class="ai-testimonials-{{ ai_gen_id }}__date">{{ review_date | escape }}</span></div>
                <svg class="ai-testimonials-{{ ai_gen_id }}__google" viewBox="0 0 24 24" aria-label="Google review" role="img"><path fill="#4285F4" d="M21.35 12.27c0-.72-.06-1.42-.18-2.09H12v3.96h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.7 2.91-4.2 2.91-7.26Z"/><path fill="#34A853" d="M12 21.5c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.3v2.53A9.74 9.74 0 0 0 12 21.5Z"/><path fill="#FBBC05" d="M6.54 13.58a5.86 5.86 0 0 1 0-3.16V7.89H3.3a9.75 9.75 0 0 0 0 8.22l3.24-2.53Z"/><path fill="#EA4335" d="M12 6.39c1.43 0 2.71.49 3.72 1.45l2.79-2.79C16.84 3.35 14.63 2.5 12 2.5a9.74 9.74 0 0 0-8.7 5.39l3.24 2.53C7.31 8.11 9.46 6.39 12 6.39Z"/></svg>
              </div>
              <div class="ai-testimonials-{{ ai_gen_id }}__rating" aria-label="{{ review_rating }} out of 5 stars">{% if review_rating == 5 %}★★★★★{% elsif review_rating == 4 %}★★★★☆{% elsif review_rating == 3 %}★★★☆☆{% elsif review_rating == 2 %}★★☆☆☆{% else %}★☆☆☆☆{% endif %}</div>
              <p class="ai-testimonials-{{ ai_gen_id }}__review">{{ review_text | escape }}</p>
              <div class="ai-testimonials-{{ ai_gen_id }}__products">
                {% for product_key in (product_one_key..product_three_key) %}{% assign product_image = block.settings[product_key] %}{% if product_image %}<img class="ai-testimonials-{{ ai_gen_id }}__product" src="{{ product_image | image_url: width: 240 }}" alt="" loading="lazy" width="100" height="100">{% else %}<div class="ai-testimonials-{{ ai_gen_id }}__product-placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}{% endfor %}
              </div>
            </article>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</customer-testimonials-{{ ai_gen_id }}>

<script>
(function() {
  class CustomerTestimonials{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll('[data-review-date]').forEach((card) => {
        const value = card.dataset.reviewDate;
        const date = new Date(value + 'T00:00:00');
        const label = card.querySelector('.ai-testimonials-{{ ai_gen_id }}__date');
        if (!Number.isNaN(date.getTime()) && label) {
          const today = new Date();
          today.setHours(0, 0, 0, 0);
          const days = Math.max(0, Math.floor((today - date) / 86400000));
          label.textContent = days === 0 ? 'Today' : days === 1 ? '1 day ago' : days + ' days ago';
        }
      });
    }
  }
  customElements.define('customer-testimonials-{{ ai_gen_id }}', CustomerTestimonials{{ ai_gen_id }});
})();
</script>

