    {"type":"select","id":"rating_3","label":"Rating","options":[{"value":"5","label":"5 stars"},{"value":"4","label":"4 stars"},{"value":"3","label":"3 stars"},{"value":"2","label":"2 stars"},{"value":"1","label":"1 star"}],"default":"5"},
    {"type":"textarea","id":"review_3","label":"Review","default":"Beautiful products, helpful service, and a great overall shopping experience."},
    {"type":"image_picker","id":"avatar_3","label":"Profile image"},
