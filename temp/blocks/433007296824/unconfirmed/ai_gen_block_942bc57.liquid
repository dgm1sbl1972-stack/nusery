{% doc %}
  @prompt
    Create a customer testimonials section with the following features:
    - End-to-end automatic infinite scrolling carousel (auto-scroll, no pause)
    - Google logo/icon displayed on each testimonial card
    - Customer profile image
    - Customer name
    - Review date showing how many days ago the review was written
    - Star rating display
    - Text review content
    - 3 product image upload options per testimonial card
    - Clean, modern card layout
    - Smooth continuous scrolling animation, need for 6 testinomials, heading can be center
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-t-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;overflow:hidden;background:{{block.settings.background_color}};padding:40px 0}.ai-t-{{ai_gen_id}}__heading{text-align:center;color:{{block.settings.heading_color}};margin:0 auto 10px}.ai-t-{{ai_gen_id}}__intro{text-align:center;color:{{block.settings.muted_color}};margin:0 auto 28px}.ai-t-{{ai_gen_id}}__track{display:flex;width:max-content;gap:20px;animation:ai-t-{{ai_gen_id}} {{block.settings.scroll_speed}}s linear infinite}.ai-t-{{ai_gen_id}}__set{display:flex;gap:20px}.ai-t-{{ai_gen_id}}__card{width:320px;flex:0 0 320px;padding:22px;background:#fff;border-radius:{{block.settings.card_radius}}px}.ai-t-{{ai_gen_id}}__avatar{width:46px;height:46px;border-radius:50%;object-fit:cover}.ai-t-{{ai_gen_id}}__rating{color:{{block.settings.star_color}}}.ai-t-{{ai_gen_id}}__date{font-size:12px;color:{{block.settings.muted_color}}}@keyframes ai-t-{{ai_gen_id}}{to{transform:translateX(calc(-50% - 10px))}}{% endstyle %}<customer-testimonials-{{ai_gen_id}} class="ai-t-{{ai_gen_id}}" {{block.shopify_attributes}}><h2 class="ai-t-{{ai_gen_id}}__heading">{{block.settings.heading|escape}}</h2><p class="ai-t-{{ai_gen_id}}__intro">{{block.settings.intro|escape}}</p><div style="overflow:hidden"><div class="ai-t-{{ai_gen_id}}__track">{% for copy in (1..2) %}<div class="ai-t-{{ai_gen_id}}__set">{% for i in (1..6) %}{% assign nk='name_'|append:i %}{% assign dk='date_'|append:i %}{% assign qk='review_'|append:i %}<article class="ai-t-{{ai_gen_id}}__card"><div>{% assign ak='avatar_'|append:i %}{% if block.settings[ak] %}<img class="ai-t-{{ai_gen_id}}__avatar" src="{{block.settings[ak]|image_url:width:92}}" alt="">{% endif %} <strong>{{block.settings[nk]|escape}}</strong> <span aria-label="Google review">G</span></div><span class="ai-t-{{ai_gen_id}}__date" data-date="{{block.settings[dk]|escape}}">{{block.settings[dk]|escape}}</span><div class="ai-t-{{ai_gen_id}}__rating">★★★★★</div><p>{{block.settings[qk]|escape}}</p></article>{% endfor %}</div>{% endfor %}</div></div></customer-testimonials-{{ai_gen_id}}><script>(function(){class T{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.querySelectorAll('[data-date]').forEach(e=>{let d=new Date(e.dataset.date+'T00:00:00'),n=new Date;n.setHours(0,0,0,0);if(!isNaN(d)) {let x=Math.max(0,Math.floor((n-d)/86400000));e.textContent=x==0?'Today':x==1?'1 day ago':x+' days ago'}})}}customElements.define('customer-testimonials-{{ai_gen_id}}',T{{ai_gen_id}})})();</script>{% schema %}{"name":"Customer testimonials","settings":[{"type":"text","id":"heading","label":"Heading","default":"Loved by our customers"},{"type":"textarea","id":"intro","label":"Intro","default":"Real experiences from customers who shop with us."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"scroll_speed","label":"Scroll speed","min":20,"max":120,"step":10,"unit":"s","default":60},{"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},{"type":"color","id":"heading_color","label":"Heading","default":"#0d3a1d"},{"type":"color","id":"muted_color","label":"Muted text","default":"#5b6660"},{"type":"color","id":"star_color","label":"Stars","default":"#d99b00"},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"header","content":"Testimonials"},{"type":"text","id":"name_1","label":"Name 1","default":"Customer one"},{"type":"text","id":"date_1","label":"Date 1","default":"2026-09-01"},{"type":"textarea","id":"review_1","label":"Review 1","default":"A wonderful experience."},{"type":"image_picker","id":"avatar_1","label":"Profile 1"},{"type":"text","id":"name_2","label":"Name 2","default":"Customer two"},{"type":"text","id":"date_2","label":"Date 2","default":"2026-08-20"},{"type":"textarea","id":"review_2","label":"Review 2","default":"Excellent quality."},{"type":"image_picker","id":"avatar_2","label":"Profile 2"},{"type":"text","id":"name_3","label":"Name 3","default":"Customer three"},{"type":"text","id":"date_3","label":"Date 3","default":"2026-08-10"},{"type":"textarea","id":"review_3","label":"Review 3","default":"Beautiful products."},{"type":"image_picker","id":"avatar_3","label":"Profile 3"},{"type":"text","id":"name_4","label":"Name 4","default":"Customer four"},{"type":"text","id":"date_4","label":"Date 4","default":"2026-08-01"},{"type":"textarea","id":"review_4","label":"Review 4","default":"Very happy with my purchase."},{"type":"image_picker","id":"avatar_4","label":"Profile 4"},{"type":"text","id":"name_5","label":"Name 5","default":"Customer five"},{"type":"text","id":"date_5","label":"Date 5","default":"2026-07-20"},{"type":"textarea","id":"review_5","label":"Review 5","default":"Fast delivery."},{"type":"image_picker","id":"avatar_5","label":"Profile 5"},{"type":"text","id":"name_6","label":"Name 6","default":"Customer six"},{"type":"text","id":"date_6","label":"Date 6","default":"2026-07-10"},{"type":"textarea","id":"review_6","label":"Review 6","default":"A smooth experience."},{"type":"image_picker","id":"avatar_6","label":"Profile 6"}],"presets":[{"name":"Customer testimonials"}],"tag":null,"class":"customer-testimonials-block"}{% endschema %}