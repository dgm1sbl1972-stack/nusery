{% doc %}
  @prompt
    need one google testimonial for 6 testimonials auto scrolling and need google logo in the each testimonial with text name profile image upload and 3 images for the upload the product , product image for each testimonials, need 3 images, original google logo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-google-reviews-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;max-width:100%;overflow:hidden;background:#f8f4ec;padding:40px 0}.ai-google-reviews-{{ai_gen_id}}__track{display:flex;gap:20px;width:max-content;animation:ai-google-scroll-{{ai_gen_id}} {{block.settings.scroll_speed}}s linear infinite}.ai-google-reviews-{{ai_gen_id}}:hover .ai-google-reviews-{{ai_gen_id}}__track{animation-play-state:paused}.ai-google-card-{{ai_gen_id}}{width:350px;flex:0 0 350px;padding:22px;background:#fff;border:1px solid #dce5de;border-radius:16px;color:#14231a}.ai-google-card-{{ai_gen_id}}__top{display:flex;align-items:center;gap:10px}.ai-google-card-{{ai_gen_id}}__profile{width:44px;height:44px;border-radius:50%;object-fit:cover}.ai-google-card-{{ai_gen_id}}__name{margin:0;font-weight:700}.ai-google-card-{{ai_gen_id}}__logo{margin-left:auto;width:28px;height:28px}.ai-google-card-{{ai_gen_id}}__stars{color:#b77900;letter-spacing:2px;margin:14px 0 8px}.ai-google-card-{{ai_gen_id}}__quote{line-height:1.6;margin:0 0 18px}.ai-google-card-{{ai_gen_id}}__products{display:flex;gap:8px}.ai-google-card-{{ai_gen_id}}__products img{width:78px;height:78px;object-fit:cover;border-radius:8px}@keyframes ai-google-scroll-{{ai_gen_id}}{to{transform:translateX(calc(-50% - 10px))}}@media(prefers-reduced-motion:reduce){.ai-google-reviews-{{ai_gen_id}}__track{animation:none}}{% endstyle %}<google-reviews-{{ai_gen_id}} class="ai-google-reviews-{{ai_gen_id}}" {{block.shopify_attributes}}><h2>{{block.settings.heading|escape}}</h2><div class="ai-google-reviews-{{ai_gen_id}}__track">{% for copy in (1..2) %}{% for i in (1..6) %}{% assign n='testimonial_'|append:i|append:'_name' %}{% assign q='testimonial_'|append:i|append:'_quote' %}{% assign pf='testimonial_'|append:i|append:'_profile' %}{% assign p1='testimonial_'|append:i|append:'_product_1' %}{% assign p2='testimonial_'|append:i|append:'_product_2' %}{% assign p3='testimonial_'|append:i|append:'_product_3' %}<article class="ai-google-card-{{ai_gen_id}}"><div class="ai-google-card-{{ai_gen_id}}__top">{% if block.settings[pf] %}<img class="ai-google-card-{{ai_gen_id}}__profile" src="{{block.settings[pf]|image_url:width:88}}" alt="{{block.settings[n]|escape}}" width="44" height="44">{% endif %}<div><p class="ai-google-card-{{ai_gen_id}}__name">{{block.settings[n]|escape}}</p><small>Google review</small></div><svg class="ai-google-card-{{ai_gen_id}}__logo" viewBox="0 0 48 48" role="img" aria-label="Google"><path fill="#4285F4" d="M46.5 24.5c0-1.7-.2-3.4-.5-5H24v9.5h12.7c-.5 3.1-2.3 5.7-4.9 7.4v6.2h7.9c4.6-4.2 6.8-10.4 6.8-18.1z"/><path fill="#34A853" d="M24 47c6.6 0 12.1-2.2 16.1-5.9l-7.9-6.2c-2.2 1.5-5 2.4-8.2 2.4-6.3 0-11.7-4.3-13.6-10.1H2.3v6.4C6.3 41.6 14.4 47 24 47z"/><path fill="#FBBC05" d="M10.4 27.2c-.5-1.5-.8-3.1-.8-4.7s.3-3.2.8-4.7v-6.4H2.3C.8 14.4 0 18.2 0 22.5s.8 8.1 2.3 11.1l8.1-6.4z"/><path fill="#EA4335" d="M24 9.4c3.6 0 6.8 1.2 9.3 3.6l7-7C36.1 2.2 30.6 0 24 0 14.4 0 6.3 5.4 2.3 13.6l8.1 6.4C12.3 13.7 17.7 9.4 24 9.4z"/></svg></div><div class="ai-google-card-{{ai_gen_id}}__stars">★★★★★</div><p class="ai-google-card-{{ai_gen_id}}__quote">{{block.settings[q]|escape}}</p><div class="ai-google-card-{{ai_gen_id}}__products">{% if block.settings[p1] %}<img src="{{block.settings[p1]|image_url:width:156}}" alt="" width="78" height="78">{% endif %}{% if block.settings[p2] %}<img src="{{block.settings[p2]|image_url:width:156}}" alt="" width="78" height="78">{% endif %}{% if block.settings[p3] %}<img src="{{block.settings[p3]|image_url:width:156}}" alt="" width="78" height="78">{% endif %}</div></article>{% endfor %}{% endfor %}</div></google-reviews-{{ai_gen_id}}>{% schema %}{"name":"Google testimonials","tag":null,"class":"google-testimonials-block","settings":[{"type":"text","id":"heading","label":"Heading","default":"What our customers say"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"scroll_speed","label":"Scroll speed","min":20,"max":120,"step":5,"unit":"s","default":60},{"type":"header","content":"Testimonials"},{"type":"text","id":"testimonial_1_name","label":"1 name","default":"Customer one"},{"type":"textarea","id":"testimonial_1_quote","label":"1 review","default":"A wonderful experience from start to finish."},{"type":"image_picker","id":"testimonial_1_profile","label":"1 profile image"},{"type":"image_picker","id":"testimonial_1_product_1","label":"1 product image 1"},{"type":"image_picker","id":"testimonial_1_product_2","label":"1 product image 2"},{"type":"image_picker","id":"testimonial_1_product_3","label":"1 product image 3"},{"type":"text","id":"testimonial_2_name","label":"2 name","default":"Customer two"},{"type":"textarea","id":"testimonial_2_quote","label":"2 review","default":"The quality and service were excellent."},{"type":"image_picker","id":"testimonial_2_profile","label":"2 profile image"},{"type":"image_picker","id":"testimonial_2_product_1","label":"2 product image 1"},{"type":"image_picker","id":"testimonial_2_product_2","label":"2 product image 2"},{"type":"image_picker","id":"testimonial_2_product_3","label":"2 product image 3"},{"type":"text","id":"testimonial_3_name","label":"3 name","default":"Customer three"},{"type":"textarea","id":"testimonial_3_quote","label":"3 review","default":"Everything arrived beautifully and on time."},{"type":"image_picker","id":"testimonial_3_profile","label":"3 profile image"},{"type":"image_picker","id":"testimonial_3_product_1","label":"3 product image 1"},{"type":"image_picker","id":"testimonial_3_product_2","label":"3 product image 2"},{"type":"image_picker","id":"testimonial_3_product_3","label":"3 product image 3"},{"type":"text","id":"testimonial_4_name","label":"4 name","default":"Customer four"},{"type":"textarea","id":"testimonial_4_quote","label":"4 review","default":"Friendly support and products I truly recommend."},{"type":"image_picker","id":"testimonial_4_profile","label":"4 profile image"},{"type":"image_picker","id":"testimonial_4_product_1","label":"4 product image 1"},{"type":"image_picker","id":"testimonial_4_product_2","label":"4 product image 2"},{"type":"image_picker","id":"testimonial_4_product_3","label":"4 product image 3"},{"type":"text","id":"testimonial_5_name","label":"5 name","default":"Customer five"},{"type":"textarea","id":"testimonial_5_quote","label":"5 review","default":"A smooth shopping experience with great results."},{"type":"image_picker","id":"testimonial_5_profile","label":"5 profile image"},{"type":"image_picker","id":"testimonial_5_product_1","label":"5 product image 1"},{"type":"image_picker","id":"testimonial_5_product_2","label":"5 product image 2"},{"type":"image_picker","id":"testimonial_5_product_3","label":"5 product image 3"},{"type":"text","id":"testimonial_6_name","label":"6 name","default":"Customer six"},{"type":"textarea","id":"testimonial_6_quote","label":"6 review","default":"Beautiful products and thoughtful service."},{"type":"image_picker","id":"testimonial_6_profile","label":"6 profile image"},{"type":"image_picker","id":"testimonial_6_product_1","label":"6 product image 1"},{"type":"image_picker","id":"testimonial_6_product_2","label":"6 product image 2"},{"type":"image_picker","id":"testimonial_6_product_3","label":"6 product image 3"}],"presets":[{"name":"Google testimonials"}]}{% endschema %}