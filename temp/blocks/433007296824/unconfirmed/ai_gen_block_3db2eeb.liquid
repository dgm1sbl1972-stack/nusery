{% doc %}
  @prompt
    need a testimonial of 6 slides where google logo and profile pic upload with name and text ratings and 3 image upload for each slides and the heading customer testimonial should come in the middle and need the testimonials automatic scroling from end to end of the desktop, need image upload size as square box
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-square-testimonials-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;overflow:hidden;background:{{ block.settings.background_color }};padding:{{ block.settings.section_padding }}px 0;color:{{ block.settings.text_color }}}
  .ai-square-testimonials-{{ ai_gen_id }}__heading{text-align:center;color:{{ block.settings.heading_color }};margin:0 auto {{ block.settings.heading_spacing }}px;font-size:{{ block.settings.heading_size }}px}
  .ai-square-testimonials-{{ ai_gen_id }}__viewport{width:100%;overflow:hidden}
  .ai-square-testimonials-{{ ai_gen_id }}__track{display:flex;width:max-content;gap:{{ block.settings.card_gap }}px;animation:ai-square-testimonials-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite}
  .ai-square-testimonials-{{ ai_gen_id }}__viewport:hover .ai-square-testimonials-{{ ai_gen_id }}__track{animation-play-state:paused}
  .ai-square-testimonials-{{ ai_gen_id }}__card{flex:0 0 min(390px,82vw);padding:24px;border:1px solid {{ block.settings.card_border_color }};border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.card_background }};box-shadow:0 8px 24px rgba(20,35,26,.08)}
  .ai-square-testimonials-{{ ai_gen_id }}__top{display:flex;align-items:center;gap:12px}.ai-square-testimonials-{{ ai_gen_id }}__profile{width:52px;height:52px;border-radius:50%;object-fit:cover}.ai-square-testimonials-{{ ai_gen_id }}__identity{flex:1}.ai-square-testimonials-{{ ai_gen_id }}__name{margin:0;color:{{ block.settings.heading_color }}}.ai-square-testimonials-{{ ai_gen_id }}__rating{color:{{ block.settings.rating_color }};letter-spacing:2px}.ai-square-testimonials-{{ ai_gen_id }}__google{width:48px;height:24px;object-fit:contain}.ai-square-testimonials-{{ ai_gen_id }}__text{line-height:1.6;margin:18px 0}.ai-square-testimonials-{{ ai_gen_id }}__gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.ai-square-testimonials-{{ ai_gen_id }}__gallery img,.ai-square-testimonials-{{ ai_gen_id }}__placeholder{display:block;width:100%;aspect-ratio:1/1;border-radius:8px;object-fit:cover;background:{{ block.settings.placeholder_background }};overflow:hidden}.ai-square-testimonials-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}
  @keyframes ai-square-testimonials-scroll-{{ ai_gen_id }}{from{transform:translateX(0)}to{transform:translateX(calc(-50% - {{ block.settings.card_gap | divided_by: 2 }}px))}}
  @media(max-width:749px){.ai-square-testimonials-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px 0}.ai-square-testimonials-{{ ai_gen_id }}__heading{font-size:{{ block.settings.mobile_heading_size }}px}}
  @media(prefers-reduced-motion:reduce){.ai-square-testimonials-{{ ai_gen_id }}__track{animation:none}}
{% endstyle %}
<testimonial-slider-{{ ai_gen_id }} class="ai-square-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-square-testimonials-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
  <div class="ai-square-testimonials-{{ ai_gen_id }}__viewport" tabindex="0" aria-label="Customer testimonials"><div class="ai-square-testimonials-{{ ai_gen_id }}__track">
    {% for copy in (1..2) %}{% for i in (1..6) %}
      {% liquid
        assign name_key = 'slide_' | append: i | append: '_name'
        assign text_key = 'slide_' | append: i | append: '_text'
        assign profile_key = 'slide_' | append: i | append: '_profile'
        assign google_key = 'slide_' | append: i | append: '_google'
        assign image_one_key = 'slide_' | append: i | append: '_image_one'
        assign image_two_key = 'slide_' | append: i | append: '_image_two'
        assign image_three_key = 'slide_' | append: i | append: '_image_three'
      %}
      <article class="ai-square-testimonials-{{ ai_gen_id }}__card">
        <div class="ai-square-testimonials-{{ ai_gen_id }}__top">{% if block.settings[profile_key] %}<img class="ai-square-testimonials-{{ ai_gen_id }}__profile" src="{{ block.settings[profile_key] | image_url: width: 120 }}" alt="{{ block.settings[name_key] | escape }}" width="52" height="52">{% endif %}<div class="ai-square-testimonials-{{ ai_gen_id }}__identity"><h3 class="ai-square-testimonials-{{ ai_gen_id }}__name">{{ block.settings[name_key] }}</h3><div class="ai-square-testimonials-{{ ai_gen_id }}__rating" aria-label="5 out of 5 stars">★★★★★</div></div>{% if block.settings[google_key] %}<img class="ai-square-testimonials-{{ ai_gen_id }}__google" src="{{ block.settings[google_key] | image_url: width: 120 }}" alt="Google review" width="48" height="24">{% endif %}</div>
        <p class="ai-square-testimonials-{{ ai_gen_id }}__text">{{ block.settings[text_key] }}</p>
        <div class="ai-square-testimonials-{{ ai_gen_id }}__gallery">{% for image_index in (1..3) %}{% liquid
          case image_index
            when 1
              assign current_image = block.settings[image_one_key]
            when 2
              assign current_image = block.settings[image_two_key]
            else
              assign current_image = block.settings[image_three_key]
          endcase
        %}{% if current_image %}<img src="{{ current_image | image_url: width: 500 }}" alt="" loading="lazy" width="500" height="500">{% else %}<div class="ai-square-testimonials-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}{% endfor %}</div>
      </article>
    {% endfor %}{% endfor %}
  </div></div>
</testimonial-slider-{{ ai_gen_id }}>
{% schema %}{"name":"Square testimonials","tag":null,"class":"square-testimonials-block","settings":[{"type":"text","id":"heading","label":"Heading","default":"Customer testimonials"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding","label":"Section padding","min":20,"max":100,"step":10,"unit":"px","default":60},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":20,"max":80,"step":10,"unit":"px","default":40},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":64,"step":4,"unit":"px","default":40},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":20,"max":44,"step":4,"unit":"px","default":28},{"type":"range","id":"heading_spacing","label":"Heading spacing","min":16,"max":60,"step":4,"unit":"px","default":32},{"type":"range","id":"card_gap","label":"Card gap","min":12,"max":48,"step":4,"unit":"px","default":24},{"type":"range","id":"scroll_speed","label":"Scroll speed","min":20,"max":120,"step":10,"unit":"s","default":60},{"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},{"type":"color","id":"card_background","label":"Card background","default":"#ffffff"},{"type":"color","id":"card_border_color","label":"Card border","default":"#d9e2d9"},{"type":"color","id":"heading_color","label":"Heading","default":"#0d3a1d"},{"type":"color","id":"text_color","label":"Text","default":"#14231a"},{"type":"color","id":"rating_color","label":"Rating","default":"#d99b00"},{"type":"color","id":"placeholder_background","label":"Placeholder background","default":"#eef2ec"},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"header","content":"Slide content"},{"type":"paragraph","content":"Each slide includes a name, testimonial, profile picture, Google logo, and three square image uploads."},{"type":"text","id":"slide_1_name","label":"Slide 1 name","default":"Customer one"},{"type":"textarea","id":"slide_1_text","label":"Slide 1 testimonial","default":"A wonderful experience from start to finish."},{"type":"image_picker","id":"slide_1_profile","label":"Slide 1 profile"},{"type":"image_picker","id":"slide_1_google","label":"Slide 1 Google logo"},{"type":"image_picker","id":"slide_1_image_one","label":"Slide 1 image 1"},{"type":"image_picker","id":"slide_1_image_two","label":"Slide 1 image 2"},{"type":"image_picker","id":"slide_1_image_three","label":"Slide 1 image 3"},{"type":"text","id":"slide_2_name","label":"Slide 2 name","default":"Customer two"},{"type":"textarea","id":"slide_2_text","label":"Slide 2 testimonial","default":"The quality and service exceeded my expectations."},{"type":"image_picker","id":"slide_2_profile","label":"Slide 2 profile"},{"type":"image_picker","id":"slide_2_google","label":"Slide 2 Google logo"},{"type":"image_picker","id":"slide_2_image_one","label":"Slide 2 image 1"},{"type":"image_picker","id":"slide_2_image_two","label":"Slide 2 image 2"},{"type":"image_picker","id":"slide_2_image_three","label":"Slide 2 image 3"},{"type":"text","id":"slide_3_name","label":"Slide 3 name","default":"Customer three"},{"type":"textarea","id":"slide_3_text","label":"Slide 3 testimonial","default":"Everything was thoughtfully prepared and beautifully presented."},{"type":"image_picker","id":"slide_3_profile","label":"Slide 3 profile"},{"type":"image_picker","id":"slide_3_google","label":"Slide 3 Google logo"},{"type":"image_picker","id":"slide_3_image_one","label":"Slide 3 image 1"},{"type":"image_picker","id":"slide_3_image_two","label":"Slide 3 image 2"},{"type":"image_picker","id":"slide_3_image_three","label":"Slide 3 image 3"},{"type":"text","id":"slide_4_name","label":"Slide 4 name","default":"Customer four"},{"type":"textarea","id":"slide_4_text","label":"Slide 4 testimonial","default":"Friendly support, fast delivery, and an excellent result."},{"type":"image_picker","id":"slide_4_profile","label":"Slide 4 profile"},{"type":"image_picker","id":"slide_4_google","label":"Slide 4 Google logo"},{"type":"image_picker","id":"slide_4_image_one","label":"Slide 4 image 1"},{"type":"image_picker","id":"slide_4_image_two","label":"Slide 4 image 2"},{"type":"image_picker","id":"slide_4_image_three","label":"Slide 4 image 3"},{"type":"text","id":"slide_5_name","label":"Slide 5 name","default":"Customer five"},{"type":"textarea","id":"slide_5_text","label":"Slide 5 testimonial","default":"A reliable store with products I am happy to recommend."},{"type":"image_picker","id":"slide_5_profile","label":"Slide 5 profile"},{"type":"image_picker","id":"slide_5_google","label":"Slide 5 Google logo"},{"type":"image_picker","id":"slide_5_image_one","label":"Slide 5 image 1"},{"type":"image_picker","id":"slide_5_image_two","label":"Slide 5 image 2"},{"type":"image_picker","id":"slide_5_image_three","label":"Slide 5 image 3"},{"type":"text","id":"slide_6_name","label":"Slide 6 name","default":"Customer six"},{"type":"textarea","id":"slide_6_text","label":"Slide 6 testimonial","default":"A smooth experience with lovely attention to detail."},{"type":"image_picker","id":"slide_6_profile","label":"Slide 6 profile"},{"type":"image_picker","id":"slide_6_google","label":"Slide 6 Google logo"},{"type":"image_picker","id":"slide_6_image_one","label":"Slide 6 image 1"},{"type":"image_picker","id":"slide_6_image_two","label":"Slide 6 image 2"},{"type":"image_picker","id":"slide_6_image_three","label":"Slide 6 image 3"}],"presets":[{"name":"Square testimonials"}]}{% endschema %}