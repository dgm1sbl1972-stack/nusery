{% doc %}
  @prompt
    Create a simple full-width banner image section only.
    
    Add an image upload option in the Shopify theme editor.
    Display the uploaded banner image at 1920 × 391 px.
    Use the image exactly as uploaded, without adding, removing, editing, or overlaying any text, icons, buttons, headings, or other elements.
    The image should span the full width of the screen.
    Maintain the image's original aspect ratio and composition.
    Do not crop important parts of the image.
    Add separate desktop and mobile image upload options if possible.
    Remove all default section padding and margins so the banner sits flush with the section edges.
    Do not add any background color, text, animation, overlay, or content.
    The only thing visible in this section should be the uploaded banner image.
    Make the section responsive across desktop, tablet, and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    line-height: 0;
    overflow: hidden;
  }

  .ai-banner-image-{{ ai_gen_id }}__picture,
  .ai-banner-image-{{ ai_gen_id }}__image,
  .ai-banner-image-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
  }

  .ai-banner-image-{{ ai_gen_id }}__placeholder {
    line-height: normal;
  }

  .ai-banner-image-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: auto;
  }
{% endstyle %}

<banner-image-{{ ai_gen_id }}
  class="ai-banner-image-{{ ai_gen_id }}"
  style="width: {{ block.settings.desktop_width_percent }}%;"
  {{ block.shopify_attributes }}
>
  {% if block.settings.desktop_image or block.settings.mobile_image %}
    <picture class="ai-banner-image-{{ ai_gen_id }}__picture">
      {% if block.settings.mobile_image %}
        <source
          media="(max-width: 749px)"
          srcset="{{ block.settings.mobile_image | image_url: width: 1920 }}"
        >
      {% endif %}
      {% if block.settings.desktop_image %}
        <img
          class="ai-banner-image-{{ ai_gen_id }}__image"
          src="{{ block.settings.desktop_image | image_url: width: 1920 }}"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          width="1920"
          height="391"
          loading="lazy"
        >
      {% else %}
        <img
          class="ai-banner-image-{{ ai_gen_id }}__image"
          src="{{ block.settings.mobile_image | image_url: width: 1920 }}"
          alt="{{ block.settings.mobile_image.alt | escape }}"
          width="1920"
          height="391"
          loading="lazy"
        >
      {% endif %}
    </picture>
  {% else %}
    <div class="ai-banner-image-{{ ai_gen_id }}__placeholder">
      {{ 'image' | placeholder_svg_tag }}
    </div>
  {% endif %}
</banner-image-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Banner image",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Banner image"
    }
  ],
  "tag": null,
  "class": "banner-image-block"
}
{% endschema %}