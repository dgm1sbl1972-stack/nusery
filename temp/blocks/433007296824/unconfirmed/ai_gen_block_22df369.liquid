{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-reviews-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;overflow:hidden;padding:{{ block.settings.section_padding }}px 0;background:{{ block.settings.background_color }}}.ai-reviews-{{ ai_gen_id }}__track{display:flex;gap:20px;width:max-content;animation:ai-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite}.ai-reviews-{{ ai_gen_id }}:hover .ai-reviews-{{ ai_gen_id }}__track{animation-play-state:paused}.ai-review-{{ ai_gen_id }}{width:min(350px,80vw);padding:22px;box-sizing:border-box;flex:0 0 min(350px,80vw);background:#fff;border:1px solid {{ block.settings.card_border }};border-radius:{{ block.settings.card_radius }}px;color:{{ block.settings.text_color }}}.ai-review-{{ ai_gen_id }}__person{display:flex;align-items:center;gap:10px}.ai-review-{{ ai_gen_id }}__profile{width:44px;height:44px;border-radius:50%;object-fit:cover}.ai-review-{{ ai_gen_id }}__name{margin:0;font-weight:700}.ai-review-{{ ai_gen_id }}__google{margin-left:auto;color:#4285f4;font-weight:700;font-size:20px}.ai-review-{{ ai_gen_id }}__stars{color:#b77900;letter-spacing:2px;margin:14px 0 8px}.ai-review-{{ ai_gen_id }}__quote{line-height:1.6;margin:0 0 18px}.ai-review-{{ ai_gen_id }}__products{display:flex;gap:8px}.ai-review-{{ ai_gen_id }}__products img,.ai-review-{{ ai_gen_id }}__placeholder{width:78px;height:78px;object-fit:cover;border-radius:8px;background:{{ block.settings.placeholder_background }};display:block}.ai-review-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center}.ai-review-{{ ai_gen_id }}__placeholder svg{width:55px;height:55px}@keyframes ai-scroll-{{ ai_gen_id }}{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 10px))}}@media(prefers-reduced-motion:reduce){.ai-reviews-{{ ai_gen_id }}__track{animation:none}}{% endstyle %}<google-reviews-{{ ai_gen_id }} class="ai-reviews-{{ ai_gen_id }}" {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2><div tabindex="0" aria-label="Google customer testimonials"><div class="ai-reviews-{{ ai_gen_id }}__track">{% for copy in (1..2) %}{% for i in (1..6) %}{% assign name_key = 'testimonial_' | append: i | append: '_name' %}{% assign quote_key = 'testimonial_' | append: i | append: '_quote' %}{% assign profile_key = 'testimonial_' | append: i | append: '_profile' %}{% assign p1_key = 'testimonial_' | append: i | append: '_product_1' %}{% assign p2_key = 'testimonial_' | append: i | append: '_product_2' %}{% assign p3_key = 'testimonial_' | append: i | append: '_product_3' %}<article class="ai-review-{{ ai_gen_id }}"><div class="ai-review-{{ ai_gen_id }}__person">{% if block.settings[profile_key] %}<img class="ai-review-{{ ai_gen_id }}__profile" src="{{ block.settings[profile_key] | image_url: width: 88 }}" alt="{{ block.settings[name_key] | escape }}" width="44" height="44">{% else %}<div class="ai-review-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<div><p class="ai-review-{{ ai_gen_id }}__name">{{ block.settings[name_key] | escape }}</p><small>Google review</small></div><span class="ai-review-{{ ai_gen_id }}__google" aria-label="Google">G</span></div><div class="ai-review-{{ ai_gen_id }}__stars">★★★★★</div><p class="ai-review-{{ ai_gen_id }}__quote">{{ block.settings[quote_key] | escape }}</p><div class="ai-review-{{ ai_gen_id }}__products">{% if block.settings[p1_key] %}<img src="{{ block.settings[p1_key] | image_url: width: 156 }}" alt="" width="78" height="78">{% else %}<div class="ai-review-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}{% if block.settings[p2_key] %}<img src="{{ block.settings[p2_key] | image_url: width: 156 }}" alt="" width="78" height="78">{% else %}<div class="ai-review-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}{% if block.settings[p3_key] %}<img src="{{ block.settings[p3_key] | image_url: width: 156 }}" alt="" width="78" height="78">{% else %}<div class="ai-review-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div></article>{% endfor %}{% endfor %}</div></div></google-reviews-{{ ai_gen_id }}>
