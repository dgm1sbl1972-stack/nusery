{% doc %}
  @prompt
    Create a Shopify collection product-grid section that closely matches the uploaded reference image.
    
    SECTION BACKGROUND:
    - Add a customizable background image upload option for the entire section.
    - The uploaded background image should cover the full section width.
    - Add a soft/light overlay if needed so the product cards remain easy to read.
    - Also allow a fallback background color.
    
    LAYOUT:
    - Full-width responsive product collection grid.
    - Desktop: 4 product cards per row.
    - Tablet: 2–3 cards per row.
    - Mobile: 2 cards per row.
    - Add consistent spacing between cards.
    - Product cards should have rounded corners, approximately 18–20px.
    
    TOP BAR:
    - Left side: FILTER with a small filter/sliders icon.
    - Right side: SORT BY with a dropdown arrow.
    - Make both functional.
    - Filter should open Shopify's collection filtering options.
    - Sort By should use Shopify's native collection sorting options.
    
    PRODUCT CARDS:
    Each card must dynamically pull products from a selected Shopify collection.
    
    Include:
    - Product image at the top.
    - Rounded top corners.
    - Discount badge in the top-right corner when a compare-at price exists.
    - Product rating and review count near the bottom of the image when available.
    - Product title below the image.
    - Current price.
    - Compare-at/original price with strikethrough.
    - "View Product" rounded button aligned to the bottom-right.
    - Button should link to the product page.
    - Entire product image/title can also link to the product page.
    
    IMPORTANT:
    - Do NOT hardcode product names, prices, ratings, discounts or images.
    - Everything must be dynamically pulled from Shopify product/collection data.
    - Allow the merchant to select the collection from the Shopify Theme Editor.
    - Add settings for number of products displayed.
    - Add settings for desktop/tablet/mobile columns.
    - Add settings for card border radius, spacing, background image, background overlay opacity and button styling.
    - Make the section fully responsive.
    - Match the visual style of the uploaded reference: clean premium gardening/plant-store aesthetic, soft off-white cards, dark green buttons and subtle rounded corners.
    - Use Shopify Liquid, HTML, CSS and JavaScript only.
    - Make it compatible with Shopify Online Store 2.0.
    - The section must work independently when added through the Shopify Theme Editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-collection-grid-{{ ai_gen_id }}{display:block;width:100%;padding:{{ block.settings.section_padding }}px 20px;background:{{ block.settings.background_color }};{% if block.settings.background_image %}background-image:linear-gradient(rgba(255,255,255,{{ block.settings.overlay_opacity | divided_by:100.0 }}),rgba(255,255,255,{{ block.settings.overlay_opacity | divided_by:100.0 }})),url('{{ block.settings.background_image | image_url:width:2400 }}');background-size:cover;background-position:center;{% endif %}}.ai-collection-grid__inner-{{ ai_gen_id }}{width:100%;max-width:{{ block.settings.content_width }}px;margin:0 auto}.ai-collection-grid__toolbar-{{ ai_gen_id }}{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.ai-collection-grid__filter-toggle-{{ ai_gen_id }},.ai-collection-grid__sort-{{ ai_gen_id }}{display:inline-flex;align-items:center;gap:8px;min-height:42px;border:1px solid {{ block.settings.control_border_color }};border-radius:999px;background:{{ block.settings.control_background }};color:{{ block.settings.text_color }};padding:10px 16px;font-size:13px;font-weight:700;text-transform:uppercase}.ai-collection-grid__filter-toggle-{{ ai_gen_id }}{cursor:pointer}.ai-collection-grid__filter-toggle-{{ ai_gen_id }} svg{width:16px}.ai-collection-grid__sort-{{ ai_gen_id }}{position:relative}.ai-collection-grid__sort-{{ ai_gen_id }} select{appearance:none;border:0;background:transparent;color:inherit;font:inherit;cursor:pointer;padding-right:14px}.ai-collection-grid__sort-{{ ai_gen_id }}:after{content:'⌄';position:absolute;right:13px;pointer-events:none}.ai-collection-grid__filters-{{ ai_gen_id }}{display:none;padding:18px;margin-bottom:24px;border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.filter_background }};border:1px solid {{ block.settings.control_border_color }} }.ai-collection-grid__filters-{{ ai_gen_id }}.is-open{display:block}.ai-collection-grid__filter-list-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:18px}.ai-collection-grid__filter-group-{{ ai_gen_id }}{display:flex;flex-direction:column;gap:8px}.ai-collection-grid__filter-group-{{ ai_gen_id }} label{color:{{ block.settings.text_color }};font-size:13px;font-weight:700}.ai-collection-grid__filter-group-{{ ai_gen_id }} select{border:1px solid {{ block.settings.control_border_color }};border-radius:10px;background:#fff;padding:10px;color:{{ block.settings.text_color }} }.ai-collection-grid__products-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat({{ block.settings.desktop_columns }},minmax(0,1fr));gap:{{ block.settings.card_spacing }}px}.ai-collection-grid__card-{{ ai_gen_id }}{display:flex;flex-direction:column;overflow:hidden;border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.card_background }};color:{{ block.settings.text_color }};box-shadow:0 8px 22px rgba(13,58,29,.07)}.ai-collection-grid__media-{{ ai_gen_id }}{position:relative;aspect-ratio:1;overflow:hidden;background:#edf0e8}.ai-collection-grid__media-{{ ai_gen_id }} img{width:100%;height:100%;display:block;object-fit:cover}.ai-collection-grid__badge-{{ ai_gen_id }}{position:absolute;top:12px;right:12px;padding:6px 9px;border-radius:999px;background:{{ block.settings.badge_background }};color:{{ block.settings.badge_text_color }};font-size:11px;font-weight:700}.ai-collection-grid__rating-{{ ai_gen_id }}{position:absolute;bottom:12px;left:12px;padding:6px 9px;border-radius:999px;background:rgba(255,255,255,.92);color:{{ block.settings.text_color }};font-size:12px}.ai-collection-grid__content-{{ ai_gen_id }}{display:flex;flex:1;flex-direction:column;gap:8px;padding:16px}.ai-collection-grid__title-{{ ai_gen_id }}{margin:0;color:{{ block.settings.text_color }};font-size:16px;line-height:1.3}.ai-collection-grid__title-{{ ai_gen_id }} a{color:inherit;text-decoration:none}.ai-collection-grid__price-{{ ai_gen_id }}{display:flex;gap:8px;font-size:15px;font-weight:700}.ai-collection-grid__compare-{{ ai_gen_id }}{color:{{ block.settings.muted_color }};font-size:13px;font-weight:400}.ai-collection-grid__button-{{ ai_gen_id }}{align-self:flex-end;margin-top:auto;padding:10px 15px;border-radius:999px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};text-decoration:none;font-size:12px;font-weight:700}.ai-collection-grid__empty-{{ ai_gen_id }}{grid-column:1/-1;padding:36px;text-align:center;border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.card_background }};color:{{ block.settings.muted_color }} }@media(max-width:989px){.ai-collection-grid__products-{{ ai_gen_id }}{grid-template-columns:repeat({{ block.settings.tablet_columns }},minmax(0,1fr))}}@media(max-width:749px){.ai-collection-grid-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px 12px}.ai-collection-grid__products-{{ ai_gen_id }}{grid-template-columns:repeat({{ block.settings.mobile_columns }},minmax(0,1fr));gap:12px}.ai-collection-grid__content-{{ ai_gen_id }}{padding:12px}.ai-collection-grid__title-{{ ai_gen_id }}{font-size:14px}.ai-collection-grid__button-{{ ai_gen_id }}{width:100%;text-align:center}}{% endstyle %}
<collection-grid-{{ ai_gen_id }} class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-collection-grid__inner-{{ ai_gen_id }}">{% if block.settings.collection != blank %}{% assign active_collection=block.settings.collection %}<form class="ai-collection-grid__toolbar-{{ ai_gen_id }}" method="get" action="{{ active_collection.url }}"><button class="ai-collection-grid__filter-toggle-{{ ai_gen_id }}" type="button" aria-expanded="false" aria-controls="ai-filters-{{ ai_gen_id }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>Filter</button><label class="ai-collection-grid__sort-{{ ai_gen_id }}">Sort by<select name="sort_by" onchange="this.form.submit()" aria-label="Sort products">{% assign current_sort=active_collection.sort_by | default:active_collection.default_sort_by %}{% for option in active_collection.sort_options %}<option value="{{ option.value }}" {% if option.value==current_sort %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></label></form><div id="ai-filters-{{ ai_gen_id }}" class="ai-collection-grid__filters-{{ ai_gen_id }}"><form method="get" action="{{ active_collection.url }}"><div class="ai-collection-grid__filter-list-{{ ai_gen_id }}">{% for filter in active_collection.filters %}{% if filter.type=='list' %}<div class="ai-collection-grid__filter-group-{{ ai_gen_id }}"><label for="filter-{{ ai_gen_id }}-{{ forloop.index }}">{{ filter.label }}</label><select id="filter-{{ ai_gen_id }}-{{ forloop.index }}" name="{{ filter.param_name }}" onchange="this.form.submit()"><option value="">All</option>{% for value in filter.values %}<option value="{{ value.value }}" {% if value.active %}selected{% endif %}>{{ value.label }} ({{ value.count }})</option>{% endfor %}</select></div>{% endif %}{% endfor %}</div></form></div><div class="ai-collection-grid__products-{{ ai_gen_id }}">{% for product in active_collection.products limit:block.settings.products_to_show %}<article class="ai-collection-grid__card-{{ ai_gen_id }}"><div class="ai-collection-grid__media-{{ ai_gen_id }}"><a href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url:width:800 }}" alt="{{ product.featured_image.alt | default:product.title | escape }}" loading="lazy" width="800" height="800">{% else %}<div>{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</a>{% if product.compare_at_price>product.price %}<span class="ai-collection-grid__badge-{{ ai_gen_id }}">Sale</span>{% endif %}{% assign rating=product.metafields.reviews.rating.value %}{% assign review_count=product.metafields.reviews.rating_count.value | default:product.metafields.reviews.rating_count %}{% if rating != blank %}<span class="ai-collection-grid__rating-{{ ai_gen_id }}">★ {{ rating }}{% if review_count != blank %} ({{ review_count }}){% endif %}</span>{% endif %}</div><div class="ai-collection-grid__content-{{ ai_gen_id }}"><h3 class="ai-collection-grid__title-{{ ai_gen_id }}"><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="ai-collection-grid__price-{{ ai_gen_id }}">{{ product.price | money }}{% if product.compare_at_price>product.price %}<span class="ai-collection-grid__compare-{{ ai_gen_id }}"><s>{{ product.compare_at_price | money }}</s></span>{% endif %}</div><a class="ai-collection-grid__button-{{ ai_gen_id }}" href="{{ product.url }}">View product</a></div></article>{% else %}<div class="ai-collection-grid__empty-{{ ai_gen_id }}">No products found in this collection.</div>{% endfor %}</div>{% else %}<div class="ai-collection-grid__empty-{{ ai_gen_id }}">Select a collection to display products.</div>{% endif %}</div></collection-grid-{{ ai_gen_id }}><script>(function(){class CollectionGrid{{ ai_gen_id }} extends HTMLElement{connectedCallback(){const b=this.querySelector('.ai-collection-grid__filter-toggle-{{ ai_gen_id }}'),p=this.querySelector('#ai-filters-{{ ai_gen_id }}');if(b&&p)b.addEventListener('click',function(){const o=p.classList.toggle('is-open');b.setAttribute('aria-expanded',o)})}}if(!customElements.get('collection-grid-{{ ai_gen_id }}'))customElements.define('collection-grid-{{ ai_gen_id }}',CollectionGrid{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Collection product grid","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":48,"step":4,"default":16},{"type":"select","id":"desktop_columns","label":"Desktop columns","options":[{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"}],"default":"4"},{"type":"select","id":"tablet_columns","label":"Tablet columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"}],"default":"3"},{"type":"select","id":"mobile_columns","label":"Mobile columns","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},{"type":"header","content":"Section background"},{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"color","id":"background_color","label":"Fallback background","default":"#f8f4ec"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":100,"step":10,"unit":"%","default":20},{"type":"header","content":"Card layout"},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":18},{"type":"range","id":"card_spacing","label":"Card spacing","min":8,"max":36,"step":4,"unit":"px","default":20},{"type":"range","id":"section_padding","label":"Section padding","min":16,"max":80,"step":8,"unit":"px","default":40},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":12,"max":40,"step":4,"unit":"px","default":24},{"type":"range","id":"content_width","label":"Content width","min":1000,"max":1600,"step":100,"unit":"px","default":1200},{"type":"color","id":"card_background","label":"Card background","default":"#fffdf8"},{"type":"color","id":"text_color","label":"Text","default":"#0d3a1d"},{"type":"color","id":"muted_color","label":"Muted text","default":"#5b6660"},{"type":"header","content":"Controls and button"},{"type":"color","id":"control_background","label":"Control background","default":"#fffdf8"},{"type":"color","id":"filter_background","label":"Filter background","default":"#fffdf8"},{"type":"color","id":"control_border_color","label":"Control border","default":"#d5ddd1"},{"type":"color","id":"button_background","label":"Button background","default":"#1f5130"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"badge_background","label":"Badge background","default":"#0d3a1d"},{"type":"color","id":"badge_text_color","label":"Badge text","default":"#ffffff"}],"presets":[{"name":"Collection product grid"}],"tag":null,"class":"collection-product-grid-block"}{% endschema %}