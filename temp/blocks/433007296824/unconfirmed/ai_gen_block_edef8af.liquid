{% doc %}
  @prompt
    Create a customer testimonials section with the following features:
    - End-to-end automatic infinite scrolling carousel (auto-scroll, no pause)
    - Google logo/icon displayed on each testimonial card
    - Customer profile image
    - Customer name
    - Review date showing how many days ago the review was written
    - Star rating display
    - Text review content
    - 3 product image upload options per testimonial card
    - Clean, modern card layout
    - Smooth continuous scrolling animation, need for 6 testinomials
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-t-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;overflow:hidden;background:{{block.settings.background_color}};padding:40px 0}.ai-t-{{ai_gen_id}}__track{display:flex;width:max-content;gap:20px;animation:ai-t-{{ai_gen_id}} {{block.settings.scroll_speed}}s linear infinite}.ai-t-{{ai_gen_id}}__set{display:flex;gap:20px}.ai-t-{{ai_gen_id}}__card{width:320px;flex:0 0 320px;padding:22px;background:{{block.settings.card_background}};border-radius:{{block.settings.card_radius}}px}.ai-t-{{ai_gen_id}}__top{display:flex;align-items:center;gap:10px}.ai-t-{{ai_gen_id}}__avatar{width:46px;height:46px;border-radius:50%;object-fit:cover}.ai-t-{{ai_gen_id}}__google{width:20px;margin-left:auto}.ai-t-{{ai_gen_id}}__rating{color:{{block.settings.star_color}};font-size:18px}.ai-t-{{ai_gen_id}}__date{font-size:12px;color:{{block.settings.muted_color}}}.ai-t-{{ai_gen_id}}__products{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.ai-t-{{ai_gen_id}}__product{width:100%;aspect-ratio:1;object-fit:cover;border-radius:7px}@keyframes ai-t-{{ai_gen_id}}{to{transform:translateX(calc(-50% - 10px))}}{% endstyle %}<customer-testimonials-{{ai_gen_id}} class="ai-t-{{ai_gen_id}}" {{block.shopify_attributes}}><h2>{{block.settings.heading|escape}}</h2><p>{{block.settings.intro|escape}}</p><div style="overflow:hidden"><div class="ai-t-{{ai_gen_id}}__track">{% for copy in (1..2) %}<div class="ai-t-{{ai_gen_id}}__set">{% for i in (1..6) %}{% assign nk = 'name_' | append: i %}{% assign dk = 'date_' | append: i %}{% assign rk = 'rating_' | append: i %}{% assign qk = 'review_' | append: i %}{% assign ak = 'avatar_' | append: i %}{% assign nm = block.settings[nk] %}{% assign dt = block.settings[dk] %}{% assign rt = block.settings[rk] %}{% assign rv = block.settings[qk] %}{% assign av = block.settings[ak] %}<article class="ai-t-{{ai_gen_id}}__card" data-date="{{dt|escape}}"><div class="ai-t-{{ai_gen_id}}__top">{% if av %}<img class="ai-t-{{ai_gen_id}}__avatar" src="{{av|image_url:width:92}}" alt="{{nm|escape}}">{% endif %}<div><strong>{{nm|escape}}</strong><br><span class="ai-t-{{ai_gen_id}}__date">{{dt|escape}}</span></div><span class="ai-t-{{ai_gen_id}}__google" aria-label="Google review">G</span></div><div class="ai-t-{{ai_gen_id}}__rating">{% case rt %}{% when '5' %}★★★★★{% when '4' %}★★★★☆{% when '3' %}★★★☆☆{% when '2' %}★★☆☆☆{% else %}★☆☆☆☆{% endcase %}</div><p>{{rv|escape}}</p><div class="ai-t-{{ai_gen_id}}__products">{% assign p1 = 'product_' | append: i | append: '_one' %}{% assign p2 = 'product_' | append: i | append: '_two' %}{% assign p3 = 'product_' | append: i | append: '_three' %}{% for pk in (p1..p3) %}{% assign pi = block.settings[pk] %}{% if pi %}<img class="ai-t-{{ai_gen_id}}__product" src="{{pi|image_url:width:220}}" alt="">{% endif %}{% endfor %}</div></article>{% endfor %}</div>{% endfor %}</div></div></customer-testimonials-{{ai_gen_id}}><script>(function(){class T{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.querySelectorAll('[data-date]').forEach(c=>{let d=new Date(c.dataset.date+'T00:00:00'),e=c.querySelector('.ai-t-{{ai_gen_id}}__date'),n=new Date;n.setHours(0,0,0,0);if(!isNaN(d)&&e){let x=Math.max(0,Math.floor((n-d)/86400000));e.textContent=x==0?'Today':x==1?'1 day ago':x+' days ago'}})}}customElements.define('customer-testimonials-{{ai_gen_id}}',T{{ai_gen_id}})})();</script>{% schema %}{"name":"Customer testimonials","settings":[{"type":"text","id":"heading","label":"Heading","default":"Loved by our customers"},{"type":"textarea","id":"intro","label":"Intro","default":"Real experiences from customers who shop with us."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"scroll_speed","label":"Scroll speed","min":20,"max":120,"step":10,"unit":"s","default":60},{"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},{"type":"color","id":"card_background","label":"Card background","default":"#ffffff"},{"type":"color","id":"muted_color","label":"Muted text","default":"#5b6660"},{"type":"color","id":"star_color","label":"Stars","default":"#d99b00"},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"header","content":"Six testimonials"},{"type":"text","id":"name_1","label":"Name 1","default":"Customer one"},{"type":"text","id":"date_1","label":"Date 1","default":"2026-09-01"},{"type":"select","id":"rating_1","label":"Rating 1","options":[{"value":"5","label":"5 stars"},{"value":"4","label":"4 stars"}],"default":"5"},{"type":"textarea","id":"review_1","label":"Review 1","default":"A wonderful experience from start to finish."},{"type":"image_picker","id":"avatar_1","label":"Profile image 1"},{"type":"image_picker","id":"product_1_one","label":"Product image 1A"},{"type":"image_picker","id":"product_1_two","label":"Product image 1B"},{"type":"image_picker","id":"product_1_three","label":"Product image 1C"},{"type":"text","id":"name_2","label":"Name 2","default":"Customer two"},{"type":"text","id":"date_2","label":"Date 2","default":"2026-08-20"},{"type":"select","id":"rating_2","label":"Rating 2","options":[{"value":"5","label":"5 stars"},{"value":"4","label":"4 stars"}],"default":"5"},{"type":"textarea","id":"review_2","label":"Review 2","default":"The quality was excellent."},{"type":"image_picker","id":"avatar_2","label":"Profile image 2"},{"type":"image_picker","id":"product_2_one","label":"Product image 2A"},{"type":"image_picker","id":"product_2_two","label":"Product image 2B"},{"type":"image_picker","id":"product_2_three","label":"Product image 2C"},{"type":"text","id":"name_3","label":"Name 3","default":"Customer three"},{"type":"text","id":"date_3","label":"Date 3","default":"2026-08-10"},{"type":"select","id":"rating_3","label":"Rating 3","options":[{"value":"5","label":"5 stars"},{"value":"4","label":"4 stars"}],"default":"5"},{"type":"textarea","id":"review_3","label":"Review 3","default":"Beautiful products and helpful service."},{"type":"image_picker","id":"avatar_3","label":"Profile image 3"},{"type":"image_picker","id":"product_3_one","label":"Product image 3A"},{"type":"image_picker","id":"product_3_two","label":"Product image 3B"},{"type":"image_picker","id":"product_3_three","label":"Product image 3C"},{"type":"text","id":"name_4","label":"Name 4","default":"Customer four"},{"type":"text","id":"date_4","label":"Date 4","default":"2026-08-01"},{"type":"select","id":"rating_4","label":"Rating 4","options":[{"value":"5","label":"5 stars"},{"value":"4","label":"4 stars"}],"default":"5"},{"type":"textarea","id":"review_4","label":"Review 4","default":"I am very happy with my purchase."},{"type":"image_picker","id":"avatar_4","label":"Profile image 4"},{"type":"image_picker","id":"product_4_one","label":"Product image 4A"},{"type":"image_picker","id":"product_4_two","label":"Product image 4B"},{"type":"image_picker","id":"product_4_three","label":"Product image 4C"},{"type":"text","id":"name_5","label":"Name 5","default":"Customer five"},{"type":"text","id":"date_5","label":"Date 5","default":"2026-07-20"},{"type":"select","id":"rating_5","label":"Rating 5","options":[{"value":"5","label":"5 stars"},{"value":"4","label":"4 stars"}],"default":"5"},{"type":"textarea","id":"review_5","label":"Review 5","default":"Fast delivery and great quality."},{"type":"image_picker","id":"avatar_5","label":"Profile image 5"},{"type":"image_picker","id":"product_5_one","label":"Product image 5A"},{"type":"image_picker","id":"product_5_two","label":"Product image 5B"},{"type":"image_picker","id":"product_5_three","label":"Product image 5C"},{"type":"text","id":"name_6","label":"Name 6","default":"Customer six"},{"type":"text","id":"date_6","label":"Date 6","default":"2026-07-10"},{"type":"select","id":"rating_6","label":"Rating 6","options":[{"value":"5","label":"5 stars"},{"value":"4","label":"4 stars"}],"default":"5"},{"type":"textarea","id":"review_6","label":"Review 6","default":"A smooth shopping experience."},{"type":"image_picker","id":"avatar_6","label":"Profile image 6"},{"type":"image_picker","id":"product_6_one","label":"Product image 6A"},{"type":"image_picker","id":"product_6_two","label":"Product image 6B"},{"type":"image_picker","id":"product_6_three","label":"Product image 6C"}],"presets":[{"name":"Customer testimonials"}],"tag":null,"class":"customer-testimonials-block"}{% endschema %}