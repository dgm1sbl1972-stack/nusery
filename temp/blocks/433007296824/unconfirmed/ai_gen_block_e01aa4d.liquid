{% doc %}
  @prompt
    can we create a blog section and need an option like all articles , 3 blogs each should have blog link to past, need the blogs in square shape  from end to end of the desktop, need in small box kind, end to end desktop 1080x1080 pixel boxes need 3 blogs , need in small boxs 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-small-blog-boxes-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding:{{ block.settings.section_padding }}px 16px;background:{{ block.settings.background_color }}}.ai-small-blog-boxes-{{ ai_gen_id }}__heading{margin:0 0 24px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px;text-align:center}.ai-small-blog-boxes-{{ ai_gen_id }}__grid{display:flex;justify-content:center;align-items:flex-start;gap:{{ block.settings.gap }}px;width:100%;flex-wrap:wrap}.ai-small-blog-boxes-{{ ai_gen_id }}__card{width:{{ block.settings.box_size }}px;max-width:100%;overflow:hidden;background:{{ block.settings.card_color }};border:1px solid rgba(20,35,26,.14);border-radius:{{ block.settings.card_radius }}px;box-shadow:0 3px 12px rgba(20,35,26,.08)}.ai-small-blog-boxes-{{ ai_gen_id }}__media,.ai-small-blog-boxes-{{ ai_gen_id }}__placeholder{display:block;width:100%;aspect-ratio:1/1;object-fit:cover}.ai-small-blog-boxes-{{ ai_gen_id }}__placeholder{background:{{ settings.color_lime }}}.ai-small-blog-boxes-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-small-blog-boxes-{{ ai_gen_id }}__content{padding:12px}.ai-small-blog-boxes-{{ ai_gen_id }}__title{margin:0 0 8px;color:{{ block.settings.heading_color }};font-size:16px;line-height:1.3}.ai-small-blog-boxes-{{ ai_gen_id }}__title a,.ai-small-blog-boxes-{{ ai_gen_id }}__article a{color:inherit;text-decoration:none}.ai-small-blog-boxes-{{ ai_gen_id }}__article{margin:0 0 10px;color:{{ block.settings.text_color }};font-size:13px}.ai-small-blog-boxes-{{ ai_gen_id }}__link{color:{{ block.settings.link_color }};font-size:12px;font-weight:700;text-decoration:underline;text-underline-offset:3px}.ai-small-blog-boxes-{{ ai_gen_id }}__empty{padding:24px 10px;color:{{ settings.color_muted }};text-align:center;font-size:13px}@media(max-width:749px){.ai-small-blog-boxes-{{ ai_gen_id }}__card{width:calc(50% - {{ block.settings.gap | divided_by: 2 }}px)}.ai-small-blog-boxes-{{ ai_gen_id }}__grid{gap:12px}}
{% endstyle %}
{% assign blog_numbers = '1,2,3' | split: ',' %}<div class="ai-small-blog-boxes-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{% if block.settings.heading != blank %}<h2 class="ai-small-blog-boxes-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-small-blog-boxes-{{ ai_gen_id }}__grid">{% for number in blog_numbers %}{% assign blog_key = 'blog_' | append: number %}{% assign selected_blog = block.settings[blog_key] %}<article class="ai-small-blog-boxes-{{ ai_gen_id }}__card">{% if selected_blog != blank %}{% assign article = selected_blog.articles.first %}<a href="{{ selected_blog.url }}" aria-label="View {{ selected_blog.title | escape }}">{% if article.image %}<img class="ai-small-blog-boxes-{{ ai_gen_id }}__media" src="{{ article.image | image_url: width: 1080 }}" alt="{{ article.image.alt | default: selected_blog.title | escape }}" loading="lazy" width="1080" height="1080">{% else %}<div class="ai-small-blog-boxes-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</a><div class="ai-small-blog-boxes-{{ ai_gen_id }}__content"><h3 class="ai-small-blog-boxes-{{ ai_gen_id }}__title"><a href="{{ selected_blog.url }}">{{ selected_blog.title | escape }}</a></h3>{% if article != blank %}<p class="ai-small-blog-boxes-{{ ai_gen_id }}__article"><a href="{{ article.url }}">{{ article.title | escape }}</a></p>{% endif %}<a class="ai-small-blog-boxes-{{ ai_gen_id }}__link" href="{{ selected_blog.url }}">{{ block.settings.link_label | escape }}</a></div>{% else %}<div class="ai-small-blog-boxes-{{ ai_gen_id }}__empty">Select blog {{ number }}.</div>{% endif %}</article>{% endfor %}</div></div>
{% schema %}{"name":"Small blog boxes","settings":[{"type":"blog","id":"blog_1","label":"Blog 1"},{"type":"blog","id":"blog_2","label":"Blog 2"},{"type":"blog","id":"blog_3","label":"Blog 3"},{"type":"text","id":"heading","label":"Heading","default":"Explore our blogs"},{"type":"text","id":"link_label","label":"Link label","default":"View all articles"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"box_size","label":"Box size","min":120,"max":360,"step":10,"unit":"px","default":220},{"type":"range","id":"section_padding","label":"Section spacing","min":20,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"gap","label":"Box gap","min":10,"max":40,"step":5,"unit":"px","default":15},{"type":"range","id":"card_radius","label":"Box radius","min":0,"max":32,"step":2,"unit":"px","default":10},{"type":"range","id":"heading_size","label":"Heading size","min":22,"max":56,"step":2,"unit":"px","default":30},{"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},{"type":"color","id":"card_color","label":"Box","default":"#ffffff"},{"type":"color","id":"heading_color","label":"Heading","default":"#0d3a1d"},{"type":"color","id":"text_color","label":"Text","default":"#14231a"},{"type":"color","id":"link_color","label":"Link","default":"#1f5130"}],"presets":[{"name":"Small blog boxes"}],"tag":null,"class":"small-blog-boxes-block"}{% endschema %}