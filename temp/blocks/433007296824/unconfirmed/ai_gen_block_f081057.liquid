{% doc %}
  @prompt
    can we create a blog section and need an option like all articles , 3 blogs each should have blog link to past, need the blogs in square shape  from end to end of the desktop, need in small box kind
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-boxes-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background: {{ block.settings.background_color }};
  }

  .ai-blog-boxes-{{ ai_gen_id }}__inner {
    width: 100%;
    margin: 0 auto;
  }

  .ai-blog-boxes-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    text-align: center;
  }

  .ai-blog-boxes-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
    max-width: {{ block.settings.max_content_width }}px;
    margin: 0 auto;
  }

  .ai-blog-boxes-{{ ai_gen_id }}__card {
    overflow: hidden;
    background: {{ block.settings.card_color }};
    border: 1px solid rgba(20, 35, 26, 0.14);
    border-radius: {{ block.settings.card_radius }}px;
    box-shadow: 0 3px 12px rgba(13, 58, 29, 0.08);
  }

  .ai-blog-boxes-{{ ai_gen_id }}__image,
  .ai-blog-boxes-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .ai-blog-boxes-{{ ai_gen_id }}__placeholder {
    background: {{ settings.color_lime }};
  }

  .ai-blog-boxes-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-blog-boxes-{{ ai_gen_id }}__content {
    padding: 14px;
  }

  .ai-blog-boxes-{{ ai_gen_id }}__title {
    margin: 0 0 10px;
    color: {{ block.settings.heading_color }};
    font-size: 18px;
    line-height: 1.3;
  }

  .ai-blog-boxes-{{ ai_gen_id }}__title a,
  .ai-blog-boxes-{{ ai_gen_id }}__article a {
    color: inherit;
    text-decoration: none;
  }

  .ai-blog-boxes-{{ ai_gen_id }}__article {
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-blog-boxes-{{ ai_gen_id }}__link {
    color: {{ block.settings.link_color }};
    font-size: 13px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-blog-boxes-{{ ai_gen_id }}__empty {
    padding: 28px 12px;
    color: {{ settings.color_muted }};
    font-size: 13px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-blog-boxes-{{ ai_gen_id }} {
      padding: 32px 16px;
    }

    .ai-blog-boxes-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
      max-width: 360px;
    }
  }
{% endstyle %}

{% assign blog_numbers = '1,2,3' | split: ',' %}

<div class="ai-blog-boxes-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-boxes-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-blog-boxes-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    <div class="ai-blog-boxes-{{ ai_gen_id }}__grid">
      {% for number in blog_numbers %}
        {% assign blog_setting = 'blog_' | append: number %}
        {% assign selected_blog = block.settings[blog_setting] %}
        <article class="ai-blog-boxes-{{ ai_gen_id }}__card">
          {% if selected_blog != blank %}
            {% assign article = selected_blog.articles.first %}
            <a href="{{ selected_blog.url }}" aria-label="View {{ selected_blog.title | escape }}">
              {% if article.image %}
                <img class="ai-blog-boxes-{{ ai_gen_id }}__image" src="{{ article.image | image_url: width: 700 }}" alt="{{ article.image.alt | default: selected_blog.title | escape }}" loading="lazy" width="700" height="700">
              {% else %}
                <div class="ai-blog-boxes-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {% endif %}
            </a>
            <div class="ai-blog-boxes-{{ ai_gen_id }}__content">
              <h3 class="ai-blog-boxes-{{ ai_gen_id }}__title"><a href="{{ selected_blog.url }}">{{ selected_blog.title | escape }}</a></h3>
              {% if article != blank %}
                <p class="ai-blog-boxes-{{ ai_gen_id }}__article"><a href="{{ article.url }}">{{ article.title | escape }}</a></p>
              {% endif %}
              <a class="ai-blog-boxes-{{ ai_gen_id }}__link" href="{{ selected_blog.url }}">{{ block.settings.link_label | escape }}</a>
            </div>
          {% else %}
            <div class="ai-blog-boxes-{{ ai_gen_id }}__empty">Select blog {{ number }}.</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Small blog boxes",
  "settings": [
    {"type":"header","content":"Blogs"},
    {"type":"blog","id":"blog_1","label":"Blog 1"},
    {"type":"blog","id":"blog_2","label":"Blog 2"},
    {"type":"blog","id":"blog_3","label":"Blog 3"},
    {"type":"text","id":"heading","label":"Heading","default":"Explore our blogs"},
    {"type":"text","id":"link_label","label":"Link label","default":"View all articles"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"max_content_width","label":"Box row width","min":600,"max":1400,"step":100,"unit":"px","default":1000},
    {"type":"range","id":"section_padding","label":"Section spacing","min":20,"max":100,"step":5,"unit":"px","default":50},
    {"type":"range","id":"card_gap","label":"Box gap","min":8,"max":40,"step":4,"unit":"px","default":16},
    {"type":"range","id":"card_radius","label":"Box radius","min":0,"max":32,"step":2,"unit":"px","default":12},
    {"type":"range","id":"heading_size","label":"Heading size","min":22,"max":56,"step":2,"unit":"px","default":32},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},
    {"type":"color","id":"card_color","label":"Box","default":"#ffffff"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#0d3a1d"},
    {"type":"color","id":"text_color","label":"Text","default":"#14231a"},
    {"type":"color","id":"link_color","label":"Link","default":"#1f5130"}
  ],
  "presets":[{"name":"Small blog boxes"}],
  "tag":null,
  "class":"small-blog-boxes-block"
}
{% endschema %}