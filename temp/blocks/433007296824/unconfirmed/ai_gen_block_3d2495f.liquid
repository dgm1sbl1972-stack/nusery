{% doc %}
  @prompt
    can we create a blog section and need an option like all articles 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-blog-section-{{ ai_gen_id }}__inner {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
  }

  .ai-blog-section-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .ai-blog-section-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .ai-blog-section-{{ ai_gen_id }}__view-all {
    color: {{ block.settings.link_color }};
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .ai-blog-section-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr));
    gap: 24px;
  }

  .ai-blog-section-{{ ai_gen_id }}__card {
    overflow: hidden;
    background: {{ block.settings.card_color }};
    border: 1px solid rgba(20, 35, 26, 0.12);
    border-radius: {{ settings.card_radius }}px;
  }

  .ai-blog-section-{{ ai_gen_id }}__image,
  .ai-blog-section-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .ai-blog-section-{{ ai_gen_id }}__placeholder {
    background: {{ settings.color_lime }};
  }

  .ai-blog-section-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-blog-section-{{ ai_gen_id }}__content {
    padding: 20px;
  }

  .ai-blog-section-{{ ai_gen_id }}__date {
    margin: 0 0 8px;
    color: {{ settings.color_muted }};
    font-size: 13px;
  }

  .ai-blog-section-{{ ai_gen_id }}__title {
    margin: 0 0 10px;
    color: {{ block.settings.heading_color }};
    font-size: 21px;
    line-height: 1.25;
  }

  .ai-blog-section-{{ ai_gen_id }}__title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-blog-section-{{ ai_gen_id }}__excerpt {
    margin: 0;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-blog-section-{{ ai_gen_id }}__empty {
    padding: 32px;
    border: 1px dashed {{ settings.color_primary }};
    border-radius: {{ settings.card_radius }}px;
    color: {{ settings.color_muted }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-blog-section-{{ ai_gen_id }} {
      padding: 36px 16px;
    }

    .ai-blog-section-{{ ai_gen_id }}__header {
      align-items: start;
      flex-direction: column;
      margin-bottom: 20px;
    }

    .ai-blog-section-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-blog-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-section-{{ ai_gen_id }}__inner">
    <div class="ai-blog-section-{{ ai_gen_id }}__header">
      <h2 class="ai-blog-section-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% if block.settings.blog != blank and block.settings.show_view_all %}
        <a class="ai-blog-section-{{ ai_gen_id }}__view-all" href="{{ block.settings.blog.url }}">{{ block.settings.view_all_label | escape }}</a>
      {% endif %}
    </div>

    {% if block.settings.blog != blank %}
      {% assign articles_to_show = block.settings.blog.articles %}
      {% if block.settings.article_source == 'latest' %}
        {% assign article_limit = block.settings.article_count %}
      {% else %}
        {% assign article_limit = 50 %}
      {% endif %}
      <div class="ai-blog-section-{{ ai_gen_id }}__grid">
        {% for article in articles_to_show limit: article_limit %}
          <article class="ai-blog-section-{{ ai_gen_id }}__card">
            <a href="{{ article.url }}" aria-label="{{ article.title | escape }}">
              {% if article.image %}
                <img class="ai-blog-section-{{ ai_gen_id }}__image" src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="900" height="563">
              {% else %}
                <div class="ai-blog-section-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {% endif %}
            </a>
            <div class="ai-blog-section-{{ ai_gen_id }}__content">
              {% if block.settings.show_date %}<p class="ai-blog-section-{{ ai_gen_id }}__date">{{ article.published_at | date: '%d %B %Y' }}</p>{% endif %}
              <h3 class="ai-blog-section-{{ ai_gen_id }}__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
              {% if block.settings.show_excerpt %}<p class="ai-blog-section-{{ ai_gen_id }}__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 | escape }}</p>{% endif %}
            </div>
          </article>
        {% else %}
          <div class="ai-blog-section-{{ ai_gen_id }}__empty">No articles are available in this blog yet.</div>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-blog-section-{{ ai_gen_id }}__empty">Choose a blog to display its articles.</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Blog articles",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From our blog" },
    { "type": "select", "id": "article_source", "label": "Articles", "options": [ { "value": "latest", "label": "Latest articles" }, { "value": "all", "label": "All articles" } ], "default": "latest" },
    { "type": "range", "id": "article_count", "label": "Article count", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all articles" },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns", "label": "Columns", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "3" },
    { "type": "range", "id": "section_padding", "label": "Section spacing", "min": 20, "max": 100, "step": 5, "unit": "px", "default": 60 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f8f4ec" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#0d3a1d" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14231a" },
    { "type": "color", "id": "link_color", "label": "Link", "default": "#1f5130" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 22, "max": 56, "step": 2, "unit": "px", "default": 36 }
  ],
  "presets": [ { "name": "Blog articles" } ],
  "tag": null,
  "class": "blog-articles-block"
}
{% endschema %}