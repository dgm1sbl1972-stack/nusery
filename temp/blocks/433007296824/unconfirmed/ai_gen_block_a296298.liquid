{% doc %}
  @prompt
    Add a background image setting to the "Pots product grid" section. The setting should allow merchants to upload or select a background image that displays behind the product grid content. Include options for background size (cover, contain, auto), background position (center, top, bottom), and an overlay color with opacity control to ensure text and products remain visible over the image.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pots-grid-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
    background-image: {% if block.settings.background_image %}url('{{ block.settings.background_image | image_url: width: 2400 }}'){% else %}none{% endif %};
    background-size: {{ block.settings.background_size }};
    background-position: {{ block.settings.background_position }};
    background-repeat: no-repeat;
  }

  .ai-pots-grid-{{ ai_gen_id }}::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    content: '';
    pointer-events: none;
  }

  .ai-pots-grid__inner-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-pots-grid__heading-{{ ai_gen_id }} {
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-pots-grid__products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-pots-grid__card-{{ ai_gen_id }} {
    min-width: 0;
    overflow: hidden;
    border-radius: {{ block.settings.card_radius }}px;
    background-color: {{ block.settings.card_background }};
    box-shadow: 0 4px 18px rgba(13, 58, 29, 0.08);
  }

  .ai-pots-grid__image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .ai-pots-grid__details-{{ ai_gen_id }} {
    padding: 16px;
  }

  .ai-pots-grid__title-{{ ai_gen_id }} {
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.35;
  }

  .ai-pots-grid__price-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 15px;
    font-weight: 600;
  }

  .ai-pots-grid__empty-{{ ai_gen_id }} {
    padding: 48px 24px;
    color: {{ block.settings.muted_color }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-pots-grid__inner-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px;
    }

    .ai-pots-grid__products-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
    }

    .ai-pots-grid__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-pots-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pots-grid__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-pots-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    {% if block.settings.products != blank %}
      <div class="ai-pots-grid__products-{{ ai_gen_id }}">
        {% for product in block.settings.products %}
          <a class="ai-pots-grid__card-{{ ai_gen_id }}" href="{{ product.url }}">
            {% if product.featured_image %}
              <img class="ai-pots-grid__image-{{ ai_gen_id }}" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="800">
            {% else %}
              <div class="ai-pots-grid__image-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
            <div class="ai-pots-grid__details-{{ ai_gen_id }}">
              <h3 class="ai-pots-grid__title-{{ ai_gen_id }}">{{ product.title | escape }}</h3>
              <div class="ai-pots-grid__price-{{ ai_gen_id }}">{{ product.price | money }}</div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-pots-grid__empty-{{ ai_gen_id }}">Select products to display in this grid.</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Pots product grid",
  "settings": [
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pots for every plant" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "select", "id": "background_size", "label": "Background size", "options": [{ "value": "cover", "label": "Cover" }, { "value": "contain", "label": "Contain" }, { "value": "auto", "label": "Auto" }], "default": "cover" },
    { "type": "select", "id": "background_position", "label": "Background position", "options": [{ "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }], "default": "center" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#f8f4ec" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 75 },
    { "type": "color", "id": "background_color", "label": "Fallback background", "default": "#f8f4ec" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "section_padding", "label": "Section padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile padding", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 56, "step": 2, "unit": "px", "default": 32 },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "border_radius", "label": "Section corners", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "Card corners", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0d3a1d" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5b6660" }
  ],
  "presets": [{ "name": "Pots product grid" }],
  "tag": null,
  "class": "pots-product-grid-block"
}
{% endschema %}