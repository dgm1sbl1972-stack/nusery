{% doc %}
  @prompt
    Create a customer testimonials section with the following features:
    - End-to-end automatic infinite scrolling carousel (auto-scroll, no pause)
    - Google logo/icon displayed on each testimonial card
    - Customer profile image
    - Customer name
    - Review date showing how many days ago the review was written
    - Star rating display
    - Text review content
    - 3 product image upload options per testimonial card
    - Clean, modern card layout
    - Smooth continuous scrolling animation, need for 6 testinomials, heading can be center, images also need to be uploaded  and add google logo, name of the person and persons profile image need to upload and text and image upload of the sustomers product
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-test-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;padding:36px 0;background:{{block.settings.background_color}};overflow:hidden}.ai-test-{{ai_gen_id}} h2{text-align:center;color:{{block.settings.heading_color}}}.ai-test-{{ai_gen_id}}__track{display:flex;width:max-content;gap:18px;animation:ai-test-scroll-{{ai_gen_id}} {{block.settings.scroll_speed}}s linear infinite}.ai-test-{{ai_gen_id}}__set{display:flex;gap:18px}.ai-test-{{ai_gen_id}}__card{width:320px;flex:0 0 320px;padding:20px;background:#fff;border-radius:{{block.settings.card_radius}}px;color:#14231a}.ai-test-{{ai_gen_id}}__avatar{width:48px;height:48px;border-radius:50%;object-fit:cover;vertical-align:middle}.ai-test-{{ai_gen_id}}__products{display:flex;gap:6px}.ai-test-{{ai_gen_id}}__products img{width:58px;height:58px;object-fit:cover;border-radius:6px}@keyframes ai-test-scroll-{{ai_gen_id}}{to{transform:translateX(calc(-50% - 9px))}}{% endstyle %}<div class="ai-test-{{ai_gen_id}}" {{block.shopify_attributes}}><h2>{{block.settings.heading|escape}}</h2><div style="overflow:hidden"><div class="ai-test-{{ai_gen_id}}__track">{% for copy in (1..2) %}<div class="ai-test-{{ai_gen_id}}__set">{% for i in (1..6) %}{% assign nk='name_'|append:i %}{% assign rk='review_'|append:i %}{% assign ak='avatar_'|append:i %}<article class="ai-test-{{ai_gen_id}}__card">{% if block.settings[ak] %}<img class="ai-test-{{ai_gen_id}}__avatar" src="{{block.settings[ak]|image_url:width:96}}" alt="{{block.settings[nk]|escape}}">{% endif %}<strong>{{block.settings[nk]|escape}}</strong><div style="color:#d99b00">★★★★★</div><p>{{block.settings[rk]|escape}}</p><div class="ai-test-{{ai_gen_id}}__products">{% for p in (1..3) %}{% assign pk='product_'|append:i|append:'_'|append:p %}{% if block.settings[pk] %}<img src="{{block.settings[pk]|image_url:width:120}}" alt="Customer product image">{% endif %}{% endfor %}</div></article>{% endfor %}</div>{% endfor %}</div></div></div>{% schema %}{"name":"Customer testimonials","settings":[{"type":"text","id":"heading","label":"Heading","default":"Loved by our customers"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"scroll_speed","label":"Scroll speed","min":20,"max":120,"step":10,"unit":"s","default":60},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"color","id":"background_color","label":"Background","default":"#f8f4ec"},{"type":"color","id":"heading_color","label":"Heading","default":"#0d3a1d"},{"type":"header","content":"Customer 1"},{"type":"text","id":"name_1","label":"Name 1","default":"Customer 1"},{"type":"textarea","id":"review_1","label":"Review 1","default":"A wonderful experience."},{"type":"image_picker","id":"avatar_1","label":"Profile image 1"},{"type":"image_picker","id":"product_1_1","label":"Product image 1A"},{"type":"image_picker","id":"product_1_2","label":"Product image 1B"},{"type":"image_picker","id":"product_1_3","label":"Product image 1C"},{"type":"header","content":"Customer 2"},{"type":"text","id":"name_2","label":"Name 2","default":"Customer 2"},{"type":"textarea","id":"review_2","label":"Review 2","default":"A wonderful experience."},{"type":"image_picker","id":"avatar_2","label":"Profile image 2"},{"type":"image_picker","id":"product_2_1","label":"Product image 2A"},{"type":"image_picker","id":"product_2_2","label":"Product image 2B"},{"type":"image_picker","id":"product_2_3","label":"Product image 2C"},{"type":"header","content":"Customer 3"},{"type":"text","id":"name_3","label":"Name 3","default":"Customer 3"},{"type":"textarea","id":"review_3","label":"Review 3","default":"A wonderful experience."},{"type":"image_picker","id":"avatar_3","label":"Profile image 3"},{"type":"image_picker","id":"product_3_1","label":"Product image 3A"},{"type":"image_picker","id":"product_3_2","label":"Product image 3B"},{"type":"image_picker","id":"product_3_3","label":"Product image 3C"},{"type":"header","content":"Customer 4"},{"type":"text","id":"name_4","label":"Name 4","default":"Customer 4"},{"type":"textarea","id":"review_4","label":"Review 4","default":"A wonderful experience."},{"type":"image_picker","id":"avatar_4","label":"Profile image 4"},{"type":"image_picker","id":"product_4_1","label":"Product image 4A"},{"type":"image_picker","id":"product_4_2","label":"Product image 4B"},{"type":"image_picker","id":"product_4_3","label":"Product image 4C"},{"type":"header","content":"Customer 5"},{"type":"text","id":"name_5","label":"Name 5","default":"Customer 5"},{"type":"textarea","id":"review_5","label":"Review 5","default":"A wonderful experience."},{"type":"image_picker","id":"avatar_5","label":"Profile image 5"},{"type":"image_picker","id":"product_5_1","label":"Product image 5A"},{"type":"image_picker","id":"product_5_2","label":"Product image 5B"},{"type":"image_picker","id":"product_5_3","label":"Product image 5C"},{"type":"header","content":"Customer 6"},{"type":"text","id":"name_6","label":"Name 6","default":"Customer 6"},{"type":"textarea","id":"review_6","label":"Review 6","default":"A wonderful experience."},{"type":"image_picker","id":"avatar_6","label":"Profile image 6"},{"type":"image_picker","id":"product_6_1","label":"Product image 6A"},{"type":"image_picker","id":"product_6_2","label":"Product image 6B"},{"type":"image_picker","id":"product_6_3","label":"Product image 6C"}],"presets":[{"name":"Customer testimonials"}],"tag":null,"class":"customer-testimonials-block"}{% endschema %}