{% doc %}
  @prompt
    Create a premium, modern horizontal scrolling ticker section for a plant nursery website.
    
    Design it as a clean, elegant plant-themed trust bar placed between website sections.
    
    Use a soft natural background in light cream, warm beige, or very subtle light green. Add small minimal botanical elements such as leaf icons, tiny plant silhouettes, or simple line-art leaves between each message. Keep the design sophisticated and uncluttered.
    
    Ticker content:
    🌿 3.5 Lakh+ Happy Plant Families
    🚚 On-Time Plant Delivery
    🪴 Healthy Plants, Carefully Packed
    🌱 Professional Garden Services
    🏡 Landscape & Green Wall Solutions
    ✨ Quality Plants, Grown with Care
    
    Make the content continuously scroll horizontally from right to left in a smooth, seamless loop.
    
    Typography should be clean, premium, modern, and highly readable. Use dark green text with subtle botanical icons. Keep the ticker height compact so it does not take too much vertical space.
    
    The section must be fully responsive on desktop, tablet, and mobile.
    
    Add customizable Shopify settings for:
    
    Ticker text
    Icon between items
    Text color
    Background color
    Scrolling speed
    Font size
    Spacing between items
    Pause on hover
    
    Do not use large images, cards, gradients, or heavy graphics. The overall look should feel premium, natural, trustworthy, and suitable for a professional online plant nursery.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign ticker_items = block.settings.ticker_text | newline_to_br | split: '<br />' %}

{% style %}
  .ai-ticker-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; overflow: hidden; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; border-top: 1px solid {{ block.settings.text_color | color_modify: 'alpha', 0.12 }}; border-bottom: 1px solid {{ block.settings.text_color | color_modify: 'alpha', 0.12 }}; }
  .ai-ticker__viewport-{{ ai_gen_id }} { width: 100%; overflow: hidden; padding: {{ block.settings.vertical_padding }}px 0; }
  .ai-ticker__track-{{ ai_gen_id }} { display: flex; width: max-content; align-items: center; animation: ai-ticker-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite; will-change: transform; }
  .ai-ticker__group-{{ ai_gen_id }} { display: flex; flex-shrink: 0; align-items: center; }
  .ai-ticker__item-{{ ai_gen_id }} { display: inline-flex; align-items: center; gap: {{ block.settings.item_spacing | divided_by: 2 }}px; margin-right: {{ block.settings.item_spacing }}px; white-space: nowrap; font-size: {{ block.settings.font_size }}px; line-height: 1.3; font-weight: 600; letter-spacing: 0.01em; }
  .ai-ticker__icon-{{ ai_gen_id }} { display: inline-flex; align-items: center; justify-content: center; color: {{ block.settings.text_color }}; font-size: {{ block.settings.icon_size }}px; line-height: 1; }
  @keyframes ai-ticker-scroll-{{ ai_gen_id }} { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-50%, 0, 0); } }
  {% if block.settings.pause_on_hover %}.ai-ticker-{{ ai_gen_id }}:hover .ai-ticker__track-{{ ai_gen_id }} { animation-play-state: paused; }{% endif %}
  @media screen and (max-width: 749px) { .ai-ticker__viewport-{{ ai_gen_id }} { padding: {{ block.settings.mobile_vertical_padding }}px 0; } .ai-ticker__item-{{ ai_gen_id }} { font-size: {{ block.settings.mobile_font_size }}px; margin-right: {{ block.settings.mobile_item_spacing }}px; } }
  @media (prefers-reduced-motion: reduce) { .ai-ticker__track-{{ ai_gen_id }} { animation: none; transform: none; } .ai-ticker__group-{{ ai_gen_id }}:nth-child(2) { display: none; } }
{% endstyle %}

<plant-ticker-{{ ai_gen_id }} class="ai-ticker-{{ ai_gen_id }}" role="region" aria-label="{{ block.settings.accessibility_label | escape }}" {{ block.shopify_attributes }}>
  <div class="ai-ticker__viewport-{{ ai_gen_id }}">
    <div class="ai-ticker__track-{{ ai_gen_id }}">
      {% for repeat in (1..2) %}
        <div class="ai-ticker__group-{{ ai_gen_id }}"{% if repeat == 2 %} aria-hidden="true"{% endif %}>
          {% for item in ticker_items %}
            {% assign clean_item = item | strip | strip_html %}
            {% if clean_item != blank %}
              <span class="ai-ticker__item-{{ ai_gen_id }}"><span>{{ clean_item | escape }}</span><span class="ai-ticker__icon-{{ ai_gen_id }}" aria-hidden="true">{{ block.settings.separator_icon }}</span></span>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</plant-ticker-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('plant-ticker-{{ ai_gen_id }}')) {
      class PlantTicker{{ ai_gen_id }} extends HTMLElement {}
      customElements.define('plant-ticker-{{ ai_gen_id }}', PlantTicker{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Plant trust ticker",
  "settings": [
    { "type": "textarea", "id": "ticker_text", "label": "Ticker text", "default": "🌿 3.5 Lakh+ Happy Plant Families\n🚚 On-Time Plant Delivery\n🪴 Healthy Plants, Carefully Packed\n🌱 Professional Garden Services\n🏡 Landscape & Green Wall Solutions\n✨ Quality Plants, Grown with Care" },
    { "type": "text", "id": "separator_icon", "label": "Icon between items", "default": "✦" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Plant nursery highlights" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0d3a1d" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f8f4ec" },
    { "type": "range", "id": "scroll_speed", "label": "Scrolling speed", "min": 10, "max": 60, "step": 5, "unit": "s", "default": 30 },
    { "type": "range", "id": "font_size", "label": "Font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "mobile_font_size", "label": "Mobile font size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "item_spacing", "label": "Spacing between items", "min": 20, "max": 120, "step": 10, "unit": "px", "default": 60 },
    { "type": "range", "id": "mobile_item_spacing", "label": "Mobile item spacing", "min": 16, "max": 80, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical padding", "min": 6, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "mobile_vertical_padding", "label": "Mobile padding", "min": 5, "max": 18, "step": 1, "unit": "px", "default": 9 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true }
  ],
  "presets": [{ "name": "Plant trust ticker" }],
  "tag": null,
  "class": "plant-trust-ticker"
}
{% endschema %}