{% doc %}
  @prompt
    Create a Shopify collection product-grid section that closely matches the uploaded reference image.
    
    SECTION BACKGROUND:
    - Add a customizable background image upload option for the entire section.
    - The uploaded background image should cover the full section width.
    - Add a soft/light overlay if needed so the product cards remain easy to read.
    - Also allow a fallback background color.
    
    LAYOUT:
    - Full-width responsive product collection grid.
    - Desktop: 4 product cards per row.
    - Tablet: 2–3 cards per row.
    - Mobile: 2 cards per row.
    - Add consistent spacing between cards.
    - Product cards should have rounded corners, approximately 18–20px.
    
    TOP BAR:
    - Left side: FILTER with a small filter/sliders icon.
    - Right side: SORT BY with a dropdown arrow.
    - Make both functional.
    - Filter should open Shopify's collection filtering options.
    - Sort By should use Shopify's native collection sorting options.
    
    PRODUCT CARDS:
    Each card must dynamically pull products from a selected Shopify collection.
    
    Include:
    - Product image at the top.
    - Rounded top corners.
    - Discount badge in the top-right corner when a compare-at price exists.
    - Product rating and review count near the bottom of the image when available.
    - Product title below the image.
    - Current price.
    - Compare-at/original price with strikethrough.
    - "View Product" rounded button aligned to the bottom-right.
    - Button should link to the product page.
    - Entire product image/title can also link to the product page.
    
    IMPORTANT:
    - Do NOT hardcode product names, prices, ratings, discounts or images.
    - Everything must be dynamically pulled from Shopify product/collection data.
    - Allow the merchant to select the collection from the Shopify Theme Editor.
    - Add settings for number of products displayed.
    - Add settings for desktop/tablet/mobile columns.
    - Add settings for card border radius, spacing, background image, background overlay opacity and button styling.
    - Make the section fully responsive.
    - Match the visual style of the uploaded reference: clean premium gardening/plant-store aesthetic, soft off-white cards, dark green buttons and subtle rounded corners.
    - Use Shopify Liquid, HTML, CSS and JavaScript only.
    - Make it compatible with Shopify Online Store 2.0.
    - The section must work independently when added through the Shopify Theme Editor., need heading
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-cg-{{ ai_gen_id }}{display:block;width:100%;padding:{{ block.settings.section_padding }}px 20px;background:{{ block.settings.background_color }};{% if block.settings.background_image %}background-image:linear-gradient(rgba(255,255,255,{{ block.settings.overlay_opacity | divided_by:100.0 }}),rgba(255,255,255,{{ block.settings.overlay_opacity | divided_by:100.0 }})),url('{{ block.settings.background_image | image_url:width:2400 }}');background-size:cover;background-position:center;{% endif %}}.ai-cg__inner-{{ ai_gen_id }}{max-width:{{ block.settings.content_width }}px;margin:auto}.ai-cg__heading-{{ ai_gen_id }}{margin:0 0 8px;color:{{ block.settings.text_color }};font-size:{{ block.settings.heading_size }}px;text-align:{{ block.settings.heading_alignment }}}.ai-cg__intro-{{ ai_gen_id }}{margin:0 0 24px;color:{{ block.settings.muted_color }};text-align:{{ block.settings.heading_alignment }}}.ai-cg__bar-{{ ai_gen_id }}{display:flex;justify-content:space-between;margin-bottom:24px}.ai-cg__control-{{ ai_gen_id }}{border:1px solid {{ block.settings.control_border_color }};border-radius:999px;background:{{ block.settings.control_background }};color:{{ block.settings.text_color }};padding:10px 16px;font-weight:700}.ai-cg__filter-{{ ai_gen_id }}{display:none;margin-bottom:24px;padding:18px;border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.filter_background }}}.ai-cg__filter-{{ ai_gen_id }}.open{display:block}.ai-cg__filters-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px}.ai-cg__filters-{{ ai_gen_id }} label{display:flex;flex-direction:column;gap:6px;color:{{ block.settings.text_color }};font-size:13px;font-weight:700}.ai-cg__filters-{{ ai_gen_id }} select{padding:9px;border:1px solid {{ block.settings.control_border_color }};border-radius:8px}.ai-cg__grid-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat({{ block.settings.desktop_columns }},minmax(0,1fr));gap:{{ block.settings.card_spacing }}px}.ai-cg__card-{{ ai_gen_id }}{display:flex;flex-direction:column;overflow:hidden;border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.card_background }};color:{{ block.settings.text_color }}}.ai-cg__image-{{ ai_gen_id }}{position:relative;aspect-ratio:1;overflow:hidden}.ai-cg__image-{{ ai_gen_id }} img{width:100%;height:100%;object-fit:cover}.ai-cg__badge-{{ ai_gen_id }}{position:absolute;top:12px;right:12px;padding:6px 9px;border-radius:99px;background:{{ block.settings.badge_background }};color:#fff;font-size:11px}.ai-cg__body-{{ ai_gen_id }}{display:flex;flex:1;flex-direction:column;gap:8px;padding:16px}.ai-cg__title-{{ ai_gen_id }}{margin:0;font-size:16px}.ai-cg__title-{{ ai_gen_id }} a{color:inherit;text-decoration:none}.ai-cg__price-{{ ai_gen_id }}{font-weight:700}.ai-cg__compare-{{ ai_gen_id }}{margin-left:8px;color:{{ block.settings.muted_color }};font-weight:400}.ai-cg__button-{{ ai_gen_id }}{margin-top:auto;align-self:flex-end;padding:10px 15px;border-radius:99px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};text-decoration:none;font-size:12px;font-weight:700}@media(max-width:989px){.ai-cg__grid-{{ ai_gen_id }}{grid-template-columns:repeat({{ block.settings.tablet_columns }},minmax(0,1fr))}}@media(max-width:749px){.ai-cg-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px 12px}.ai-cg__grid-{{ ai_gen_id }}{grid-template-columns:repeat({{ block.settings.mobile_columns }},minmax(0,1fr));gap:12px}.ai-cg__body-{{ ai_gen_id }}{padding:12px}}{% endstyle %}
<collection-grid-{{ ai_gen_id }} class="ai-cg-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-cg__inner-{{ ai_gen_id }}">{% if block.settings.heading != blank %}<h2 class="ai-cg__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>{% endif %}{% if block.settings.intro != blank %}<div class="ai-cg__intro-{{ ai_gen_id }}">{{ block.settings.intro }}</div>{% endif %}{% if block.settings.collection != blank %}{% assign c=block.settings.collection %}<form class="ai-cg__bar-{{ ai_gen_id }}" method="get" action="{{ c.url }}"><button type="button" class="ai-cg__control-{{ ai_gen_id }} js-filter">☷ Filter</button><label class="ai-cg__control-{{ ai_gen_id }}">Sort by <select name="sort_by" onchange="this.form.submit()">{% assign selected_sort=c.sort_by | default:c.default_sort_by %}{% for o in c.sort_options %}<option value="{{ o.value }}" {% if o.value==selected_sort %}selected{% endif %}>{{ o.name }}</option>{% endfor %}</select></label></form><div class="ai-cg__filter-{{ ai_gen_id }}"><form method="get" action="{{ c.url }}"><div class="ai-cg__filters-{{ ai_gen_id }}">{% for f in c.filters %}{% if f.type=='list' %}<label>{{ f.label }}<select name="{{ f.param_name }}" onchange="this.form.submit()"><option value="">All</option>{% for v in f.values %}<option value="{{ v.value }}" {% if v.active %}selected{% endif %}>{{ v.label }} ({{ v.count }})</option>{% endfor %}</select></label>{% endif %}{% endfor %}</div></form></div><div class="ai-cg__grid-{{ ai_gen_id }}">{% for p in c.products limit:block.settings.products_to_show %}<article class="ai-cg__card-{{ ai_gen_id }}"><div class="ai-cg__image-{{ ai_gen_id }}"><a href="{{ p.url }}">{% if p.featured_image %}<img src="{{ p.featured_image | image_url:width:800 }}" alt="{{ p.featured_image.alt | default:p.title | escape }}" loading="lazy" width="800" height="800">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</a>{% if p.compare_at_price>p.price %}<span class="ai-cg__badge-{{ ai_gen_id }}">Sale</span>{% endif %}</div><div class="ai-cg__body-{{ ai_gen_id }}"><h3 class="ai-cg__title-{{ ai_gen_id }}"><a href="{{ p.url }}">{{ p.title }}</a></h3><div class="ai-cg__price-{{ ai_gen_id }}">{{ p.price | money }}{% if p.compare_at_price>p.price %}<span class="ai-cg__compare-{{ ai_gen_id }}"><s>{{ p.compare_at_price | money }}</s></span>{% endif %}</div><a class="ai-cg__button-{{ ai_gen_id }}" href="{{ p.url }}">View product</a></div></article>{% endfor %}</div>{% else %}<p>Select a collection.</p>{% endif %}</div></collection-grid-{{ ai_gen_id }}><script>(function(){class C{{ ai_gen_id }} extends HTMLElement{connectedCallback(){const b=this.querySelector('.js-filter'),p=this.querySelector('.ai-cg__filter-{{ ai_gen_id }}');if(b&&p)b.onclick=()=>p.classList.toggle('open')}}customElements.define('collection-grid-{{ ai_gen_id }}',C{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Collection product grid","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop our collection"},{"type":"textarea","id":"intro","label":"Intro text","default":"Bring a little more green into your space."},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":60,"step":2,"unit":"px","default":36},{"type":"select","id":"heading_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":48,"step":4,"default":16},{"type":"select","id":"desktop_columns","label":"Desktop columns","options":[{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"}],"default":"4"},{"type":"select","id":"tablet_columns","label":"Tablet columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"}],"default":"3"},{"type":"select","id":"mobile_columns","label":"Mobile columns","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"color","id":"background_color","label":"Fallback background","default":"#f8f4ec"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":100,"step":10,"unit":"%","default":20},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":18},{"type":"range","id":"card_spacing","label":"Card spacing","min":8,"max":36,"step":4,"unit":"px","default":20},{"type":"range","id":"section_padding","label":"Section padding","min":16,"max":80,"step":8,"unit":"px","default":40},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":12,"max":40,"step":4,"unit":"px","default":24},{"type":"range","id":"content_width","label":"Content width","min":1000,"max":1600,"step":100,"unit":"px","default":1200},{"type":"color","id":"card_background","label":"Card background","default":"#fffdf8"},{"type":"color","id":"text_color","label":"Text","default":"#0d3a1d"},{"type":"color","id":"muted_color","label":"Muted text","default":"#5b6660"},{"type":"color","id":"control_background","label":"Control background","default":"#fffdf8"},{"type":"color","id":"filter_background","label":"Filter background","default":"#fffdf8"},{"type":"color","id":"control_border_color","label":"Control border","default":"#d5ddd1"},{"type":"color","id":"button_background","label":"Button background","default":"#1f5130"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"badge_background","label":"Badge background","default":"#0d3a1d"}],"presets":[{"name":"Collection product grid"}],"tag":null,"class":"collection-product-grid-block"}{% endschema %}