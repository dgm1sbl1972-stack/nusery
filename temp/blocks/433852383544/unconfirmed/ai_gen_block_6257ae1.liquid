{% doc %}
  @prompt
    Create a Shopify OS 2.0 custom section called **“Handpicked Favourites”** matching the attached reference layout.
    
    * Premium horizontal product carousel with cream background and rounded cards.
    * Desktop: 3 cards, tablet: 2, mobile: 1.2–1.5 cards with swipe.
    * Products dynamically load from a **collection selected in Theme Editor**.
    * Product card: image, BESTSELLER badge, automatic % OFF badge, rating/reviews from metafields, title, short description, price + compare-at-price.
    * Add **View Product** button.
    * Add **Add to Cart** text + circular cart icon as one button.
    * Use Shopify AJAX Cart API, then redirect directly to **`/cart`** after adding.
    * Include loading state and prevent double-clicks.
    * Add Theme Editor controls for collection, product count, badges, ratings, descriptions, prices, buttons, colors, card radius and spacing.
    * Fully responsive, accessible, clean Liquid/CSS/JS, no hardcoded products or IDs.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-favourites-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }
  .ai-favourites-{{ ai_gen_id }}__inner { max-width: 1400px; margin: 0 auto; padding: 0 24px; }
  .ai-favourites-{{ ai_gen_id }}__heading { margin: 0 0 22px; font-size: clamp(24px, 3vw, 38px); line-height: 1.15; color: {{ block.settings.text_color }}; }
  .ai-favourites-{{ ai_gen_id }}__track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - {{ block.settings.card_gap | times: 2 }}px) / 3); gap: {{ block.settings.card_gap }}px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 2px 2px 14px; scrollbar-width: thin; }
  .ai-favourites-{{ ai_gen_id }}__card { min-width: 0; overflow: hidden; scroll-snap-align: start; background: {{ block.settings.card_color }}; border-radius: {{ block.settings.card_radius }}px; display: flex; flex-direction: column; }
  .ai-favourites-{{ ai_gen_id }}__media { position: relative; aspect-ratio: 1 / 1; background: #eee9df; overflow: hidden; }
  .ai-favourites-{{ ai_gen_id }}__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-favourites-{{ ai_gen_id }}__placeholder { height: 100%; }
  .ai-favourites-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-favourites-{{ ai_gen_id }}__badge { position: absolute; top: 12px; left: 12px; border-radius: 99px; padding: 6px 10px; background: {{ block.settings.badge_color }}; color: {{ block.settings.badge_text_color }}; font-size: 11px; font-weight: 700; line-height: 1; }
  .ai-favourites-{{ ai_gen_id }}__badge--sale { left: auto; right: 12px; }
  .ai-favourites-{{ ai_gen_id }}__body { padding: 16px; display: flex; flex-direction: column; gap: 9px; flex: 1; }
  .ai-favourites-{{ ai_gen_id }}__rating { font-size: 13px; color: {{ block.settings.muted_color }}; }
  .ai-favourites-{{ ai_gen_id }}__stars { color: {{ block.settings.star_color }}; letter-spacing: 1px; }
  .ai-favourites-{{ ai_gen_id }}__title { margin: 0; font-size: 18px; line-height: 1.3; color: {{ block.settings.text_color }}; }
  .ai-favourites-{{ ai_gen_id }}__title a { color: inherit; text-decoration: none; }
  .ai-favourites-{{ ai_gen_id }}__description { margin: 0; color: {{ block.settings.muted_color }}; font-size: 14px; line-height: 1.5; }
  .ai-favourites-{{ ai_gen_id }}__price { font-weight: 700; font-size: 16px; display: flex; gap: 8px; align-items: baseline; }
  .ai-favourites-{{ ai_gen_id }}__compare { color: {{ block.settings.muted_color }}; text-decoration: line-through; font-weight: 400; font-size: 14px; }
  .ai-favourites-{{ ai_gen_id }}__actions { display: grid; gap: 8px; margin-top: auto; padding-top: 5px; }
  .ai-favourites-{{ ai_gen_id }}__view, .ai-favourites-{{ ai_gen_id }}__add { width: 100%; min-height: 44px; border-radius: 999px; display: flex; justify-content: center; align-items: center; gap: 9px; font: inherit; font-weight: 650; text-decoration: none; cursor: pointer; }
  .ai-favourites-{{ ai_gen_id }}__view { border: 1px solid {{ block.settings.button_color }}; color: {{ block.settings.button_color }}; background: transparent; }
  .ai-favourites-{{ ai_gen_id }}__add { border: 1px solid {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }}; background: {{ block.settings.button_color }}; }
  .ai-favourites-{{ ai_gen_id }}__add:disabled { opacity: .65; cursor: wait; }
  .ai-favourites-{{ ai_gen_id }}__cart-icon { width: 27px; height: 27px; border: 1px solid currentColor; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; }
  .ai-favourites-{{ ai_gen_id }}__cart-icon svg { width: 15px; height: 15px; }
  .ai-favourites-{{ ai_gen_id }}__empty { padding: 30px; text-align: center; color: {{ block.settings.muted_color }}; }
  .ai-favourites-{{ ai_gen_id }}__track:focus-visible, .ai-favourites-{{ ai_gen_id }} a:focus-visible, .ai-favourites-{{ ai_gen_id }} button:focus-visible { outline: 3px solid {{ block.settings.star_color }}; outline-offset: 3px; }
  @media (min-width: 750px) and (max-width: 989px) { .ai-favourites-{{ ai_gen_id }}__track { grid-auto-columns: calc((100% - {{ block.settings.card_gap }}px) / 2); } }
  @media (max-width: 749px) { .ai-favourites-{{ ai_gen_id }}__inner { padding: 0 16px; } .ai-favourites-{{ ai_gen_id }}__track { grid-auto-columns: {{ block.settings.mobile_card_width }}%; } }
  @media (prefers-reduced-motion: reduce) { .ai-favourites-{{ ai_gen_id }}__track { scroll-behavior: auto; } }
{% endstyle %}

<handpicked-favourites-{{ ai_gen_id }} class="ai-favourites-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-favourites-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-favourites-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}
      <div class="ai-favourites-{{ ai_gen_id }}__track" tabindex="0" aria-label="{{ block.settings.heading | default: 'Handpicked favourites' | escape }} products">
        {% for product in block.settings.collection.products limit: block.settings.product_limit %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          {% assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.rating.value %}
          {% assign review_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews_count.value %}
          {% assign sale_percent = 0 %}
          {% if product.compare_at_price_max > product.price %}{% assign difference = product.compare_at_price_max | minus: product.price %}{% assign sale_percent = difference | times: 100.0 | divided_by: product.compare_at_price_max | round %}{% endif %}
          <article class="ai-favourites-{{ ai_gen_id }}__card">
            <div class="ai-favourites-{{ ai_gen_id }}__media">
              {% if product.featured_image %}<a href="{{ product.url }}" tabindex="-1" aria-hidden="true"><img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"></a>{% else %}<div class="ai-favourites-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
              {% if block.settings.show_bestseller and product.tags contains block.settings.bestseller_tag %}<span class="ai-favourites-{{ ai_gen_id }}__badge">{{ block.settings.bestseller_label | escape }}</span>{% endif %}
              {% if block.settings.show_sale_badge and sale_percent > 0 %}<span class="ai-favourites-{{ ai_gen_id }}__badge ai-favourites-{{ ai_gen_id }}__badge--sale">{{ sale_percent }}% {{ block.settings.sale_label | escape }}</span>{% endif %}
            </div>
            <div class="ai-favourites-{{ ai_gen_id }}__body">
              {% if block.settings.show_rating and rating_value != blank %}<div class="ai-favourites-{{ ai_gen_id }}__rating"><span class="ai-favourites-{{ ai_gen_id }}__stars" aria-label="Rated {{ rating_value }} out of 5">{% assign rating_rounded = rating_value | round %}{% for star in (1..5) %}{% if star <= rating_rounded %}★{% else %}☆{% endif %}{% endfor %}</span> <span>{{ rating_value }}{% if review_count != blank %} ({{ review_count }}){% endif %}</span></div>{% endif %}
              <h3 class="ai-favourites-{{ ai_gen_id }}__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              {% if block.settings.show_description %}{% assign short_description = product.metafields.custom.short_description.value | default: product.description | strip_html | truncate: block.settings.description_length %}{% if short_description != blank %}<p class="ai-favourites-{{ ai_gen_id }}__description">{{ short_description | escape }}</p>{% endif %}{% endif %}
              {% if block.settings.show_price %}<div class="ai-favourites-{{ ai_gen_id }}__price">{{ product.price | money }}{% if product.compare_at_price_max > product.price %}<span class="ai-favourites-{{ ai_gen_id }}__compare">{{ product.compare_at_price_max | money }}</span>{% endif %}</div>{% endif %}
              <div class="ai-favourites-{{ ai_gen_id }}__actions">
                {% if block.settings.show_view_button %}<a class="ai-favourites-{{ ai_gen_id }}__view" href="{{ product.url }}">{{ block.settings.view_label | escape }}</a>{% endif %}
                {% if block.settings.show_add_button %}<button class="ai-favourites-{{ ai_gen_id }}__add" type="button" data-variant-id="{{ current_variant.id }}" {% unless current_variant.available %}disabled{% endunless %} aria-label="{{ block.settings.add_label | escape }}: {{ product.title | escape }}"><span class="ai-favourites-{{ ai_gen_id }}__add-label">{% if current_variant.available %}{{ block.settings.add_label | escape }}{% else %}{{ block.settings.sold_out_label | escape }}{% endif %}</span><span class="ai-favourites-{{ ai_gen_id }}__cart-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M1 1h4l2.7 13.2a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path></svg></span></button>{% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}<div class="ai-favourites-{{ ai_gen_id }}__empty">Select a collection with products to display your favourites.</div>{% endif %}
  </div>
  <div class="ai-favourites-{{ ai_gen_id }}__status" role="status" aria-live="polite" hidden></div>
</handpicked-favourites-{{ ai_gen_id }}>

<script>
  (function() {
    const elementName = 'handpicked-favourites-{{ ai_gen_id }}';
    if (customElements.get(elementName)) return;
    class HandpickedFavourites extends HTMLElement {
      connectedCallback() {
        this.addEventListener('click', this.handleClick.bind(this));
      }
      async handleClick(event) {
        const button = event.target.closest('.ai-favourites-{{ ai_gen_id }}__add');
        if (!button || !this.contains(button) || button.disabled) return;
        button.disabled = true;
        const label = button.querySelector('.ai-favourites-{{ ai_gen_id }}__add-label');
        const originalLabel = label.textContent;
        label.textContent = {{ block.settings.loading_label | json }};
        try {
          const response = await fetch((window.Shopify && Shopify.routes && Shopify.routes.root ? Shopify.routes.root : '/') + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: [{ id: Number(button.dataset.variantId), quantity: 1 }] })
          });
          if (!response.ok) throw new Error('Cart request failed');
          window.location.assign((window.Shopify && Shopify.routes && Shopify.routes.root ? Shopify.routes.root : '/') + 'cart');
        } catch (error) {
          label.textContent = originalLabel;
          button.disabled = false;
          const status = this.querySelector('.ai-favourites-{{ ai_gen_id }}__status');
          status.textContent = {{ block.settings.error_label | json }};
          status.hidden = false;
        }
      }
    }
    customElements.define(elementName, HandpickedFavourites);
  })();
</script>

{% schema %}
{
  "name": "Handpicked favourites",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Handpicked Favourites" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Product count", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_gap", "label": "Card spacing", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "mobile_card_width", "label": "Mobile card width", "min": 65, "max": 85, "step": 5, "unit": "%", "default": 75 },
    { "type": "range", "id": "section_padding", "label": "Section padding", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Product details" },
    { "type": "checkbox", "id": "show_bestseller", "label": "Show bestseller badge", "default": true },
    { "type": "text", "id": "bestseller_tag", "label": "Bestseller product tag", "default": "bestseller" },
    { "type": "text", "id": "bestseller_label", "label": "Bestseller label", "default": "BESTSELLER" },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Show discount badge", "default": true },
    { "type": "text", "id": "sale_label", "label": "Discount badge suffix", "default": "OFF" },
    { "type": "checkbox", "id": "show_rating", "label": "Show ratings from metafields", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show short description", "default": true },
    { "type": "range", "id": "description_length", "label": "Description length", "min": 40, "max": 160, "step": 10, "default": 90 },
    { "type": "checkbox", "id": "show_price", "label": "Show prices", "default": true },
    { "type": "header", "content": "Buttons" },
    { "type": "checkbox", "id": "show_view_button", "label": "Show view product button", "default": true },
    { "type": "text", "id": "view_label", "label": "View button label", "default": "View Product" },
    { "type": "checkbox", "id": "show_add_button", "label": "Show add to cart button", "default": true },
    { "type": "text", "id": "add_label", "label": "Add button label", "default": "Add to Cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "loading_label", "label": "Loading label", "default": "Adding…" },
    { "type": "text", "id": "error_label", "label": "Error message", "default": "Could not add this item. Please try again." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f8f4ec" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0d3a1d" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5b6660" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#1f5130" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "badge_color", "label": "Badge background", "default": "#1f5130" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text", "default": "#ffffff" },
    { "type": "color", "id": "star_color", "label": "Stars and focus", "default": "#805b00" }
  ],
  "presets": [{ "name": "Handpicked favourites" }],
  "tag": null,
  "class": "handpicked-favourites-block"
}
{% endschema %}