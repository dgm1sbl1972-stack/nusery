{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-plant-card-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    border-radius: 16px;
    background: {{ block.settings.card_background }};
    color: #14231a;
    box-shadow: 0 4px 18px rgba(20, 35, 26, 0.08);
  }
  .ai-plant-card__image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f4f4ed;
  }
  .ai-plant-card__image-{{ ai_gen_id }} img,
  .ai-plant-card__image-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
  }
  .ai-plant-card-{{ ai_gen_id }}:hover .ai-plant-card__image-{{ ai_gen_id }} img { transform: scale(1.025); }
  .ai-plant-card__cart-{{ ai_gen_id }} {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #1f5130;
    color: #fff;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(0,0,0,.2);
    transition: transform 180ms ease, background-color 180ms ease;
  }
  .ai-plant-card__cart-{{ ai_gen_id }}:hover { transform: scale(1.06); background: #0d3a1d; }
  .ai-plant-card__cart-{{ ai_gen_id }}:focus-visible { outline: 3px solid #ffd60a; outline-offset: 3px; }
  .ai-plant-card__cart-{{ ai_gen_id }}:disabled { opacity: .55; cursor: not-allowed; }
  .ai-plant-card__cart-{{ ai_gen_id }} svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ai-plant-card__details-{{ ai_gen_id }} { padding: 16px 18px 20px; }
  .ai-plant-card__title-{{ ai_gen_id }} { margin: 0 0 6px; font-family: Georgia, serif; font-size: 21px; line-height: 1.25; }
  .ai-plant-card__description-{{ ai_gen_id }} { margin: 0; color: #5b6660; font-size: 14px; line-height: 1.5; }
  .ai-plant-card__link-{{ ai_gen_id }} { display: block; color: inherit; text-decoration: none; }
  @media (prefers-reduced-motion: reduce) {
    .ai-plant-card-{{ ai_gen_id }} *, .ai-plant-card-{{ ai_gen_id }} *::before, .ai-plant-card-{{ ai_gen_id }} *::after { transition-duration: .01ms !important; }
  }
{% endstyle %}

<div class="ai-plant-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-plant-card__image-{{ ai_gen_id }}">
    {% if block.settings.product_image != blank %}
      {% if block.settings.product_link != blank %}<a class="ai-plant-card__link-{{ ai_gen_id }}" href="{{ block.settings.product_link }}" aria-label="View {{ block.settings.product_title | escape }}">{% endif %}
      <img src="{{ block.settings.product_image | image_url: width: 1000 }}" alt="{{ block.settings.product_image.alt | default: block.settings.product_title | escape }}" loading="lazy" width="{{ block.settings.product_image.width }}" height="{{ block.settings.product_image.height }}">
      {% if block.settings.product_link != blank %}</a>{% endif %}
    {% else %}
      <div class="ai-plant-card__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
    {% endif %}
    {% if block.settings.product != blank %}
      {% assign selected_variant = block.settings.product.selected_or_first_available_variant %}
      {% form 'product', block.settings.product %}
        <input type="hidden" name="id" value="{{ selected_variant.id }}">
        <button class="ai-plant-card__cart-{{ ai_gen_id }}" type="submit" aria-label="Add {{ block.settings.product.title | escape }} to cart" {% unless selected_variant.available %}disabled{% endunless %}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.1 10.1a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"></path><circle cx="10" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle></svg>
        </button>
      {% endform %}
    {% else %}
      <a class="ai-plant-card__cart-{{ ai_gen_id }}" href="{{ block.settings.product_link | default: routes.all_products_collection_url }}" aria-label="View {{ block.settings.product_title | escape }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.1 10.1a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"></path><circle cx="10" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle></svg>
      </a>
    {% endif %}
  </div>
  <div class="ai-plant-card__details-{{ ai_gen_id }}">
    {% if block.settings.product != blank %}
      {% if block.settings.product_link != blank %}<a class="ai-plant-card__link-{{ ai_gen_id }}" href="{{ block.settings.product_link }}">{% endif %}
      <h3 class="ai-plant-card__title-{{ ai_gen_id }}">{{ block.settings.product_title | default: block.settings.product.title | escape }}</h3>
      {% if block.settings.product_link != blank %}</a>{% endif %}
    {% else %}
      {% if block.settings.product_link != blank %}<a class="ai-plant-card__link-{{ ai_gen_id }}" href="{{ block.settings.product_link }}">{% endif %}
      <h3 class="ai-plant-card__title-{{ ai_gen_id }}">{{ block.settings.product_title | escape }}</h3>
      {% if block.settings.product_link != blank %}</a>{% endif %}
    {% endif %}
    {% if block.settings.product_description != blank %}<p class="ai-plant-card__description-{{ ai_gen_id }}">{{ block.settings.product_description | escape }}</p>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Plant product card",
  "settings": [
    {"type":"product","id":"product","label":"Product for cart"},
    {"type":"image_picker","id":"product_image","label":"Plant image"},
    {"type":"text","id":"product_title","label":"Product title","default":"Peace lily"},
    {"type":"textarea","id":"product_description","label":"Description","default":"A beautiful, easy-care indoor plant."},
    {"type":"url","id":"product_link","label":"Product link"},
    {"type":"color","id":"card_background","label":"Card background","default":"#ffffff"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}
  ],
  "presets": [{"name":"Plant product card"}],
  "tag": null,
  "class": "plant-product-card"
}
{% endschema %}