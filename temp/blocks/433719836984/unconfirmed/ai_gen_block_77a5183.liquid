are lucky succulent"},{"type":"header","content":"Plant 4"},{"type":"image_picker","id":"image_4","label":"Plant image"},{"type":"product","id":"product_4","label":"Product"},{"type":"text","id":"title_4","label":"Title","default":"Add a plant"},{"type":"text","id":"description_4","label":"Description","default":"Choose a favorite plant"},{"type":"header","content":"Plant 5"},{"type":"image_picker","id":"image_5","label":"Plant image"},{"type":"product","id":"product_5","label":"Product"},{"type":"text","id":"title_5","label":"Title","default":"Add a plant"},{"type":"text","id":"description_5","label":"Description","default":"Choose a favorite plant"},{"type":"header","content":"Plant 6"},{"type":"image_picker","id":"image_6","label":"Plant image"},{"type":"product","id":"product_6","label":"Product"},{"type":"text","id":"title_6","label":"Title","default":"Add a plant"},{"type":"text","id":"description_6","label":"Description","default":"Choose a favorite plant"}],"presets":[{"name":"Nursery product carousel"}],"tag":null,"class":"nursery-product-carousel"}
{% endschema %}