{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture cart_form_class %}ai-nursery-cart-form-{{ ai_gen_id }}{% endcapture %}
{% style %}
  .ai-nursery-carousel-{{ ai_gen_id }} { display:block;width:100%;max-width:100%;box-sizing:border-box;background:{{ block.settings.background }};border-radius:{{ block.settings.radius }}px;padding:clamp(24px,4vw,56px);position:relative;overflow:hidden; }
  .ai-nursery-inner-{{ ai_gen_id }} { position:relative;width:100%; }
  .ai-nursery-heading-{{ ai_gen_id }} { display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px; }
  .ai-nursery-heading-{{ ai_gen_id }} h2 { color:#1f5130;font-family:Georgia,serif;margin:0; }
  .ai-nursery-controls-{{ ai_gen_id }} { display:flex;gap:8px; }
  .ai-nursery-arrow-{{ ai_gen_id }} { width:42px;height:42px;border-radius:50%;border:1px solid #1f5130;background:#fff;color:#1f5130;display:grid;place-items:center;cursor:pointer; }
  .ai-nursery-track-{{ ai_gen_id }} { display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;padding:4px 2px 14px; }
  .ai-nursery-track-{{ ai_gen_id }}::-webkit-scrollbar { display:none; }
  .ai-nursery-card-{{ ai_gen_id }} { position:relative;flex:0 0 calc((100% - 36px)/3);min-width:0;scroll-snap-align:start;background:#fff;border-radius:{{ block.settings.radius }}px;overflow:hidden;box-shadow:0 3px 14px rgba(23,49,32,.08); }
  .ai-nursery-photo-{{ ai_gen_id }} { height:clamp(190px,22vw,290px);background:#f4f1e8;position:relative;overflow:hidden; }
  .ai-nursery-photo-{{ ai_gen_id }} img { width:100%;height:100%;display:block;object-fit:cover; }
  .ai-nursery-photo-{{ ai_gen_id }} svg { width:100%;height:100%;display:block; }
  .ai-nursery-info-{{ ai_gen_id }} { position:static;padding:16px 16px 20px;min-height:160px; }
  .ai-nursery-info-{{ ai_gen_id }} h3 { color:#1f5130;font:19px/1.25 Georgia,serif;margin:7px 0; }
  .ai-nursery-info-{{ ai_gen_id }} p { color:#5b6660;font-size:13px;margin:0 0 12px; }
  .ai-nursery-rating-{{ ai_gen_id }} { font-size:12px;color:#1f5130; }
  .ai-nursery-prices-{{ ai_gen_id }} { display:flex;gap:8px;align-items:baseline;flex-wrap:wrap; }
  .ai-nursery-price-{{ ai_gen_id }} { color:#14231a;font-weight:700; }
  .ai-nursery-compare-{{ ai_gen_id }} { color:#68736c;text-decoration:line-through;font-size:13px; }
  .ai-nursery-badge-{{ ai_gen_id }} { position:absolute;top:12px;left:12px;background:#1f5130;color:#fff;border-radius:20px;padding:6px 10px;font-size:11px; }
  .ai-nursery-off-{{ ai_gen_id }} { position:absolute;top:12px;right:12px;background:#ffd60a;color:#14231a;border-radius:20px;padding:6px 10px;font-size:11px; }
  .ai-nursery-cart-form-{{ ai_gen_id }} { position:absolute;right:{{ block.settings.cart_right }}px;bottom:{{ block.settings.cart_bottom }}px;margin:0;z-index:3; }
  .ai-nursery-cart-button-{{ ai_gen_id }} { width:{{ block.settings.cart_size }}px;height:{{ block.settings.cart_size }}px;padding:0;border:0;border-radius:{{ block.settings.cart_radius }}%;background:{{ block.settings.cart_background }};color:{{ block.settings.cart_icon_color }};display:grid;place-items:center;cursor:pointer;text-decoration:none;box-shadow:0 3px 9px rgba(13,58,29,.3);transition:transform .2s ease,background .2s ease; }
  .ai-nursery-cart-button-{{ ai_gen_id }}:hover { transform:scale(1.05); }
  .ai-nursery-cart-button-{{ ai_gen_id }}:focus-visible,.ai-nursery-arrow-{{ ai_gen_id }}:focus-visible { outline:3px solid #9a7600;outline-offset:3px; }
  .ai-nursery-cart-button-{{ ai_gen_id }}:disabled { opacity:.65;cursor:wait; }
  .ai-nursery-cart-button-{{ ai_gen_id }} svg { width:48%;height:48%; }
  .ai-nursery-cart-label-{{ ai_gen_id }} { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0; }
  .ai-nursery-cart-status-{{ ai_gen_id }} { display:block;min-height:1.2em;margin-top:6px;color:#1f5130;font-size:12px; }
  .ai-nursery-viewrow-{{ ai_gen_id }} { display:flex;justify-content:center;margin-top:18px; }
  .ai-nursery-view-{{ ai_gen_id }} { display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 24px;border-radius:30px;background:#1f5130;color:#fff;text-decoration:none;font-weight:700; }
  @media(max-width:990px) { .ai-nursery-card-{{ ai_gen_id }} { flex-basis:calc((100% - 18px)/2); } }
  @media(max-width:600px) { .ai-nursery-carousel-{{ ai_gen_id }} { padding:24px 16px; } .ai-nursery-card-{{ ai_gen_id }} { flex-basis:84%; } .ai-nursery-track-{{ ai_gen_id }} { gap:12px; } }
{% endstyle %}
<plant-carousel-{{ ai_gen_id }} class="ai-nursery-carousel-{{ ai_gen_id }}" style="width:{{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  <div class="ai-nursery-inner-{{ ai_gen_id }}">
    <div class="ai-nursery-heading-{{ ai_gen_id }}"><h2>{{ block.settings.heading | escape }}</h2><div class="ai-nursery-controls-{{ ai_gen_id }}"><button class="ai-nursery-arrow-{{ ai_gen_id }}" type="button" data-direction="-1" aria-label="Previous products">‹</button><button class="ai-nursery-arrow-{{ ai_gen_id }}" type="button" data-direction="1" aria-label="Next products">›</button></div></div>
    <div class="ai-nursery-track-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign product_key = 'product_' | append: i
          assign title_key = 'title_' | append: i
          assign desc_key = 'description_' | append: i
          assign image = block.settings[image_key]
          assign item = block.settings[product_key]
          assign item_title = block.settings[title_key]
          assign item_desc = block.settings[desc_key]
          assign variant = item.selected_or_first_available_variant
        %}
        {% if item != blank or image != blank or item_title != blank %}
          <article class="ai-nursery-card-{{ ai_gen_id }}">
            <div class="ai-nursery-photo-{{ ai_gen_id }}">
              {% if image %}<img src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | default: item_title | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">{% elsif item.featured_image %}<img src="{{ item.featured_image | image_url: width: 900 }}" alt="{{ item.featured_image.alt | escape }}" loading="lazy" width="{{ item.featured_image.width }}" height="{{ item.featured_image.height }}">{% else %}<div>{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
              <span class="ai-nursery-badge-{{ ai_gen_id }}">{{ block.settings.bestseller_text | escape }}</span><span class="ai-nursery-off-{{ ai_gen_id }}">{{ block.settings.discount | escape }}</span>
              {% if variant != blank and item.available %}
                {% form 'product', item, class: cart_form_class %}
                  <input type="hidden" name="id" value="{{ variant.id }}"><input type="hidden" name="quantity" value="1">
                  <button class="ai-nursery-cart-button-{{ ai_gen_id }}" type="submit" aria-label="{{ block.settings.cart_button_text | escape }} — {{ item_title | default: item.title | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 3h2l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 1.9-1.4L22 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg><span class="ai-nursery-cart-label-{{ ai_gen_id }}">{{ block.settings.cart_button_text | escape }}</span></button>
                  <span class="ai-nursery-cart-status-{{ ai_gen_id }}" aria-live="polite" role="status"></span>
                {% endform %}
              {% endif %}
            </div>
            <div class="ai-nursery-info-{{ ai_gen_id }}"><div class="ai-nursery-rating-{{ ai_gen_id }}">★ {{ block.settings.rating | escape }} | {{ block.settings.reviews | escape }}</div><h3>{% if item != blank %}<a href="{{ item.url }}">{{ item_title | default: item.title | escape }}</a>{% else %}{{ item_title | escape }}{% endif %}</h3><p>{{ item_desc | escape }}</p><div class="ai-nursery-prices-{{ ai_gen_id }}">{% if item != blank %}<span class="ai-nursery-price-{{ ai_gen_id }}">{{ item.price | money }}</span>{% if item.compare_at_price > item.price %}<span class="ai-nursery-compare-{{ ai_gen_id }}">{{ item.compare_at_price | money }}</span>{% endif %}{% else %}<span class="ai-nursery-price-{{ ai_gen_id }}">{{ block.settings.price | escape }}</span><span class="ai-nursery-compare-{{ ai_gen_id }}">{{ block.settings.original_price | escape }}</span>{% endif %}</div></div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    <div class="ai-nursery-viewrow-{{ ai_gen_id }}"><a class="ai-nursery-view-{{ ai_gen_id }}" href="{{ block.settings.view_all_link | default: routes.all_products_collection_url }}">{{ block.settings.view_all_label | escape }}</a></div>
  </div>
</plant-carousel-{{ ai_gen_id }}>
<script>
(function(){
  const tag='plant-carousel-{{ ai_gen_id }}';
  if(customElements.get(tag)) return;
  class PlantCarousel extends HTMLElement {
    connectedCallback(){
      this.track=this.querySelector('.ai-nursery-track-{{ ai_gen_id }}');
      this.querySelectorAll('.ai-nursery-arrow-{{ ai_gen_id }}').forEach(button=>button.addEventListener('click',()=>{const card=this.track.querySelector('.ai-nursery-card-{{ ai_gen_id }}');if(card)this.track.scrollBy({left:Number(button.dataset.direction)*(card.getBoundingClientRect().width+18),behavior:'smooth'});}));
      this.querySelectorAll('.ai-nursery-cart-form-{{ ai_gen_id }}').forEach(form=>form.addEventListener('submit',event=>this.addToCart(event,form)));
    }
    async addToCart(event,form){
      event.preventDefault();
      const button=form.querySelector('button[type="submit"]');
      const status=form.querySelector('[role="status"]');
      if(!button||button.disabled)return;
      button.disabled=true;
      if(status)status.textContent='Adding…';
      try{
        const response=await fetch(`${form.action}.js`,{method:'POST',headers:{'Accept':'application/json'},body:new FormData(form)});
        const result=await response.json();
        if(!response.ok)throw new Error(result.description||result.message||'Could not add this item.');
        if(status)status.textContent={{ block.settings.cart_success_text | json }};
        document.dispatchEvent(new CustomEvent('cart:updated',{detail:{item:result}}));
        document.dispatchEvent(new CustomEvent('cart:refresh',{detail:{item:result}}));
      }catch(error){if(status)status.textContent=error.message||{{ block.settings.cart_error_text | json }};}
      finally{button.disabled=false;}
    }
  }
  customElements.define(tag,PlantCarousel);
})();
</script>
