{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-plant-card-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 16px;
    background: #fff;
  }
  .ai-plant-card__media-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .ai-plant-card__media-{{ ai_gen_id }} img,
  .ai-plant-card__placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ai-plant-card__placeholder-{{ ai_gen_id }} { width: 100%; height: 100%; background: #f4f4f4; }
  .ai-plant-card__cart-{{ ai_gen_id }} {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: #1f5130;
    cursor: pointer;
    box-shadow: 0 3px 12px rgba(0,0,0,.2);
  }
  .ai-plant-card__cart-{{ ai_gen_id }}:hover { transform: scale(1.05); }
  .ai-plant-card__cart-{{ ai_gen_id }}:focus-visible { outline: 3px solid #ffd60a; outline-offset: 3px; }
  .ai-plant-card__cart-{{ ai_gen_id }} svg { width: 22px; height: 22px; }
  .ai-plant-card__title-{{ ai_gen_id }} { margin: 12px 14px 14px; color: #14231a; }
{% endstyle %}

<article class="ai-plant-card-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  <div class="ai-plant-card__media-{{ ai_gen_id }}">
    {% if block.settings.product_image != blank %}
      <img src="{{ block.settings.product_image | image_url: width: 900 }}" alt="{{ block.settings.product_image.alt | default: block.settings.product.title | escape }}" loading="lazy" width="{{ block.settings.product_image.width }}" height="{{ block.settings.product_image.height }}">
    {% else %}
      <div class="ai-plant-card__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
    {% endif %}
    {% if block.settings.product != blank %}
      {% form 'product', block.settings.product, class: 'ai-plant-card__product-form' %}
        <input type="hidden" name="id" value="{{ block.settings.product.selected_or_first_available_variant.id }}">
        <button class="ai-plant-card__cart-{{ ai_gen_id }}" type="submit" name="add" aria-label="Add {{ block.settings.product.title | escape }} to cart" {% unless block.settings.product.available %}disabled{% endunless %}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.1 10.1a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
        </button>
      {% endform %}
    {% elsif block.settings.product_link != blank %}
      <a class="ai-plant-card__cart-{{ ai_gen_id }}" href="{{ block.settings.product_link }}" aria-label="View product">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.1 10.1a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
      </a>
    {% endif %}
  </div>
  {% if block.settings.product != blank %}<h3 class="ai-plant-card__title-{{ ai_gen_id }}">{{ block.settings.product.title | escape }}</h3>{% elsif block.settings.title != blank %}<h3 class="ai-plant-card__title-{{ ai_gen_id }}">{{ block.settings.title | escape }}</h3>{% endif %}
</article>

{% schema %}
{
  "name": "Plant image cart button",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "product_image", "label": "Plant image" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "url", "id": "product_link", "label": "Product link" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Plant image cart button" }],
  "tag": null,
  "class": "plant-image-cart-button"
}
{% endschema %}