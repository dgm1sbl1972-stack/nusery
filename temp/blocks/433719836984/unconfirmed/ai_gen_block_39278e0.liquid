{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture plant_form_class %}plant-cart-card__form-{{ ai_gen_id }}{% endcapture %}
{% style %}
  .plant-cart-card-{{ ai_gen_id }} { position: relative; display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; overflow: hidden; border-radius: 16px; background: #fff; color: #14231a; }
  .plant-cart-card__media-{{ ai_gen_id }} { position: relative; aspect-ratio: 4 / 5; overflow: hidden; }
  .plant-cart-card__media-{{ ai_gen_id }} > a { display: block; width: 100%; height: 100%; }
  .plant-cart-card__media-{{ ai_gen_id }} img, .plant-cart-card__placeholder-{{ ai_gen_id }} svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .plant-cart-card__placeholder-{{ ai_gen_id }} { width: 100%; height: 100%; background: #f8f4ec; }
  .plant-cart-card__form-{{ ai_gen_id }} { position: absolute; right: {{ block.settings.cart_inset }}px; bottom: {{ block.settings.cart_inset }}px; z-index: 2; margin: 0; }
  .plant-cart-card__button-{{ ai_gen_id }} { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: {{ block.settings.cart_size }}px; padding: 0 14px; border: 0; border-radius: {{ block.settings.cart_radius }}px; background: {{ block.settings.cart_background }}; color: {{ block.settings.cart_text_color }}; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; }
  .plant-cart-card__button-{{ ai_gen_id }} svg { flex: 0 0 auto; width: 20px; height: 20px; }
  .plant-cart-card__button-{{ ai_gen_id }}:focus-visible, .plant-cart-card__title-{{ ai_gen_id }} a:focus-visible { outline: 3px solid #ffd60a; outline-offset: 3px; }
  .plant-cart-card__button-{{ ai_gen_id }}[disabled] { opacity: .65; cursor: wait; }
  .plant-cart-card__content-{{ ai_gen_id }} { padding: 16px; }
  .plant-cart-card__title-{{ ai_gen_id }} { margin: 0; font-family: Georgia, serif; font-size: 20px; }
  .plant-cart-card__title-{{ ai_gen_id }} a { color: inherit; text-decoration: none; }
  .plant-cart-card__price-{{ ai_gen_id }} { margin-top: 8px; font-weight: 600; }
  .plant-cart-card__status-{{ ai_gen_id }} { min-height: 1.3em; margin: 6px 0 0; color: #1f5130; font-size: 13px; }
  @media (max-width: 749px) { .plant-cart-card__content-{{ ai_gen_id }} { padding: 12px; } .plant-cart-card__button-{{ ai_gen_id }} { min-height: {{ block.settings.cart_size | at_least: 44 }}px; padding: 0 11px; font-size: 13px; } }
{% endstyle %}
<plant-cart-card-{{ ai_gen_id }} class="plant-cart-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% assign product = block.settings.product %}
  {% assign card_image = block.settings.product_image %}
  {% if card_image == blank and product != blank %}{% assign card_image = product.featured_image %}{% endif %}
  <div class="plant-cart-card__media-{{ ai_gen_id }}">
    <a href="{% if product != blank %}{{ product.url }}{% else %}#{% endif %}" aria-label="{% if product != blank %}{{ product.title | escape }}{% else %}{{ block.settings.product_title | escape }}{% endif %}">
      {% if card_image != blank %}<img src="{{ card_image | image_url: width: 900 }}" alt="{{ card_image.alt | default: product.title | escape }}" loading="lazy" width="{{ card_image.width }}" height="{{ card_image.height }}">{% else %}<div class="plant-cart-card__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
    </a>
    {% if product != blank and product.available %}
      {% form 'product', product, class: plant_form_class %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="plant-cart-card__button-{{ ai_gen_id }}">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M3 4h2l2.1 10.1a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="20" r="1" fill="currentColor"/><circle cx="18" cy="20" r="1" fill="currentColor"/></svg>
          <span>{{ block.settings.cart_button_text | escape }}</span>
        </button>
      {% endform %}
    {% endif %}
  </div>
  <div class="plant-cart-card__content-{{ ai_gen_id }}">
    {% if product != blank %}<h3 class="plant-cart-card__title-{{ ai_gen_id }}"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><div class="plant-cart-card__price-{{ ai_gen_id }}">{{ product.price | money }}</div>{% else %}<h3 class="plant-cart-card__title-{{ ai_gen_id }}">{{ block.settings.product_title | escape }}</h3>{% endif %}
    <p class="plant-cart-card__status-{{ ai_gen_id }}" aria-live="polite" role="status"></p>
  </div>
</plant-cart-card-{{ ai_gen_id }}>
<script>
(() => {
  const tag = 'plant-cart-card-{{ ai_gen_id }}';
  if (customElements.get(tag)) return;
  class PlantCartCard extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector('form');
      const button = this.querySelector('button[type="submit"]');
      const status = this.querySelector('[role="status"]');
      if (!form || !button || this.dataset.ready) return;
      this.dataset.ready = 'true';
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (button.disabled) return;
        button.disabled = true;
        status.textContent = '';
        try {
          const response = await fetch(`${form.action}.js`, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          const result = await response.json();
          if (!response.ok) throw new Error(result.description || 'Could not add this item. Please try again.');
          status.textContent = {{ block.settings.success_message | json }};
          document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { product: result } }));
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        } catch (error) {
          status.textContent = error.message;
        } finally {
          button.disabled = false;
        }
      });
    }
  }
  customElements.define(tag, PlantCartCard);
})();
</script>
{% schema %}
{
  "name": "Plant cart card",
  "settings": [
    {"type":"product","id":"product","label":"Product"},
    {"type":"image_picker","id":"product_image","label":"Product image"},
    {"type":"text","id":"product_title","label":"Fallback title","default":"Choose a product"},
    {"type":"text","id":"cart_button_text","label":"Button text","default":"Add to cart"},
    {"type":"text","id":"success_message","label":"Success message","default":"Added to cart"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"cart_size","label":"Button size","min":36,"max":60,"step":4,"unit":"px","default":44},
    {"type":"range","id":"cart_radius","label":"Border radius","min":0,"max":40,"step":2,"unit":"px","default":24},
    {"type":"range","id":"cart_inset","label":"Corner inset","min":4,"max":28,"step":2,"unit":"px","default":14},
    {"type":"color","id":"cart_background","label":"Button background","default":"#1f5130"},
    {"type":"color","id":"cart_text_color","label":"Button text","default":"#ffffff"}
  ],
  "presets": [{"name":"Plant cart card"}],
  "tag": null,
  "class": "plant-cart-card-block"
}
{% endschema %}