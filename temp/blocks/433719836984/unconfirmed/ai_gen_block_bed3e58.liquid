<plant-carousel-{{ ai_gen_id }} class="ai-plant-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-plant-{{ ai_gen_id }}__content"><h2 class="ai-plant-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2><div class="ai-plant-{{ ai_gen_id }}__track-wrap"><button type="button" class="ai-plant-{{ ai_gen_id }}__arrow ai-plant-{{ ai_gen_id }}__arrow--prev" aria-label="Previous plants"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button><div class="ai-plant-{{ ai_gen_id }}__track" tabindex="0" aria-label="Plant products">{% for i in (1..6) %}{% assign image_key='image_' | append:i %}{% assign product_key='product_' | append:i %}{% assign title_key='title_' | append:i %}{% assign description_key='description_' | append:i %}{% assign price_key='price_' | append:i %}{% assign original_key='original_' | append:i %}{% assign discount_key='discount_' | append:i %}{% assign best_key='best_' | append:i %}{% assign best_text_key='best_text_' | append:i %}{% assign rating_key='rating_' | append:i %}{% assign reviews_key='reviews_' | append:i %}{% assign link_key='link_' | append:i %}{% assign bg_key='card_bg_' | append:i %}{% assign image=block.settings[image_key] %}{% assign product=block.settings[product_key] %}{% assign variant=product.selected_or_first_available_variant %}{% assign card_title=block.settings[title_key] | default:product.title %}<article class="ai-plant-{{ ai_gen_id }}__card" style="--card-bg:{{ block.settings[bg_key] }}"><div class="ai-plant-{{ ai_gen_id }}__media">{% if image %}<img src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | default:card_title | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">{% elsif product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default:card_title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% else %}<div class="ai-plant-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}<span class="ai-plant-{{ ai_gen_id }}__empty">Choose an image in product {{ i }} settings</span></div>{% endif %}{% if block.settings[best_key] %}<span class="ai-plant-{{ ai_gen_id }}__badge ai-plant-{{ ai_gen_id }}__best">{{ block.settings[best_text_key] | escape }}</span>{% endif %}{% if block.settings[discount_key] != blank %}<span class="ai-plant-{{ ai_gen_id }}__badge ai-plant-{{ ai_gen_id }}__discount">{{ block.settings[discount_key] | escape }}</span>{% endif %}</div><div class="ai-plant-{{ ai_gen_id }}__body">{% if block.settings[rating_key] != blank %}<div class="ai-plant-{{ ai_gen_id }}__rating">★ {{ block.settings[rating_key] }}{% if block.settings[reviews_key] != blank %} | {{ block.settings[reviews_key] }}{% endif %}</div>{% endif %}<h3 class="ai-plant-{{ ai_gen_id }}__title">{% if block.settings[link_key] != blank %}<a href="{{ block.settings[link_key] }}">{{ card_title | escape }}</a>{% elsif product != blank %}<a href="{{ product.url }}">{{ card_title | escape }}</a>{% else %}{{ card_title | escape }}{% endif %}</h3>{% if block.settings[description_key] != blank %}<p class="ai-plant-{{ ai_gen_id }}__desc">{{ block.settings[description_key] | escape }}</p>{% endif %}<div class="ai-plant-{{ ai_gen_id }}__prices">{% if block.settings[price_key] != blank %}<span class="ai-plant-{{ ai_gen_id }}__price">{{ block.settings[price_key] | escape }}</span>{% elsif product != blank %}<span class="ai-plant-{{ ai_gen_id }}__price">{{ product.price | money }}</span>{% endif %}{% if block.settings[original_key] != blank %}<span class="ai-plant-{{ ai_gen_id }}__compare">{{ block.settings[original_key] | escape }}</span>{% elsif product.compare_at_price > product.price %}<span class="ai-plant-{{ ai_gen_id }}__compare">{{ product.compare_at_price | money }}</span>{% endif %}</div>{% if product != blank and variant != blank %}<button class="ai-plant-{{ ai_gen_id }}__cart" type="button" data-variant-id="{{ variant.id }}" aria-label="Add {{ card_title | escape }} to cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg></button>{% endif %}</div></article>{% endfor %}</div><button type="button" class="ai-plant-{{ ai_gen_id }}__arrow ai-plant-{{ ai_gen_id }}__arrow--next" aria-label="Next plants"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button></div><p class="ai-plant-{{ ai_gen_id }}__status" role="status" aria-live="polite" hidden></p></div></plant-carousel-{{ ai_gen_id }}>
<script>(()=>{const tag='plant-carousel-{{ ai_gen_id }}';if(customElements.get(tag))return;class PlantCarousel extends HTMLElement{connectedCallback(){this.track=this.querySelector('.ai-plant-{{ ai_gen_id }}__track');this.prev=this.querySelector('.ai-plant-{{ ai_gen_id }}__arrow--prev');this.next=this.querySelector('.ai-plant-{{ ai_gen_id }}__arrow--next');this.status=this.querySelector('.ai-plant-{{ ai_gen_id }}__status');this.onScroll=()=>this.update();this.track.addEventListener('scroll',this.onScroll,{passive:true});this.prev.addEventListener('click',()=>this.move(-1));this.next.addEventListener('click',()=>this.move(1));this.addEventListener('click',this.addItem);this.update()}disconnectedCallback(){if(this.track)this.track.removeEventListener('scroll',this.onScroll);this.removeEventListener('click',this.addItem)}move(n){const c=this.track.querySelector('.ai-plant-{{ ai_gen_id }}__card');if(c)this.track.scrollBy({left:n*(c.getBoundingClientRect().width+(parseFloat(getComputedStyle(this.track).gap)||0)),behavior:'smooth'})}update(){const end=this.track.scrollWidth-this.track.clientWidth;this.prev.disabled=this.track.scrollLeft<=2;this.next.disabled=this.track.scrollLeft>=end-2}addItem=async e=>{const b=e.target.closest('.ai-plant-{{ ai_gen_id }}__cart');if(!b||!this.contains(b))return;b.disabled=true;this.status.hidden=false;this.status.textContent='Adding plant to cart…';try{const root=window.Shopify&&window.Shopify.routes?window.Shopify.routes.root:'/';const r=await fetch(`${root}cart/add.js`,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:Number(b.dataset.variantId),quantity:1}]})});if(!r.ok)throw new Error('Could not add this product. Please try again.');window.location.assign(`${root}cart`)}catch(err){this.status.textContent=err.message;b.disabled=false}}}customElements.define(tag,PlantCarousel)})();</script>
