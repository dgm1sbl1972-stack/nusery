      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#0d3a1d"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background",
      "default": "#1f5130"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "SBL Farms feature"
    }
  ],
  "tag": null,
  "class": "sbl-farms-feature"
