{% doc %}
  @prompt
    can we create a blog section and need an option like all articles , 3 blogs each should have blog link to past, need the blogs in square shape  from end to end of the desktop, need in small box kind, end to end desktop 1080x1080 pixel boxes need 3 blogs , need in small boxs , need in square shape boxes 
    with view all articles button in center of the page 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.section_padding }}px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }
  .ai-blog-section-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }
  .ai-blog-section-{{ ai_gen_id }}__heading {
    margin: 0 0 28px;
    text-align: center;
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.2;
    color: {{ block.settings.text_color }};
  }
  .ai-blog-section-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }
  .ai-blog-section-{{ ai_gen_id }}__card {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .ai-blog-section-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #e8e6dc;
    border-radius: {{ block.settings.card_radius }}px;
  }
  .ai-blog-section-{{ ai_gen_id }}__media img,
  .ai-blog-section-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ai-blog-section-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
  }
  .ai-blog-section-{{ ai_gen_id }}__placeholder svg {
    background: #e8e6dc;
  }
  .ai-blog-section-{{ ai_gen_id }}__meta {
    padding: 14px 2px 0;
  }
  .ai-blog-section-{{ ai_gen_id }}__date {
    margin: 0 0 7px;
    color: {{ block.settings.muted_color }};
    font-size: 13px;
  }
  .ai-blog-section-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.35;
  }
  .ai-blog-section-{{ ai_gen_id }}__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 30px;
  }
  .ai-blog-section-{{ ai_gen_id }}__cta {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-align: center;
    text-decoration: none;
    font-weight: 600;
  }
  .ai-blog-section-{{ ai_gen_id }}__cta:hover {
    filter: brightness(0.92);
  }
  .ai-blog-section-{{ ai_gen_id }}__card:focus-visible,
  .ai-blog-section-{{ ai_gen_id }}__cta:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }
  @media screen and (max-width: 749px) {
    .ai-blog-section-{{ ai_gen_id }} { padding: {{ block.settings.section_padding | divided_by: 2 }}px 16px; }
    .ai-blog-section-{{ ai_gen_id }}__inner { width: 100%; }
    .ai-blog-section-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; gap: 24px; }
  }
{% endstyle %}

<div class="ai-blog-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-section-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-blog-section-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% assign selected_blog = block.settings.blog %}
    {% if selected_blog != blank and selected_blog.articles.size > 0 %}
      <div class="ai-blog-section-{{ ai_gen_id }}__grid">
        {% for article in selected_blog.articles limit: 3 %}
          <a class="ai-blog-section-{{ ai_gen_id }}__card" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
            <div class="ai-blog-section-{{ ai_gen_id }}__media">
              {% if article.image %}
                <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="900" height="900">
              {% else %}
                <div class="ai-blog-section-{{ ai_gen_id }}__placeholder">{{ 'blog-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </div>
            <div class="ai-blog-section-{{ ai_gen_id }}__meta">
              {% if block.settings.show_date %}<p class="ai-blog-section-{{ ai_gen_id }}__date"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time></p>{% endif %}
              <h3 class="ai-blog-section-{{ ai_gen_id }}__title">{{ article.title | escape }}</h3>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-blog-section-{{ ai_gen_id }}__grid">
        {% for i in (1..3) %}
          <div class="ai-blog-section-{{ ai_gen_id }}__card">
            <div class="ai-blog-section-{{ ai_gen_id }}__media"><div class="ai-blog-section-{{ ai_gen_id }}__placeholder">{{ 'blog-apparel-1' | placeholder_svg_tag }}</div></div>
            <div class="ai-blog-section-{{ ai_gen_id }}__meta"><h3 class="ai-blog-section-{{ ai_gen_id }}__title">Choose a blog to show articles</h3></div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
    {% if selected_blog != blank %}
      <div class="ai-blog-section-{{ ai_gen_id }}__cta-wrap"><a class="ai-blog-section-{{ ai_gen_id }}__cta" href="{{ selected_blog.url }}">{{ block.settings.button_label | escape }}</a></div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Blog articles grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "checkbox", "id": "show_date", "label": "Show publish date", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all articles" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f8f4ec" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0d3a1d" },
    { "type": "color", "id": "muted_color", "label": "Date text", "default": "#5b6660" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#1f5130" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#0c8f45" },
    { "type": "range", "id": "section_padding", "label": "Section padding", "min": 10, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 6 }
  ],
  "presets": [{ "name": "Blog articles grid" }],
  "tag": null,
  "class": "blog-articles-grid"
}
{% endschema %}