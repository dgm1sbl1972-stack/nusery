{% doc %}
  @prompt
    can we create a blog section and need an option like all articles , 3 blogs each should have blog link to past, need the blogs in square shape  from end to end of the desktop, need in small box kind, end to end desktop 1080x1080 pixel boxes need 3 blogs , need in small boxs , need in square shape boxes,
    with "view all articles" button  with link in center of the section 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.section_padding }}px 24px;
  }

  .ai-blog-grid__inner-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-blog-grid__heading-{{ ai_gen_id }} {
    margin: 0 0 28px;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.heading_alignment }};
    font-size: clamp(24px, 3vw, {{ block.settings.heading_size }}px);
    line-height: 1.15;
  }

  .ai-blog-grid__cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-blog-grid__card-{{ ai_gen_id }} {
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.card_radius }}px;
    background: #e8e6dc;
    color: #fff;
    text-decoration: none;
  }

  .ai-blog-grid__card-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(transparent, rgba(12, 27, 17, 0.82));
    pointer-events: none;
  }

  .ai-blog-grid__card-{{ ai_gen_id }} img,
  .ai-blog-grid__placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-blog-grid__card-{{ ai_gen_id }}:hover img {
    transform: scale(1.03);
  }

  .ai-blog-grid__placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
  }

  .ai-blog-grid__placeholder-{{ ai_gen_id }} svg {
    background: #e8e6dc;
  }

  .ai-blog-grid__empty-{{ ai_gen_id }} {
    position: absolute;
    z-index: 1;
    inset: auto 18px 18px;
    color: #26352b;
    background: rgba(248, 244, 236, 0.94);
    padding: 10px 12px;
    text-align: center;
    font-size: 14px;
  }

  .ai-blog-grid__card-content-{{ ai_gen_id }} {
    position: absolute;
    z-index: 1;
    inset: auto 22px 22px;
    color: #fff;
  }

  .ai-blog-grid__date-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .ai-blog-grid__title-{{ ai_gen_id }} {
    margin: 0;
    color: #fff;
    font-size: clamp(18px, 2vw, 26px);
    line-height: 1.2;
  }

  .ai-blog-grid__read-{{ ai_gen_id }} {
    display: inline-block;
    margin-top: 10px;
    color: #fff;
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-blog-grid__empty-card-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: {{ block.settings.empty_color }};
    color: {{ block.settings.text_color }};
    text-align: center;
    font-size: 14px;
  }

  .ai-blog-grid__footer-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: 30px;
  }

  .ai-blog-grid__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 26px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
  }

  .ai-blog-grid__button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
  }

  .ai-blog-grid__button-{{ ai_gen_id }}:focus-visible,
  .ai-blog-grid__card-{{ ai_gen_id }}:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-blog-grid-{{ ai_gen_id }} { padding: 36px 16px; }
    .ai-blog-grid__inner-{{ ai_gen_id }} { width: 100%; }
    .ai-blog-grid__cards-{{ ai_gen_id }} { grid-template-columns: 1fr; gap: 16px; }
    .ai-blog-grid__card-{{ ai_gen_id }} { max-width: 520px; width: 100%; margin: 0 auto; }
  }
{% endstyle %}

<div class="ai-blog-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-grid__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-blog-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    <div class="ai-blog-grid__cards-{{ ai_gen_id }}">
      {% if block.settings.blog != blank %}
        {% assign article_count = 0 %}
        {% for article in block.settings.blog.articles limit: 3 %}
          {% assign article_count = article_count | plus: 1 %}
          <a class="ai-blog-grid__card-{{ ai_gen_id }}" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
            {% if article.image %}
              <img src="{{ article.image | image_url: width: 1080 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="1080" height="1080">
            {% else %}
              <div class="ai-blog-grid__placeholder-{{ ai_gen_id }}">{{ 'blog-apparel-1' | placeholder_svg_tag }}</div>
              <span class="ai-blog-grid__empty-{{ ai_gen_id }}">Add a featured image to this article</span>
            {% endif %}
            <div class="ai-blog-grid__card-content-{{ ai_gen_id }}">
              {% if block.settings.show_date %}<span class="ai-blog-grid__date-{{ ai_gen_id }}">{{ article.published_at | date: '%B %d, %Y' }}</span>{% endif %}
              <h3 class="ai-blog-grid__title-{{ ai_gen_id }}">{{ article.title | escape }}</h3>
              {% if block.settings.show_read_link %}<span class="ai-blog-grid__read-{{ ai_gen_id }}">{{ block.settings.read_label | escape }}</span>{% endif %}
            </div>
          </a>
        {% endfor %}
        {% if article_count == 0 %}
          {% for i in (1..3) %}<div class="ai-blog-grid__card-{{ ai_gen_id }} ai-blog-grid__empty-card-{{ ai_gen_id }}">Publish articles in the selected blog to display them here.</div>{% endfor %}
        {% endif %}
      {% else %}
        {% for i in (1..3) %}<div class="ai-blog-grid__card-{{ ai_gen_id }} ai-blog-grid__empty-card-{{ ai_gen_id }}">Select a blog to show its latest articles.</div>{% endfor %}
      {% endif %}
    </div>
    {% if block.settings.blog != blank and block.settings.show_all_button %}
      <div class="ai-blog-grid__footer-{{ ai_gen_id }}">
        <a class="ai-blog-grid__button-{{ ai_gen_id }}" href="{{ block.settings.blog.url }}">{{ block.settings.button_label | escape }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Editorial blog grid",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "checkbox", "id": "show_date", "label": "Show publish date", "default": true },
    { "type": "checkbox", "id": "show_read_link", "label": "Show article link label", "default": true },
    { "type": "text", "id": "read_label", "label": "Article link label", "default": "Read article" },
    { "type": "checkbox", "id": "show_all_button", "label": "Show view all button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all articles" },
    { "type": "header", "content": "Layout and style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "section_padding", "label": "Vertical padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 56, "step": 4, "unit": "px", "default": 36 },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 4 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f8f4ec" },
    { "type": "color", "id": "empty_color", "label": "Empty card background", "default": "#f4f7dc" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0d3a1d" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#1f5130" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover background", "default": "#0d3a1d" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#0c8f45" }
  ],
  "presets": [{ "name": "Editorial blog grid" }],
  "tag": null,
  "class": "editorial-blog-grid-block"
}
{% endschema %}