{%- comment -%} Password input with show/hide toggle. Accepts: name, id, label, autocomplete {%- endcomment -%}
<label class="acct-field" for="{{ id }}">
  <span>{{ label }}</span>
  <span class="acct-field__pw">
    <input type="password" name="{{ name }}" id="{{ id }}" autocomplete="{{ autocomplete | default: 'current-password' }}" required>
    <button type="button" class="acct-field__toggle" aria-label="Show password" data-pw-toggle>Show</button>
  </span>
</label>
