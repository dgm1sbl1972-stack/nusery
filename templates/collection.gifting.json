        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "Can I add a personal message?",
            "answer": "<p>Yes. Add your message at checkout and we will include it as a handwritten card with your gift.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Do you offer same day delivery?",
            "answer": "<p>Same day delivery is available in select cities for orders placed before 12 noon. Delivery options are shown at checkout.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "How are the plants packaged?",
            "answer": "<p>Every plant is secured in its pot, wrapped in protective eco-friendly packaging and packed in a sturdy box so it arrives fresh and healthy.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "Can I send a gift to another city?",
            "answer": "<p>Yes. Simply enter the recipient's address at checkout and we will deliver it to them directly.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Do you offer corporate gifting?",
            "answer": "<p>Yes. We offer bulk orders, custom branding and personalised packaging for teams, clients and events.</p>"
          }
        },
