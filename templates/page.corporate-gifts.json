    "faq": {
      "type": "sbl-gift-faq",
      "settings": {
        "faq_heading": "Answered with Honesty",
        "faq_subheading": "Common questions about corporate gifting with SBL Nursery",
        "faq_open_first": true,
        "bg_color": "#ffffff"
      },
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "What is the minimum order for corporate gifts?",
            "answer": "<p>Corporate orders start from 20 gifts. For smaller quantities, you can order directly from our gifting pages.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Can you add our company logo?",
            "answer": "<p>Yes. We can brand pots, boxes, cards, ribbons and stickers with your logo.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Do you deliver to multiple addresses?",
            "answer": "<p>Yes. Share a list of addresses and we'll deliver to each recipient across India.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "How far in advance should we order?",
            "answer": "<p>We recommend 2–3 weeks for branded orders, and more for festive seasons like Diwali.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Can you work within our budget?",
            "answer": "<p>Absolutely. Tell us your budget per gift and we'll suggest options that fit.</p>"
          }
        }
      },
      "block_order": [
        "faq_1",
        "faq_2",
        "faq_3",
        "faq_4",
        "faq_5"
      ]
