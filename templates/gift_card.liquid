<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Gift card – {{ shop.name }}</title>
    {{ content_for_header }}
  </head>
  <body style="font-family: system-ui, sans-serif; text-align: center; padding: 48px 16px;">
    <h1>{{ shop.name }}</h1>
    <p>Your gift card balance</p>
    <p style="font-size: 2rem; font-weight: 700;">{{ gift_card.balance | money }}</p>
    <p>Code: <strong>{{ gift_card.code | format_code }}</strong></p>
    {%- if gift_card.expired -%}<p>This gift card has expired.</p>{%- endif -%}
    <p><a href="{{ shop.url }}">Shop now</a></p>
  </body>
</html>
