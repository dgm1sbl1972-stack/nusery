{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
<style>
  .site-header__inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; }
  .site-header__logo { justify-self: start; min-width: 0; }
  .site-nav { margin: 0; justify-self: center; }
  .site-header__actions { justify-content: flex-end; justify-self: end; margin-left: 0; }
  .header-search-toggle > summary { list-style: none; cursor: pointer; }
  .header-search-toggle > summary::-webkit-details-marker { display: none; }
  .header-search-panel { position: absolute; left: 0; right: 0; top: 100%; background: #fff; padding: 16px 0; box-shadow: 0 12px 24px rgba(0,0,0,.08); border-top: 1px solid #f0f0f0; }
  .header-search-panel .header-search { display: flex; width: calc(100% - 32px); margin: 0 auto; }
  .header-search-panel .header-search input { width: 100%; }
  @media (max-width: 900px) {
    .site-header__inner { gap: 12px; }
    .menu-toggle { justify-self: start; }
    .site-header__logo { justify-self: center; }
    .site-header__brand small { display: none; }
    .site-header__actions { gap: 10px; }
  }
</style>

<header class="site-header" data-header>
  <div class="page-width site-header__inner">
    <button class="icon-btn menu-toggle" type="button" aria-label="Menu" aria-expanded="false" data-menu-toggle>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, width: section.settings.logo_width, loading: 'eager' }}
      {%- else -%}
        <span class="logo-badge" aria-hidden="true">
          <svg viewBox="0 0 48 48" width="40" height="40"><circle cx="24" cy="24" r="22" fill="#fff" stroke="#c62828" stroke-width="3"/><circle cx="24" cy="24" r="15" fill="#c62828"/><text x="24" y="28" text-anchor="middle" font-size="10" font-weight="700" fill="#fff">SBL</text></svg>
        </span>
      {%- endif -%}
      {%- if section.settings.show_brand_text -%}
        <span class="site-header__brand">
          <strong>{{ section.settings.brand_name | default: shop.name }}</strong>
          {%- if section.settings.tagline != blank -%}<small>{{ section.settings.tagline }}</small>{%- endif -%}
        </span>
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="Main" data-nav>
      <ul class="site-nav__list">
        {%- for link in menu.links -%}
          <li class="site-nav__item{% if link.links != blank %} has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="site-nav__link"{% if link.current %} aria-current="page"{% endif %}>
              {{ link.title }}
              {%- if link.links != blank -%}
                <svg viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              {%- endif -%}
            </a>
            {%- if link.links != blank -%}
              <ul class="site-nav__dropdown">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      <details class="header-search-toggle" data-search-toggle>
        <summary class="icon-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </summary>
        <div class="header-search-panel">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header-search header-search--lg">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}" aria-label="Search">
            <input type="hidden" name="options[prefix]" value="last">
          </form>
        </div>
      </details>

      {%- if section.settings.show_wishlist -%}
        <a href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" class="icon-btn icon-btn--wishlist" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="icon-btn" aria-label="{% if customer %}Account{% else %}Log in{% endif %}">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 21a8 8 0 0116 0" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="icon-btn" aria-label="Cart">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z M9 7a3 3 0 016 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        <span class="icon-btn__count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<script>
  (function () {
    var search = document.querySelector('[data-search-toggle]');
    if (!search) return;
    search.addEventListener('toggle', function () {
      if (search.open) { var input = search.querySelector('input[type="search"]'); if (input) input.focus(); }
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && search.open) search.open = false; });
    document.addEventListener('click', function (e) { if (search.open && !search.contains(e.target)) search.open = false; });
  })();
</script>


{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 30, "max": 200, "step": 5, "unit": "px", "default": 44 },
    { "type": "checkbox", "id": "show_brand_text", "label": "Show brand name next to logo", "default": true },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Nursery" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Nursery & Garden Store" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist icon", "default": true },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist link", "info": "Defaults to /pages/wishlist" }
  ]
}
{% endschema %}
