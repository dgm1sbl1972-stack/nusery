{%- comment -%}
  Gifting pages: products from one or more collections. With several "Tab" blocks the shopper switches
  between them; with one block it is a plain row. Shows as a swipeable carousel or a grid.
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign layout = section.settings.layout
  assign first_collection = section.blocks.first.settings.collection
  assign view_all_url = section.settings.view_all_link | default: first_collection.url
-%}
<section class="gh gh-tabs" id="GhTabs-{{ sid }}" style="--gh-bg: {{ section.settings.bg_color }};">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="gh__head">
        {%- if section.settings.heading != blank -%}<h2 class="gh__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="gh__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 1 or layout == 'carousel' and section.settings.view_all_label != blank -%}
      <div class="gh-tabs__bar">
        {%- if section.blocks.size > 1 -%}
          <div class="gh-tabs__tabs" role="tablist">
            {%- for block in section.blocks -%}
              <button type="button" class="gh-tabs__tab" role="tab" id="GhTab-{{ sid }}-{{ forloop.index }}" aria-controls="GhPanel-{{ sid }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tab {{ block.shopify_attributes }}>
                {{ block.settings.label | default: block.settings.collection.title | default: 'Tab' | escape }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if layout == 'carousel' and section.settings.view_all_label != blank and view_all_url != blank -%}
          <a class="gh-tabs__all" href="{{ view_all_url }}">{{ section.settings.view_all_label | escape }} <span aria-hidden="true">→</span></a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="gh-tabs__stage">
      {%- for block in section.blocks -%}
        {%- assign products = block.settings.collection.products -%}
        <div class="gh-tabs__panel" id="GhPanel-{{ sid }}-{{ forloop.index }}" {% if section.blocks.size > 1 %}role="tabpanel" aria-labelledby="GhTab-{{ sid }}-{{ forloop.index }}"{% endif %} {% unless forloop.first %}hidden{% endunless %} data-panel>
          <div class="gh-tabs__track gh-tabs__track--{{ layout }}" data-track>
            {%- if products.size > 0 -%}
              {%- for product in products limit: section.settings.limit -%}
                <div class="gh-tabs__cell">{%- render 'product-card', product: product -%}</div>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <div class="gh-tabs__cell">{%- render 'product-card', product: blank, index: i -%}</div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
      {%- if layout == 'carousel' -%}
        <button type="button" class="gh-tabs__arrow gh-tabs__arrow--prev" aria-label="Previous" data-dir="-1"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="gh-tabs__arrow gh-tabs__arrow--next" aria-label="Next" data-dir="1"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      {%- endif -%}
    </div>

    {%- if layout == 'grid' and section.settings.view_all_label != blank and view_all_url != blank -%}
      <div class="gh__more"><a class="btn btn--dark" href="{{ view_all_url }}">{{ section.settings.view_all_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('GhTabs-{{ sid }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    var tabs = root.querySelectorAll('[data-tab]');
    var panels = root.querySelectorAll('[data-panel]');
    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t, j) { t.setAttribute('aria-selected', j === i ? 'true' : 'false'); });
        panels.forEach(function (p, j) { p.hidden = j !== i; });
      });
    });
    root.querySelectorAll('[data-dir]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var track = root.querySelector('[data-panel]:not([hidden]) [data-track]');
        if (!track) return;
        var cell = track.firstElementChild;
        var step = cell ? cell.getBoundingClientRect().width + 20 : track.clientWidth;
        track.scrollBy({ left: step * Number(btn.getAttribute('data-dir')), behavior: 'smooth' });
      });
    });
  })();
</script>

{% stylesheet %}
.gh-tabs__bar { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 20px; position: relative; }
.gh-tabs__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
.gh-tabs__tab { padding: 8px 16px; border: 1px solid #d9dfd4; border-radius: 999px; background: #fff; color: var(--c-text); font: inherit; font-size: 13.5px; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
.gh-tabs__tab:hover { border-color: var(--c-primary); }
.gh-tabs__tab[aria-selected="true"] { background: var(--c-primary-dark); border-color: var(--c-primary-dark); color: #fff; }
.gh-tabs__all { position: absolute; right: 0; color: var(--c-primary-dark); font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; }
.gh-tabs__stage { position: relative; }
.gh-tabs__track--grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
.gh-tabs__track--carousel { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 3 * 20px) / 4); gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 4px 2px 8px; }
.gh-tabs__track--carousel::-webkit-scrollbar { display: none; }
.gh-tabs__cell { min-width: 0; scroll-snap-align: start; display: flex; }
.gh-tabs__cell > .product-card { width: 100%; }
.gh-tabs__arrow { position: absolute; top: 38%; z-index: 2; display: grid; place-items: center; width: 42px; height: 42px; padding: 0; border: 1px solid #e3e7df; border-radius: 50%; background: #fff; color: var(--c-primary-dark); box-shadow: 0 6px 16px rgba(0,0,0,.10); cursor: pointer; }
.gh-tabs__arrow--prev { left: -18px; }
.gh-tabs__arrow--next { right: -18px; }
@media (max-width: 989px) {
  .gh-tabs__track--grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .gh-tabs__track--carousel { grid-auto-columns: calc((100% - 2 * 16px) / 3); gap: 16px; }
}
@media (max-width: 749px) {
  .gh-tabs__bar { flex-direction: column; gap: 10px; }
  .gh-tabs__tabs { flex-wrap: nowrap; justify-content: flex-start; width: calc(100% + 32px); margin: 0 -16px; padding: 0 16px 4px; overflow-x: auto; scrollbar-width: none; }
  .gh-tabs__tabs::-webkit-scrollbar { display: none; }
  .gh-tabs__tab { flex: none; }
  .gh-tabs__all { position: static; align-self: flex-end; font-size: 13px; }
  .gh-tabs__track--grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .gh-tabs__track--carousel { grid-auto-columns: 46%; gap: 12px; }
  .gh-tabs__arrow { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Gifting: Product row",
  "tag": "section",
  "class": "section-gh-product-tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most Loved Gift Hampers" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "carousel", "label": "Carousel (swipe)" }, { "value": "grid", "label": "Grid" }], "default": "carousel" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 24, "step": 4, "default": 8 },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View All" },
    { "type": "url", "id": "view_all_link", "label": "View all link", "info": "Leave empty to use the first tab's collection." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "info": "Leave empty to use the collection name. Tabs only show when there is more than one." },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Gifting: Product row",
      "blocks": [
        { "type": "tab", "settings": { "label": "Diwali Gifts" } },
        { "type": "tab", "settings": { "label": "Birthday Gifts" } },
        { "type": "tab", "settings": { "label": "Plant Hampers" } }
      ]
    }
  ]
}
{% endschema %}
