{%- comment -%}
  Blog posts grid with leaf-shaped images, centred titles, a short excerpt and
  a "Read more" button. Add "Post" blocks to write each card by hand. With no
  Post blocks, the latest articles of the selected blog are shown instead.
  Styles live in this file so it can be copied into another theme on its own.
{%- endcomment -%}
{%- assign blog = section.settings.blog -%}
<section class="blog-cards section-pad" style="background: {{ section.settings.background }}; --blog-cols: {{ section.settings.columns }};">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.heading_accent != blank -%}
      <div class="blog-cards__head">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-title">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h2>
      </div>
    {%- endif -%}

    <div class="blog-cards__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign s = block.settings
            assign article = s.article
            assign image = s.image | default: article.image
            assign title = s.title | default: article.title
            assign url = s.link | default: article.url
            assign excerpt = s.excerpt
            if excerpt == blank and article != blank
              assign excerpt = article.excerpt_or_content | strip_html | truncatewords: 20
            endif
          -%}
          <article class="blog-card" {{ block.shopify_attributes }}>
            {%- if url != blank -%}<a href="{{ url }}" class="blog-card__media">{%- else -%}<div class="blog-card__media">{%- endif -%}
              {%- if image != blank -%}
                {{ image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 300px, (min-width: 600px) 50vw, 100vw', widths: '400, 600, 800', alt: title }}
              {%- else -%}
                {%- assign ph = forloop.index0 | modulo: 2 | plus: 1 -%}
                {{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            {%- if url != blank -%}</a>{%- else -%}</div>{%- endif -%}
            <h3 class="blog-card__title">
              {%- if url != blank -%}<a href="{{ url }}">{{ title }}</a>{%- else -%}{{ title }}{%- endif -%}
            </h3>
            {%- if excerpt != blank -%}<p class="blog-card__excerpt">{{ excerpt }}</p>{%- endif -%}
            {%- if s.button_label != blank -%}
              {%- if url != blank -%}
                <a href="{{ url }}" class="blog-card__btn">{{ s.button_label }}</a>
              {%- else -%}
                <span class="blog-card__btn">{{ s.button_label }}</span>
              {%- endif -%}
            {%- endif -%}
          </article>
        {%- endfor -%}
      {%- elsif blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.columns -%}
          <article class="blog-card">
            <a href="{{ article.url }}" class="blog-card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 300px, (min-width: 600px) 50vw, 100vw', widths: '400, 600, 800' }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <h3 class="blog-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
            <a href="{{ article.url }}" class="blog-card__btn">{{ section.settings.blog_button_label }}</a>
          </article>
        {%- endfor -%}
      {%- else -%}
        <p class="blog-cards__empty">Add a <strong>Post</strong> block or choose a blog in this section's settings.</p>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="blog-cards__footer">
        <a href="{{ section.settings.button_link | default: blog.url | default: '/blogs' }}" class="btn btn--outline">{{ section.settings.button_label }} <span aria-hidden="true">→</span></a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .blog-cards__head { text-align: center; margin-bottom: 40px; }
  .blog-cards__grid { display: grid; grid-template-columns: repeat(var(--blog-cols, 4), minmax(0, 1fr)); gap: 40px 32px; }
  .blog-card { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .blog-card__media { display: block; width: 100%; aspect-ratio: 3 / 2; overflow: hidden; border-radius: 64px 6px 64px 6px; margin-bottom: 18px; background: #eef1e8; }
  .blog-card__media img, .blog-card__media svg { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .blog-card:hover .blog-card__media img { transform: scale(1.05); }
  .blog-card__title { font-family: Arial, Helvetica, sans-serif; font-size: 17px; font-weight: 700; line-height: 1.4; color: #111; margin: 0 0 10px; }
  .blog-card__title a:hover { color: var(--c-primary, #1f5130); }
  .blog-card__excerpt { font-size: 14px; line-height: 1.7; color: #6b6b6b; margin: 0 0 20px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .blog-card__btn { margin-top: auto; display: inline-block; padding: 12px 34px; border: 2px solid #cfe0cf; border-radius: 999px; font-size: 14px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: #222; background: #fff; transition: background .2s ease, border-color .2s ease, color .2s ease; }
  .blog-card__btn:hover { background: var(--c-primary, #1f5130); border-color: var(--c-primary, #1f5130); color: #fff; }
  .blog-cards__footer { text-align: center; margin-top: 44px; }
  .blog-cards__empty { grid-column: 1 / -1; text-align: center; color: #6b6b6b; background: #eef8ea; border-radius: 14px; padding: 40px 20px; margin: 0; }
  @media (max-width: 989px) { .blog-cards__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 20px; } }
  @media (max-width: 599px) { .blog-cards__grid { grid-template-columns: 1fr; } .blog-card__media { border-radius: 48px 6px 48px 6px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Plant journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From Our" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic green)", "default": "Blog" },
    { "type": "range", "id": "columns", "label": "Posts per row on desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "Button below the posts" },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Leave empty to hide", "default": "All Articles" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the selected blog" },
    { "type": "header", "content": "Shopify blog" },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog (optional)",
      "info": "Used only when there are no Post blocks: shows this blog's latest articles"
    },
    { "type": "text", "id": "blog_button_label", "label": "Blog article button label", "default": "Read more" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Blog post title" },
        { "type": "textarea", "id": "excerpt", "label": "Short text", "info": "Shows 2 lines, then \"...\"", "default": "A short introduction to this blog post." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Read more" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "article",
          "id": "article",
          "label": "Blog article (optional)",
          "info": "Empty fields above are filled from this article, and the card links to it"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog posts",
      "blocks": [
        { "type": "post", "settings": { "title": "Bangalore's Hidden Natural Farm", "excerpt": "There's something quietly powerful about the idea of natural farming. No chemicals, no shortcuts, no forced growth..." } },
        { "type": "post", "settings": { "title": "Nature's Best, Grown Organically Here", "excerpt": "There's a growing curiosity today around where our food comes from. More people are reading labels..." } },
        { "type": "post", "settings": { "title": "Why landscapers & Gardeners Choose SBL Farms", "excerpt": "There's a difference between buying plants for a personal space and sourcing..." } },
        { "type": "post", "settings": { "title": "Visit Karnataka's Largest SBL Plant Nursery", "excerpt": "There comes a point where plants stop being just decorative elements and start becoming part of..." } }
      ]
    }
  ]
}
{% endschema %}
