{%- comment -%}
  Blog posts grid. Add "Post" blocks to write each card by hand (image, tag,
  title, date, read time, link). With no Post blocks, the latest articles of
  the selected blog are shown instead.
{%- endcomment -%}
{%- assign blog = section.settings.blog -%}
<section class="journal section-pad" style="background: {{ section.settings.background }};">
  <div class="page-width">
    <div class="section-head section-head--split">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-title section-title--left">{{ section.settings.heading }}<br><em>{{ section.settings.heading_accent }}</em></h2>
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: blog.url | default: '/blogs' }}" class="btn btn--outline">{{ section.settings.button_label }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>

    <div class="journal__grid{% if section.settings.equal_cards %} journal__grid--even{% endif %}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign s = block.settings -%}
          {%- assign article = s.article -%}
          {%- assign image = s.image | default: article.image -%}
          {%- assign title = s.title | default: article.title -%}
          {%- assign tag = s.tag | default: article.tags.first -%}
          {%- assign url = s.link | default: article.url -%}
          {%- assign date = s.date -%}
          {%- if date == blank and article != blank -%}{%- assign date = article.published_at | date: '%B %-d, %Y' -%}{%- endif -%}
          <article class="post{% if forloop.first and section.settings.equal_cards == false %} post--wide{% endif %}" {{ block.shopify_attributes }}>
            {%- if url != blank -%}<a href="{{ url }}" class="post__media">{%- else -%}<div class="post__media">{%- endif -%}
              {%- if image != blank -%}
                {{ image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 450px, 100vw', widths: '400, 600, 900', alt: title }}
              {%- else -%}
                {%- assign ph = forloop.index0 | modulo: 2 | plus: 1 -%}
                {{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            {%- if url != blank -%}</a>{%- else -%}</div>{%- endif -%}
            <div class="post__body">
              {%- if tag != blank -%}<span class="tag">{{ tag }}</span>{%- endif -%}
              <h3 class="post__title">{%- if url != blank -%}<a href="{{ url }}">{{ title }}</a>{%- else -%}{{ title }}{%- endif -%}</h3>
              {%- if s.excerpt != blank -%}<p class="post__excerpt">{{ s.excerpt }}</p>{%- endif -%}
              {%- if date != blank or s.read_time != blank -%}
                <p class="post__meta">
                  {%- if date != blank -%}📅 {{ date }}{%- endif -%}
                  {%- if date != blank and s.read_time != blank %} · {% endif -%}
                  {%- if s.read_time != blank -%}⏱ {{ s.read_time }}{%- endif -%}
                </p>
              {%- endif -%}
              {%- if s.link_label != blank -%}
                {%- if url != blank -%}<a href="{{ url }}" class="post__link">{{ s.link_label }} →</a>{%- else -%}<span class="post__link">{{ s.link_label }} →</span>{%- endif -%}
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- elsif blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: 3 -%}
          <article class="post{% if forloop.first and section.settings.equal_cards == false %} post--wide{% endif %}">
            <a href="{{ article.url }}" class="post__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 450px, 100vw', widths: '400, 600, 900' }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="post__body">
              {%- if article.tags.size > 0 -%}<span class="tag">{{ article.tags.first }}</span>{%- endif -%}
              <h3 class="post__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
              {%- assign words = article.content | strip_html | split: ' ' | size -%}
              {%- assign minutes = words | divided_by: 200 | at_least: 1 -%}
              <p class="post__meta">📅 {{ article.published_at | date: '%B %-d, %Y' }} · ⏱ {{ minutes }} {{ 'general.min_read' | t }}</p>
              <a href="{{ article.url }}" class="post__link">{{ 'general.read_article' | t }} →</a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        <p class="journal__empty">Add a <strong>Post</strong> block or choose a blog in this section's settings.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .post__excerpt { font-size: 13px; color: var(--c-muted); margin-bottom: 8px; }
  .journal__empty { grid-column: 1 / -1; text-align: center; color: var(--c-muted); background: #eef8ea; border-radius: 14px; padding: 40px 20px; margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Plant journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Grow Smarter with" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic green)", "default": "Expert Tips" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "All Articles" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the selected blog" },
    { "type": "checkbox", "id": "equal_cards", "label": "Make all cards the same size", "default": false },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog (optional)",
      "info": "Used only when there are no Post blocks: shows this blog's 3 latest articles"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Plant care" },
        { "type": "text", "id": "title", "label": "Title", "default": "Blog post title" },
        { "type": "textarea", "id": "excerpt", "label": "Short text (optional)" },
        { "type": "text", "id": "date", "label": "Date", "default": "June 12, 2026" },
        { "type": "text", "id": "read_time", "label": "Read time", "default": "5 min read" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Read Article" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "article",
          "id": "article",
          "label": "Blog article (optional)",
          "info": "Empty fields above are filled from this article, and the card links to it"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog posts",
      "blocks": [
        { "type": "post", "settings": { "tag": "🌿 Beginner guide", "title": "10 Easiest Indoor Plants That Even Black Thumbs Can't Kill", "date": "June 12, 2026", "read_time": "6 min read" } },
        { "type": "post", "settings": { "tag": "🌱 Grow at home", "title": "How to Start a Kitchen Garden on Your Balcony", "date": "May 28, 2026", "read_time": "5 min read" } },
        { "type": "post", "settings": { "tag": "💧 Plant care", "title": "Overwatering vs Underwatering: How to Tell the Difference", "date": "May 10, 2026", "read_time": "4 min read" } }
      ]
    }
  ]
}
{% endschema %}
