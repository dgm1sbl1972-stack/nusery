{%- assign blog = section.settings.blog -%}
<section class="journal section-pad" style="background: {{ section.settings.background }};">
  <div class="page-width">
    <div class="section-head section-head--split">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-title section-title--left">{{ section.settings.heading }}<br><em>{{ section.settings.heading_accent }}</em></h2>
      </div>
      <a href="{{ blog.url | default: '#' }}" class="btn btn--outline">{{ section.settings.button_label }} <span aria-hidden="true">→</span></a>
    </div>

    <div class="journal__grid">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: 3 -%}
          <article class="post{% if forloop.first %} post--wide{% endif %}">
            <a href="{{ article.url }}" class="post__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 400px, 100vw', widths: '400, 600, 800' }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="post__body">
              {%- if article.tags.size > 0 -%}<span class="tag">{{ article.tags.first }}</span>{%- endif -%}
              <h3 class="post__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
              {%- assign words = article.content | strip_html | split: ' ' | size -%}
              {%- assign minutes = words | divided_by: 200 | at_least: 1 -%}
              <p class="post__meta">📅 {{ article.published_at | date: '%B %-d, %Y' }} · ⏱ {{ minutes }} {{ 'general.min_read' | t }}</p>
              <a href="{{ article.url }}" class="post__link">{{ 'general.read_article' | t }} →</a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- assign demo_titles = "10 Easiest Indoor Plants That Even Black Thumbs Can't Kill|How to Start a Kitchen Garden on Your Balcony|Overwatering vs Underwatering: How to Tell the Difference" | split: '|' -%}
        {%- assign demo_tags = "Beginner guide|Grow at home|Plant care" | split: '|' -%}
        {%- for t in demo_titles -%}
          <article class="post{% if forloop.first %} post--wide{% endif %}">
            {%- assign ph = forloop.index0 | modulo: 2 | plus: 1 -%}
            <div class="post__media">{{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="post__body">
              <span class="tag">{{ demo_tags[forloop.index0] }}</span>
              <h3 class="post__title">{{ t }}</h3>
              <p class="post__meta">📅 June 12, 2026 · ⏱ 5 {{ 'general.min_read' | t }}</p>
              <span class="post__link">{{ 'general.read_article' | t }} →</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Plant journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Grow Smarter with" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Expert Tips" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "All Articles" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [ { "name": "Blog posts" } ]
}
{% endschema %}
