{%- comment -%}
  SBL Gift: Build your gift section for the SBL Nursery gifting page.
  Shared styles: assets/sbl-gifting.css. Carousel and reveal script: assets/sbl-pages.js.
{%- endcomment -%}

{%- comment -%} Hidden while shoppers filter or sort, so the product grid shows instead. {%- endcomment -%}
{%- capture sbl_filtered -%}{%- render 'sbl-collection-filtered' -%}{%- endcapture -%}
{%- unless sbl_filtered contains 'true' -%}

{%- liquid
  assign sid = section.id
  if collection != blank and collection.url != blank
    assign browse_sort = collection.default_sort_by | default: 'manual'
    assign page_collection_url = collection.url | append: '?sort_by=' | append: browse_sort
  else
    assign page_collection_url = routes.all_products_collection_url
  endif
  assign build_link = section.settings.build_button_link | default: page_collection_url
-%}

{{ 'sbl-gifting.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sbl-pages.js' | asset_url }}" defer></script>

{%- capture leaf_svg -%}<svg viewBox="0 0 120 160" fill="currentColor" aria-hidden="true" focusable="false"><path d="M60 4C28 30 12 62 14 94c2 30 22 52 46 62 24-10 44-32 46-62 2-32-14-64-46-90Z" opacity=".9"/><path d="M60 22v134M60 60 36 40M60 60l24-20M60 90 30 68M60 90l30-22M60 120 38 102M60 120l22-18" stroke="#fff" stroke-opacity=".35" stroke-width="3" fill="none" stroke-linecap="round"/></svg>{%- endcapture -%}
{%- capture arrow_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}

<div id="sblg-{{ sid }}" class="sblg" style="--sec-bg: {{ section.settings.bg_color }}; --build-bg: {{ section.settings.build_bg }};" data-sbl-root>
  <section class="sblg-block" aria-labelledby="sblg-build-title-{{ sid }}">
    <div class="sblg-wrap">
      <div class="sblg-build">
        <div class="sblg-build__leaf sblg-build__leaf--l">{{ leaf_svg }}</div>
        <div class="sblg-build__leaf sblg-build__leaf--r">{{ leaf_svg }}</div>
        <div class="sblg-head" data-reveal>
          <h2 id="sblg-build-title-{{ sid }}" class="sblg-h2">{{ section.settings.build_heading | escape }}</h2>
          {%- if section.settings.build_subheading != blank -%}<p>{{ section.settings.build_subheading | escape }}</p>{%- endif -%}
        </div>
        <ol class="sblg-steps" role="list">
          {%- for n in (1..3) -%}
            {%- assign st_key = 'step_' | append: n | append: '_title' -%}
            {%- assign sx_key = 'step_' | append: n | append: '_text' -%}
            <li class="sblg-step" data-reveal>
              {%- assign si_key = 'step_' | append: n | append: '_icon' -%}
              <span class="sblg-step__num" aria-hidden="true">
                {%- case section.settings[si_key] -%}
                  {%- when 'plant' -%}<svg viewBox="0 0 24 24"><path d="M12 21v-9"/><path d="M12 12c-4.2 0-6.5-2.7-6.5-7 4.2 0 6.5 2.7 6.5 7Zm0 0c4.2 0 6.5-2.7 6.5-7-4.2 0-6.5 2.7-6.5 7Z"/><path d="M7.5 21h9"/></svg>
                  {%- when 'pot' -%}<svg viewBox="0 0 24 24"><path d="M4.5 10.5h15"/><path d="M5.5 10.5 7 20a1.2 1.2 0 0 0 1.2 1h7.6A1.2 1.2 0 0 0 17 20l1.5-9.5"/><path d="M12 10.5V7"/><path d="M12 8c-1.8 0-3-1.2-3-3.3 1.9 0 3 1.2 3 3.3Zm0 0c1.8 0 3-1.2 3-3.3-1.9 0-3 1.2-3 3.3Z"/></svg>
                  {%- when 'message' -%}<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6 8.5 7 8.5-7"/><path d="M12 17.5c-1.3-.9-2.2-1.7-2.2-2.7a1.1 1.1 0 0 1 2.2-.4 1.1 1.1 0 0 1 2.2.4c0 1-.9 1.8-2.2 2.7Z"/></svg>
                  {%- when 'gift' -%}<svg viewBox="0 0 24 24"><rect x="3.5" y="8.5" width="17" height="4" rx="1"/><path d="M5 12.5V20h14v-7.5M12 8.5V20"/><path d="M12 8.5C10.5 5 7.5 4.5 7 6.2c-.5 1.8 2.5 2.3 5 2.3Zm0 0c1.5-3.5 4.5-4 5-2.3.5 1.8-2.5 2.3-5 2.3Z"/></svg>
                  {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                  {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-7.5-10A4.2 4.2 0 0 1 12 7.6 4.2 4.2 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"/></svg>
                  {%- else -%}<span style="font-size:inherit">0{{ n }}</span>
                {%- endcase -%}
              </span>
              <div>
                <h3 class="sblg-h3"><span class="sblg-sr">Step {{ n }}: </span>{{ section.settings[st_key] | escape }}</h3>
                {%- if section.settings[sx_key] != blank -%}<p>{{ section.settings[sx_key] | escape }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
        {%- if section.settings.build_button_label != blank -%}
          <div class="sblg-build__cta" data-reveal>
            <a class="sblg-btn sblg-btn--primary" href="{{ build_link }}">{{ section.settings.build_button_label | escape }}{{ arrow_svg }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{%- endunless -%}

