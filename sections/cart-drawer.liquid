{%- comment -%}
  Slide-out cart drawer. Rendered once in the layout and re-rendered through
  the Section Rendering API (?sections=cart-drawer) after every cart change.
{%- endcomment -%}
<div class="cart-drawer__inner" data-cart-drawer-inner data-enabled="{{ section.settings.enabled }}" data-item-count="{{ cart.item_count }}">
  <div class="cart-drawer__head">
    <h2 class="cart-drawer__title" id="CartDrawerTitle">{{ section.settings.heading }} <span>({{ cart.item_count }})</span></h2>
    <button type="button" class="cart-drawer__close" aria-label="Close cart" data-cart-drawer-close>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>

  {%- if section.settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
    {%- assign threshold = section.settings.free_shipping_threshold | times: 100 -%}
    {%- assign remaining = threshold | minus: cart.total_price -%}
    {%- assign progress = cart.total_price | times: 100 | divided_by: threshold -%}
    {%- if progress > 100 -%}{%- assign progress = 100 -%}{%- endif -%}
    <div class="cart-drawer__shipping">
      {%- if remaining > 0 -%}
        <p>Add <strong>{{ remaining | money }}</strong> more for <strong>free shipping</strong></p>
      {%- else -%}
        <p>🎉 You’ve unlocked <strong>free shipping</strong></p>
      {%- endif -%}
      <div class="cart-drawer__bar"><span style="width: {{ progress }}%;"></span></div>
    </div>
  {%- endif -%}

  {%- if cart.item_count > 0 -%}
    <ul class="cart-drawer__items" role="list">
      {%- for item in cart.items -%}
        <li class="cart-item">
          <a href="{{ item.url }}" class="cart-item__media">
            {%- if item.image -%}
              {{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.product.title }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>
          <div class="cart-item__info">
            <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
            {%- unless item.product.has_only_default_variant -%}<p class="cart-item__meta">{{ item.variant.title }}</p>{%- endunless -%}
            {%- for p in item.properties -%}
              {%- assign first = p.first | slice: 0 -%}
              {%- if p.last != blank and first != '_' -%}<p class="cart-item__meta">{{ p.first }}: {{ p.last }}</p>{%- endif -%}
            {%- endfor -%}
            <div class="cart-item__row">
              <div class="cart-item__qty">
                <button type="button" aria-label="Decrease quantity" data-cart-line="{{ forloop.index }}" data-cart-qty="{{ item.quantity | minus: 1 }}">−</button>
                <span aria-label="Quantity">{{ item.quantity }}</span>
                <button type="button" aria-label="Increase quantity" data-cart-line="{{ forloop.index }}" data-cart-qty="{{ item.quantity | plus: 1 }}">+</button>
              </div>
              <div class="cart-item__price">
                {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
            </div>
            <button type="button" class="cart-item__remove" data-cart-line="{{ forloop.index }}" data-cart-qty="0">Remove</button>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    <div class="cart-drawer__foot">
      {%- for discount in cart.cart_level_discount_applications -%}
        <div class="cart-drawer__line"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
      {%- endfor -%}
      <div class="cart-drawer__line cart-drawer__subtotal"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
      <p class="cart-drawer__note">{{ section.settings.note }}</p>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn cart-drawer__checkout">{{ section.settings.checkout_label }}</button>
      </form>
      <a class="cart-drawer__view" href="{{ routes.cart_url }}">View cart</a>
    </div>
  {%- else -%}
    <div class="cart-drawer__empty">
      <p>Your cart is empty</p>
      <a class="btn btn--dark" href="{{ routes.all_products_collection_url }}" data-cart-drawer-close>Continue shopping</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart drawer",
  "class": "cart-drawer-section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Open cart drawer instead of going to the cart page", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    { "type": "range", "id": "free_shipping_threshold", "label": "Free shipping above", "min": 0, "max": 2000, "step": 10, "default": 150, "info": "Set to 0 to hide the free shipping bar." },
    { "type": "text", "id": "note", "label": "Note under subtotal", "default": "Taxes and shipping calculated at checkout" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Checkout" }
  ]
}
{% endschema %}
