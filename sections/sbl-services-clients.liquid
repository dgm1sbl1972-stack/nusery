{%- comment -%}
  SBL Services: client logos scrolling as a ticker.
  Shared styles: assets/sbl-services.css.
{%- endcomment -%}

{%- assign sid = section.id -%}

{{ 'sbl-services.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sbl-pages.js' | asset_url }}" defer></script>

<div id="sbls-{{ sid }}" class="sbls{% if section.settings.logos_grayscale %} sbls--gray-logos{% endif %}" style="--clients-bg: {{ section.settings.clients_bg }};" data-sbl-root>
{%- if section.blocks.size > 0 -%}
  <section class="sbls-clients" aria-labelledby="sbls-cl-title-{{ sid }}">
    <div class="sbls-wrap">
      <div class="sbls-clients__head" data-reveal>
        {%- if section.settings.clients_eyebrow != blank -%}<p class="sbls-eyebrow">{{ section.settings.clients_eyebrow | escape }}</p>{%- endif -%}
        <h2 id="sbls-cl-title-{{ sid }}" class="sbls-h2">{{ section.settings.clients_heading | escape }}</h2>
        {%- if section.settings.clients_text != blank -%}<p>{{ section.settings.clients_text | escape }}</p>{%- endif -%}
      </div>
      {%- capture client_items -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'client' -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a class="sbls-logo" href="{{ block.settings.link }}" target="_blank" rel="noopener">{%- else -%}<div class="sbls-logo">{%- endif -%}
                {%- if block.settings.logo != blank -%}
                  {{ block.settings.logo | image_url: width: 320 | image_tag: widths: '160, 240, 320', sizes: '200px', loading: 'lazy', alt: block.settings.name | default: block.settings.logo.alt }}
                {%- else -%}
                  <span>{{ block.settings.name | escape }}</span>
                {%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- liquid
        assign client_count = 0
        for block in section.blocks
          if block.type == 'client'
            assign client_count = client_count | plus: 1
          endif
        endfor
        assign client_repeat = 1
        if client_count > 0 and client_count < 10
          assign client_repeat = 10 | divided_by: client_count | plus: 1
        endif
        capture client_set
          for i in (1..client_repeat)
            echo client_items
          endfor
        endcapture
      -%}
      {%- comment -%} The list is repeated so the ticker loops without a gap; copies are hidden from screen readers. {%- endcomment -%}
      <div class="sbls-ticker" style="--ticker-duration: {{ section.settings.ticker_speed }}s;" data-reveal>
        <div class="sbls-ticker__track">
          <ul class="sbls-ticker__list" role="list" aria-label="{{ section.settings.clients_heading | escape }}">{{ client_set }}</ul>
          <ul class="sbls-ticker__list" role="list" aria-hidden="true">{{ client_set | replace: '<a ', '<a tabindex="-1" ' }}</ul>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}
</div>

{% schema %}
{
  "name": "SBL Services: Clients",
  "tag": "section",
  "class": "section-sbl-services",
  "settings": [
    {
      "type": "text",
      "id": "clients_eyebrow",
      "label": "Eyebrow",
      "default": "Trusted by"
    },
    {
      "type": "text",
      "id": "clients_heading",
      "label": "Heading",
      "default": "Our Valued Clients"
    },
    {
      "type": "text",
      "id": "clients_text",
      "label": "Text",
      "default": "Creating greener spaces for leading businesses and organisations."
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "label": "Ticker loop duration",
      "info": "Seconds for one full loop. Lower is faster.",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "logos_grayscale",
      "label": "Show logos in grey until hovered",
      "default": false
    },
    {
      "type": "color",
      "id": "clients_bg",
      "label": "Background",
      "default": "#EEF1EA"
    }
  ],
  "blocks": [
    {
      "type": "client",
      "name": "Client logo",
      "limit": 30,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Transparent PNG or SVG works best"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Client name",
          "default": "Client name",
          "info": "Used as the logo's alt text, or shown when no logo is uploaded"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SBL Services: Clients",
      "blocks": [
        {
          "type": "client",
          "settings": {
            "name": "Client 1"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Client 2"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Client 3"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Client 4"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Client 5"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Client 6"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Client 7"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Client 8"
          }
        }
      ]
    }
  ]
}
{% endschema %}
