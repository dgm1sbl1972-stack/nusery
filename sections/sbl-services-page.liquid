{%- comment -%}
  SBL Nursery — Services landing page.
  Hero with background image, alternating service rows (image + copy + feature list + button)
  and a client logo carousel. Header, announcement bar and footer come from the theme groups.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign contact_url = section.settings.default_button_link | default: '/pages/contact'
  if section.settings.hero_button_link != blank
    assign hero_link = section.settings.hero_button_link
  else
    assign hero_link = '#sbls-services-' | append: sid
  endif
-%}

<style>
  #sbls-{{ sid }} {
    --s-primary: {{ section.settings.color_primary }};
    --s-accent: {{ section.settings.color_accent }};
    --s-bg: {{ section.settings.color_bg }};
    --s-card: {{ section.settings.color_card }};
    --s-text: {{ section.settings.color_text }};
    --s-muted: rgba({{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }}, .74);
    --s-line: rgba({{ section.settings.color_primary.red }}, {{ section.settings.color_primary.green }}, {{ section.settings.color_primary.blue }}, .12);
    --s-radius: 20px;
    --s-shadow: 0 6px 24px rgba(31, 81, 48, .08);
    --s-shadow-hover: 0 14px 34px rgba(31, 81, 48, .14);
    --s-gutter: 16px;
    --s-space: 48px;
    --s-head: 'Montserrat', 'Poppins', sans-serif;
    --s-body: 'Poppins', sans-serif;
    background: var(--s-bg);
    color: var(--s-text);
    font-family: var(--s-body);
    font-size: 15px;
    line-height: 1.6;
    overflow: hidden;
  }
  @media (min-width: 750px) { #sbls-{{ sid }} { --s-gutter: 32px; --s-space: 72px; font-size: 16px; } }

  #sbls-{{ sid }} *, #sbls-{{ sid }} *::before, #sbls-{{ sid }} *::after { box-sizing: border-box; }
  #sbls-{{ sid }} img { display: block; max-width: 100%; height: auto; }
  #sbls-{{ sid }} .sbls-wrap { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 var(--s-gutter); }
  #sbls-{{ sid }} .sbls-ph { width: 100%; height: 100%; background: #E6EFE2; fill: rgba(31, 81, 48, .28); }
  #sbls-{{ sid }} .sbls-eyebrow { margin: 0 0 12px; font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--s-primary); opacity: .8; }
  #sbls-{{ sid }} .sbls-h1, #sbls-{{ sid }} .sbls-h2 { margin: 0; font-family: var(--s-head); font-weight: 700; letter-spacing: -.01em; }
  #sbls-{{ sid }} .sbls-h1 { font-size: clamp(30px, 5.6vw, 54px); line-height: 1.1; color: #fff; }
  #sbls-{{ sid }} .sbls-h2 { font-size: clamp(26px, 3.8vw, 38px); line-height: 1.15; color: var(--s-primary); }

  /* Buttons */
  #sbls-{{ sid }} .sbls-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 26px; border: 0; border-radius: 999px; font-family: var(--s-body); font-size: 15px; font-weight: 600; line-height: 1; text-decoration: none; cursor: pointer; transition: transform .25s ease, box-shadow .25s ease; }
  #sbls-{{ sid }} .sbls-btn svg { width: 18px; height: 18px; transition: transform .25s ease; }
  #sbls-{{ sid }} .sbls-btn:hover { transform: translateY(-2px); }
  #sbls-{{ sid }} .sbls-btn:hover svg { transform: translateX(3px); }
  #sbls-{{ sid }} .sbls-btn--primary { background: var(--s-primary); color: #fff; box-shadow: 0 8px 20px rgba(31, 81, 48, .22); }
  #sbls-{{ sid }} .sbls-btn--primary:hover { box-shadow: 0 12px 26px rgba(31, 81, 48, .3); }
  #sbls-{{ sid }} .sbls-btn--accent { background: var(--s-accent); color: #1b2a1f; box-shadow: 0 8px 20px rgba(0, 0, 0, .18); }
  #sbls-{{ sid }} a:focus-visible, #sbls-{{ sid }} button:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }

  /* Hero */
  #sbls-{{ sid }} .sbls-hero { position: relative; display: flex; align-items: center; min-height: {{ section.settings.hero_height_mobile }}px; background: var(--s-primary); color: #fff; overflow: hidden; }
  @media (min-width: 750px) { #sbls-{{ sid }} .sbls-hero { min-height: {{ section.settings.hero_height }}px; } }
  #sbls-{{ sid }} .sbls-hero__media { position: absolute; inset: 0; }
  #sbls-{{ sid }} .sbls-hero__media img, #sbls-{{ sid }} .sbls-hero__media svg { width: 100%; height: 100%; object-fit: cover; }
  #sbls-{{ sid }} .sbls-hero__media .sbls-ph { background: #2b5e3c; fill: rgba(255, 255, 255, .12); }
  #sbls-{{ sid }} .sbls-hero__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10, 32, 18, {{ section.settings.hero_overlay | divided_by: 100.0 }}) 0%, rgba(10, 32, 18, {{ section.settings.hero_overlay | divided_by: 160.0 }}) 45%, rgba(10, 32, 18, 0) 80%); }
  @media (max-width: 749px) { #sbls-{{ sid }} .sbls-hero__media::after { background: rgba(10, 32, 18, {{ section.settings.hero_overlay | divided_by: 100.0 }}); } }
  #sbls-{{ sid }} .sbls-hero__copy { position: relative; z-index: 1; padding: 48px 0; max-width: 620px; }
  #sbls-{{ sid }} .sbls-hero .sbls-eyebrow { color: #fff; opacity: .92; }
  #sbls-{{ sid }} .sbls-hero__text { margin: 16px 0 28px; max-width: 520px; font-size: 17px; color: rgba(255, 255, 255, .92); }

  /* Service rows */
  #sbls-{{ sid }} .sbls-list { display: grid; gap: var(--s-space); padding: var(--s-space) 0; }
  #sbls-{{ sid }} .sbls-row { display: grid; gap: 22px; align-items: center; scroll-margin-top: 90px; }
  @media (min-width: 990px) {
    #sbls-{{ sid }} .sbls-row { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 56px; }
    #sbls-{{ sid }} .sbls-row--flip .sbls-row__media { order: 2; }
  }
  #sbls-{{ sid }} .sbls-row__media { border-radius: var(--s-radius); overflow: hidden; aspect-ratio: 16 / 10; background: #E6EFE2; box-shadow: var(--s-shadow); }
  #sbls-{{ sid }} .sbls-row__media img, #sbls-{{ sid }} .sbls-row__media svg { width: 100%; height: 100%; object-fit: cover; transition: transform .7s ease; }
  #sbls-{{ sid }} .sbls-row:hover .sbls-row__media img { transform: scale(1.03); }
  #sbls-{{ sid }} .sbls-row__text { margin: 14px 0 18px; color: var(--s-muted); }
  #sbls-{{ sid }} .sbls-feats { display: grid; grid-template-columns: 1fr; gap: 10px 24px; margin: 0 0 24px; padding: 0; list-style: none; font-size: 15px; }
  @media (min-width: 600px) { #sbls-{{ sid }} .sbls-feats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  #sbls-{{ sid }} .sbls-feats li { display: flex; align-items: flex-start; gap: 10px; }
  #sbls-{{ sid }} .sbls-feats svg { flex: none; width: 20px; height: 20px; margin-top: 2px; color: var(--s-primary); }

  /* Clients */
  #sbls-{{ sid }} .sbls-clients { padding: var(--s-space) 0; background: {{ section.settings.clients_bg }}; }
  #sbls-{{ sid }} .sbls-clients__head { text-align: center; max-width: 640px; margin: 0 auto 28px; }
  #sbls-{{ sid }} .sbls-clients__head p:not(.sbls-eyebrow) { margin: 8px 0 0; color: var(--s-muted); }
  #sbls-{{ sid }} .sbls-rail { display: flex; align-items: center; gap: 12px; }
  #sbls-{{ sid }} .sbls-track { flex: 1; min-width: 0; display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 2 * 12px) / 2.4); gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; list-style: none; margin: 0; padding: 6px 2px 10px; }
  #sbls-{{ sid }} .sbls-track::-webkit-scrollbar { display: none; }
  #sbls-{{ sid }} .sbls-track > li { scroll-snap-align: start; }
  @media (min-width: 750px) { #sbls-{{ sid }} .sbls-track { grid-auto-columns: calc((100% - 4 * 14px) / 5); gap: 14px; } }
  @media (min-width: 1100px) { #sbls-{{ sid }} .sbls-track { grid-auto-columns: calc((100% - 7 * 14px) / 8); } }
  #sbls-{{ sid }} .sbls-logo { display: grid; place-items: center; height: 84px; padding: 14px 16px; border-radius: 14px; background: var(--s-card); box-shadow: var(--s-shadow); text-decoration: none; color: var(--s-primary); font-family: var(--s-head); font-weight: 700; font-size: 15px; text-align: center; transition: transform .25s ease, box-shadow .25s ease; }
  #sbls-{{ sid }} a.sbls-logo:hover { transform: translateY(-3px); box-shadow: var(--s-shadow-hover); }
  #sbls-{{ sid }} .sbls-logo img { max-height: 52px; width: auto; object-fit: contain;{% if section.settings.logos_grayscale %} filter: grayscale(1); opacity: .8; transition: filter .25s ease, opacity .25s ease;{% endif %} }
  #sbls-{{ sid }} .sbls-logo:hover img { filter: none; opacity: 1; }
  #sbls-{{ sid }} .sbls-arrow { display: none; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 50%; border: 0; background: var(--s-card); color: var(--s-primary); box-shadow: var(--s-shadow); cursor: pointer; transition: background-color .25s ease, color .25s ease, opacity .25s ease; }
  @media (min-width: 750px) { #sbls-{{ sid }} .sbls-arrow { display: grid; } }
  #sbls-{{ sid }} .sbls-arrow:hover:not(:disabled) { background: var(--s-primary); color: #fff; }
  #sbls-{{ sid }} .sbls-arrow:disabled { opacity: .35; cursor: default; }
  #sbls-{{ sid }} .sbls-arrow svg { width: 20px; height: 20px; }

  /* Reveal */
  html.js #sbls-{{ sid }} [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }
  html.js #sbls-{{ sid }} [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.js #sbls-{{ sid }} [data-reveal] { opacity: 1; transform: none; transition: none; }
    #sbls-{{ sid }} * { transition: none !important; scroll-behavior: auto !important; }
  }
</style>

{%- capture arrow_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture check_svg -%}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.5 14.6 4l3-.1 1.4 2.6 2.6 1.5-.1 3L23 13.6l-1.5 2.6.1 3-2.6 1.4L17.6 23l-3-.1L12 24.5 9.4 23l-3 .1L5 20.5 2.4 19l.1-3L1 13.4l1.5-2.6-.1-3L5 6.4 6.4 3.9l3 .1Z" transform="scale(.92) translate(1 0)"/><path d="m8 12.3 2.7 2.7 5.4-5.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}

<div id="sbls-{{ sid }}" class="sbls">

  {%- comment -%} ===== HERO ===== {%- endcomment -%}
  <section class="sbls-hero" aria-labelledby="sbls-hero-title-{{ sid }}">
    <div class="sbls-hero__media">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1900, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_image.alt | default: '' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'sbls-ph' }}
      {%- endif -%}
    </div>
    <div class="sbls-wrap">
      <div class="sbls-hero__copy" data-reveal>
        {%- if section.settings.hero_eyebrow != blank -%}<p class="sbls-eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>{%- endif -%}
        <h1 id="sbls-hero-title-{{ sid }}" class="sbls-h1">{{ section.settings.hero_heading | escape }}</h1>
        {%- if section.settings.hero_text != blank -%}<p class="sbls-hero__text">{{ section.settings.hero_text | escape }}</p>{%- endif -%}
        {%- if section.settings.hero_button_label != blank -%}
          <a class="sbls-btn sbls-btn--accent" href="{{ hero_link }}">{{ section.settings.hero_button_label | escape }}{{ arrow_svg }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== SERVICES ===== {%- endcomment -%}
  <div class="sbls-wrap">
    <div class="sbls-list" id="sbls-services-{{ sid }}">
      {%- assign svc_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'service' -%}
          {%- assign svc_index = svc_index | plus: 1 -%}
          {%- assign flip = svc_index | modulo: 2 -%}
          {%- assign btn_link = block.settings.button_link | default: contact_url -%}
          <article class="sbls-row{% if flip == 0 %} sbls-row--flip{% endif %}" id="{{ block.settings.anchor | default: block.id | handleize }}" aria-labelledby="sbls-t-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="sbls-row__media" data-reveal>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 1240px) 600px, (min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.title }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'sbls-ph' }}
              {%- endif -%}
            </div>
            <div data-reveal>
              <p class="sbls-eyebrow">{% if svc_index < 10 %}0{% endif %}{{ svc_index }}{% if block.settings.label != blank %} / {{ block.settings.label | escape }}{% endif %}</p>
              <h2 id="sbls-t-{{ block.id }}" class="sbls-h2">{{ block.settings.title | escape }}</h2>
              {%- if block.settings.text != blank -%}<p class="sbls-row__text">{{ block.settings.text | escape }}</p>{%- endif -%}
              {%- if block.settings.features != blank -%}
                {%- assign feats = block.settings.features | newline_to_br | split: '<br />' -%}
                <ul class="sbls-feats" role="list">
                  {%- for feat in feats -%}
                    {%- assign f = feat | strip -%}
                    {%- if f != blank -%}<li>{{ check_svg }}<span>{{ f | escape }}</span></li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a class="sbls-btn sbls-btn--primary" href="{{ btn_link }}">{{ block.settings.button_label | escape }}{{ arrow_svg }}</a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ===== CLIENTS ===== {%- endcomment -%}
  {%- if section.settings.show_clients -%}
    <section class="sbls-clients" aria-labelledby="sbls-cl-title-{{ sid }}">
      <div class="sbls-wrap">
        <div class="sbls-clients__head" data-reveal>
          {%- if section.settings.clients_eyebrow != blank -%}<p class="sbls-eyebrow">{{ section.settings.clients_eyebrow | escape }}</p>{%- endif -%}
          <h2 id="sbls-cl-title-{{ sid }}" class="sbls-h2">{{ section.settings.clients_heading | escape }}</h2>
          {%- if section.settings.clients_text != blank -%}<p>{{ section.settings.clients_text | escape }}</p>{%- endif -%}
        </div>
        <div class="sbls-rail" data-rail>
          <button class="sbls-arrow" type="button" aria-label="Previous clients" aria-controls="sbls-cl-track-{{ sid }}" data-rail-prev><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
          <ul class="sbls-track" id="sbls-cl-track-{{ sid }}" role="list" tabindex="0" aria-label="{{ section.settings.clients_heading | escape }}" data-rail-track>
            {%- for block in section.blocks -%}
              {%- if block.type == 'client' -%}
                <li {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}<a class="sbls-logo" href="{{ block.settings.link }}" target="_blank" rel="noopener">{%- else -%}<div class="sbls-logo">{%- endif -%}
                    {%- if block.settings.logo != blank -%}
                      {{ block.settings.logo | image_url: width: 320 | image_tag: widths: '160, 240, 320', sizes: '160px', loading: 'lazy', alt: block.settings.name | default: block.settings.logo.alt }}
                    {%- else -%}
                      <span>{{ block.settings.name | escape }}</span>
                    {%- endif -%}
                  {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <button class="sbls-arrow" type="button" aria-label="Next clients" aria-controls="sbls-cl-track-{{ sid }}" data-rail-next><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('sbls-{{ sid }}');
    if (!root) return;

    root.querySelectorAll('[data-rail]').forEach(function (rail) {
      var track = rail.querySelector('[data-rail-track]');
      var prev = rail.querySelector('[data-rail-prev]');
      var next = rail.querySelector('[data-rail-next]');
      if (!track) return;
      function step() {
        var item = track.querySelector('li');
        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return item ? (item.getBoundingClientRect().width + gap) * 2 : track.clientWidth;
      }
      function update() {
        var max = track.scrollWidth - track.clientWidth - 2;
        if (prev) prev.disabled = track.scrollLeft <= 2;
        if (next) next.disabled = track.scrollLeft >= max;
      }
      if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });

    var items = root.querySelectorAll('[data-reveal]');
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches || (window.Shopify && Shopify.designMode)) {
      items.forEach(function (el) { el.classList.add('is-in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-in');
        io.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    items.forEach(function (el) { io.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "SBL Services page",
  "tag": "section",
  "class": "section-sbl-services",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_primary", "label": "Primary green", "default": "#1F5130" },
    { "type": "color", "id": "color_accent", "label": "Accent yellow", "default": "#FFD60A" },
    { "type": "color", "id": "color_bg", "label": "Page background", "default": "#F8F4EC" },
    { "type": "color", "id": "color_card", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#1E2A22" },

    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Background image", "info": "Wide garden or landscape photo, 2400 x 900px recommended" },
    { "type": "range", "id": "hero_overlay", "label": "Image darkening", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 70 },
    { "type": "range", "id": "hero_height", "label": "Desktop height", "min": 320, "max": 700, "step": 20, "unit": "px", "default": 420 },
    { "type": "range", "id": "hero_height_mobile", "label": "Mobile height", "min": 320, "max": 640, "step": 20, "unit": "px", "default": 440 },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "SBL Nursery Services" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Complete Green Solutions, From Design to Care" },
    { "type": "textarea", "id": "hero_text", "label": "Text", "default": "Transforming homes, offices and commercial spaces with professional landscaping and plant care solutions." },
    { "type": "text", "id": "hero_button_label", "label": "Button label", "default": "Explore Our Services" },
    { "type": "url", "id": "hero_button_link", "label": "Button link", "info": "Defaults to scrolling down to the services" },

    { "type": "header", "content": "Service buttons" },
    { "type": "url", "id": "default_button_link", "label": "Default button link", "info": "Used by service buttons without their own link. Defaults to /pages/contact." },

    { "type": "header", "content": "Clients" },
    { "type": "checkbox", "id": "show_clients", "label": "Show clients", "default": true },
    { "type": "text", "id": "clients_eyebrow", "label": "Eyebrow", "default": "Trusted by" },
    { "type": "text", "id": "clients_heading", "label": "Heading", "default": "Our Valued Clients" },
    { "type": "text", "id": "clients_text", "label": "Text", "default": "Creating greener spaces for leading businesses and organisations." },
    { "type": "checkbox", "id": "logos_grayscale", "label": "Show logos in grey until hovered", "default": false },
    { "type": "color", "id": "clients_bg", "label": "Background", "default": "#EEF1EA" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "label", "label": "Small label", "default": "Landscaping", "info": "Shown after the number, e.g. 01 / LANDSCAPING" },
        { "type": "text", "id": "title", "label": "Title", "default": "Landscaping" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "textarea", "id": "features", "label": "Features", "info": "One per line" },
        { "type": "image_picker", "id": "image", "label": "Image" },
