{%- comment -%}
  SBL Gift: Budget section for the SBL Nursery gifting page.
  Shared styles: assets/sbl-gifting.css. Carousel and reveal script: assets/sbl-pages.js.
{%- endcomment -%}

{%- comment -%} Hidden while shoppers filter or sort, so the product grid shows instead. {%- endcomment -%}
{%- capture sbl_filtered -%}{%- render 'sbl-collection-filtered' -%}{%- endcapture -%}
{%- unless sbl_filtered contains 'true' -%}

{%- liquid
  assign sid = section.id
  if section.settings.budget_collection != blank
    assign budget_base_url = section.settings.budget_collection.url
  elsif collection != blank and collection.url != blank
    assign budget_base_url = collection.url
  else
    assign budget_base_url = routes.all_products_collection_url
  endif
-%}

{{ 'sbl-gifting.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sbl-pages.js' | asset_url }}" defer></script>

<div id="sblg-{{ sid }}" class="sblg" style="--sec-bg: {{ section.settings.bg_color }};" data-sbl-root>
  <section class="sblg-block" aria-labelledby="sblg-bud-title-{{ sid }}">
    <div class="sblg-wrap">
      <div class="sblg-head" data-reveal>
        <h2 id="sblg-bud-title-{{ sid }}" class="sblg-h2">{{ section.settings.budget_heading | escape }}</h2>
        {%- if section.settings.budget_subheading != blank -%}<p>{{ section.settings.budget_subheading | escape }}</p>{%- endif -%}
      </div>
      <ul class="sblg-cards" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'budget' -%}
            {%- liquid
              if block.settings.link != blank
                assign bud_link = block.settings.link
              else
                assign bud_params = ''
                if block.settings.min_price != blank and block.settings.min_price > 0
                  assign bud_params = bud_params | append: '&filter.v.price.gte=' | append: block.settings.min_price
                endif
                if block.settings.max_price != blank and block.settings.max_price > 0
                  assign bud_params = bud_params | append: '&filter.v.price.lte=' | append: block.settings.max_price
                endif
                if bud_params != ''
                  assign bud_params = bud_params | remove_first: '&'
                  assign bud_link = budget_base_url | append: '?' | append: bud_params
                else
                  assign bud_link = budget_base_url
                endif
              endif
            -%}
            <li data-reveal {{ block.shopify_attributes }}>
              <a class="sblg-budget" href="{{ bud_link }}">
                <span class="sblg-budget__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 800 | image_tag: widths: '300, 450, 600, 800', sizes: '(min-width: 990px) 24vw, 48vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.label }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'sblg-ph' }}
                  {%- endif -%}
                </span>
                <span class="sblg-budget__body">
                  <span class="sblg-budget__label">{{ block.settings.label | escape }}</span>
                  {%- if block.settings.caption != blank -%}<span class="sblg-budget__cap">{{ block.settings.caption | escape }}</span>{%- endif -%}
                  <span class="sblg-budget__go">{{ section.settings.budget_link_label | escape }}</span>
                </span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
</div>

{%- endunless -%}

{% schema %}
{
  "name": "SBL Gift: Budget",
  "tag": "section",
  "class": "section-sbl-gift",
  "settings": [
    {
      "type": "text",
      "id": "budget_heading",
      "label": "Heading",
      "default": "Gifts by Budget"
    },
    {
      "type": "text",
      "id": "budget_subheading",
      "label": "Subheading",
      "default": "Thoughtful green gifts for every budget"
    },
    {
      "type": "collection",
      "id": "budget_collection",
      "label": "Collection to filter by price",
      "info": "Budget cards without their own link open this collection filtered by their price range. Defaults to the current collection."
    },
    {
      "type": "text",
      "id": "budget_link_label",
      "label": "Card link label",
      "default": "Shop now"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#F8F4EC"
    }
  ],
  "blocks": [
    {
      "type": "budget",
      "name": "Budget card",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Under ₹500"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Small joys"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square photo works best, e.g. 800 x 800px"
        },
        {
          "type": "number",
          "id": "min_price",
          "label": "Minimum price",
          "info": "In store currency. Leave empty for no minimum."
        },
        {
          "type": "number",
          "id": "max_price",
          "label": "Maximum price",
          "info": "In store currency. Leave empty for no maximum.",
          "default": 500
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Optional. Overrides the price filter link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SBL Gift: Budget",
      "blocks": [
        {
          "type": "budget",
          "settings": {
            "label": "Under ₹500",
            "caption": "Small joys",
            "max_price": 500
          }
        },
        {
          "type": "budget",
          "settings": {
            "label": "₹500 – ₹1,000",
            "caption": "Thoughtful picks",
            "min_price": 500,
            "max_price": 1000
          }
        },
        {
          "type": "budget",
          "settings": {
            "label": "₹1,000 – ₹2,000",
            "caption": "Premium gifts",
            "min_price": 1000,
            "max_price": 2000
          }
        },
        {
          "type": "budget",
          "settings": {
            "label": "Above ₹2,000",
            "caption": "Luxury green gifts",
            "min_price": 2000
          }
        }
      ]
    }
  ]
}
{% endschema %}
