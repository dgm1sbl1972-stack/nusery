<section class="section-pad" style="background: var(--c-cream);">
  <div class="page-width">
    <h1 class="section-title section-title--left">{% if search.performed %}{{ search.terms | escape }}{% else %}Search{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" class="header-search header-search--lg mt-40" role="search">
      <input type="hidden" name="type" value="product">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}" aria-label="Search">
    </form>

    {%- paginate search.results by section.settings.products_per_page -%}
      {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
      {%- assign show_filters = false -%}
      {%- if section.settings.enable_filtering and search.performed and search.filters.size > 0 -%}{%- assign show_filters = true -%}{%- endif -%}
      {%- assign show_sidebar = show_filters -%}
      {%- if section.blocks.size > 0 -%}{%- assign show_sidebar = true -%}{%- endif -%}

      {%- assign terms_q = search.terms | url_encode -%}
      {%- assign current_url = routes.search_url | append: '?type=product&q=' | append: terms_q -%}
      {%- assign clear_url = current_url | append: '&sort_by=' | append: sort_by -%}
      {%- assign form_id = 'CollectionFilters-' | append: section.id -%}
      <div class="collection-layout mt-40{% unless show_sidebar %} collection-layout--no-filters{% endunless %}">
        {%- render 'facets-sidebar', section: section, section_id: section.id, filters: search.filters, show_filters: show_filters, show_sidebar: show_sidebar, form_id: form_id, results_url: routes.search_url, clear_url: clear_url, current_url: current_url, search_terms: search.terms -%}

        <div class="collection-main">
          {%- if search.performed -%}
            <div class="collection-toolbar">
              <p class="collection-toolbar__count">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }} for “{{ search.terms | escape }}”</p>
              {%- if show_sidebar -%}{%- render 'facets-filter-button', section_id: section.id -%}{%- endif -%}
              {%- if section.settings.enable_sorting -%}
                <label class="collection-toolbar__sort">
                  <span>Sort by</span>
                  <select name="sort_by" form="{{ form_id }}">
                    {%- for option in search.sort_options -%}
                      <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
                    {%- endfor -%}
                  </select>
                </label>
              {%- endif -%}
            </div>

            {%- if show_filters -%}{%- render 'facets-active', filters: search.filters -%}{%- endif -%}

            <div class="product-grid">
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}
                  {%- render 'product-card', product: item -%}
                {%- else -%}
                  <article class="product-card"><div class="product-card__body"><h3 class="product-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3></div></article>
                {%- endif -%}
              {%- else -%}
                <p class="collection-empty">No products found. <a href="{{ current_url }}">Clear filters</a> or try another search.</p>
              {%- endfor -%}
            </div>
            {%- if paginate.pages > 1 -%}<div class="pagination center mt-40">{{ paginate | default_pagination }}</div>{%- endif -%}
          {%- else -%}
            <p class="section-sub">Search for plants, seeds, pots and more — or pick a category.</p>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</section>

