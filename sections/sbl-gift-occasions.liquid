{%- comment -%}
  SBL Gift: Occasions section for the SBL Nursery gifting page.
  Shared styles: assets/sbl-gifting.css. Carousel and reveal script: assets/sbl-pages.js.
{%- endcomment -%}

{%- comment -%} Hidden while shoppers filter or sort, so the product grid shows instead. {%- endcomment -%}
{%- capture sbl_filtered -%}{%- render 'sbl-collection-filtered' -%}{%- endcapture -%}
{%- unless sbl_filtered contains 'true' -%}

{%- liquid
  assign sid = section.id
  if collection != blank and collection.url != blank
    assign browse_sort = collection.default_sort_by | default: 'manual'
    assign page_collection_url = collection.url | append: '?sort_by=' | append: browse_sort
  else
    assign page_collection_url = routes.all_products_collection_url
  endif
-%}

{{ 'sbl-gifting.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sbl-pages.js' | asset_url }}" defer></script>

{%- capture arrow_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}

<div id="sblg-{{ sid }}" class="sblg" style="--sec-bg: {{ section.settings.bg_color }};" data-sbl-root>
  <section class="sblg-block" aria-labelledby="sblg-occ-title-{{ sid }}">
    <div class="sblg-wrap">
      <div class="sblg-head" data-reveal>
        <h2 id="sblg-occ-title-{{ sid }}" class="sblg-h2">{{ section.settings.occasion_heading | escape }}</h2>
        {%- if section.settings.occasion_subheading != blank -%}<p>{{ section.settings.occasion_subheading | escape }}</p>{%- endif -%}
      </div>
      <ul class="sblg-cards sblg-cards--occ" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'occasion' -%}
            {%- assign occ_link = block.settings.link | default: page_collection_url -%}
            <li data-reveal {{ block.shopify_attributes }}>
              <a class="sblg-occ{% if block.settings.image == blank %} sblg-occ--noimg{% endif %}" href="{{ occ_link }}">
                {%- if block.settings.image != blank -%}
                  <div class="sblg-occ__media">
                    {{ block.settings.image | image_url: width: 640 | image_tag: widths: '240, 360, 480, 640', sizes: '(min-width: 1100px) 16vw, (min-width: 750px) 32vw, 48vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.title }}
                  </div>
                {%- endif -%}
                <div class="sblg-occ__body">
                  <span class="sblg-icon">
                    {%- case block.settings.icon -%}
                      {%- when 'cake' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21h16M5 21v-7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7"/><path d="M5 16c1.5 1 2.8 1 4 0s2.8-1 4 0 2.8 1 4 0 1.5-.7 2-.7"/><path d="M12 12V8M8 12V9M16 12V9"/><path d="M12 5.5c.8-.8.8-1.7 0-2.5-.8.8-.8 1.7 0 2.5Z"/></svg>
                      {%- when 'home' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 11 12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M12 20v-4.5"/><path d="M12 15.5c-2.4 0-3.5-1.6-3.5-3.8 2.3 0 3.5 1.4 3.5 3.8Zm0 0c2.4 0 3.5-1.6 3.5-3.8-2.3 0-3.5 1.4-3.5 3.8Z"/></svg>
                      {%- when 'heart' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10A4.2 4.2 0 0 1 12 7.6 4.2 4.2 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"/><path d="M12 7.6V4M10 5.2c1-.2 1.6-.6 2-1.2.4.6 1 1 2 1.2"/></svg>
                      {%- when 'thanks' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="2.2"/><path d="M12 6.8c0-2 1-3.3 2.2-3.3S15.6 5 14 6.8M14.2 9c2 0 3.3 1 3.3 2.2s-1.5 1.4-3.3-.2M9.8 9c-2 0-3.3 1-3.3 2.2s1.5 1.4 3.3-.2M12 6.8c0-2-1-3.3-2.2-3.3S8.4 5 10 6.8"/><path d="M12 11.2V21M12 17c-2.5 0-4-1.4-4-3.5 2.4 0 4 1.3 4 3.5Zm0-1c2.2 0 3.5-1.2 3.5-3 -2.1 0-3.5 1.1-3.5 3Z"/></svg>
                      {%- when 'gift' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="8.5" width="17" height="4" rx="1"/><path d="M5 12.5V20h14v-7.5M12 8.5V20"/><path d="M12 8.5C10.5 5 7.5 4.5 7 6.2c-.5 1.8 2.5 2.3 5 2.3Zm0 0c1.5-3.5 4.5-4 5-2.3.5 1.8-2.5 2.3-5 2.3Z"/></svg>
                      {%- when 'baby' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-8"/><path d="M12 13c-4 0-6-2.6-6-6.5 4 0 6 2.6 6 6.5Zm0 0c4 0 6-2.6 6-6.5-4 0-6 2.6-6 6.5Z"/><path d="M8 21h8"/></svg>
                      {%- else -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19C5 10 10 5 19 5c0 9-5 14-14 14Z"/><path d="M5 19 13 11"/></svg>
                    {%- endcase -%}
                  </span>
                  <span class="sblg-occ__title">
                    <span class="sblg-h3">{{ block.settings.title | escape }}</span>
                    {{ arrow_svg | replace: '<svg ', '<svg class="sblg-occ__arrow" ' }}
                  </span>
                </div>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
</div>

{%- endunless -%}

{% schema %}
{
  "name": "SBL Gift: Occasions",
  "tag": "section",
  "class": "section-sbl-gift",
  "settings": [
    {
      "type": "text",
      "id": "occasion_heading",
      "label": "Heading",
      "default": "Shop by Occasion"
    },
    {
      "type": "text",
      "id": "occasion_subheading",
      "label": "Subheading",
      "default": "Find the perfect plant gift for every moment"
    },
    {
      "type": "paragraph",
      "content": "Add or edit cards with \"Occasion card\" blocks."
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#F8F4EC"
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion card",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Birthday"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "cake",
          "options": [
            {
              "value": "cake",
              "label": "Cake"
            },
            {
              "value": "home",
              "label": "Home"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "thanks",
              "label": "Flower"
            },
            {
              "value": "gift",
              "label": "Gift box"
            },
            {
              "value": "baby",
              "label": "Sprout"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Square or 5:4 works best."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Pick a collection. Defaults to the current collection."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SBL Gift: Occasions",
      "blocks": [
        {
          "type": "occasion",
          "settings": {
            "title": "Birthday",
            "icon": "cake"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Housewarming",
            "icon": "home"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Anniversary",
            "icon": "heart"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Thank You",
            "icon": "thanks"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Congratulations",
            "icon": "gift"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Get Well Soon",
            "icon": "baby"
          }
        }
      ]
    }
  ]
}
{% endschema %}
