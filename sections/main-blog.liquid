<section class="journal section-pad">
  <div class="page-width">
    <h1 class="section-title section-title--left">{{ blog.title }}</h1>
    {%- paginate blog.articles by 9 -%}
      <div class="journal__grid journal__grid--even mt-40">
        {%- for article in blog.articles -%}
          <article class="post">
            <a href="{{ article.url }}" class="post__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="post__body">
              {%- if article.tags.size > 0 -%}<span class="tag">{{ article.tags.first }}</span>{%- endif -%}
              <h2 class="post__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="post__meta">📅 {{ article.published_at | date: '%B %-d, %Y' }}</p>
              <a href="{{ article.url }}" class="post__link">{{ 'general.read_article' | t }} →</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination center mt-40">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog posts list", "settings": [] }
{% endschema %}
