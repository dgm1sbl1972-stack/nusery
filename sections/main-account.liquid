<section class="acct-page">
  <div class="page-width acct-layout">
    {%- render 'account-nav', active: 'orders' -%}
    <div class="acct-content">
      <h1 class="acct-title">My orders</h1>
      {%- paginate customer.orders by 10 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="acct-orders">
            <div class="acct-orders__head" aria-hidden="true">
              <span>Order</span><span>Date</span><span>Payment</span><span>Delivery</span><span>Total</span>
            </div>
            {%- for order in customer.orders -%}
              <a class="acct-order" href="{{ order.customer_url }}">
                <span class="acct-order__name"><em>Order</em>{{ order.name }}</span>
                <span class="acct-order__date"><em>Date</em>{{ order.created_at | date: '%d %b %Y' }}</span>
                <span><em>Payment</em>{%- render 'account-status', status: order.financial_status, label: order.financial_status_label -%}</span>
                <span><em>Delivery</em>{%- render 'account-status', status: order.fulfillment_status, label: order.fulfillment_status_label -%}</span>
                <span class="acct-order__total"><em>Total</em>{{ order.total_price | money }}</span>
              </a>
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}<div class="pagination center mt-40">{{ paginate | default_pagination }}</div>{%- endif -%}
        {%- else -%}
          <div class="acct-empty">
            <p>You haven’t placed any orders yet.</p>
            <a class="acct-btn acct-btn--inline" href="{{ routes.all_products_collection_url }}">Start shopping</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}

      <h2 class="acct-subtitle">Default address</h2>
      <div class="acct-card">
        {%- if customer.default_address -%}
          <p class="acct-address">{{ customer.default_address | format_address }}</p>
        {%- else -%}
          <p class="acct-muted">No address saved yet.</p>
        {%- endif -%}
        <a class="acct-link" href="{{ routes.account_addresses_url }}">Manage addresses →</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Account", "class": "section-account", "settings": [] }
{% endschema %}
