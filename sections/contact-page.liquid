{%- liquid
  assign s = section.settings
  assign phone_digits = s.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign wa_digits = s.whatsapp | default: s.phone | remove: ' ' | remove: '-' | remove: '+' | remove: '(' | remove: ')'
  assign map_query = s.map_query | default: s.address | newline_to_br | replace: '<br />', ', ' | strip_newlines | url_encode
-%}

<section class="contact-page" style="--cp-bg: {{ s.background }}; --cp-accent: {{ s.accent }};">
  <div class="contact-page__hero">
    <div class="page-width">
      {%- if s.eyebrow != blank -%}<p class="contact-page__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="contact-page__title">{{ s.heading | default: page.title | escape }}</h1>
      {%- if s.subheading != blank -%}<p class="contact-page__sub">{{ s.subheading | escape }}</p>{%- endif -%}
    </div>
  </div>

  <div class="page-width contact-page__grid">
    <div class="contact-page__info">
      {%- if s.address != blank -%}
        <div class="contact-card">
          <span class="contact-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
          <div>
            <h2>{{ s.address_label | escape }}</h2>
            <p>{{ s.address | escape | newline_to_br }}</p>
            <a class="contact-card__link" href="https://www.google.com/maps/search/?api=1&query={{ map_query }}" target="_blank" rel="noopener">Get directions →</a>
          </div>
        </div>
      {%- endif -%}

      {%- if s.phone != blank -%}
        <div class="contact-card">
          <span class="contact-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></span>
          <div>
            <h2>{{ s.phone_label | escape }}</h2>
            <p><a href="tel:{{ phone_digits }}">{{ s.phone | escape }}</a></p>
            {%- if s.whatsapp_enabled -%}
              <a class="contact-card__link" href="https://wa.me/{{ wa_digits }}" target="_blank" rel="noopener">Chat on WhatsApp →</a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if s.email != blank -%}
        <div class="contact-card">
          <span class="contact-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
          <div>
            <h2>{{ s.email_label | escape }}</h2>
            <p><a href="mailto:{{ s.email | strip }}">{{ s.email | escape }}</a></p>
          </div>
        </div>
      {%- endif -%}

      {%- if s.hours != blank -%}
        <div class="contact-card">
          <span class="contact-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <div>
            <h2>{{ s.hours_label | escape }}</h2>
            <p>{{ s.hours | escape | newline_to_br }}</p>
          </div>
        </div>
      {%- endif -%}

      {%- if page.content != blank -%}<div class="rte contact-page__content">{{ page.content }}</div>{%- endif -%}
    </div>

    <div class="contact-page__form-wrap">
      <h2 class="contact-page__form-title">{{ s.form_heading | escape }}</h2>
      {%- if s.form_text != blank -%}<p class="contact-page__form-text">{{ s.form_text | escape }}</p>{%- endif -%}

      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="contact-form__status contact-form__status--ok" role="status">✓ {{ s.success_message | escape }}</p>
        {%- elsif form.errors -%}
          <div class="contact-form__status contact-form__status--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="contact-form__row">
          <label class="contact-form__field">
            <span>Name *</span>
            <input type="text" name="contact[name]" autocomplete="name" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </label>
          <label class="contact-form__field">
            <span>Phone</span>
            <input type="tel" name="contact[phone]" autocomplete="tel" pattern="[0-9\-\+\s]*" value="{{ form.phone }}">
          </label>
        </div>
        <label class="contact-form__field">
          <span>Email *</span>
          <input type="email" name="contact[email]" autocomplete="email" required spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
        </label>
        {%- assign topics = s.topics | split: ',' -%}
        {%- if topics.size > 0 -%}
          <label class="contact-form__field">
            <span>Topic</span>
            <select name="contact[topic]">
              {%- for topic in topics -%}<option>{{ topic | strip | escape }}</option>{%- endfor -%}
            </select>
          </label>
        {%- endif -%}
        <label class="contact-form__field">
          <span>Message *</span>
          <textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea>
        </label>
        <button type="submit" class="contact-form__submit">{{ s.button_label | escape }}</button>
      {%- endform -%}
    </div>
  </div>

  {%- if s.show_map and map_query != blank -%}
    <div class="page-width contact-page__map">
      <iframe title="Map to {{ shop.name | escape }}" src="https://www.google.com/maps?q={{ map_query }}&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Contact page",
  "class": "section-contact-page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "We’re here to help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "subheading", "label": "Intro text", "default": "Questions about plants, orders, delivery or garden services? Reach out and our plant experts will get back to you." },
    { "type": "header", "content": "Contact details" },
    { "type": "text", "id": "address_label", "label": "Address label", "default": "Visit our farm" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "SBL Farms\nKolur, Gururayanapura (Village)\nRamohalli Post, Tavarekere Hobli\nBangalore, Karnataka" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Call us" },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "+91 99000 01972" },
    { "type": "checkbox", "id": "whatsapp_enabled", "label": "Show WhatsApp link", "default": true },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "info": "With country code, e.g. 919900001972. Leave empty to use the phone number." },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email us" },
    { "type": "text", "id": "email", "label": "Email", "default": "sblfarms@sbl1972.com" },
    { "type": "text", "id": "hours_label", "label": "Hours label", "default": "Opening hours" },
    { "type": "textarea", "id": "hours", "label": "Hours", "default": "Monday – Saturday: 9:00 AM – 6:00 PM\nSunday: 9:00 AM – 1:00 PM" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "text", "id": "form_text", "label": "Form text", "default": "We usually reply within one working day." },
    { "type": "text", "id": "topics", "label": "Topics (comma separated)", "default": "Order & delivery, Plant care help, Garden services, Bulk / corporate order, Other" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks! Your message has been sent. We’ll get back to you soon." },
    { "type": "header", "content": "Map" },
    { "type": "checkbox", "id": "show_map", "label": "Show Google map", "default": true },
    { "type": "text", "id": "map_query", "label": "Map location", "info": "Place name or address to show on the map. Leave empty to use the address above." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F8F4EC" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#1F5130" }
  ],
  "presets": [{ "name": "Contact page" }]
}
{% endschema %}
