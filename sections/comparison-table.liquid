{%- comment -%}
  Comparison table. Each row block has a value per column.
  Start a value with "yes", "no" or "~" to show ✓, ✕ or ~ icons; any text after
  a "|" is shown as a caption, e.g. "no | Common issue".
{%- endcomment -%}
<section class="compare section-pad" style="background: {{ section.settings.background }};">
  <div class="page-width page-width--narrow">
    <div class="section-head center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--lines">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-title">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h2>
      {%- if section.settings.subheading != blank -%}<p class="section-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="compare__wrap">
      <table class="compare__table">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            <th scope="col">{{ section.settings.col_1 }}</th>
            <th scope="col" class="is-highlight">{{ section.settings.col_2 }}</th>
            <th scope="col">{{ section.settings.col_3 }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              {%- for n in (1..3) -%}
                {%- assign key = 'value_' | append: n -%}
                {%- assign parts = block.settings[key] | split: '|' -%}
                {%- assign kind = parts[0] | strip | downcase -%}
                {%- assign note = parts[1] | strip -%}
                <td{% if n == 2 %} class="is-highlight"{% endif %}>
                  {%- case kind -%}
                    {%- when 'yes' -%}<span class="mark mark--yes" aria-label="Yes">✓</span>
                    {%- when 'no' -%}<span class="mark mark--no" aria-label="No">✕</span>
                    {%- when '~' -%}<span class="mark mark--mid" aria-label="Partly">~</span>
                    {%- else -%}{%- assign note = block.settings[key] -%}
                  {%- endcase -%}
                  {%- if note != blank -%}<small>{{ note }}</small>{%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Subscription plans" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Monthly" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Green Dose" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Get curated plants, seeds and care products delivered to your door every month. Cancel anytime." },
    { "type": "color", "id": "background", "label": "Background", "default": "#e3fbdc" },
    { "type": "text", "id": "col_1", "label": "Column 1", "default": "Local Nurseries" },
    { "type": "text", "id": "col_2", "label": "Column 2 (highlighted)", "default": "SBL" },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Others" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Plant quality" },
        { "type": "text", "id": "value_1", "label": "Column 1 value", "default": "yes", "info": "yes / no / ~ then optional | caption" },
        { "type": "text", "id": "value_2", "label": "Column 2 value", "default": "yes" },
        { "type": "text", "id": "value_3", "label": "Column 3 value", "default": "no" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Plant quality", "value_1": "yes", "value_2": "yes | Green, healthy & bushy", "value_3": "~ | Inconsistent" } },
        { "type": "row", "settings": { "feature": "Pests", "value_1": "no | Common issue", "value_2": "yes | Pest-controlled", "value_3": "yes" } },
        { "type": "row", "settings": { "feature": "Repotting", "value_1": "no | Requires repotting (Pot is missing)", "value_2": "yes | Not required", "value_3": "~ | Varies; not consistent" } },
        { "type": "row", "settings": { "feature": "Standard soil", "value_1": "no | Standard soil", "value_2": "yes | Pre-mixed", "value_3": "yes" } },
        { "type": "row", "settings": { "feature": "Growing Conditions", "value_1": "yes", "value_2": "yes | Grown by experts on old farms", "value_3": "no | Outsourced" } },
        { "type": "row", "settings": { "feature": "After-sale help", "value_1": "no | None", "value_2": "yes | Expert support", "value_3": "no | None" } },
        { "type": "row", "settings": { "feature": "Guaranteed", "value_1": "no | No guarantee", "value_2": "yes | Assured quality, 14 days replacement", "value_3": "~ | Conditional" } },
        { "type": "row", "settings": { "feature": "One-stop garden shop", "value_1": "yes", "value_2": "yes", "value_3": "no" } }
      ]
    }
  ]
}
{% endschema %}
