  "presets": [
    {
      "name": "Plant hamper builder",
      "blocks": [
        { "type": "wrap", "settings": { "title": "Natural jute ribbon", "color": "#b08a5b" } },
        { "type": "wrap", "settings": { "title": "Sage satin ribbon", "color": "#9caf88" } },
        { "type": "wrap", "settings": { "title": "Forest green wrap", "color": "#2f5d3a" } },
