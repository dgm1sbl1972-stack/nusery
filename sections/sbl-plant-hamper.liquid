    { "type": "text", "id": "step_3_text", "label": "Text", "default": "Pots, tools, care kits and little extras. All optional." },
    { "type": "collection", "id": "accessory_collection", "label": "Accessory collection" },
    { "type": "text", "id": "accessory_button", "label": "Button", "default": "Add" },
    { "type": "header", "content": "Step 4: Personalize" },
    { "type": "text", "id": "step_4_label", "label": "Step name", "default": "Personalize & Checkout" },
    { "type": "text", "id": "step_4_title", "label": "Title", "default": "Personalize your hamper" },
    { "type": "text", "id": "step_4_text", "label": "Text", "default": "Add a message, pick a card and wrapping, and choose when it should arrive." },
    { "type": "collection", "id": "card_collection", "label": "Greeting card collection", "info": "Optional. Shoppers can also choose No card." },
