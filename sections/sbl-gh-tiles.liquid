{%- comment -%}
  Gifting pages: image tiles with a title (and optional text), as a masonry collage or an even grid.
  Used for "Gifts for every celebration", "Promotional products", "What makes us unique", "Signature solutions".
{%- endcomment -%}
<section class="gh gh-tiles" style="--gh-bg: {{ section.settings.bg_color }}; --gh-title: {{ section.settings.heading_color }}; --gh-muted: {{ section.settings.text_color }}; --gh-cols: {{ section.settings.columns }};">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="gh__head">
        {%- if section.settings.heading != blank -%}<h2 class="gh__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="gh__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="gh-tiles__wrap gh-tiles__wrap--{{ section.settings.layout }} gh-tiles__wrap--{{ section.settings.label_style }} gh-tiles__wrap--{{ section.settings.ratio }}">
      {%- for block in section.blocks -%}
        <div class="gh-tile{% if block.settings.tall %} gh-tile--tall{% endif %}{% if block.settings.link != blank %} gh-tile--link{% endif %}" {{ block.shopify_attributes }}>
          <span class="gh-tile__img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 33vw, 50vw', alt: block.settings.title }}
            {%- else -%}
              <span class="gh__ph">{{ 'collection-' | append: forloop.index | placeholder_svg_tag }}</span>
            {%- endif -%}
          </span>
          {%- if block.settings.title != blank or block.settings.text != blank -%}
            <span class="gh-tile__label">
              {%- if block.settings.title != blank -%}<span class="gh-tile__title">{{ block.settings.title | escape }}</span>{%- endif -%}
              {%- if block.settings.text != blank -%}<span class="gh-tile__text">{{ block.settings.text | escape }}</span>{%- endif -%}
            </span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}<a class="gh-tile__link" href="{{ block.settings.link }}"><span class="visually-hidden">{{ block.settings.title | default: 'Shop now' | escape }}</span></a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.gh-tiles__wrap--grid { display: grid; grid-template-columns: repeat(var(--gh-cols, 3), minmax(0, 1fr)); gap: 16px; }
.gh-tiles__wrap--masonry { columns: var(--gh-cols, 3); column-gap: 14px; }
.gh-tiles__wrap--masonry .gh-tile { break-inside: avoid; margin-bottom: 14px; }
.gh-tile { position: relative; display: flex; flex-direction: column; overflow: hidden; border-radius: 14px; background: #fff; color: var(--c-text); text-decoration: none; }
.gh-tile__img { display: block; overflow: hidden; aspect-ratio: 1; }
.gh-tiles__wrap--portrait .gh-tile__img { aspect-ratio: 4 / 5; }
.gh-tiles__wrap--landscape .gh-tile__img { aspect-ratio: 4 / 3; }
.gh-tiles__wrap--masonry .gh-tile__img { aspect-ratio: 5 / 4; }
.gh-tiles__wrap--masonry .gh-tile--tall .gh-tile__img { aspect-ratio: 4 / 5; }
.gh-tile__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.gh-tile--link:hover .gh-tile__img img { transform: scale(1.04); }
.gh-tile__link { position: absolute; inset: 0; z-index: 2; border-radius: inherit; }
.gh-tile__link:focus-visible { outline: 3px solid var(--c-primary); outline-offset: 3px; }
.gh-tile .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.gh-tile__label { display: flex; flex-direction: column; gap: 4px; }
.gh-tile__title { font-family: var(--font-display); font-size: 16px; font-weight: 700; line-height: 1.25; }
.gh-tile__text { font-size: 13px; line-height: 1.5; }
/* Label styles */
.gh-tiles__wrap--pill .gh-tile__label { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); width: max-content; max-width: calc(100% - 24px); padding: 7px 18px; border-radius: 999px; background: rgba(255,255,255,.94); color: var(--c-primary-dark); text-align: center; box-shadow: 0 4px 12px rgba(0,0,0,.08); }
.gh-tiles__wrap--pill .gh-tile__title { font-size: 14px; }
.gh-tiles__wrap--pill .gh-tile__text { display: none; }
.gh-tiles__wrap--overlay .gh-tile__label { position: absolute; inset: auto 0 0 0; padding: 40px 16px 16px; background: linear-gradient(transparent, rgba(13,30,18,.85)); color: #fff; }
.gh-tiles__wrap--overlay .gh-tile__text { color: rgba(255,255,255,.88); }
.gh-tiles__wrap--below .gh-tile__label { padding: 14px 16px 18px; }
.gh-tiles__wrap--below .gh-tile__title { color: var(--c-primary-dark); }
.gh-tiles__wrap--below .gh-tile__text { color: var(--c-muted); }
@media (max-width: 989px) {
  .gh-tiles__wrap--grid { grid-template-columns: repeat(min(var(--gh-cols, 3), 3), minmax(0, 1fr)); }
}
@media (max-width: 749px) {
  .gh-tiles__wrap--grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .gh-tiles__wrap--masonry { columns: 2; column-gap: 10px; }
  .gh-tiles__wrap--masonry .gh-tile { margin-bottom: 10px; }
  .gh-tile { border-radius: 10px; }
  .gh-tile__title { font-size: 14px; }
  .gh-tiles__wrap--pill .gh-tile__label { top: 8px; padding: 5px 12px; }
  .gh-tiles__wrap--pill .gh-tile__title { font-size: 12px; }
  .gh-tiles__wrap--overlay .gh-tile__label { padding: 28px 10px 10px; }
  .gh-tile__text { font-size: 12px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Gifting: Image tiles",
  "tag": "section",
  "class": "section-gh-tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elegant Gifts for Every Celebration" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "masonry", "label": "Collage (mixed heights)" }, { "value": "grid", "label": "Even grid" }], "default": "masonry" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "select", "id": "ratio", "label": "Tile shape (even grid)", "options": [{ "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }], "default": "square" },
    { "type": "select", "id": "label_style", "label": "Title style", "options": [{ "value": "pill", "label": "White pill on the image" }, { "value": "overlay", "label": "Over the image, at the bottom" }, { "value": "below", "label": "Below the image" }], "default": "pill" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#0d3a1d" },
    { "type": "color", "id": "text_color", "label": "Subheading", "default": "#5b6660" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Birthday Gifts" },
        { "type": "textarea", "id": "text", "label": "Text", "info": "Shown with the 'Over the image' and 'Below the image' styles." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "tall", "label": "Tall tile (collage layout)", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Gifting: Image tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Birthday Gifts" } },
        { "type": "tile", "settings": { "title": "Anniversary Gifts", "tall": true } },
        { "type": "tile", "settings": { "title": "Housewarming Gifts", "tall": true } },
        { "type": "tile", "settings": { "title": "Self Care Hampers" } },
        { "type": "tile", "settings": { "title": "Baby Shower Hampers", "tall": true } },
        { "type": "tile", "settings": { "title": "Thank You Gifts" } }
      ]
    }
  ]
}
{% endschema %}
