<section class="product-tabs section-pad" style="background: {{ section.settings.background }};" data-tabs>
  <div class="page-width">
    <div class="section-head section-head--split">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-title section-title--left">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h2>
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="pill-tabs" role="tablist">
          {%- for block in section.blocks -%}
            <button type="button" role="tab" class="pill{% if forloop.first %} is-active{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="panel-{{ block.id }}" data-tab {{ block.shopify_attributes }}>
              {{ block.settings.label | default: block.settings.collection.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="product-grid" id="panel-{{ block.id }}" role="tabpanel" data-tab-panel{% unless forloop.first %} hidden{% endunless %}>
        {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
          {%- for product in block.settings.collection.products limit: section.settings.limit -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..section.settings.limit) -%}
            {%- render 'product-card', product: blank, index: i -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- if section.settings.button_label != blank -%}
      <div class="center mt-40">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--outline">{{ section.settings.button_label }} <span aria-hidden="true">→</span></a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product tabs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Handpicked" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Favourites" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "color", "id": "background", "label": "Background", "default": "#f8f4ec" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View All 500+ Products" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "All" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "All" } },
        { "type": "tab", "settings": { "label": "Plants" } },
        { "type": "tab", "settings": { "label": "Seeds" } },
        { "type": "tab", "settings": { "label": "Kits" } }
      ]
    }
  ]
}
{% endschema %}
