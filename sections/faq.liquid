<section class="faq section-pad" style="background: {{ section.settings.background }};">
  <div class="page-width faq__grid">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-title section-title--left">{{ section.settings.heading }}<br><em>{{ section.settings.heading_accent }}</em></h2>
      <div class="faq__text">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '/pages/contact' }}" class="btn btn--dark">{{ section.settings.button_label }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
      {%- if section.settings.help_title != blank -%}
        <div class="help-box">
          <strong>💬 {{ section.settings.help_title }}</strong>
          <span>{{ section.settings.help_text }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="faq__icon" aria-hidden="true">+</span></summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions," },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Answered" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Everything you need to know about ordering plants online, care tips, shipping and our policies.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact Support" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "help_title", "label": "Help box title", "default": "Need more help?" },
    { "type": "text", "id": "help_text", "label": "Help box text", "default": "Chat with our plant experts — Mon to Sat, 9am–6pm IST" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f8f4ec" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How are live plants packaged and shipped?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Every plant is packed in a custom, breathable box with its soil secured, so it arrives fresh and upright.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "What if my plant arrives damaged or dead?", "answer": "<p>Share a photo within 7 days of delivery and we'll send a free replacement.</p>" } },
        { "type": "question", "settings": { "question": "Do you ship all across India?", "answer": "<p>Yes, we deliver to most pin codes across India.</p>" } },
        { "type": "question", "settings": { "question": "I'm a complete beginner. Where should I start?", "answer": "<p>Try our plant finder quiz or our beginner-friendly collection.</p>" } },
        { "type": "question", "settings": { "question": "Are your seeds and fertilisers organic?", "answer": "<p>Yes, our seeds and fertilisers are 100% organic.</p>" } },
        { "type": "question", "settings": { "question": "Can I return or exchange a plant?", "answer": "<p>Live plants can be replaced under our plant guarantee. Pots and accessories can be returned within 7 days.</p>" } },
        { "type": "question", "settings": { "question": "How do I cancel or modify my order?", "answer": "<p>Contact support before your order ships and we'll update it for you.</p>" } }
      ]
    }
  ]
}
{% endschema %}
