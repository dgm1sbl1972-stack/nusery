{%- comment -%}
  Blog index: one card per blog. Clicking a card opens that blog's page (/blogs/<handle>).
  Shopify has no page listing all blogs, so each blog is added as a block.
{%- endcomment -%}
<section class="journal section-pad">
  <div class="page-width">
    <h1 class="section-title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="all-blogs__intro">{{ section.settings.intro }}</div>
    {%- elsif page.content != blank -%}
      <div class="all-blogs__intro rte">{{ page.content }}</div>
    {%- endif -%}

    {%- liquid
      assign blog_cards = 0
      for block in section.blocks
        if block.settings.blog != blank or request.design_mode
          assign blog_cards = blog_cards | plus: 1
        endif
      endfor
    -%}
    <div class="journal__grid journal__grid--even mt-40{% if blog_cards >= 4 %} all-blogs__grid--4{% endif %}">
      {%- for block in section.blocks -%}
        {%- assign card_blog = block.settings.blog -%}
        {%- if card_blog != blank -%}
          {%- assign latest = card_blog.articles.first -%}
          <a href="{{ card_blog.url }}" class="post all-blogs__card" {{ block.shopify_attributes }}>
            <span class="post__media">
              {%- if block.settings.image != blank -%}
                {%- assign image_alt = block.settings.image.alt | default: card_blog.title -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: image_alt }}
              {%- elsif latest.image -%}
                {%- assign image_alt = latest.image.alt | default: card_blog.title -%}
                {{ latest.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: image_alt }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="post__body">
              <span class="tag">{{ card_blog.articles_count }} {% if card_blog.articles_count == 1 %}article{% else %}articles{% endif %}</span>
              <span class="post__title">{{ card_blog.title }}</span>
              {%- if block.settings.description != blank -%}
                <span class="all-blogs__desc">{{ block.settings.description }}</span>
              {%- elsif latest.excerpt != blank -%}
                <span class="all-blogs__desc">{{ latest.excerpt | strip_html | truncatewords: 20 }}</span>
              {%- endif -%}
              <span class="post__link">{{ section.settings.link_label }} →</span>
            </span>
          </a>
        {%- else -%}
          <div class="post all-blogs__card all-blogs__card--empty" {{ block.shopify_attributes }}>
            <span class="post__body">Select a blog for this card.</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .all-blogs__intro { max-width: 720px; margin: 12px auto 0; text-align: center; }
  .all-blogs__card { color: inherit; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  .all-blogs__card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(20,35,26,.12); }
  .all-blogs__card .post__body { display: flex; flex-direction: column; align-items: flex-start; flex: 1; }
  .all-blogs__card .post__link { margin-top: auto; }
  .all-blogs__desc { display: block; margin: 0 0 12px; font-size: 14px; line-height: 1.5; opacity: .85; }
  .all-blogs__card--empty { min-height: 160px; justify-content: center; text-align: center; }
  .all-blogs__grid--4 { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  @media (min-width: 750px) { .all-blogs__grid--4 { grid-template-columns: repeat(4, 1fr); gap: 20px; } }
</style>

{% schema %}
{
  "name": "All blogs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Blogs", "info": "Leave empty to use the page title." },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "text", "id": "link_label", "label": "Card link label", "default": "View blog" }
  ],
  "blocks": [
    {
      "type": "blog",
      "name": "Blog",
      "settings": [
        { "type": "blog", "id": "blog", "label": "Blog" },
        { "type": "image_picker", "id": "image", "label": "Card image", "info": "Optional. Defaults to the latest article's image." },
        { "type": "textarea", "id": "description", "label": "Short description", "info": "Optional. Defaults to the latest article's excerpt." }
      ]
    }
  ],
  "enabled_on": { "templates": ["page"] },
  "presets": [{ "name": "All blogs" }]
}
{% endschema %}
