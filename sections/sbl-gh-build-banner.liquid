{%- comment -%} Gifting pages: two images side by side with a round badge between them, linking to the hamper builder. {%- endcomment -%}
{%- assign build_url = section.settings.link | default: '/pages/make-your-own-hamper' -%}
<section class="gh gh-build" style="--gh-bg: {{ section.settings.bg_color }};">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="gh__head">
        {%- if section.settings.heading != blank -%}<h2 class="gh__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="gh__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="gh-build__media">
      {%- for n in (1..2) -%}
        {%- assign image_key = 'image_' | append: n -%}
        {%- assign img = section.settings[image_key] -%}
        <a class="gh-build__img" href="{{ build_url }}" tabindex="-1" aria-hidden="true">
          {%- if img != blank -%}
            {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 50vw, 50vw', alt: '' }}
          {%- else -%}
            <span class="gh__ph">{{ 'lifestyle-' | append: n | placeholder_svg_tag }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
      <a class="gh-build__badge" href="{{ build_url }}">{{ section.settings.badge_text | escape }}</a>
    </div>
  </div>
</section>

{% stylesheet %}
.gh-build__media { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.gh-build__img { display: block; overflow: hidden; aspect-ratio: 16 / 11; border-radius: 14px; }
.gh-build__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.gh-build__media:hover .gh-build__img img { transform: scale(1.03); }
.gh-build__badge { position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: clamp(92px, 11vw, 140px); aspect-ratio: 1; padding: 12px; border: 6px solid #fff; border-radius: 50%; background: var(--c-primary-dark); color: #fff; font-family: var(--font-display); font-size: clamp(12px, 1.2vw, 16px); font-weight: 700; line-height: 1.2; text-align: center; text-decoration: none; transform: translate(-50%, -50%); box-shadow: 0 10px 26px rgba(0,0,0,.18); transition: transform .3s ease; }
.gh-build__badge:hover { transform: translate(-50%, -50%) scale(1.06); }
@media (max-width: 749px) {
  .gh-build__media { gap: 8px; }
  .gh-build__img { aspect-ratio: 4 / 5; border-radius: 10px; }
  .gh-build__badge { border-width: 4px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Gifting: Build banner",
  "tag": "section",
  "class": "section-gh-build",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make your Own Hamper" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick your favourite plants and gifts, add a card and a message, and we'll pack it beautifully." },
    { "type": "image_picker", "id": "image_1", "label": "Left image" },
    { "type": "image_picker", "id": "image_2", "label": "Right image" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Make your Own Hamper" },
    { "type": "url", "id": "link", "label": "Link", "info": "Leave empty for /pages/make-your-own-hamper." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Gifting: Build banner" }]
}
{% endschema %}
