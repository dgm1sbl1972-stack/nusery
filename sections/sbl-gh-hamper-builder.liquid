{%- comment -%}
  Make-your-own-hamper builder: 1 Choose a box → 2 Add products → 3 Pick a card → 4 Personalise.
  Everything goes to the cart together; each line carries a "Hamper" reference, and the box line also
  carries the To / From / message, so the order shows what belongs in which hamper.
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign product_source = s.product_collection
  if product_source == blank
    assign product_source = collections.all
  endif
  assign box_required = s.box_required
  if s.box_collection == blank or s.box_collection.products.size == 0
    assign box_required = false
  endif
-%}
<section class="gh hb" id="Hamper-{{ sid }}" style="--gh-bg: {{ s.bg_color }}; --hb-accent: {{ s.accent_color }}; --hb-cols: {{ s.columns_desktop }};"
  data-hamper
  data-min="{{ s.min_products }}"
  data-max="{{ s.max_products }}"
  data-box-required="{{ box_required }}"
  data-money-format="{{ shop.money_format | escape }}">
  <div class="page-width">
    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="gh__head">
        {%- if s.heading != blank -%}<h1 class="gh__title">{{ s.heading | escape }}</h1>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="gh__sub">{{ s.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <ol class="hb__steps">
      {%- for n in (1..4) -%}
        {%- assign label_key = 'step_' | append: n | append: '_label' -%}
        <li class="hb__step{% if n == 1 %} is-current{% endif %}" data-step-tab="{{ n }}">
          <button type="button" class="hb__step-btn" data-goto="{{ n }}" {% if n == 1 %}aria-current="step"{% endif %}>
            <span class="hb__step-icon" aria-hidden="true">
              {%- case n -%}
                {%- when 1 -%}<svg viewBox="0 0 24 24" width="22" height="22"><path d="M3 8l9-4 9 4-9 4-9-4Zm0 0v8l9 4 9-4V8M12 12v8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                {%- when 2 -%}<svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 20v-8m0 0c0-4 3-7 7-7 0 4-3 7-7 7Zm0 3c0-3-2.5-5.5-6-5.5 0 3.5 2.5 5.5 6 5.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                {%- when 3 -%}<svg viewBox="0 0 24 24" width="22" height="22"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </span>
            <span class="hb__step-label">{{ s[label_key] | escape }}</span>
          </button>
        </li>
      {%- endfor -%}
    </ol>

    <div class="hb__layout">
      <div class="hb__main">
        {%- for n in (1..3) -%}
          {%- liquid
            case n
              when 1
                assign kind = 'box'
                assign source = s.box_collection
                assign add_label = s.box_button
              when 2
                assign kind = 'product'
                assign source = product_source
                assign add_label = s.product_button
              else
                assign kind = 'card'
                assign source = s.card_collection
                assign add_label = s.card_button
            endcase
            assign title_key = 'step_' | append: n | append: '_title'
            assign text_key = 'step_' | append: n | append: '_text'
          -%}
          <div class="hb__panel" data-step="{{ n }}" {% unless n == 1 %}hidden{% endunless %}>
            <div class="hb__panel-head">
              <h2 class="hb__panel-title">{{ s[title_key] | escape }}</h2>
              {%- if s[text_key] != blank -%}<p class="hb__panel-text">{{ s[text_key] | escape }}</p>{%- endif -%}
            </div>
            {%- if source.products.size > 0 -%}
              <div class="hb__grid" data-kind-grid="{{ kind }}">
                {%- for product in source.products limit: 48 -%}
                  {%- render 'sbl-hamper-item', product: product, kind: kind, add_label: add_label -%}
                {%- endfor -%}
              </div>
            {%- elsif request.design_mode -%}
              <p class="hb__empty">Choose the collection for this step in the section settings (only you see this note).</p>
            {%- else -%}
              <p class="hb__empty">Coming soon. You can continue to the next step.</p>
            {%- endif -%}
          </div>
        {%- endfor -%}

        <div class="hb__panel" data-step="4" hidden>
          <div class="hb__panel-head">
            <h2 class="hb__panel-title">{{ s.step_4_title | escape }}</h2>
            {%- if s.step_4_text != blank -%}<p class="hb__panel-text">{{ s.step_4_text | escape }}</p>{%- endif -%}
          </div>
          <div class="hb__form">
            <label><span>To</span><input type="text" maxlength="40" autocomplete="off" placeholder="Recipient's name" data-field="To"></label>
            <label><span>From</span><input type="text" maxlength="40" autocomplete="name" placeholder="Your name" data-field="From"></label>
            <label class="hb__form-full"><span>Your message</span><textarea rows="5" maxlength="{{ s.message_max }}" placeholder="Write a few words for the card…" data-field="Gift message"></textarea><small class="hb__count"><span data-count>0</span> / {{ s.message_max }}</small></label>
          </div>
        </div>
      </div>

      <aside class="hb__summary" aria-label="Your hamper">
        <div class="hb__summary-head">
          <h2 class="hb__summary-title">{{ s.summary_title | escape }}</h2>
          <span class="hb__summary-count" data-count-label>0 items</span>
        </div>
        <ul class="hb__list" data-list role="list"></ul>
        <p class="hb__list-empty" data-list-empty>Nothing added yet.</p>
        <div class="hb__total"><span>Total</span><strong data-total>{{ 0 | money }}</strong></div>
        <p class="hb__error" data-error role="alert" hidden></p>
        <div class="hb__nav">
          <button type="button" class="btn btn--outline hb__back" data-back hidden>Back</button>
          <button type="button" class="btn btn--dark hb__next" data-next>Next</button>
          <button type="button" class="btn btn--dark hb__add" data-add-cart hidden>{{ s.cart_button | escape }}</button>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('Hamper-{{ sid }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    var min = Number(root.dataset.min) || 0;
    var max = Number(root.dataset.max) || 0;
    var boxRequired = root.dataset.boxRequired === 'true';
    var moneyFormat = root.dataset.moneyFormat || ('{' + '{amount}' + '}');
    var step = 1;
    var picked = { box: null, card: null };
    var products = {}; /* variantId -> { qty, title, price, image } */

    function formatMoney(cents) {
      var n = (Number(cents) || 0) / 100;
      return moneyFormat.replace(/\{\{\s*(\w+)\s*\}\}/, function (_, key) {
        var decimals = /no_decimals/.test(key) ? 0 : 2;
        var parts = n.toFixed(decimals).split('.');
        var sep = /comma_separator/.test(key) ? ['.', ','] : [',', '.'];
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, sep[0]);
        return parts.join(sep[1]);
      });
    }
    function itemData(el) {
      return { id: el.dataset.variant, title: el.dataset.title, price: Number(el.dataset.price), image: el.dataset.image };
    }
    function productCount() {
      return Object.keys(products).reduce(function (sum, k) { return sum + products[k].qty; }, 0);
    }
    function showError(msg) {
      var el = root.querySelector('[data-error]');
      el.textContent = msg || '';
      el.hidden = !msg;
    }

    function syncItems() {
      root.querySelectorAll('[data-item]').forEach(function (el) {
        var kind = el.dataset.kind;
        var id = el.dataset.variant;
        var on = kind === 'product' ? !!products[id] : !!(picked[kind] && picked[kind].id === id);
        el.classList.toggle('is-picked', on);
        var add = el.querySelector('[data-add]');
        var qty = el.querySelector('[data-qty]');
        if (add) {
          add.setAttribute('aria-pressed', on ? 'true' : 'false');
          if (kind === 'product') add.hidden = on;
          else add.textContent = on ? 'Selected ✓' : add.dataset.label;
        }
        if (qty) {
          qty.hidden = !on;
          if (on) qty.querySelector('[data-qty-value]').textContent = products[id].qty;
        }
      });
    }

    function renderSummary() {
      var list = root.querySelector('[data-list]');
      var rows = [];
      var total = 0;
      function row(kind, it, qty) {
        total += it.price * qty;
        rows.push(
          '<li class="hb__line">' +
            (it.image ? '<img src="' + it.image + '" alt="" width="48" height="48" loading="lazy">' : '<span class="hb__line-ph"></span>') +
            '<span class="hb__line-text"><span class="hb__line-title"></span><span class="hb__line-meta">' + (qty > 1 ? qty + ' × ' : '') + formatMoney(it.price) + '</span></span>' +
            '<button type="button" class="hb__line-remove" data-remove="' + kind + ':' + it.id + '" aria-label="Remove">×</button>' +
          '</li>'
        );
      }
      if (picked.box) row('box', picked.box, 1);
      Object.keys(products).forEach(function (id) { row('product', products[id], products[id].qty); });
      if (picked.card) row('card', picked.card, 1);
      list.innerHTML = rows.join('');
      /* Titles go in as text, never as HTML. */
      var titles = [];
      if (picked.box) titles.push(picked.box.title);
      Object.keys(products).forEach(function (id) { titles.push(products[id].title); });
      if (picked.card) titles.push(picked.card.title);
      list.querySelectorAll('.hb__line-title').forEach(function (el, i) { el.textContent = titles[i]; });

      var count = (picked.box ? 1 : 0) + productCount() + (picked.card ? 1 : 0);
      root.querySelector('[data-count-label]').textContent = count + (count === 1 ? ' item' : ' items');
      root.querySelector('[data-list-empty]').hidden = count > 0;
      root.querySelector('[data-total]').textContent = formatMoney(total);
    }

    function refresh() { syncItems(); renderSummary(); }

    function validate(n) {
      if (n === 1 && boxRequired && !picked.box) return 'Please choose a box to continue.';
      if (n === 2 && productCount() < min) return 'Please add at least ' + min + (min === 1 ? ' product' : ' products') + ' to your hamper.';
      return '';
    }

    function go(n) {
      for (var i = 1; i < n; i++) {
        var err = validate(i);
        if (err) { n = i; showError(err); break; }
        showError('');
      }
      step = n;
      root.querySelectorAll('[data-step]').forEach(function (p) { p.hidden = Number(p.dataset.step) !== step; });
      root.querySelectorAll('[data-step-tab]').forEach(function (li) {
        var k = Number(li.dataset.stepTab);
        li.classList.toggle('is-current', k === step);
        li.classList.toggle('is-done', k < step);
        var b = li.querySelector('button');
        if (k === step) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
      });
      root.querySelector('[data-back]').hidden = step === 1;
      root.querySelector('[data-next]').hidden = step === 4;
      root.querySelector('[data-add-cart]').hidden = step !== 4;
      var top = root.querySelector('.hb__steps').getBoundingClientRect().top + window.scrollY - 90;
      if (window.scrollY > top) window.scrollTo({ top: top, behavior: 'smooth' });
    }

    root.querySelectorAll('[data-item] [data-add]').forEach(function (btn) { btn.dataset.label = btn.textContent.trim(); });

    root.addEventListener('click', function (e) {
      var t = e.target;
      var item = t.closest('[data-item]');
      if (t.closest('[data-add]') && item) {
        var kind = item.dataset.kind;
        var it = itemData(item);
        showError('');
        if (kind === 'product') {
          if (max && productCount() >= max) { showError('You can add up to ' + max + ' products to one hamper.'); return; }
          products[it.id] = Object.assign(it, { qty: 1 });
        } else {
          picked[kind] = picked[kind] && picked[kind].id === it.id ? null : it;
        }
        refresh();
        return;
      }
      if (t.closest('[data-plus]') && item) {
        if (max && productCount() >= max) { showError('You can add up to ' + max + ' products to one hamper.'); return; }
        products[item.dataset.variant].qty++;
        refresh();
        return;
      }
      if (t.closest('[data-minus]') && item) {
        var p = products[item.dataset.variant];
        if (p && --p.qty <= 0) delete products[item.dataset.variant];
        showError('');
        refresh();
        return;
      }
      var rm = t.closest('[data-remove]');
      if (rm) {
        var parts = rm.dataset.remove.split(':');
        if (parts[0] === 'product') delete products[parts[1]]; else picked[parts[0]] = null;
        refresh();
        return;
      }
      var goto = t.closest('[data-goto]');
      if (goto) { go(Number(goto.dataset.goto)); return; }
      if (t.closest('[data-next]')) { go(Math.min(step + 1, 4)); return; }
      if (t.closest('[data-back]')) { showError(''); go(Math.max(step - 1, 1)); return; }
      if (t.closest('[data-add-cart]')) addToCart(t.closest('[data-add-cart]'));
    });

    /* Changing a product's option swaps the variant (and keeps it in the hamper if it was added). */
    root.addEventListener('change', function (e) {
      var sel = e.target.closest('[data-variant-select]');
      if (sel) {
        var item = sel.closest('[data-item]');
        var opt = sel.options[sel.selectedIndex];
        var oldId = item.dataset.variant;
        item.dataset.variant = opt.value;
        item.dataset.price = opt.dataset.price;
        item.querySelector('[data-price-label]').textContent = opt.dataset.money;
        var kind = item.dataset.kind;
        if (kind === 'product' && products[oldId]) {
          var qty = products[oldId].qty;
          delete products[oldId];
          products[opt.value] = Object.assign(itemData(item), { qty: qty });
        } else if (kind !== 'product' && picked[kind] && picked[kind].id === oldId) {
          picked[kind] = itemData(item);
        }
        refresh();
      }
    });

    var message = root.querySelector('[data-field="Gift message"]');
    if (message) message.addEventListener('input', function () { root.querySelector('[data-count]').textContent = message.value.length; });

    function addToCart(btn) {
      for (var i = 1; i <= 3; i++) {
        var err = validate(i);
        if (err) { go(i); showError(err); return; }
      }
      var ref = 'H-' + Date.now().toString(36).slice(-5).toUpperCase();
      var personal = { Hamper: ref };
      root.querySelectorAll('[data-field]').forEach(function (f) { if (f.value.trim()) personal[f.dataset.field] = f.value.trim(); });
      var items = [];
      if (picked.box) items.push({ id: Number(picked.box.id), quantity: 1, properties: personal });
      Object.keys(products).forEach(function (id) {
        items.push({ id: Number(id), quantity: products[id].qty, properties: items.length ? { Hamper: ref } : personal });
      });
      if (picked.card) items.push({ id: Number(picked.card.id), quantity: 1, properties: items.length ? { Hamper: ref } : personal });
      if (!items.length) { showError('Your hamper is empty.'); return; }

      var label = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Adding…';
      var cartRoot = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
      fetch(cartRoot + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
        .then(function (res) {
          if (!res.ok) { showError(res.data.description || res.data.message || 'Could not add the hamper to your cart.'); return; }
          picked = { box: null, card: null };
          products = {};
          root.querySelectorAll('[data-field]').forEach(function (f) { f.value = ''; });
          refresh();
          go(1);
          if (window.SBLCart) window.SBLCart.open(); else window.location.assign(cartRoot + 'cart');
        })
        .catch(function () { showError('Something went wrong. Please try again.'); })
        .finally(function () { btn.disabled = false; btn.textContent = label; });
    }

    refresh();
  })();
</script>

{% stylesheet %}
.hb { --hb-accent: #b5884b; }
.hb .gh__head { margin-bottom: 18px; }
/* Steps: thin line with outlined icons, BoxUp style. */
.hb__steps { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); max-width: 900px; margin: 0 auto 34px; padding: 0; list-style: none; }
.hb__steps::before { content: ""; position: absolute; top: 20px; left: 0; right: 0; height: 1px; background: #d8cfbf; }
.hb__step { position: relative; display: flex; justify-content: center; }
.hb__step-btn { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 0; border: 0; background: none; color: #9a9184; font: inherit; font-size: 13px; letter-spacing: .02em; cursor: pointer; }
.hb__step-icon { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid #cfc4b2; border-radius: 4px; background: var(--gh-bg, #fff); color: #9a9184; transition: background .2s, color .2s, border-color .2s; }
.hb__step-icon svg { width: 20px; height: 20px; }
.hb__step.is-current .hb__step-icon { border-color: var(--hb-accent); background: var(--hb-accent); color: #fff; }
.hb__step.is-current .hb__step-btn { color: var(--hb-accent); font-weight: 600; }
.hb__step.is-done .hb__step-icon { border-color: var(--hb-accent); color: var(--hb-accent); }
/* Full-width grid; the summary is a bar pinned to the bottom. */
.hb__layout { display: block; }
.hb__panel-head { margin-bottom: 18px; text-align: center; }
.hb__panel-title { margin: 0; font-family: var(--font-display); font-size: 20px; color: var(--c-primary-dark); }
.hb__panel-text { margin: 6px 0 0; color: var(--c-muted); font-size: 14px; }
.hb__empty { padding: 30px; border: 1px dashed #cfc4b2; border-radius: 6px; color: var(--c-muted); text-align: center; }
.hb__grid { display: grid; grid-template-columns: repeat(var(--hb-cols, 4), minmax(0, 1fr)); gap: 20px; }
.hb-item { display: flex; flex-direction: column; padding: 8px; border: 1px solid #ece6da; border-radius: 2px; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,.04); transition: border-color .2s, box-shadow .2s; }
.hb-item:hover { box-shadow: 0 6px 18px rgba(0,0,0,.08); }
.hb-item.is-picked { border-color: var(--hb-accent); box-shadow: 0 0 0 1px var(--hb-accent); }
.hb-item__media { position: relative; aspect-ratio: 10 / 9; overflow: hidden; background: #f4f1ea; }
.hb-item__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.hb-item__tick { position: absolute; top: 8px; right: 8px; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--hb-accent); color: #fff; opacity: 0; transform: scale(.6); transition: opacity .2s, transform .2s; }
.hb-item.is-picked .hb-item__tick { opacity: 1; transform: none; }
.hb-item__body { display: flex; flex: 1; flex-direction: column; gap: 4px; padding: 12px 0 0; }
.hb-item__title { margin: 0; overflow: hidden; font-size: 13.5px; font-weight: 400; line-height: 1.35; color: var(--c-text); white-space: nowrap; text-overflow: ellipsis; }
.hb-item__price { margin: 0 0 8px; font-size: 13.5px; font-weight: 700; color: var(--c-text); }
.hb-item__variant { width: 100%; margin-bottom: 8px; font: inherit; font-size: 13px; }
.hb-item__add { margin-top: auto; width: 100%; padding: 10px 12px; border: 0; border-radius: 2px; background: var(--hb-accent); color: #fff; font: inherit; font-size: 13px; font-weight: 500; letter-spacing: .02em; cursor: pointer; transition: filter .15s; }
.hb-item__add:hover { filter: brightness(.92); }
.hb-item__add[aria-pressed="true"] { background: var(--c-primary-dark); }
.hb-item__add--off { background: #e5e2dc; color: #7b776f; text-align: center; cursor: default; }
.hb-item__qty { display: flex; align-items: center; justify-content: space-between; margin-top: auto; border: 1px solid var(--hb-accent); border-radius: 2px; overflow: hidden; }
.hb-item__qty button { width: 40px; height: 38px; border: 0; background: var(--hb-accent); color: #fff; font-size: 18px; cursor: pointer; }
.hb-item__qty span { font-weight: 700; }
.hb__form { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; max-width: 640px; margin: 0 auto; }
.hb__form label { position: relative; display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600; }
.hb__form-full { grid-column: 1 / -1; }
.hb__form input, .hb__form textarea { width: 100%; box-sizing: border-box; padding: 12px; border: 1px solid #d8cfbf; border-radius: 4px; background: #fff; font: inherit; font-size: 16px; font-weight: 400; color: var(--c-text); }
.hb__form input:focus, .hb__form textarea:focus { outline: none; border-color: var(--hb-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--hb-accent) 20%, transparent); }
.hb__count { align-self: flex-end; color: var(--c-muted); font-weight: 400; }
.hb__summary { position: sticky; bottom: 0; z-index: 5; display: grid; grid-template-columns: auto minmax(0, 1fr) auto minmax(260px, auto); grid-template-areas: "head list total nav" "error error error error"; align-items: center; gap: 8px 20px; margin-top: 28px; padding: 12px 20px calc(12px + env(safe-area-inset-bottom)); border-top: 2px solid var(--hb-accent); border-radius: 10px 10px 0 0; background: #fff; box-shadow: 0 -8px 24px rgba(0,0,0,.08); }
.hb__summary-head { grid-area: head; display: flex; flex-direction: column; }
.hb__summary-title { margin: 0; font-family: var(--font-display); font-size: 16px; color: var(--c-primary-dark); }
.hb__summary-count { font-size: 12.5px; color: var(--c-muted); }
.hb__list { grid-area: list; display: flex; gap: 8px; margin: 0; padding: 2px 0; overflow-x: auto; list-style: none; }
.hb__list-empty { grid-area: list; margin: 0; font-size: 13px; color: var(--c-muted); }
.hb__line { position: relative; flex: none; }
.hb__line img, .hb__line-ph { display: block; width: 44px; height: 44px; border: 1px solid #ece6da; border-radius: 4px; object-fit: cover; background: #f1efe8; }
.hb__line-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.hb__line-remove { position: absolute; top: -6px; right: -6px; display: grid; place-items: center; width: 18px; height: 18px; padding: 0; border: 0; border-radius: 50%; background: var(--c-text); color: #fff; font-size: 13px; line-height: 1; cursor: pointer; }
.hb__total { grid-area: total; display: flex; flex-direction: column; align-items: flex-end; font-size: 12.5px; color: var(--c-muted); }
.hb__total strong { font-size: 18px; color: var(--c-text); }
.hb__error { grid-area: error; margin: 0; padding: 8px 12px; border-radius: 6px; background: #fdecea; color: #9b2c1f; font-size: 13px; }
.hb__nav { grid-area: nav; display: flex; gap: 10px; }
.hb__nav .btn { flex: 1; justify-content: center; }
.hb__nav .btn--dark { border-color: var(--hb-accent); background: var(--hb-accent); color: #fff; }
.hb__nav .btn--outline { border-color: var(--hb-accent); color: var(--hb-accent); }
@media (max-width: 989px) {
  .hb__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .hb__summary { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "head total" "list list" "error error" "nav nav"; margin-inline: -16px; padding-inline: 16px; }
}
@media (max-width: 749px) {
  .hb__steps { margin-bottom: 24px; }
  .hb__steps::before { top: 18px; }
  .hb__step-icon { width: 36px; height: 36px; }
  .hb__step-btn { font-size: 11.5px; text-align: center; }
  .hb__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .hb-item { padding: 6px; }
  .hb-item__title, .hb-item__price { font-size: 12.5px; }
  .hb-item__add { padding: 9px 8px; font-size: 12.5px; }
  .hb__list, .hb__list-empty { display: none; }
  .hb__summary { grid-template-areas: "head total" "error error" "nav nav"; }
  .hb__form { grid-template-columns: 1fr; }
}
{% endstylesheet %}

