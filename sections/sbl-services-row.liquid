{%- comment -%}
  SBL Services: one service (image, label, title, description, features, button).
  Add one section per service. Shared styles: assets/sbl-services.css.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign b = section.settings
  assign btn_link = b.button_link | default: '/pages/contact'
  assign slides = ''
  for i in (1..6)
    if i == 1
      assign key = 'image'
    else
      assign key = 'image_' | append: i
    endif
    if b[key] != blank
      assign slides = slides | append: key | append: ','
    endif
  endfor
  assign slides = slides | split: ','
-%}

{{ 'sbl-services.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sbl-pages.js' | asset_url }}" defer></script>

{%- capture arrow_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture check_svg -%}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.5 14.6 4l3-.1 1.4 2.6 2.6 1.5-.1 3L23 13.6l-1.5 2.6.1 3-2.6 1.4L17.6 23l-3-.1L12 24.5 9.4 23l-3 .1L5 20.5 2.4 19l.1-3L1 13.4l1.5-2.6-.1-3L5 6.4 6.4 3.9l3 .1Z" transform="scale(.92) translate(1 0)"/><path d="m8 12.3 2.7 2.7 5.4-5.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}

<div id="sbls-{{ sid }}" class="sbls" style="--sec-bg: {{ b.bg_color }};" data-sbl-root>
  <div class="sbls-wrap" style="padding-top: {{ b.padding_top }}px; padding-bottom: {{ b.padding_bottom }}px;">
    <article class="sbls-row{% if b.image_side == 'right' %} sbls-row--flip{% endif %}" id="{{ b.anchor | default: sid | handleize }}" aria-labelledby="sbls-t-{{ sid }}">
      <div class="sbls-row__media sbls-slider" data-reveal data-sbls-slider data-autoplay="{{ b.autoplay_seconds }}">
        {%- if slides.size > 0 -%}
          <div class="sbls-slider__track" data-track tabindex="0" aria-label="{{ b.title | escape }} photos" aria-roledescription="carousel">
            {%- for key in slides -%}
              {%- assign img = b[key] -%}
              <div class="sbls-slider__slide" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ slides.size }}">
                {{ img | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 52vw, 100vw', loading: 'lazy', alt: img.alt | default: b.title }}
              </div>
            {%- endfor -%}
          </div>
          {%- if slides.size > 1 -%}
            <button type="button" class="sbls-slider__btn sbls-slider__btn--prev" data-prev aria-label="Previous photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button type="button" class="sbls-slider__btn sbls-slider__btn--next" data-next aria-label="Next photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
            <div class="sbls-slider__dots" aria-hidden="true">
              {%- for key in slides -%}<span class="sbls-slider__dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'sbls-ph' }}
        {%- endif -%}
      </div>
      <div data-reveal>
        {%- if b.number != blank or b.label != blank -%}
          <p class="sbls-eyebrow">{{ b.number | escape }}{% if b.number != blank and b.label != blank %} / {% endif %}{{ b.label | escape }}</p>
        {%- endif -%}
        <h2 id="sbls-t-{{ sid }}" class="sbls-h2">{{ b.title | escape }}</h2>
        {%- if b.text != blank -%}<p class="sbls-row__text">{{ b.text | escape }}</p>{%- endif -%}
        {%- if b.features != blank -%}
          {%- assign feats = b.features | newline_to_br | split: '<br />' -%}
          <ul class="sbls-feats" role="list">
            {%- for feat in feats -%}
              {%- assign f = feat | strip -%}
              {%- if f != blank -%}<li>{{ check_svg }}<span>{{ f | escape }}</span></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if b.button_label != blank -%}
          <a class="sbls-btn sbls-btn--primary" href="{{ btn_link }}">{{ b.button_label | escape }}{{ arrow_svg }}</a>
        {%- endif -%}
      </div>
    </article>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('#sbls-{{ sid }} [data-sbls-slider]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    var track = root.querySelector('[data-track]');
    var dots = root.querySelectorAll('.sbls-slider__dot');
    if (!track || dots.length < 2) return;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function index() { return Math.round(track.scrollLeft / track.clientWidth); }
    function go(i) {
      var n = dots.length;
      i = (i + n) % n;
      track.scrollTo({ left: i * track.clientWidth, behavior: reduced ? 'auto' : 'smooth' });
    }

    /* Autoplay: moves to the next photo every few seconds; pauses on hover, focus or when the tab is hidden. */
    var delay = (Number(root.dataset.autoplay) || 0) * 1000;
    var timer = null;
    var paused = false;
    function stop() { clearInterval(timer); timer = null; }
    function start() {
      stop();
      if (!delay || paused || document.hidden) return;
      timer = setInterval(function () { go(index() + 1); }, delay);
    }
    function user(fn) { return function (e) { fn(e); start(); }; }

    root.querySelector('[data-prev]').addEventListener('click', user(function () { go(index() - 1); }));
    root.querySelector('[data-next]').addEventListener('click', user(function () { go(index() + 1); }));
    track.addEventListener('keydown', user(function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index() - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index() + 1); }
    }));
    root.addEventListener('mouseenter', function () { paused = true; stop(); });
    root.addEventListener('mouseleave', function () { paused = false; start(); });
    root.addEventListener('focusin', function () { paused = true; stop(); });
    root.addEventListener('focusout', function () { paused = false; start(); });
    track.addEventListener('touchstart', function () { stop(); }, { passive: true });
    track.addEventListener('touchend', function () { start(); }, { passive: true });
    document.addEventListener('visibilitychange', start);
    start();
    var t;
    track.addEventListener('scroll', function () {
      clearTimeout(t);
      t = setTimeout(function () {
        var i = index();
        dots.forEach(function (d, k) { d.classList.toggle('is-active', k === i); });
      }, 60);
    }, { passive: true });
  })();
</script>

{% stylesheet %}
.sbls .sbls-slider { position: relative; }
.sbls .sbls-slider__track { display: flex; width: 100%; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
.sbls .sbls-slider__track::-webkit-scrollbar { display: none; }
.sbls .sbls-slider__track:focus-visible { outline: 3px solid #fff; outline-offset: -6px; }
.sbls .sbls-slider__slide { flex: 0 0 100%; height: 100%; scroll-snap-align: start; overflow: hidden; }
.sbls .sbls-slider__btn { position: absolute; top: 50%; z-index: 2; display: grid; place-items: center; width: 32px; height: 32px; margin-top: -16px; padding: 0; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .92); color: #1f3d27; box-shadow: 0 6px 18px rgba(0, 0, 0, .18); cursor: pointer; transition: background .2s, transform .2s; }
.sbls .sbls-slider__btn:hover { background: #fff; transform: scale(1.06); }
.sbls .sbls-slider__btn svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
.sbls .sbls-slider__btn--prev { left: 12px; }
.sbls .sbls-slider__btn--next { right: 12px; }
.sbls .sbls-slider__dots { position: absolute; left: 0; right: 0; bottom: 14px; z-index: 2; display: flex; justify-content: center; gap: 7px; pointer-events: none; }
.sbls .sbls-slider__dot { width: 8px; height: 8px; border-radius: 999px; background: rgba(255, 255, 255, .6); box-shadow: 0 1px 4px rgba(0, 0, 0, .25); transition: width .25s, background .25s; }
.sbls .sbls-slider__dot.is-active { width: 22px; background: #fff; }
@media (max-width: 749px) {
  .sbls .sbls-slider__btn { width: 28px; height: 28px; margin-top: -14px; }
  .sbls .sbls-slider__btn svg { width: 14px; height: 14px; }
  .sbls .sbls-slider__btn--prev { left: 8px; }
  .sbls .sbls-slider__btn--next { right: 8px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "SBL Services: Service",
  "tag": "section",
  "class": "section-sbl-services",
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "Number",
      "default": "01",
      "info": "Shown before the small label, e.g. 01 / LANDSCAPING"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "Landscaping",
      "info": "Shown after the number, e.g. 01 / LANDSCAPING"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Landscaping"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description"
    },
    {
      "type": "textarea",
      "id": "features",
      "label": "Features",
      "info": "One per line"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image 1",
      "info": "Add more images below to show ‹ › arrows and slide between them."
    },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "image_picker", "id": "image_5", "label": "Image 5" },
    { "type": "image_picker", "id": "image_6", "label": "Image 6" },
    { "type": "range", "id": "autoplay_seconds", "label": "Change photo every", "min": 0, "max": 10, "step": 1, "unit": "s", "default": 5, "info": "0 turns automatic sliding off. Sliding pauses while a visitor hovers over the photo." },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to /pages/contact"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Optional. Lets you link straight to this service, e.g. landscaping for #landscaping"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#F8F4EC"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "SBL Services: Service"
    }
  ]
}
{% endschema %}
