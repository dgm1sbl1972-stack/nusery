{%- comment -%}
  Smart Cart Drawer
  Rendered once in layout/theme.liquid inside the [data-cart-drawer] shell and
  re-rendered through the Section Rendering API (?sections=smart-cart-drawer)
  after every Ajax cart change, so totals, progress and recommendations stay live.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign threshold = s.free_delivery_threshold | default: 0 | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign progress = 0
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
  endif
  if progress > 100
    assign progress = 100
  endif

  assign cart_product_ids = cart.items | map: 'product_id' | join: ','
  assign cart_product_ids = ',' | append: cart_product_ids | append: ','
  assign rec_source = s.recommend_collection
  if rec_source == blank
    assign rec_source = collections['all']
  endif
  assign badge_tag = s.bestseller_tag | strip | downcase
-%}

<style>
  #shopify-section-{{ section.id }} {
    --scd-primary: {{ s.color_primary }};
    --scd-accent: {{ s.color_accent }};
    --scd-bg: {{ s.color_background }};
    --scd-card: {{ s.color_card }};
    --scd-text: {{ s.color_text }};
  }
  [data-cart-drawer] {
    --scd-width: {{ s.drawer_width }}px;
    --scd-overlay: {{ s.color_overlay }};
    --scd-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
  }
</style>

<div class="scd" data-cart-drawer-inner data-enabled="{{ s.enabled }}" data-item-count="{{ cart.item_count }}">
  <div class="scd__head">
    <h2 class="scd__title" id="CartDrawerTitle">{{ s.heading | escape }}</h2>
    <button type="button" class="scd__close" aria-label="Close cart" data-cart-drawer-close>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div class="scd__body">
    {%- if cart.item_count > 0 -%}
      {%- if threshold > 0 -%}
        <div class="scd__delivery">
          <p class="scd__delivery-text">
            {%- if remaining > 0 -%}
              Add {{ remaining | money_without_trailing_zeros }} more to unlock <strong>free delivery</strong>
            {%- else -%}
              Yay! You’ve unlocked <strong>free delivery</strong> 🎉
            {%- endif -%}
          </p>
          <div class="scd__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}" aria-label="Progress to free delivery">
            <span class="scd__fill" style="width: {{ progress }}%;"></span>
            <span class="scd__truck{% if remaining <= 0 %} is-done{% endif %}" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7" cy="17" r="1.6" fill="currentColor"/><circle cx="17" cy="17" r="1.6" fill="currentColor"/></svg>
            </span>
          </div>
        </div>
      {%- endif -%}

      <ul class="scd__items" role="list">
        {%- for item in cart.items -%}
          <li class="scd-item">
            <a href="{{ item.url }}" class="scd-item__media">
              {%- if item.image -%}
                {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title, width: 72, height: 72 }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'scd-placeholder' }}
              {%- endif -%}
            </a>
            <div class="scd-item__info">
              <div class="scd-item__top">
                <a href="{{ item.url }}" class="scd-item__title">{{ item.product.title }}</a>
                <button type="button" class="scd-item__remove" aria-label="Remove {{ item.product.title | escape }}" data-cart-line="{{ forloop.index }}" data-cart-qty="0">
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
              {%- unless item.product.has_only_default_variant -%}
                <label class="scd-select">
                  <span class="visually-hidden">Choose option for {{ item.product.title | escape }}</span>
                  <select data-cart-variant data-key="{{ item.key }}" data-qty="{{ item.quantity }}" data-properties="{{ item.properties | json | escape }}">
                    {%- for v in item.product.variants -%}
                      <option value="{{ v.id }}"{% if v.id == item.variant_id %} selected{% endif %}{% unless v.available or v.id == item.variant_id %} disabled{% endunless %}>{{ v.title }} · {{ v.price | money_without_trailing_zeros }}{% unless v.available %} (sold out){% endunless %}</option>
                    {%- endfor -%}
                  </select>
                </label>
              {%- endunless -%}
              {%- for p in item.properties -%}
                {%- assign first_char = p.first | slice: 0 -%}
                {%- if p.last != blank and first_char != '_' -%}<p class="scd-item__variant">{{ p.first }}: {{ p.last }}</p>{%- endif -%}
              {%- endfor -%}
              <div class="scd-item__bottom">
                <div class="scd-item__price">
                  <strong>{{ item.final_line_price | money_without_trailing_zeros }}</strong>
                  {%- assign compare_line = item.variant.compare_at_price | times: item.quantity -%}
                  {%- if compare_line > item.final_line_price -%}
                    <s>{{ compare_line | money_without_trailing_zeros }}</s>
                  {%- elsif item.original_line_price > item.final_line_price -%}
                    <s>{{ item.original_line_price | money_without_trailing_zeros }}</s>
                  {%- endif -%}
                </div>
                <div class="scd-qty">
                  <button type="button" aria-label="Decrease quantity" data-cart-line="{{ forloop.index }}" data-cart-qty="{{ item.quantity | minus: 1 }}">−</button>
                  <span aria-label="Quantity">{{ item.quantity }}</span>
                  <button type="button" aria-label="Increase quantity" data-cart-line="{{ forloop.index }}" data-cart-qty="{{ item.quantity | plus: 1 }}">+</button>
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="scd__empty">
        <svg viewBox="0 0 24 24" width="48" height="48" aria-hidden="true"><path d="M3 4h2l2.1 11.2a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 1.9-1.4L21 8H6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
        <p>Your cart is empty</p>
        <a class="scd__btn" href="{{ routes.all_products_collection_url }}" data-cart-drawer-close>Continue shopping</a>
      </div>
    {%- endif -%}

    {%- if s.show_recommendations and rec_source != blank -%}
      {%- capture rec_cards -%}
        {%- assign shown = 0 -%}
        {%- for product in rec_source.products -%}
          {%- if shown >= s.recommend_count -%}{%- break -%}{%- endif -%}
          {%- assign pid_key = ',' | append: product.id | append: ',' -%}
          {%- if cart_product_ids contains pid_key or product.available == false -%}{%- continue -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign rec_variant = product.selected_or_first_available_variant -%}
          {%- liquid
            assign rating = product.metafields.reviews.rating.value.rating
            assign rating_count = product.metafields.reviews.rating_count.value
            if rating == blank
              assign rating = product.metafields.custom.rating.value
              assign rating_count = product.metafields.custom.review_count.value
            endif
            assign is_bestseller = false
            if badge_tag != blank
              for tag in product.tags
                assign t = tag | downcase
                if t == badge_tag
                  assign is_bestseller = true
                  break
                endif
              endfor
            endif
          -%}
          <div class="scd-rec">
            <a href="{{ product.url }}" class="scd-rec__media">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: product.title, sizes: '180px', widths: '200, 400' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'scd-placeholder' }}
              {%- endif -%}
              {%- if s.show_badge and is_bestseller -%}<span class="scd-rec__badge">{{ s.badge_label | escape }}</span>{%- endif -%}
              {%- if s.show_ratings and rating != blank -%}
                <span class="scd-rec__rating">{{ rating | round: 1 }} <span aria-hidden="true">★</span>{% if rating_count != blank %}<em>| {{ rating_count }}</em>{% endif %}</span>
              {%- endif -%}
            </a>
            <div class="scd-rec__body">
              <a href="{{ product.url }}" class="scd-rec__title">{{ product.title }}</a>
              {%- unless product.has_only_default_variant -%}
                <label class="scd-select scd-select--sm">
                  <span class="visually-hidden">Choose option for {{ product.title | escape }}</span>
                  <select data-rec-variant>
                    {%- for v in product.variants -%}
                      {%- if v.available -%}
                        <option value="{{ v.id }}" data-price="{{ v.price | money_without_trailing_zeros | escape }}"{% if v.id == rec_variant.id %} selected{% endif %}>{{ v.title }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                </label>
              {%- endunless -%}
              <div class="scd-rec__foot">
                <span class="scd-rec__price" data-rec-price>{{ rec_variant.price | money_without_trailing_zeros }}</span>
                <button type="button" class="scd-rec__add" aria-label="Add {{ product.title | escape }} to cart" data-quick-add="{{ rec_variant.id }}">
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8zM9 8V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endcapture -%}

      {%- if rec_cards != blank -%}
        <div class="scd__recs" data-scd-recs>
          <div class="scd__recs-head">
            <h3>{{ s.recommend_heading | escape }}</h3>
            <div class="scd__arrows">
              <button type="button" aria-label="Previous" data-scd-scroll="-1"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <button type="button" aria-label="Next" data-scd-scroll="1"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
          </div>
          <div class="scd__recs-track" data-scd-track>{{ rec_cards }}</div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="scd__foot">
      <div class="scd__total">
        <strong>{{ cart.total_price | money_without_trailing_zeros }}</strong>
        <span>{{ s.tax_note | escape }}</span>
      </div>
      <form action="{{ routes.cart_url }}" method="post" class="scd__checkout-form">
        <button type="submit" name="checkout" class="scd__checkout">{{ s.checkout_label | escape }}</button>
      </form>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Smart Cart Drawer",
  "class": "smart-cart-drawer-section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Open cart drawer on Add to cart", "default": true, "info": "Turn off to send shoppers to the /cart page instead." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cart" },
    { "type": "range", "id": "drawer_width", "label": "Drawer width (desktop)", "min": 360, "max": 600, "step": 10, "unit": "px", "default": 460 },
    { "type": "header", "content": "Free delivery" },
    { "type": "number", "id": "free_delivery_threshold", "label": "Free delivery above (₹)", "default": 499, "info": "Order value for free delivery. Set to 0 to hide the progress bar." },
    { "type": "header", "content": "Recommended products" },
    { "type": "checkbox", "id": "show_recommendations", "label": "Show recommended products", "default": true },
    { "type": "text", "id": "recommend_heading", "label": "Heading", "default": "Recommended Products" },
    { "type": "collection", "id": "recommend_collection", "label": "Collection", "info": "Products already in the cart are skipped automatically. Defaults to all products." },
    { "type": "range", "id": "recommend_count", "label": "Number of products", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_ratings", "label": "Show ratings", "default": true, "info": "Uses Judge.me / Shopify review ratings." },
    { "type": "checkbox", "id": "show_badge", "label": "Show bestseller badge", "default": true },
    { "type": "text", "id": "bestseller_tag", "label": "Bestseller product tag", "default": "bestseller", "info": "Products with this tag get the badge." },
    { "type": "text", "id": "badge_label", "label": "Badge text", "default": "BESTSELLER" },
    { "type": "header", "content": "Checkout" },
    { "type": "text", "id": "tax_note", "label": "Note under total", "default": "Inclusive of all taxes" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "CHECKOUT" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_primary", "label": "Primary green", "default": "#1F5130" },
    { "type": "color", "id": "color_accent", "label": "Accent yellow", "default": "#FFD60A" },
    { "type": "color", "id": "color_background", "label": "Drawer background", "default": "#FFFDF8" },
    { "type": "color", "id": "color_card", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#14231A" },
    { "type": "color", "id": "color_overlay", "label": "Overlay", "default": "#0D3A1D" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 }
  ]
}
{% endschema %}
