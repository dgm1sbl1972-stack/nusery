<section class="services section-pad" style="background: {{ section.settings.background }};">
  <div class="page-width page-width--narrow">
    <div class="services__card">
      <div class="services__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 450px, 100vw', widths: '450, 700, 900' }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="services__content">
        <h2 class="services__title">{{ section.settings.heading }}</h2>
        <div class="services__text">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--dark">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Services banner",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#ffe9c4" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Garden services by SBL Nursery" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>From balcony makeovers to full garden setups and regular maintenance — our horticulture experts bring the green to your doorstep.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all Our Service" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Services banner" } ]
}
{% endschema %}
