<section class="story section-pad" style="background: {{ section.settings.background }};">
  <div class="page-width story__grid">
    <div class="story__images">
      {%- for n in (1..3) -%}
        {%- assign key = 'image_' | append: n -%}
        {%- assign img = section.settings[key] -%}
        <div class="story__img story__img--{{ n }}">
          {%- if img != blank -%}
            {{ img | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 440px, 100vw', widths: '400, 600, 800' }}
          {%- else -%}
            {%- assign ph = n | modulo: 2 | plus: 1 -%}
            {{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="story__content">
      {%- if section.settings.eyebrow != blank -%}<p class="story__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-title section-title--left">
        {{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em>
        {%- if section.settings.heading_2 != blank -%}<br>{{ section.settings.heading_2 }}{%- endif -%}
      </h2>
      <div class="story__text rte">{{ section.settings.text }}</div>

      <div class="stats">
        {%- for block in section.blocks -%}
          <div class="stat" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.value }}</strong>
            <span>{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Our story",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#fdf6ee" },
    { "type": "image_picker", "id": "image_1", "label": "Large image" },
    { "type": "image_picker", "id": "image_2", "label": "Small image 1" },
    { "type": "image_picker", "id": "image_3", "label": "Small image 2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rooted in" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Passion," },
    { "type": "text", "id": "heading_2", "label": "Heading line 2", "default": "Growing in Purpose" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>SBL Nursery started in a small Bangalore nursery with one simple belief — every home deserves the joy of greenery. What began as a weekend hobby grew into India's most trusted online plant store.</p><p>We work directly with skilled horticulturists and small-scale growers across India, ensuring every plant is nurtured with care before reaching your doorstep.</p><p>Today, we've helped over 3.5 lakh families across India build their own green sanctuaries — and we're just getting started.</p>"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "3.5L+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Happy Customers" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our story",
      "blocks": [
        { "type": "stat", "settings": { "value": "3.5L+", "label": "Happy Customers" } },
        { "type": "stat", "settings": { "value": "500+", "label": "Plant Varieties" } },
        { "type": "stat", "settings": { "value": "28+", "label": "Cities Served" } },
        { "type": "stat", "settings": { "value": "4.9★", "label": "Customer Rating" } }
      ]
    }
  ]
}
{% endschema %}
