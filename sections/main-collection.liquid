{%- liquid
  assign coll_filtered = false
  if collection != blank
    if collection.sort_by != blank
      assign coll_filtered = true
    endif
    for f in collection.filters
      if f.active_values.size > 0 or f.min_value.value != nil or f.max_value.value != nil
        assign coll_filtered = true
        break
      endif
    endfor
  endif
  assign main_coll_show = true
  unless coll_filtered
    if section.settings.hide_on_handle == '*'
      assign main_coll_show = false
    elsif section.settings.hide_on_handle != blank and collection.handle == section.settings.hide_on_handle
      assign main_coll_show = false
    endif
  endunless
-%}
{%- if main_coll_show -%}
<section class="section-pad" style="background: var(--c-cream);">
  <div class="page-width">
    <h1 class="section-title section-title--left">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte section-sub">{{ collection.description }}</div>{%- endif -%}

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
      {%- assign show_filters = false -%}
      {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}{%- assign show_filters = true -%}{%- endif -%}
      {%- assign show_sidebar = show_filters -%}
      {%- if section.blocks.size > 0 -%}{%- assign show_sidebar = true -%}{%- endif -%}

      {%- assign form_id = 'CollectionFilters-' | append: section.id -%}
      {%- assign clear_url = collection.url | append: '?sort_by=' | append: sort_by -%}
      <div class="collection-layout mt-40{% unless show_sidebar %} collection-layout--no-filters{% endunless %}">
        {%- render 'facets-sidebar', section: section, section_id: section.id, filters: collection.filters, show_filters: show_filters, show_sidebar: show_sidebar, form_id: form_id, results_url: collection.url, clear_url: clear_url, current_url: collection.url -%}

        <div class="collection-main">
          <div class="collection-toolbar">
            <p class="collection-toolbar__count collection-toolbar__count--desktop">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</p>
            {%- if show_sidebar -%}{%- render 'facets-filter-button', section_id: section.id -%}{%- endif -%}
            {%- if section.settings.enable_sorting -%}
              <label class="collection-toolbar__sort">
                <span>Sort by</span>
                <select name="sort_by" form="{{ form_id }}">
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
                  {%- endfor -%}
                </select>
              </label>
            {%- endif -%}
          </div>

          {%- if show_filters -%}{%- render 'facets-active', filters: collection.filters -%}{%- endif -%}

          <div class="product-grid">
            {%- for product in collection.products -%}
              {%- render 'product-card', product: product -%}
            {%- else -%}
              <p class="collection-empty">No products match these filters. <a href="{{ collection.url }}">Clear filters</a></p>
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}<div class="pagination center mt-40">{{ paginate | default_pagination }}</div>{%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</section>

{%- endif -%}

{% schema %}
{
  "name": "Collection products",
  "settings": [
    { "type": "text", "id": "hide_on_handle", "label": "Hide product grid on collection (handle)", "info": "Hides this grid on that collection unless a filter or sort is applied, e.g. gifting so the gifting page shows instead. Use * to hide it on every collection using this template." },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16 },
    { "type": "header", "content": "Categories" },
    { "type": "text", "id": "categories_heading", "label": "Categories heading", "default": "Shop by category" },
    { "type": "checkbox", "id": "open_categories", "label": "Expand all categories by default", "default": false },
    { "type": "paragraph", "content": "Leave a link empty to use the collection whose name matches the category (e.g. \"Indoor plants\" → /collections/indoor-plants). If no such collection exists, it links to a product search." },
    { "type": "header", "content": "Filters" },
    { "type": "checkbox", "id": "enable_filtering", "label": "Show filters on the left", "default": true, "info": "Choose which filters appear in the Shopify Search & Discovery app." },
    { "type": "checkbox", "id": "open_filters", "label": "Expand all filter groups by default", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "Show sort dropdown", "default": true }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Category name", "default": "Plants" },
        { "type": "url", "id": "link", "label": "Category link" },
        { "type": "header", "content": "Sub-category 1" },
        { "type": "text", "id": "sub_1_title", "label": "Name" },
        { "type": "url", "id": "sub_1_link", "label": "Link" },
        { "type": "header", "content": "Sub-category 2" },
