        { "type": "text", "id": "sub_7_title", "label": "Name" },
        { "type": "url", "id": "sub_7_link", "label": "Link" },
        { "type": "header", "content": "Sub-category 8" },
        { "type": "text", "id": "sub_8_title", "label": "Name" },
        { "type": "url", "id": "sub_8_link", "label": "Link" },
        { "type": "header", "content": "Sub-category 9" },
        { "type": "text", "id": "sub_9_title", "label": "Name" },
        { "type": "url", "id": "sub_9_link", "label": "Link" },
