{%- comment -%}
  Plant finder quiz. Each question block lists answers one per line:
    Answer label | collection-handle
  The collection handle is optional. When the quiz ends, the collection with
  the most votes is recommended (falls back to the section's default link).
{%- endcomment -%}
<section class="finder" data-plant-finder>
  <div class="page-width finder__grid">
    <div class="finder__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--lines">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="finder__title">{{ section.settings.heading }} <span class="text-accent">{{ section.settings.heading_accent }}</span></h2>
      <div class="finder__text">{{ section.settings.text }}</div>
      <ul class="check-list">
        {%- for n in (1..3) -%}
          {%- assign key = 'point_' | append: n -%}
          {%- if section.settings[key] != blank -%}<li>{{ section.settings[key] }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="finder__card">
      <div class="finder__progress"><span data-finder-progress></span></div>

      {%- for block in section.blocks -%}
        {%- assign lines = block.settings.answers | newline_to_br | split: '<br />' -%}
        <div class="finder__step" data-finder-step{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
          <p class="finder__question">{{ block.settings.question }}</p>
          <div class="finder__options">
            {%- for line in lines -%}
              {%- assign parts = line | split: '|' -%}
              {%- assign label = parts[0] | strip -%}
              {%- if label == blank -%}{%- continue -%}{%- endif -%}
              {%- assign handle = parts[1] | strip -%}
              {%- assign target = collections[handle] -%}
              <button type="button" class="finder__option" data-finder-option data-value="{{ handle | escape }}" data-title="{{ target.title | default: handle | escape }}" data-url="{% if target != blank %}{{ target.url }}{% endif %}">{{ label }}</button>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}

      <div class="finder__result" data-finder-result hidden>
        <p class="finder__question">{{ section.settings.result_heading }}</p>
        <p class="finder__result-name" data-finder-result-name></p>
        <div class="finder__result-actions">
          <a href="{{ section.settings.fallback_link | default: routes.all_products_collection_url }}" class="btn btn--accent" data-finder-link data-fallback="{{ section.settings.fallback_link | default: routes.all_products_collection_url }}">{{ section.settings.result_button }} <span aria-hidden="true">→</span></a>
          <button type="button" class="btn btn--ghost" data-finder-restart>Start over</button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Plant finder quiz",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Plant finder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not Sure Which Plant to" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (yellow)", "default": "Choose?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Answer 4 quick questions and we'll match you with the perfect plant for your space, lifestyle and experience level. No green thumb required!</p>" },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "Takes less than 60 seconds" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "Personalised to your home & lifestyle" },
    { "type": "text", "id": "point_3", "label": "Point 3", "default": "Instant results with care tips" },
    { "type": "text", "id": "result_heading", "label": "Result heading", "default": "Your perfect match:" },
    { "type": "text", "id": "result_button", "label": "Result button label", "default": "Shop my plants" },
    { "type": "url", "id": "fallback_link", "label": "Default result link" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How much natural light does your space get?" },
        {
          "type": "textarea",
          "id": "answers",
          "label": "Answers",
          "info": "One per line. Format: Answer | collection-handle (handle optional)",
          "default": "☀️ Bright & sunny | flower-plant\n🌥️ Low light | leaf-plant\n⛅ Moderate light | herbs\n🪟 No windows | succulent-creepers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Plant finder quiz",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "How often can you water your plants?", "answers": "💧 Every day | herbs\n🗓️ Twice a week | flower-plant\n🌵 Once in a while | succulent-creepers\n🤷 I often forget | succulent-creepers" } },
        { "type": "question", "settings": { "question": "Where will the plant live?", "answers": "🛋️ Living room | leaf-plant\n🌇 Balcony | flower-creepers\n🍳 Kitchen | herbs\n💻 Work desk | succulent-creepers" } },
        { "type": "question", "settings": { "question": "What's your experience level?", "answers": "🌱 Complete beginner | leaf-plant\n🌿 Some experience | flower-plant\n🌳 Plant pro | fruit-plant\n🎁 Buying as a gift | ornamental-flower" } }
      ]
    }
  ]
}
{% endschema %}
