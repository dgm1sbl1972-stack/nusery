    { "type": "textarea", "id": "hero_text", "label": "Text", "default": "Thoughtful plants and green gifts for every celebration, occasion and special moment." },
    { "type": "text", "id": "hero_button_label", "label": "Button label", "default": "Shop Gifts" },
    { "type": "url", "id": "hero_button_link", "label": "Button link", "info": "Defaults to the current collection" },
    { "type": "text", "id": "hero_note", "label": "Small note under button", "default": "Gift-wrapped with a free handwritten note" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Lifestyle image, 1600 x 1400px recommended" },
    { "type": "text", "id": "hero_chip", "label": "Image badge", "default": "Loved by plant gifters" },
    { "type": "checkbox", "id": "hero_media_first_mobile", "label": "Show image first on mobile", "default": false },

    { "type": "header", "content": "Shop by occasion" },
