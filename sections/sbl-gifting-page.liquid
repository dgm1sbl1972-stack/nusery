    { "type": "text", "id": "budget_heading", "label": "Heading", "default": "Gifts by Budget" },
    { "type": "text", "id": "budget_subheading", "label": "Subheading", "default": "Thoughtful green gifts for every budget" },
    { "type": "collection", "id": "budget_collection", "label": "Collection to filter by price", "info": "Budget cards without their own link open this collection filtered by their price range. Defaults to the current collection." },
    { "type": "text", "id": "budget_link_label", "label": "Card link label", "default": "Shop now" },

