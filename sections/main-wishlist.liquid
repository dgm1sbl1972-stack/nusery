{%- comment -%}
  Wishlist page. Saved product handles live in the shopper's browser
  (localStorage); nursery.js fetches each product and renders the cards here.
{%- endcomment -%}
<section class="wl-page section-pad">
  <div class="page-width">
    <div class="wl-page__head">
      <h1 class="section-title section-title--left">{{ section.settings.heading | escape }}</h1>
      <p class="wl-page__count" data-wishlist-summary></p>
    </div>
    <div class="wl-grid" data-wishlist-page data-currency="{{ cart.currency.iso_code }}" data-add-label="{{ 'general.add_to_cart' | t | escape }}">
      <p class="wl-page__loading">Loading your wishlist…</p>
    </div>
    <div class="wl-empty" data-wishlist-empty hidden>
      <svg viewBox="0 0 24 24" width="56" height="56" aria-hidden="true"><path d="M20.8 8.7c0 5.2-8.8 11-8.8 11s-8.8-5.8-8.8-11A4.6 4.6 0 0 1 12 6.4a4.6 4.6 0 0 1 8.8 2.3Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      <h2>{{ section.settings.empty_heading | escape }}</h2>
      <p>{{ section.settings.empty_text | escape }}</p>
      <a class="btn btn--dark" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "My Wishlist" },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Your wishlist is empty" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "Tap the ♡ on any plant to save it here for later." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore plants" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ]
}
{% endschema %}
